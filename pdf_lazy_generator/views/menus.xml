<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_pdf_attachments" model="ir.actions.act_window">
        <field name="name">All PDFs</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('mimetype','=','application/pdf')]</field>
    </record>
    <menuitem id="menu_pdf_root"
              name="PDF Manager"
              sequence="10"/>

    <menuitem id="menu_all_pdfs"
              name="All PDFs"
              parent="menu_pdf_root"
              action="action_pdf_attachments"/>
</odoo>