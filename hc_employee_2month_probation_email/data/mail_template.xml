<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="employee_2month_probation_email_template" model="mail.template">
            <field name="name">Employee 2 Month Probation Email</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">{{object.name}} 入职已满兩个月</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{object.parent_id.work_email }},{{object.hr_responsible_id.work_email}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <p>Dear
                            <t t-out="object.parent_id.name"/>
                        </p>
                        <p>
                            <t t-out="object.name"/> 入职已满两个月， 試用期將於 <t t-esc="object.probation_end_date.strftime('%d/%m/%y')"/>屆滿。 請直属主管同意是否轉正。
                        </p>
                        <br/>
                        <p>Dear HR,
                        </p>
                        <p>
                            如確認轉正，请向员工发放 《转正评核表》进行填写。
                        </p>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
