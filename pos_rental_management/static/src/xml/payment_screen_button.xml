<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ✅ Extend existing Payment Screen Buttons -->
    <t t-name="pos_rental_management.PaymentScreenButtonsPartial"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">

        <!-- ✅ SAFE TARGET: Customer button (NO @class usage) -->
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <t t-if="pos.config.allow_partial_payment">
                <button
                    t-on-click="PartialPaymentButton"
                    t-attf-class="button partial-payment-btn btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline flex-fill lh-lg
                    #{currentOrder and currentOrder.is_partial_payment ? 'highlight active text-action' : ''}">

                    <span>
                        <i class="fa fa-credit-card me-2"/>
                        Partial Payment
                    </span>

                    <i class="fa me-2"
                       t-attf-class="{{ currentOrder and currentOrder.is_partial_payment
                            ? 'fa-check-square text-action'
                            : 'fa-square-o' }}" />
                </button>
            </t>
        </xpath>
    </t>


    <!-- ✅ Validate Button Reference (SAFE, NO @class) -->
    <t t-name="pos_rental_management.PaymentScreenValidateRef"
       t-inherit="point_of_sale.PaymentScreenValidate"
       t-inherit-mode="extension">

        <xpath expr="//button[hasclass('validation')]" position="attributes">
            <attribute name="t-ref">PartialPayment</attribute>
        </xpath>

    </t>

</templates>
