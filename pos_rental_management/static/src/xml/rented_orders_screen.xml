<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_rental_management.RentedOrdersPage" owl="1">
        <div class="screen d-flex flex-column p-3">

            <h2>Rented Orders</h2>

            <button class="btn btn-secondary mt-2 mb-3" t-on-click="back">
                ⬅ Back
            </button>

            <t t-foreach="state.orders" t-as="o" t-key="o.id">
                <div class="card p-2 my-2">
                    <strong><t t-esc="o.name" /></strong>
                </div>
            </t>

        </div>
    </t>
</templates>
