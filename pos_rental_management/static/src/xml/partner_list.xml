<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<t t-name="pos_rent.PartnerLine"
   t-inherit="point_of_sale.PartnerLine"
   t-inherit-mode="extension">

    <xpath expr="//tr[hasclass('partner-line')]/td[hasclass('partner-line-balance')]" position="after">
        <td class="text-center px-3 py-2">
            <button class="btn btn-primary btn-sm"
                    t-on-click="() => this.onClickViewRentalProducts()">
                View Rental Product
            </button>
        </td>
    </xpath>

</t>
</templates>