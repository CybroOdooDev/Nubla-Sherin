<odoo>
    <record id="view_pos_rental_res_config_settings" model="ir.ui.view">
        <field name="name">pos.rental.res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='pos_pricing_section']" position="inside">
                <div class="o_setting_box">
                    <div class="o_setting_left">
                        <field name="allow_partial_payment"/>
                    </div>

                    <div class="o_setting_right">
                        <label for="allow_partial_payment"/>
                        <div class="text-muted">
                            Allow seller to validate partially paid rental orders.
                            *Rental Order - Order that contains at least one rental product.
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="after">
                <block title="Rental Security Product" id="rental_management_section">
                    <setting
                            string="Default Rental Security Product"
                            help="Select the default rental security product used in POS orders."
                    >
                        <div class="row mt16">
                            <label class="col-lg-3" for="rental_security_product_id"/>
                            <field name="rental_security_product_id" nolabel="1"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
