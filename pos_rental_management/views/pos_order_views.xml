<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit POS Order Form View -->
    <record id="view_pos_order_rented_ribbon" model="ir.ui.view">
        <field name="name">pos.order.rented.ribbon</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>

        <field name="arch" type="xml">
            <!-- Insert RENTED ribbon above sheet -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon"
                        title="RENTED"
                        bg_color="text-bg-success"
                        invisible="not is_rented"/>
            </xpath>
        </field>
    </record>

</odoo>
