<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban view: application pipeline cards grouped by stage, with score/RTW/registration flags -->
    <record id="view_nhs_application_kanban" model="ir.ui.view">
        <field name="name">nhs.application.kanban</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" records_draggable="1">
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="vacancy_id"/>
                <field name="shortlist_score"/>
                <field name="duplicate_warning"/>
                <field name="right_to_work_flagged"/>
                <field name="registration_flagged"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5"><field name="candidate_id"/></strong>
                                    <div class="text-muted"><field name="name"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-briefcase me-1" title="Vacancy"/><field name="vacancy_id"/></div>
                                <div t-if="record.shortlist_score.raw_value > 0" class="mt-1">
                                    <i class="fa fa-star text-warning me-1" title="Shortlist Score"/>
                                    <field name="shortlist_score"/>
                                </div>
                                <div class="mt-2">
                                    <span t-if="record.duplicate_warning.raw_value" class="badge text-bg-danger me-1">
                                        <i class="fa fa-exclamation-triangle"/> Duplicate?
                                    </span>
                                    <span t-if="record.right_to_work_flagged.raw_value" class="badge text-bg-warning me-1" title="Right to Work Flagged">
                                        <i class="fa fa-globe"/> RTW
                                    </span>
                                    <span t-if="record.registration_flagged.raw_value" class="badge text-bg-warning me-1" title="Registration Flagged">
                                        <i class="fa fa-id-card-o"/> Reg
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <i class="fa fa-clock-o me-1"/> <field name="create_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view: applications overview with stage, shortlist score and source -->
    <record id="view_nhs_application_list" model="ir.ui.view">
        <field name="name">nhs.application.list</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <list string="Applications">
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="vacancy_id"/>
                <field name="stage" widget="badge"/>
                <field name="shortlist_score"/>
                <field name="source"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form view: application record, shortlisting/interview/offer workflow buttons and tabs -->
    <record id="view_nhs_application_form" model="ir.ui.view">
        <field name="name">nhs.application.form</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <form string="Application">
                <header>
                    <button name="action_start_shortlisting" type="object" string="Start Shortlisting"
                            class="btn-primary" invisible="stage != 'received'"/>
                    <button name="action_shortlist_decide" type="object" string="Apply Shortlist Decision"
                            class="btn-primary" invisible="stage != 'shortlisting'"/>
                    <button name="action_make_offer" type="object" string="Make Offer"
                            class="btn-primary" invisible="stage != 'interview'"/>
                    <button name="action_send_acknowledgement" type="object" string="Send Acknowledgement"
                            class="btn-primary" invisible="acknowledged or stage == 'received'"/>
                    <button name="action_reject" type="object" string="Reject"
                            class="btn-primary" invisible="stage in ('hired', 'rejected', 'withdrawn')"
                            confirm="Reject this application?"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            class="btn-primary" invisible="stage in ('hired', 'rejected', 'withdrawn')"/>
                    <field name="stage" widget="statusbar"
                           statusbar_visible="received,shortlisting,shortlisted,interview,offered,hired"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not duplicate_warning">
                        This candidate has applied to this vacancy more than once.
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="vacancy_id"/>
                            <field name="candidate_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="shortlist_score" readonly="1"/>
                            <field name="shortlist_outcome" widget="radio" options="{'horizontal': true}"
                                   invisible="stage == 'received'"/>
                            <field name="shortlist_reason"
                                   invisible="stage == 'received' or shortlist_outcome != 'not_shortlisted'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Application">
                            <group>
                                <field name="right_to_work_flagged"/>
                                <field name="registration_flagged"/>
                            </group>
                            <separator string="Supporting Statement"/>
                            <field name="supporting_statement" placeholder="Candidate's reasons for applying and how they meet the person specification..."/>
                            <separator string="Employment History"/>
                            <field name="employment_history" placeholder="Details of previous employment, roles, and responsibilities..."/>
                            <field name="cv_attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Shortlisting Scores" invisible="stage == 'received'">
                            <field name="person_spec_id" invisible="1"/>
                            <div class="alert alert-warning" role="alert" invisible="person_spec_id">
                                This vacancy has no Person Specification set — set one on the
                                vacancy before scoring this application against it.
                            </div>
                            <field name="score_line_ids">
                                <list editable="bottom">
                                    <field name="criterion_id"
                                           domain="[('spec_id', '=', parent.person_spec_id)]"/>
                                    <field name="score"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Interviews" invisible="stage == 'received'">
                            <field name="interview_ids">
                                <list>
                                    <field name="interview_datetime"/>
                                    <field name="location"/>
                                    <field name="invite_status"/>
                                    <field name="outcome"/>
                                    <field name="total_score"/>
                                </list>
                            </field>
                        </page>
                        <page string="Offer" invisible="not offer_id">
                            <field name="offer_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view: filter applications by stage, group by stage or vacancy -->
    <record id="view_nhs_application_search" model="ir.ui.view">
        <field name="name">nhs.application.search</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name"/>
                <field name="candidate_id"/>
                <field name="vacancy_id"/>
                <filter string="Received" name="received" domain="[('stage', '=', 'received')]"/>
                <filter string="Shortlisting" name="shortlisting" domain="[('stage', '=', 'shortlisting')]"/>
                <filter string="Interview" name="interview" domain="[('stage', '=', 'interview')]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Vacancy" name="group_vacancy" context="{'group_by': 'vacancy_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: Applications menu entry (kanban/list/form) -->
    <record id="action_nhs_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">nhs.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_application_search"/>
    </record>
</odoo>
