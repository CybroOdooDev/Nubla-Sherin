<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard view: confirm-hire form, warns if checks not all cleared -->
    <record id="view_nhs_onboard_wizard_form" model="ir.ui.view">
        <field name="name">nhs.onboard.wizard.form</field>
        <field name="model">nhs.onboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Hire">
                <group>
                    <field name="offer_id" invisible="1"/>
                    <field name="candidate_id" readonly="1"/>
                    <field name="vacancy_id" readonly="1"/>
                    <field name="all_checks_cleared" widget="boolean_toggle" readonly="1"/>
                    <field name="start_date"/>
                    <field name="create_training_member"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="all_checks_cleared">
                    Not all required pre-employment checks are cleared yet.
                </div>
                <footer>
                    <button name="action_confirm_hire" type="object"
                            string="Confirm Hire" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard action: opens the confirm-hire onboarding wizard -->
    <record id="action_nhs_onboard_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Hire</field>
        <field name="res_model">nhs.onboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
