<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: daily check for ageing/stale vacancies needing attention -->
        <record id="ir_cron_nhs_vacancy_ageing" model="ir.cron">
            <field name="name">NHS Recruitment: Vacancy Ageing Reminder</field>
            <field name="model_id" ref="model_nhs_vacancy"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_vacancy_ageing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: daily check for pre-employment checks nearing/past expiry -->
        <record id="ir_cron_nhs_check_expiry" model="ir.cron">
            <field name="name">NHS Recruitment: Check Expiry Reminder</field>
            <field name="model_id" ref="model_nhs_check"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: monthly anonymise/purge of unsuccessful applicants past retention_expiry -->
        <record id="ir_cron_nhs_retention_purge" model="ir.cron">
            <field name="name">NHS Recruitment: Unsuccessful-Applicant Retention Purge</field>
            <field name="model_id" ref="model_nhs_candidate"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
