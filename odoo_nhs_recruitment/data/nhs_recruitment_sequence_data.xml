<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_nhs_vacancy" model="ir.sequence">
        <field name="name">NHS Vacancy Reference</field>
        <field name="code">nhs.vacancy</field>
        <field name="prefix">VAC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_nhs_candidate" model="ir.sequence">
        <field name="name">NHS Candidate Reference</field>
        <field name="code">nhs.candidate</field>
        <field name="prefix">CAND/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_nhs_application" model="ir.sequence">
        <field name="name">NHS Application Reference</field>
        <field name="code">nhs.application</field>
        <field name="prefix">APP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_nhs_interview" model="ir.sequence">
        <field name="name">NHS Interview Reference</field>
        <field name="code">nhs.interview</field>
        <field name="prefix">INT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_nhs_offer" model="ir.sequence">
        <field name="name">NHS Offer Reference</field>
        <field name="code">nhs.offer</field>
        <field name="prefix">OFR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
