<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- OWL template: KPI recruitment dashboard with stat cards, funnel and ageing panels -->
    <t t-name="odoo_nhs_recruitment.NhsRecruitmentDashboard" owl="1">
        <div class="o_nhs_recruitment_dashboard o_content p-4" style="height: 100%; overflow-y: auto;">
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                    <div class="spinner-border text-nhs-blue" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>

            <t t-else="">
                <!-- Dashboard Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom bg-white p-3 rounded-3 shadow-sm">
                    <div>
                        <h3 class="fw-bold mb-0 text-nhs-blue">
                            <i class="fa fa-tachometer me-2"/>Recruitment Dashboard
                        </h3>
                        <div class="text-muted small">
                            NHS Recruitment Pipeline Overview
                        </div>
                    </div>
                    <button class="btn btn-outline-nhs-blue btn-sm fw-semibold" t-on-click="loadData">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                </div>

                <!-- KPI Metric Cards Grid -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openOpenVacancies">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Open</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-briefcase"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.open_count"/>
                                <small class="text-muted">Vacancies open</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openApprovals">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Approvals</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-gavel"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.approval_count"/>
                                <small class="text-muted">Awaiting sign-off</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openApplicationsInFlight">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">In Flight</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-users"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.in_flight_count"/>
                                <small class="text-muted">Applications in flight</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openTimeToHire">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Time to Hire</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-hourglass-half"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.avg_time_to_hire"/>
                                <small class="text-muted">Average days</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl-2" t-if="state.data.can_view_checks">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openChecksOutstanding">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Checks</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-shield"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.checks_outstanding_count"/>
                                <small class="text-muted">Outstanding</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-4 col-xl-2" t-if="state.data.can_view_checks">
                        <div class="card h-100 shadow-sm rounded-3 rec-stat-card cursor-pointer"
                             t-on-click="openChecksConcern">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Concerns</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-exclamation-triangle"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.checks_concern_count"/>
                                <small class="text-muted">Checks flagged</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Panels Layout -->
                <div class="row g-4">
                    <!-- Left Column: Vacancies & Funnel -->
                    <div class="col-lg-7">
                        <!-- Open Vacancies Panel -->
                        <div class="card shadow-sm mb-4 rounded-3">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-briefcase text-nhs-blue me-2"/>Recruitment Pipeline
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="openOpenVacancies">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="small">
                                                <th>Vacancy</th>
                                                <th>Team</th>
                                                <th>Status</th>
                                                <th>Applications</th>
                                                <th>Days Open</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="!state.data.open_list.length">
                                                <tr>
                                                    <td colspan="5" class="text-center py-4 text-muted">
                                                        No open vacancies
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="state.data.open_list" t-as="v" t-key="v.id">
                                                <tr class="cursor-pointer" t-on-click="() => this.openRecord('nhs.vacancy', v.id)">
                                                    <td class="fw-semibold text-nhs-blue" t-esc="v.name"/>
                                                    <td class="small text-muted" t-esc="v.org_unit"/>
                                                    <td>
                                                        <span class="badge text-bg-secondary" t-esc="v.state_label"/>
                                                    </td>
                                                    <td t-esc="v.application_count"/>
                                                    <td class="small" t-esc="v.days_open"/>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Stage Funnel Panel -->
                        <div class="card shadow-sm rounded-3">
                            <div class="card-header bg-white py-3">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-filter text-nhs-blue me-2"/>Stage Conversion / Funnel
                                </h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="small">
                                                <th>Stage</th>
                                                <th class="text-end">Applications</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.funnel" t-as="f" t-key="f.stage">
                                                <tr class="cursor-pointer" t-on-click="() => this.openFunnelStage(f.stage)">
                                                    <td class="fw-semibold text-dark" t-esc="f.label"/>
                                                    <td class="text-end">
                                                        <span class="badge bg-nhs-blue" t-esc="f.count"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Ageing & Checks -->
                    <div class="col-lg-5">
                        <!-- Vacancy Ageing Panel -->
                        <div class="card shadow-sm mb-4 rounded-3">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-clock-o text-nhs-blue me-2"/>Vacancy Ageing
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="openAgeingVacancies">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="!state.data.ageing_list.length">
                                    <div class="text-center py-4 text-muted small">
                                        <i class="fa fa-check-circle text-success me-1"/> No long-open vacancies
                                    </div>
                                </t>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="state.data.ageing_list" t-as="v" t-key="v.id">
                                        <li class="list-group-item px-3 py-2 d-flex justify-content-between align-items-center cursor-pointer"
                                            t-on-click="() => this.openRecord('nhs.vacancy', v.id)">
                                            <div>
                                                <div class="small fw-semibold text-dark" t-esc="v.name"/>
                                                <div class="small text-muted opacity-75" t-esc="v.org_unit"/>
                                            </div>
                                            <span class="badge text-bg-warning" t-esc="v.days_open + ' days'"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>

                        <!-- Pre-Employment Checks Panel (restricted) -->
                        <div class="card shadow-sm rounded-3" t-if="state.data.can_view_checks">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-shield text-nhs-blue me-2"/>Pre-Employment Checks Outstanding
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="openChecksOutstanding">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="!state.data.checks_outstanding_list.length">
                                    <div class="text-center py-4 text-muted small">
                                        <i class="fa fa-check-circle text-success me-1"/> No outstanding checks
                                    </div>
                                </t>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="state.data.checks_outstanding_list" t-as="c" t-key="c.id">
                                        <li class="list-group-item px-3 py-2 d-flex justify-content-between align-items-center cursor-pointer"
                                            t-on-click="() => this.openRecord('nhs.check', c.id)">
                                            <div>
                                                <div class="small fw-semibold text-dark" t-esc="c.candidate"/>
                                                <div class="small text-muted opacity-75" t-esc="c.check_type"/>
                                            </div>
                                            <span class="badge text-bg-secondary" t-esc="c.status_label"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
