<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sage" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sage Integration" name="sage_integration">
                    <group>
                        <group name="sage_details" string="Sage Details">
                            <field name="sage_id" readonly="1"/>
                            <field name="sage_invoice_number" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
