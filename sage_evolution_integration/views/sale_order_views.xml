<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sage" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sage</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sage Integration" name="sage_integration">
                    <group>
                        <group name="sage_details" string="Sage Details">
                            <field name="sage_id" readonly="1"/>
                            <field name="sage_order_number" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
