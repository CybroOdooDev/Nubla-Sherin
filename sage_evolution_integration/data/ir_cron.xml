<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_pull_customers" model="ir.cron">
            <field name="name">Sage Evolution: Pull Customers</field>
            <field name="model_id" ref="model_sage_sync_log"/>
            <field name="state">code</field>
            <field name="code">model.pull_customers()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_pull_products" model="ir.cron">
