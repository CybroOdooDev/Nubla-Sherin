<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_complaint_link_incident_wizard_form" model="ir.ui.view">
        <field name="name">nhs.complaint.link.incident.wizard.form</field>
        <field name="model">nhs.complaint.link.incident.wizard</field>
        <field name="arch" type="xml">
            <form string="Link or Create Incident">
                <group>
                    <field name="complaint_id" readonly="1"/>
                    <field name="action" widget="radio"/>
                </group>
                <group string="Select Incidents to Link" invisible="action != 'link'">
                    <field name="incident_ids" nolabel="1" widget="many2many">
                        <list>
                            <field name="name"/>
                            <field name="incident_kind"/>
                            <field name="occurred_at" widget="date"/>
                            <field name="harm_grade"/>
                        </list>
                    </field>
                </group>
                <group string="New Incident Details" invisible="action != 'create'">
                    <field name="new_incident_occurred_at"/>
                    <field name="new_incident_description" nolabel="1"
                           placeholder="Incident description (pre-filled from complaint)…"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
