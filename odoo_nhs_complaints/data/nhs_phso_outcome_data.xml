<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="phso_outcome_not_upheld" model="nhs.phso.outcome">
        <field name="name">Not Upheld</field>
        <field name="sequence">10</field>
        <field name="color">success</field>
    </record>
    <record id="phso_outcome_partly_upheld" model="nhs.phso.outcome">
        <field name="name">Partly Upheld</field>
        <field name="sequence">20</field>
        <field name="color">warning</field>
    </record>
    <record id="phso_outcome_upheld" model="nhs.phso.outcome">
        <field name="name">Upheld</field>
        <field name="sequence">30</field>
        <field name="color">danger</field>
    </record>
</odoo>
