<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── KO41a Subject Config List ───────────────────────────── -->
    <record id="view_nhs_complaint_subject_list" model="ir.ui.view">
        <field name="name">nhs.complaint.subject.list</field>
        <field name="model">nhs.complaint.subject</field>
        <field name="arch" type="xml">
            <list string="KO41a Subjects" decoration-muted="not active">
                <field name="complete_name"/>
                <field name="ko41a_code"/>
                <field name="provider_types"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_complaint_subject_form" model="ir.ui.view">
        <field name="name">nhs.complaint.subject.form</field>
        <field name="model">nhs.complaint.subject</field>
        <field name="arch" type="xml">
            <form string="KO41a Complaint Subject">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="ko41a_code"/>
                        <field name="provider_types"/>
                        <field name="active"/>
                    </group>
                    <group string="Sub-subjects" invisible="parent_id">
                        <field name="child_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="ko41a_code"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nhs_complaint_subject" model="ir.actions.act_window">
        <field name="name">KO41a Subjects</field>
        <field name="res_model">nhs.complaint.subject</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id','=',False)]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ── Timescale Presets Config ────────────────────────────── -->
    <record id="view_nhs_complaint_timescale_list" model="ir.ui.view">
        <field name="name">nhs.complaint.timescale.list</field>
        <field name="model">nhs.complaint.timescale</field>
        <field name="arch" type="xml">
            <list string="Response Timescale Presets" editable="top">
                <field name="name"/>
                <field name="working_days"/>
                <field name="complexity"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_complaint_timescale" model="ir.actions.act_window">
        <field name="name">Response Timescale Presets</field>
        <field name="res_model">nhs.complaint.timescale</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Settings extension ──────────────────────────────────── -->
    <record id="view_res_config_settings_complaint_form" model="ir.ui.view">
        <field name="name">res.config.settings.complaint.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" string="NHS Complaints &amp; PALS" data-string="Complaints">
                    <h2>NHS Complaints &amp; PALS Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="complaint_public_form_enabled" widget="boolean_toggle"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="complaint_public_form_enabled"/>
                                <div class="text-muted">Allow patients and relatives to submit complaints via the public web form.</div>
                                <div class="content-group" invisible="not complaint_public_form_enabled">
                                    <div class="mt8">
                                        <label for="complaint_public_form_token" class="o_light_label"/>
                                        <field name="complaint_public_form_token"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="complaint_default_timescale_id"/>
                                <field name="complaint_default_timescale_id"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="complaint_anonymise_after_years"/>
                                <field name="complaint_anonymise_after_years"/>
                                <div class="text-muted">Set 0 to disable automatic anonymisation.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
