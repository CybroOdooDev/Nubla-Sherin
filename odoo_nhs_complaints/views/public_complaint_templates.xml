<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="public_complaint_form" name="NHS Public Complaint Submission Form">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Submit a Complaint or PALS Concern</title>
                <t t-call-assets="web.assets_frontend"/>
                <link rel="stylesheet" href="/odoo_nhs_complaints/static/src/css/public_complaint.css"/>
            </t>
            <div class="nhs-complaint-form-wrapper">
                <div class="nhs-complaint-form">
                    <div class="card">
                        <div class="card-header">
                            <h2>Submit a Complaint or PALS Concern</h2>
                            <p class="mb-0"><t t-esc="organisation_name"/></p>
                        </div>
                        <div class="card-body">
                            <t t-if="error">
                                <div class="alert alert-danger mb-4"><t t-esc="error"/></div>
                            </t>
                            <form method="POST" t-att-action="'/complaint/submit/' + token" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="honeypot_check" value=""/>

                                <div class="mb-4">
                                    <label class="form-label">Type of submission</label>
                                    <div class="submission-type-option d-flex align-items-center">
                                        <input type="radio" name="record_type" value="pals" id="type_pals" class="form-check-input m-0" checked="checked"/>
                                        <label for="type_pals" class="form-check-label ms-3 flex-grow-1">PALS Concern (informal — quick resolution)</label>
                                    </div>
                                    <div class="submission-type-option d-flex align-items-center">
                                        <input type="radio" name="record_type" value="complaint" id="type_complaint" class="form-check-input m-0"/>
                                        <label for="type_complaint" class="form-check-label ms-3 flex-grow-1">Formal Complaint (statutory process)</label>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label for="subject_summary" class="form-label">Brief summary <span class="text-danger">*</span></label>
                                    <input type="text" name="subject_summary" id="subject_summary" class="form-control" required="required" maxlength="200" placeholder="One-line summary of your concern…"/>
                                </div>

                                <div class="mb-4">
                                    <label for="description" class="form-label">Full description <span class="text-danger">*</span></label>
                                    <textarea name="description" id="description" class="form-control" rows="6" required="required" placeholder="Please describe your complaint or concern in detail. Use initials rather than full patient names where possible."/>
                                </div>

                                <div class="mb-4">
                                    <label for="event_date" class="form-label">When did this happen?</label>
                                    <input type="date" name="event_date" id="event_date" class="form-control"/>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Are you the patient, or acting on someone's behalf?</label>
                                    <div class="patient-relation-option d-flex align-items-center">
                                        <input type="radio" name="is_third_party" value="0" id="is_patient" class="form-check-input m-0" checked="checked"/>
                                        <label for="is_patient" class="form-check-label ms-3 flex-grow-1">I am the patient</label>
                                    </div>
                                    <div class="patient-relation-option d-flex align-items-center">
                                        <input type="radio" name="is_third_party" value="1" id="is_third_party" class="form-check-input m-0"/>
                                        <label for="is_third_party" class="form-check-label ms-3 flex-grow-1">I am acting on behalf of a patient</label>
                                    </div>
                                </div>

                                <hr/>
                                <h5>Your Contact Details</h5>
                                <div class="mb-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="is_anonymous" id="is_anonymous" class="form-check-input"/>
                                        <label for="is_anonymous" class="form-check-label">I wish to remain anonymous (PALS concerns only)</label>
                                    </div>
                                </div>

                                <div id="contact_fields">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="complainant_name" class="form-label">Your name</label>
                                            <input type="text" name="complainant_name" id="complainant_name" class="form-control" placeholder="Full name"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="complainant_email" class="form-label">Email address</label>
                                            <input type="email" name="complainant_email" id="complainant_email" class="form-control" placeholder="name@example.com"/>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label for="complainant_phone" class="form-label">Phone number</label>
                                        <input type="tel" name="complainant_phone" id="complainant_phone" class="form-control" placeholder="e.g. 07123 456789"/>
                                    </div>
                                </div>

                                <div class="btn-submit-container">
                                    <button type="submit" class="btn btn-primary btn-submit">Submit</button>
                                </div>
                                <p class="text-muted small mt-4 text-center">
                                    Your information will be handled in accordance with our privacy policy and the NHS Complaints Regulations 2009.
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="public_complaint_confirm" name="NHS Public Complaint Confirmation">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Complaint Submitted</title>
                <t t-call-assets="web.assets_frontend"/>
                <link rel="stylesheet" href="/odoo_nhs_complaints/static/src/css/public_complaint.css"/>
            </t>
            <div class="nhs-confirm-container">
                <div class="nhs-confirm-card">
                    <div class="nhs-confirm-icon">
                        <i class="oi oi-check-circle-item fa-4x text-success"></i>
                    </div>
                    <h2>Thank you</h2>
                    <p>Your submission has been received. Your reference number is:</p>
                    <div class="nhs-confirm-ref-box">
                        <h3><t t-esc="reference"/></h3>
                    </div>
                    <p class="mt-4">We will acknowledge your complaint within 3 working days and contact you to agree a response timescale.</p>
                    <p class="text-muted small mt-4">If you have any questions, please contact our Complaints Team directly.</p>
                </div>
            </div>
        </t>
    </template>
</odoo>
