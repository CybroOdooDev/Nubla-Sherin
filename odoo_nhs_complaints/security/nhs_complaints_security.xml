<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ══════════════════════════════════════════════════════════════
             Module Category
        ══════════════════════════════════════════════════════════════════ -->
        <record id="module_category_nhs_complaints" model="ir.module.category">
            <field name="name">NHS Complaints &amp; PALS</field>
            <field name="description">NHS Complaints and PALS Management access levels.</field>
            <field name="sequence">51</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Privilege (Odoo 19 — replaces category_id on res.groups)
        ══════════════════════════════════════════════════════════════════ -->
        <record id="privilege_complaints_access_level" model="res.groups.privilege">
            <field name="name">Complaints &amp; PALS Access Level</field>
            <field name="category_id" ref="module_category_nhs_complaints"/>
            <field name="sequence">10</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Groups
        ══════════════════════════════════════════════════════════════════ -->
        <record id="group_nhs_complaint_handler" model="res.groups">
            <field name="name">Complaint Handler</field>
            <field name="privilege_id" ref="privilege_complaints_access_level"/>
        </record>

        <record id="group_nhs_complaint_manager" model="res.groups">
            <field name="name">Complaint Manager</field>
            <field name="privilege_id" ref="privilege_complaints_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_complaint_handler'))]"/>
        </record>

        <record id="group_nhs_complaint_quality_lead" model="res.groups">
            <field name="name">Complaint Quality Lead</field>
            <field name="privilege_id" ref="privilege_complaints_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_complaint_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Record Rules — Company scoping
        ══════════════════════════════════════════════════════════════════ -->
        <record id="rule_complaint_company" model="ir.rule">
            <field name="name">nhs.complaint: company scope</field>
            <field name="model_id" ref="model_nhs_complaint"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_complaint_handler'))]"/>
        </record>

        <record id="rule_complaint_phso_company" model="ir.rule">
            <field name="name">nhs.complaint.phso: company scope</field>
            <field name="model_id" ref="model_nhs_complaint_phso"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_complaint_handler'))]"/>
        </record>

        <record id="rule_complaint_investigation_company" model="ir.rule">
            <field name="name">nhs.complaint.investigation: company scope</field>
            <field name="model_id" ref="model_nhs_complaint_investigation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_complaint_handler'))]"/>
        </record>

        <!-- Handler: location scoping (own cases or all unscoped) -->
        <record id="rule_complaint_handler_location" model="ir.rule">
            <field name="name">nhs.complaint: handler location scope</field>
            <field name="model_id" ref="model_nhs_complaint"/>
            <field name="domain_force">['|', ('location_id', '=', False), ('handler_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_complaint_handler'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- No-delete is enforced via unlink() overrides in Python models
             and by perm_unlink=0 in ir.model.access.csv for handler/manager groups. -->
    </data>
</odoo>
