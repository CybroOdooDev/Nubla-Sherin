<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit.vct.expense.form.updates</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='product_id']" position="before">
                <field name="date" attrs="{'readonly': [('sheet_is_editable', '=', False)]}"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/group/group/div[1]" position="after">
                <label for="name"/>
                <div>
                <field name="name" placeholder="e.g. Lunch with Customer"
                       attrs="{'readonly': [('sheet_is_editable', '=', False)]}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
