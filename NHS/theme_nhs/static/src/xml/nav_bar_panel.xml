<templates id="template" xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension" owl="1">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="attributes">
            <attribute name="class" add="navbar navbar-expand-lg" separator=" "/>
        </xpath>
        <xpath expr="//DropdownItem[@class=&quot;'o_menu_brand d-flex'&quot;]" position="attributes">
            <attribute name="class">'o_menu_brand d-flex fs-4 fw-bolder px-3'</attribute>
        </xpath>
    </t>
</templates>