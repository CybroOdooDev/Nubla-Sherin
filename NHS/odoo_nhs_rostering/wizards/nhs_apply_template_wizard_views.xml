<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_apply_template_wizard_form" model="ir.ui.view">
        <field name="name">nhs.apply.template.wizard.form</field>
        <field name="model">nhs.apply.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Rotation Template">
                <field name="period_id" invisible="1"/>
                <field name="unit_id" invisible="1"/>
                <field name="team_member_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="rotation_template_id"/>
                        <field name="start_week"/>
                        <field name="skip_bank_holidays"/>
                    </group>
                    <group>
                        <field name="member_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
