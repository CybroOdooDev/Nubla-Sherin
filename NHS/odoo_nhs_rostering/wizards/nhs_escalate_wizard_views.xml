<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_escalate_wizard_form for ir.ui.view -->
    <record id="view_nhs_escalate_wizard_form" model="ir.ui.view">
        <field name="name">nhs.escalate.wizard.form</field>
        <field name="model">nhs.escalate.wizard</field>
        <field name="arch" type="xml">
            <form string="Escalate Unfilled Duties">
                <field name="bank_installed" invisible="1"/>
                <group>
                    <field name="duty_ids" widget="many2many_tags"/>
                    <field name="urgency"/>
                    <field name="push_to_bank" invisible="not bank_installed"/>
                    <div class="alert alert-info" role="alert" invisible="bank_installed">
                        The Staff Bank module isn't installed - these duties will be tracked as
                        needing manual cover.
                    </div>
                </group>
                <footer>
                    <button name="action_escalate" type="object" string="Escalate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
