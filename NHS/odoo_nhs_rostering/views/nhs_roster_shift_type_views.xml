<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_roster_shift_type_list" model="ir.ui.view">
        <field name="name">nhs.roster.shift.type.list</field>
        <field name="model">nhs.roster.shift.type</field>
        <field name="arch" type="xml">
            <list string="Shift Types">
                <field name="roster_unit_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="break_minutes"/>
                <field name="duration_hours"/>
                <field name="is_night"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_roster_shift_type_form" model="ir.ui.view">
        <field name="name">nhs.roster.shift.type.form</field>
        <field name="model">nhs.roster.shift.type</field>
        <field name="arch" type="xml">
            <form string="Shift Type">
                <sheet>
                    <group>
                        <group>
                            <field name="roster_unit_id"/>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="break_minutes"/>
                            <field name="duration_hours" readonly="1"/>
                            <field name="is_night" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nhs_roster_shift_type" model="ir.actions.act_window">
        <field name="name">Shift Types</field>
        <field name="res_model">nhs.roster.shift.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
