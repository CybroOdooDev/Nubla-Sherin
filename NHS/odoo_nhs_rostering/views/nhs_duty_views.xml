<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_duty_list for ir.ui.view -->
    <record id="view_nhs_duty_list" model="ir.ui.view">
        <field name="name">nhs.duty.list</field>
        <field name="model">nhs.duty</field>
        <field name="arch" type="xml">
            <list string="Duties" decoration-danger="state == 'unfilled'"
                  decoration-warning="state == 'partially_filled'"
                  decoration-success="state in ('filled', 'covered_bank', 'covered_agency')"
                  decoration-muted="state == 'cancelled'">
                <field name="unit_id"/>
                <field name="period_id"/>
                <field name="duty_date"/>
                <field name="shift_type_id"/>
                <field name="staff_group_id"/>
                <field name="required_band_id"/>
                <field name="required_headcount"/>
                <field name="assigned_count"/>
                <field name="state" widget="badge"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Record: view_nhs_duty_form for ir.ui.view -->
    <record id="view_nhs_duty_form" model="ir.ui.view">
        <field name="name">nhs.duty.form</field>
        <field name="model">nhs.duty</field>
        <field name="arch" type="xml">
            <form string="Duty">
                <header>
                    <button name="action_cancel" type="object" string="Cancel Duty"
                            invisible="not id or is_cancelled"/>
                    <button name="action_reinstate" type="object" string="Reinstate"
                            invisible="not id or not is_cancelled"/>
                    <button name="action_escalate_to_bank" type="object" string="Escalate to Bank"
                            invisible="not id or is_cancelled or escalation_id or state not in ('unfilled', 'partially_filled')"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,unfilled,partially_filled,filled,escalated"/>
                </header>
                <sheet>
                    <field name="escalation_id" invisible="1"/>
                    <field name="bank_filled_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not is_overstaffed">
                        <strong>Possibly overstaffed:</strong>
                        <field name="assigned_count" readonly="1" class="oe_inline"/> assigned directly on the
                        roster plus <field name="bank_filled_count" readonly="1" class="oe_inline"/> confirmed
                        via the linked bank shift together exceed the
                        <field name="required_headcount" readonly="1" class="oe_inline"/> required. The roster
                        and Staff Bank fill this duty independently and aren't reconciled automatically -
                        check the linked bank shift and stand down the extra cover if it isn't needed.
                    </div>
                    <group>
                        <group>
                            <field name="period_id"/>
                            <field name="unit_id" readonly="1"/>
                            <field name="duty_date"/>
                            <field name="shift_type_id"/>
                        </group>
                        <group>
                            <field name="staff_group_id"/>
                            <field name="required_band_id"/>
                            <field name="required_skill_ids" widget="many2many_tags"/>
                            <field name="required_headcount"/>
                            <field name="assigned_count" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <field name="eligible_member_ids" invisible="1"/>
                    <field name="assignment_ids">
                        <list editable="bottom">
                            <field name="member_id" domain="[('id', 'in', parent.eligible_member_ids)]"/>
                            <field name="state"/>
                            <field name="compliant_at_assignment" readonly="1"/>
                            <field name="paid_hours" readonly="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Record: view_nhs_duty_search for ir.ui.view -->
    <record id="view_nhs_duty_search" model="ir.ui.view">
        <field name="name">nhs.duty.search</field>
        <field name="model">nhs.duty</field>
        <field name="arch" type="xml">
            <search string="Duties">
                <field name="period_id"/>
                <field name="unit_id"/>
                <field name="duty_date"/>
                <filter string="Unfilled" name="filter_unfilled" domain="[('state', '=', 'unfilled')]"/>
                <filter string="Partially Filled" name="filter_partial" domain="[('state', '=', 'partially_filled')]"/>
                <group>
                    <filter string="Unit" name="group_unit" context="{'group_by': 'unit_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'duty_date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Record: action_nhs_duty_gaps for ir.actions.act_window -->
    <record id="action_nhs_duty_gaps" model="ir.actions.act_window">
        <field name="name">Gaps &amp; Escalation</field>
        <field name="res_model">nhs.duty</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('unfilled', 'partially_filled'))]</field>
        <field name="context">{'search_default_group_unit': 1}</field>
    </record>
</odoo>
