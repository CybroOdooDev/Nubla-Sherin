<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_roster_rule_list for ir.ui.view -->
    <record id="view_nhs_roster_rule_list" model="ir.ui.view">
        <field name="name">nhs.roster.rule.list</field>
        <field name="model">nhs.roster.rule</field>
        <field name="arch" type="xml">
            <list string="Roster Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'hard'"
                       decoration-warning="severity == 'soft'"/>
                <field name="limit_value"/>
                <field name="limit_value_2"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Record: view_nhs_roster_rule_form for ir.ui.view -->
    <record id="view_nhs_roster_rule_form" model="ir.ui.view">
        <field name="name">nhs.roster.rule.form</field>
        <field name="model">nhs.roster.rule</field>
        <field name="arch" type="xml">
            <form string="Roster Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="limit_value"/>
                            <field name="limit_value_2"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Record: action_nhs_roster_rule for ir.actions.act_window -->
    <record id="action_nhs_roster_rule" model="ir.actions.act_window">
        <field name="name">Roster Rules</field>
        <field name="res_model">nhs.roster.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
