<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_leave_type_list" model="ir.ui.view">
        <field name="name">nhs.leave.type.list</field>
        <field name="model">nhs.leave.type</field>
        <field name="arch" type="xml">
            <list string="Leave Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_paid"/>
                <field name="counts_as_worked_hours"/>
                <field name="requires_approval"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_leave_type" model="ir.actions.act_window">
        <field name="name">Leave Types</field>
        <field name="res_model">nhs.leave.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
