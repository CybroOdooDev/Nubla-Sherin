<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_swap_request_list for ir.ui.view -->
    <record id="view_nhs_swap_request_list" model="ir.ui.view">
        <field name="name">nhs.swap.request.list</field>
        <field name="model">nhs.swap.request</field>
        <field name="arch" type="xml">
            <list string="Duty Swap Requests" decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="requester_member_id"/>
                <field name="target_member_id"/>
                <field name="requester_assignment_id"/>
                <field name="target_assignment_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Record: view_nhs_swap_request_form for ir.ui.view -->
    <record id="view_nhs_swap_request_form" model="ir.ui.view">
        <field name="name">nhs.swap.request.form</field>
        <field name="model">nhs.swap.request</field>
        <field name="arch" type="xml">
            <form string="Duty Swap Request">
                <header>
                    <button name="action_propose" type="object" string="Propose"
                            class="btn-primary" invisible="state != 'draft' or (not is_requester_user and not is_manager)"/>
                    <button name="action_accept_by_target" type="object" string="Accept (Colleague)"
                            class="btn-primary" invisible="state != 'proposed' or (not is_target_user and not is_manager)"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'accepted_by_target'"
                            groups="odoo_nhs_rostering.group_nhs_roster_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('approved', 'rejected', 'cancelled') or (not is_target_user and not is_manager)"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('approved', 'cancelled') or (not is_requester_user and not is_manager)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,accepted_by_target,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="is_manager" invisible="1"/>
                            <field name="is_requester_user" invisible="1"/>
                            <field name="is_target_user" invisible="1"/>
                            <field name="requester_assignment_id" domain="[('member_id.user_id', '=', uid)]" invisible="is_manager"/>
                            <field name="requester_assignment_id" invisible="not is_manager"/>
                            <field name="requester_member_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="requester_duty_id" invisible="1"/>
                            <field name="unit_id" invisible="1"/>
                            <field name="target_assignment_id" domain="[('member_id', '!=', requester_member_id), ('duty_id', '!=', requester_duty_id), ('unit_id', '=', unit_id)]"/>
                            <field name="target_member_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rule Check" invisible="not rule_check_note">
                        <field name="rule_check_passed" readonly="1"/>
                        <field name="rule_check_note" readonly="1"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Record: action_nhs_swap_request for ir.actions.act_window -->
    <record id="action_nhs_swap_request" model="ir.actions.act_window">
        <field name="name">Duty Swap Requests</field>
        <field name="res_model">nhs.swap.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
