<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_roster_preference_list" model="ir.ui.view">
        <field name="name">nhs.roster.preference.list</field>
        <field name="model">nhs.roster.preference</field>
        <field name="arch" type="xml">
            <list string="Roster Preferences" editable="bottom">
                <field name="member_id"/>
                <field name="unit_id"/>
                <field name="period_id"/>
                <field name="date"/>
                <field name="shift_type_id"/>
                <field name="preference_type" widget="badge"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_roster_preference" model="ir.actions.act_window">
        <field name="name">Roster Preferences</field>
        <field name="res_model">nhs.roster.preference</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
