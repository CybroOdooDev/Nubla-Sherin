<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_leave_entitlement_list for ir.ui.view -->
    <record id="view_nhs_leave_entitlement_list" model="ir.ui.view">
        <field name="name">nhs.leave.entitlement.list</field>
        <field name="model">nhs.leave.entitlement</field>
        <field name="arch" type="xml">
            <list string="Leave Entitlements">
                <field name="member_id"/>
                <field name="leave_type_id"/>
                <field name="leave_year"/>
                <field name="entitlement_hours"/>
                <field name="taken_hours"/>
                <field name="remaining_hours"/>
            </list>
        </field>
    </record>

    <!-- Record: view_nhs_leave_entitlement_form for ir.ui.view -->
    <record id="view_nhs_leave_entitlement_form" model="ir.ui.view">
        <field name="name">nhs.leave.entitlement.form</field>
        <field name="model">nhs.leave.entitlement</field>
        <field name="arch" type="xml">
            <form string="Leave Entitlement">
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="leave_type_id"/>
                            <field name="leave_year"/>
                        </group>
                        <group>
                            <field name="entitlement_hours"/>
                            <field name="taken_hours" readonly="1"/>
                            <field name="remaining_hours" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Record: action_nhs_leave_entitlement for ir.actions.act_window -->
    <record id="action_nhs_leave_entitlement" model="ir.actions.act_window">
        <field name="name">Leave Entitlements</field>
        <field name="res_model">nhs.leave.entitlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
