<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_roster_escalation_list for ir.ui.view -->
    <record id="view_nhs_roster_escalation_list" model="ir.ui.view">
        <field name="name">nhs.roster.escalation.list</field>
        <field name="model">nhs.roster.escalation</field>
        <field name="arch" type="xml">
            <list string="Escalations" decoration-danger="urgency == 'last_minute'"
                  decoration-warning="urgency == 'urgent'">
                <field name="reference"/>
                <field name="duty_id"/>
                <field name="headcount"/>
                <field name="urgency"/>
                <field name="state" widget="badge"/>
                <field name="agency_name"/>
                <field name="agency_cost" sum="Total"/>
                <field name="pushed_at"/>
                <field name="filled_at"/>
            </list>
        </field>
    </record>

    <!-- Record: view_nhs_roster_escalation_form for ir.ui.view -->
    <record id="view_nhs_roster_escalation_form" model="ir.ui.view">
        <field name="name">nhs.roster.escalation.form</field>
        <field name="model">nhs.roster.escalation</field>
        <field name="arch" type="xml">
            <form string="Escalation">
                <header>
                    <button name="action_push_to_bank" type="object" string="Push to Bank"
                            invisible="state != 'needed'" class="btn-primary"/>
                    <button name="action_sync_from_bank" type="object" string="Sync from Bank"
                            invisible="state not in ('pushed_to_bank', 'offered', 'to_agency')"/>
                    <button name="action_mark_manual_cover" type="object" string="Mark Manual Cover"
                            invisible="state in ('bank_filled', 'agency_filled', 'cancelled')"/>
                    <button name="action_send_to_agency" type="object" string="Send to Agency"
                            invisible="state not in ('pushed_to_bank', 'offered')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('bank_filled', 'agency_filled', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="needed,pushed_to_bank,offered,bank_filled,agency_filled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="duty_id"/>
                            <field name="headcount"/>
                            <field name="urgency"/>
                        </group>
                        <group>
                            <field name="bank_shift_reference" readonly="1"/>
                            <field name="bank_filled_count" readonly="1"/>
                            <field name="pushed_at" readonly="1"/>
                            <field name="filled_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Agency" invisible="state not in ('to_agency', 'agency_filled')">
                        <field name="agency_name"/>
                        <field name="agency_cost"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Record: view_nhs_roster_escalation_search for ir.ui.view -->
    <record id="view_nhs_roster_escalation_search" model="ir.ui.view">
        <field name="name">nhs.roster.escalation.search</field>
        <field name="model">nhs.roster.escalation</field>
        <field name="arch" type="xml">
            <search string="Escalations">
                <field name="reference"/>
                <field name="duty_id"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Urgency" name="group_urgency" context="{'group_by': 'urgency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Record: action_nhs_roster_escalation for ir.actions.act_window -->
    <record id="action_nhs_roster_escalation" model="ir.actions.act_window">
        <field name="name">Escalations</field>
        <field name="res_model">nhs.roster.escalation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Record: action_nhs_escalate_wizard for ir.actions.act_window -->
    <record id="action_nhs_escalate_wizard" model="ir.actions.act_window">
        <field name="name">Escalate Unfilled Duties</field>
        <field name="res_model">nhs.escalate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nhs_duty"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
