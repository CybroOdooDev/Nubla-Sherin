<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_rotation_template_list" model="ir.ui.view">
        <field name="name">nhs.rotation.template.list</field>
        <field name="model">nhs.rotation.template</field>
        <field name="arch" type="xml">
            <list string="Rotation Templates">
                <field name="roster_unit_id"/>
                <field name="name"/>
                <field name="weeks"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_rotation_template_form" model="ir.ui.view">
        <field name="name">nhs.rotation.template.form</field>
        <field name="model">nhs.rotation.template</field>
        <field name="arch" type="xml">
            <form string="Rotation Template">
                <sheet>
                    <group>
                        <field name="roster_unit_id"/>
                        <field name="name"/>
                        <field name="weeks"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="week_number"/>
                            <field name="weekday"/>
                            <field name="shift_type_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nhs_rotation_template" model="ir.actions.act_window">
        <field name="name">Rotation Templates</field>
        <field name="res_model">nhs.rotation.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
