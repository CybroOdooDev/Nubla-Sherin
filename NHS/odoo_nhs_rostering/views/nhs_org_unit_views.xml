<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_org_unit_form_rostering for ir.ui.view -->
    <record id="view_nhs_org_unit_form_rostering" model="ir.ui.view">
        <field name="name">nhs.org.unit.form.rostering</field>
        <field name="model">nhs.org.unit</field>
        <field name="inherit_id" ref="odoo_nhs_establishment.view_nhs_org_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_roster_unit" type="object"
                        class="oe_stat_button" icon="fa-calendar">
                    <div class="o_stat_info">
                        <span class="o_stat_text" invisible="not is_rostered">Rostered Unit</span>
                        <span class="o_stat_text" invisible="is_rostered">Set Up Rostering</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
