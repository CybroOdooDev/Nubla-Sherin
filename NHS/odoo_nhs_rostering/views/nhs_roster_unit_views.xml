<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_roster_unit_list" model="ir.ui.view">
        <field name="name">nhs.roster.unit.list</field>
        <field name="model">nhs.roster.unit</field>
        <field name="arch" type="xml">
            <list string="Rostered Units">
                <field name="display_name"/>
                <field name="member_count"/>
                <field name="shift_type_count"/>
                <field name="period_count"/>
                <field name="leave_capacity_pct" widget="percentage"/>
                <field name="escalation_lead_days"/>
                <field name="roster_manager_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_roster_unit_form" model="ir.ui.view">
        <field name="name">nhs.roster.unit.form</field>
        <field name="model">nhs.roster.unit</field>
        <field name="arch" type="xml">
            <form string="Rostered Unit">
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_team" icon="fa-users">
                            <field name="member_count" widget="statinfo" string="Team"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_periods" icon="fa-calendar">
                            <field name="period_count" widget="statinfo" string="Periods"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="org_unit_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="roster_manager_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="leave_capacity_pct"/>
                            <field name="escalation_lead_days"/>
                            <field name="escalation_auto_push"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shift Types">
                            <field name="shift_type_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category"/>
                                    <field name="time_start" widget="float_time"/>
                                    <field name="time_end" widget="float_time"/>
                                    <field name="break_minutes"/>
                                    <field name="duration_hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rotation Templates">
                            <field name="rotation_template_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="weeks"/>
                                    <field name="line_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Demand Templates">
                            <field name="demand_template_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="line_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nhs_roster_unit" model="ir.actions.act_window">
        <field name="name">Rostered Units</field>
        <field name="res_model">nhs.roster.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
