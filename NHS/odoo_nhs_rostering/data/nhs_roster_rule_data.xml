<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Statutory-default rule set. noupdate="1": editable in the UI afterward,
         module upgrades won't reset an organisation's local tuning. Verify
         current statutory values before relying on these seed figures. -->
    <data noupdate="1">
        <!-- Record: roster_rule_wtr_avg_48 for nhs.roster.rule -->
    <record id="roster_rule_wtr_avg_48" model="nhs.roster.rule">
            <field name="code">WTR_AVG_48</field>
            <field name="name">48-Hour Average Week</field>
            <field name="severity">hard</field>
            <field name="sequence">10</field>
            <field name="limit_value">48.0</field>
            <field name="description">Working Time Regulations 1998: average weekly hours (including
linked bank duties, where the Staff Bank module is installed) must stay within the limit over the
reference period (Settings &gt; e-Rostering &gt; WTR Reference Period, statutory default 17 weeks).</field>
        </record>
        <!-- Record: roster_rule_rest_11h for nhs.roster.rule -->
    <record id="roster_rule_rest_11h" model="nhs.roster.rule">
            <field name="code">REST_11H</field>
            <field name="name">11-Hour Daily Rest</field>
            <field name="severity">hard</field>
            <field name="sequence">20</field>
            <field name="limit_value">11.0</field>
            <field name="description">Minimum rest between the end of one duty and the start of the
next.</field>
        </record>
        <!-- Record: roster_rule_weekly_rest for nhs.roster.rule -->
    <record id="roster_rule_weekly_rest" model="nhs.roster.rule">
            <field name="code">WEEKLY_REST</field>
            <field name="name">Weekly Rest</field>
            <field name="severity">hard</field>
            <field name="sequence">30</field>
            <field name="limit_value">24.0</field>
            <field name="description">At least one unbroken rest period of this many hours within any
trailing 7-day window.</field>
        </record>
        <!-- Record: roster_rule_max_consec_days for nhs.roster.rule -->
    <record id="roster_rule_max_consec_days" model="nhs.roster.rule">
            <field name="code">MAX_CONSEC_DAYS</field>
            <field name="name">Maximum Consecutive Working Days</field>
            <field name="severity">hard</field>
            <field name="sequence">40</field>
            <field name="limit_value">7</field>
            <field name="description">Maximum number of consecutive working days (overridable per
member for agreed exceptions).</field>
        </record>
        <!-- Record: roster_rule_max_consec_nights for nhs.roster.rule -->
    <record id="roster_rule_max_consec_nights" model="nhs.roster.rule">
            <field name="code">MAX_CONSEC_NIGHTS</field>
            <field name="name">Maximum Consecutive Nights</field>
            <field name="severity">hard</field>
            <field name="sequence">50</field>
            <field name="limit_value">4</field>
            <field name="description">Maximum number of consecutive night duties (overridable per
member for agreed exceptions).</field>
        </record>
        <!-- Record: roster_rule_contract_hours for nhs.roster.rule -->
    <record id="roster_rule_contract_hours" model="nhs.roster.rule">
            <field name="code">CONTRACT_HOURS</field>
            <field name="name">Contracted Hours Position</field>
            <field name="severity">soft</field>
            <field name="sequence">60</field>
            <field name="limit_value">0.0</field>
            <field name="description">Warns when assigned hours over the roster period diverge from
contracted hours by more than this many hours (over or under) - an informational position, not a
hard block.</field>
        </record>
        <!-- Record: roster_rule_skill_mix for nhs.roster.rule -->
    <record id="roster_rule_skill_mix" model="nhs.roster.rule">
            <field name="code">SKILL_MIX</field>
            <field name="name">Skill Mix</field>
            <field name="severity">hard</field>
            <field name="sequence">70</field>
            <field name="description">The duty's required band and skills must actually be met by the
assigned person, not just the headcount.</field>
        </record>
        <!-- Record: roster_rule_compliance_gate for nhs.roster.rule -->
    <record id="roster_rule_compliance_gate" model="nhs.roster.rule">
            <field name="code">COMPLIANCE_GATE</field>
            <field name="name">Compliance Gate</field>
            <field name="severity">hard</field>
            <field name="sequence">5</field>
            <field name="description">Only members with in-date mandatory training and professional
registration can be assigned (reads odoo_nhs_training) - the same standard the Staff Bank enforces.</field>
        </record>
        <!-- Record: roster_rule_double_book for nhs.roster.rule -->
    <record id="roster_rule_double_book" model="nhs.roster.rule">
            <field name="code">DOUBLE_BOOK</field>
            <field name="name">No Double-Booking</field>
            <field name="severity">hard</field>
            <field name="sequence">80</field>
            <field name="description">No overlapping duties for the same member, across duties, units,
and (where installed) Staff Bank bookings.</field>
        </record>
        <!-- Record: roster_rule_leave_conflict for nhs.roster.rule -->
    <record id="roster_rule_leave_conflict" model="nhs.roster.rule">
            <field name="code">LEAVE_CONFLICT</field>
            <field name="name">Leave Conflict</field>
            <field name="severity">hard</field>
            <field name="sequence">90</field>
            <field name="description">No duty on a date covered by approved leave.</field>
        </record>
    </data>
</odoo>
