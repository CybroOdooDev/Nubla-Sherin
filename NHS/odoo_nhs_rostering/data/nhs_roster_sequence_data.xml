<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_nhs_roster_escalation" model="ir.sequence">
            <field name="name">Roster Escalation Reference</field>
            <field name="code">nhs.roster.escalation</field>
            <field name="prefix">ESC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Reference data: the seven weekdays, used on rotation-template lines,
             demand lines and a member's fixed working-day pattern. -->
        <record id="roster_weekday_mon" model="nhs.roster.weekday">
            <field name="name">Monday</field>
            <field name="index">0</field>
            <field name="sequence">1</field>
        </record>
        <record id="roster_weekday_tue" model="nhs.roster.weekday">
            <field name="name">Tuesday</field>
            <field name="index">1</field>
            <field name="sequence">2</field>
        </record>
        <record id="roster_weekday_wed" model="nhs.roster.weekday">
            <field name="name">Wednesday</field>
            <field name="index">2</field>
            <field name="sequence">3</field>
        </record>
        <record id="roster_weekday_thu" model="nhs.roster.weekday">
            <field name="name">Thursday</field>
            <field name="index">3</field>
            <field name="sequence">4</field>
        </record>
        <record id="roster_weekday_fri" model="nhs.roster.weekday">
            <field name="name">Friday</field>
            <field name="index">4</field>
            <field name="sequence">5</field>
        </record>
        <record id="roster_weekday_sat" model="nhs.roster.weekday">
            <field name="name">Saturday</field>
            <field name="index">5</field>
            <field name="sequence">6</field>
        </record>
        <record id="roster_weekday_sun" model="nhs.roster.weekday">
            <field name="name">Sunday</field>
            <field name="index">6</field>
            <field name="sequence">7</field>
        </record>
    </data>
</odoo>
