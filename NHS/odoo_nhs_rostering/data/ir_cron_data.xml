<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record: ir_cron_roster_auto_escalate for ir.cron -->
    <record id="ir_cron_roster_auto_escalate" model="ir.cron">
            <field name="name">NHS e-Rostering: Auto-Escalate Unfilled Duties</field>
            <field name="model_id" ref="model_nhs_roster_escalation"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_escalate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Record: ir_cron_roster_sync_bank for ir.cron -->
    <record id="ir_cron_roster_sync_bank" model="ir.cron">
            <field name="name">NHS e-Rostering: Sync Escalations from Staff Bank</field>
            <field name="model_id" ref="model_nhs_roster_escalation"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_from_bank()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Record: ir_cron_roster_remind_unpublished for ir.cron -->
    <record id="ir_cron_roster_remind_unpublished" model="ir.cron">
            <field name="name">NHS e-Rostering: Remind Unpublished Rosters</field>
            <field name="model_id" ref="model_nhs_roster_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_unpublished()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
