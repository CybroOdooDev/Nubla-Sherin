<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record: module_category_nhs_rostering for ir.module.category -->
    <record id="module_category_nhs_rostering" model="ir.module.category">
            <field name="name">NHS e-Rostering</field>
            <field name="description">NHS e-Rostering access levels.</field>
            <field name="sequence">56</field>
        </record>

        <!-- Record: privilege_rostering_access_level for res.groups.privilege -->
    <record id="privilege_rostering_access_level" model="res.groups.privilege">
            <field name="name">Rostering Access Level</field>
            <field name="category_id" ref="module_category_nhs_rostering"/>
            <field name="sequence">10</field>
        </record>

        <!-- Record: group_nhs_roster_staff for res.groups -->
    <record id="group_nhs_roster_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="privilege_id" ref="privilege_rostering_access_level"/>
            <field name="implied_ids" eval="[(3, ref('base.group_portal'))]"/>
            <field name="comment">Portal role: a member sees their own published roster, requests
                leave and sees their balance, and proposes/responds to duty swaps. No access to
                other members, other units, or configuration.</field>
        </record>

        <!-- Security group: Roster Manager - build/approve/publish for their own unit(s) -->
        <!-- Record: group_nhs_roster_manager for res.groups -->
    <record id="group_nhs_roster_manager" model="res.groups">
            <field name="name">Roster Manager</field>
            <field name="privilege_id" ref="privilege_rostering_access_level"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Ward/department rota manager: build and publish rosters, manage
                shift types/templates/demand, approve leave and swaps, resolve rule violations
                and escalate gaps - scoped to the unit(s) they manage. Cannot edit the statutory
                rule set or reference data shared across units.</field>
        </record>

        <!-- Security group: Workforce Admin - full control across all units + configuration -->
        <!-- Record: group_nhs_workforce_admin for res.groups -->
    <record id="group_nhs_workforce_admin" model="res.groups">
            <field name="name">Workforce Admin</field>
            <field name="privilege_id" ref="privilege_rostering_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_roster_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full control: every roster unit, the statutory rule set,
                leave types, escalation policy and all other configuration.</field>
        </record>
    </data>

