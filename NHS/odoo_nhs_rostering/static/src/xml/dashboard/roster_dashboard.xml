<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_nhs_rostering.NhsRosterDashboard" owl="1">
        <div class="o_nhs_roster_dashboard o_content p-4" style="height: 100%; overflow-y: auto;">
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                    <div class="spinner-border text-nhs-blue" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom bg-white p-3 rounded-3 shadow-sm">
                    <div>
                        <h3 class="fw-bold mb-0 text-nhs-blue"><i class="fa fa-tachometer me-2"/>e-Rostering Dashboard</h3>
                        <div class="text-muted small">Fill Rate, Gaps &amp; Rules Health</div>
                    </div>
                    <button class="btn btn-outline-nhs-blue btn-sm fw-semibold" t-on-click="loadData">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">Fill Rate</span>
                                <h3 class="fw-bold mb-0 text-nhs-blue"><t t-esc="state.data.fill_rate"/>%</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">Open Gaps</span>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.total_gaps"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card cursor-pointer" t-on-click="openEscalations">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">In-Flight Escalations</span>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.open_escalation_count"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card cursor-pointer"
                             t-on-click="() => this.openViolations('hard')">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">Open Hard Violations</span>
                                <h3 class="fw-bold mb-0 text-danger" t-esc="state.data.open_hard_violation_count"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card cursor-pointer"
                             t-on-click="() => this.openViolations('soft')">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">Open Soft Violations</span>
                                <h3 class="fw-bold mb-0 text-warning" t-esc="state.data.open_soft_violation_count"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 roster-stat-card">
                            <div class="card-body p-3">
                                <span class="text-uppercase small fw-bold text-muted">Avg. Publish Lead Time</span>
                                <h3 class="fw-bold mb-0 text-nhs-blue"><t t-esc="state.data.avg_lead_time"/>d</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card shadow-sm rounded-3 h-100">
                            <div class="card-body">
                                <div class="text-uppercase small fw-bold text-muted">Bank-Filled Duties</div>
                                <h4 class="fw-bold text-nhs-blue" t-esc="state.data.bank_filled_count"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm rounded-3 h-100">
                            <div class="card-body">
                                <div class="text-uppercase small fw-bold text-muted">Agency-Filled Duties / Cost</div>
                                <h4 class="fw-bold text-nhs-blue">
                                    <t t-esc="state.data.agency_filled_count"/> / <t t-esc="Math.round(state.data.agency_cost)"/>
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm rounded-3">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0"><i class="fa fa-calendar text-nhs-blue me-2"/>Recent Periods</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="small"><th>Period</th><th>Fill %</th><th>Gaps</th><th>Hard Violations</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.data.periods.length">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">No periods yet</td></tr>
                                </t>
                                <tr t-foreach="state.data.periods" t-as="p" t-key="p.id" class="cursor-pointer"
                                    t-on-click="() => this.openPeriod(p.id)">
                                    <td class="fw-semibold text-nhs-blue" t-esc="p.name"/>
                                    <td t-esc="p.fill_pct + '%'"/>
                                    <td t-esc="p.gap_count"/>
                                    <td t-esc="p.hard_violation_count"/>
                                    <td><span class="badge text-bg-secondary" t-esc="p.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
