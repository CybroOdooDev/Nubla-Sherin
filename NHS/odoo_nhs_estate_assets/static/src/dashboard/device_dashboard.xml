<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_nhs_estate_assets.NhsDeviceDashboard" owl="1">
        <div class="o_nhs_device_dashboard">
            <div t-if="state.loading" class="o_nhs_dashboard_loading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading NHS Device Dashboard...</span>
                </div>
                <span class="ms-2 fw-bold text-muted">Loading Device Register Analytics...</span>
            </div>
            <div t-else="" class="o_nhs_dashboard_content">
                <div class="o_nhs_dashboard_section mb-4">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openTotalDevices" title="Click to view all devices">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="o_nhs_kpi_icon bg-primary-light text-primary rounded-circle me-2">
                                            <i class="fa fa-cube fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">Total Devices</div>
                                    </div>
                                    <div class="h3 mb-1 fw-bold text-dark" t-out="state.metrics.total_devices"/>
                                    <div class="small text-success text-truncate">
                                        <i class="fa fa-check-circle me-1"></i>
                                        <t t-out="state.metrics.devices_by_status.in_service || 0"/> In Service
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openDueSoonSchedules" title="Click to view schedules due soon">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="o_nhs_kpi_icon bg-warning-light text-warning rounded-circle me-2">
                                            <i class="fa fa-calendar-check-o fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">Due Maintenance</div>
                                    </div>
                                    <div class="h3 mb-1 fw-bold text-warning" t-out="state.metrics.maintenance_planner.due_soon_count"/>
                                    <div class="small text-muted text-truncate">
                                        PPM: <strong t-out="state.metrics.maintenance_planner.due_soon_ppm"/> | Cal: <strong t-out="state.metrics.maintenance_planner.due_soon_calib"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openOverdueSchedules" title="Click to view overdue schedules">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div t-attf-class="o_nhs_kpi_icon rounded-circle me-2 #{state.metrics.overdue_register.total_overdue > 0 ? 'bg-danger-light text-danger' : 'bg-success-light text-success'}">
                                            <i class="fa fa-exclamation-triangle fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">Overdue Maintenance</div>
                                    </div>
                                    <div t-attf-class="h3 mb-1 fw-bold #{state.metrics.overdue_register.total_overdue > 0 ? 'text-danger' : 'text-success'}" t-out="state.metrics.overdue_register.total_overdue"/>
                                    <div class="small text-muted text-truncate">
                                        PPM: <strong t-out="state.metrics.overdue_register.overdue_ppm_count"/> | Cal: <strong t-out="state.metrics.overdue_register.overdue_calib_count"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openSafetyAlerts" title="Click to view open safety alerts">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div t-attf-class="o_nhs_kpi_icon rounded-circle me-2 #{state.metrics.safety_alerts.open_alerts_count > 0 ? 'bg-danger-light text-danger' : 'bg-success-light text-success'}">
                                            <i class="fa fa-shield fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">Open Safety Alerts</div>
                                    </div>
                                    <div class="h3 mb-1 fw-bold text-dark" t-out="state.metrics.safety_alerts.open_alerts_count"/>
                                    <div class="small text-muted text-truncate">
                                        <strong class="text-danger" t-out="state.metrics.safety_alerts.affected_devices_count"/> Affected Devices
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openEndOfLifeDevices" title="Click to view end-of-life devices">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="o_nhs_kpi_icon bg-secondary-light text-secondary rounded-circle me-2">
                                            <i class="fa fa-recycle fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">End-of-Life Devices</div>
                                    </div>
                                    <div class="h3 mb-1 fw-bold text-dark" t-out="state.metrics.replacement_forecast.end_of_life_count"/>
                                    <div class="small text-muted text-truncate">
                                        Est. Cost: <strong t-out="formatCurrency(state.metrics.replacement_forecast.total_forecast_cost)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-xl-2">
                            <div class="o_nhs_kpi_card card h-100 shadow-sm border-0 cursor-pointer" t-on-click="openIndicativeRegisterValue" title="Click to view register valuation">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="o_nhs_kpi_icon bg-info-light text-info rounded-circle me-2">
                                            <i class="fa fa-gbp fa-lg"></i>
                                        </div>
                                        <div class="text-uppercase text-muted fw-bold extra-small text-truncate">Indicative Value</div>
                                    </div>
                                    <div class="h4 mb-1 fw-bold text-primary text-truncate" t-out="formatCurrency(state.metrics.register_value.total_indicative_value)"/>
                                    <div class="small text-muted text-truncate">
                                        Cost: <t t-out="formatCurrency(state.metrics.register_value.total_acquisition_cost)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_nhs_dashboard_section mb-4">
                    <div class="o_nhs_section_header border-primary-accent">
                        <div>
                            <h5 class="o_nhs_section_title">
                                <i class="fa fa-pie-chart me-2 text-primary"></i> Equipment Breakdown &amp; Location Analytics
                            </h5>
                            <small class="text-muted">Categorical distribution, operational status, and site location density</small>
                        </div>
                        <button class="btn btn-outline-primary btn-sm rounded-pill" t-on-click="openTotalDevices">
                            <i class="fa fa-list me-1"></i> Device Register
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-pie-chart text-primary me-2"></i> Devices by Category
                                    </h6>
                                    <button class="btn btn-link btn-xs text-muted" t-on-click="openTotalDevices">View List</button>
                                </div>
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 220px;">
                                        <canvas t-ref="categoryChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-tasks text-success me-2"></i> Operational Status
                                    </h6>
                                    <button class="btn btn-link btn-xs text-muted" t-on-click="openTotalDevices">View List</button>
                                </div>
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 220px;">
                                        <canvas t-ref="statusChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-hospital-o text-info me-2"></i> Top Locations (Sites)
                                    </h6>
                                    <button class="btn btn-link btn-xs text-muted" t-on-click="openTotalDevices">View List</button>
                                </div>
                                <div class="card-body overflow-auto p-3" style="max-height: 240px;">
                                    <t t-if="!state.metrics.devices_by_location or state.metrics.devices_by_location.length == 0">
                                        <div class="text-muted text-center py-4">No location data available</div>
                                    </t>
                                    <t t-else="">
                                        <ul class="list-group list-group-flush">
                                            <t t-foreach="state.metrics.devices_by_location" t-as="loc" t-key="loc.name">
                                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom-dashed">
                                                    <span class="fw-semibold text-dark text-truncate me-2" t-out="loc.name"/>
                                                    <span class="badge bg-secondary rounded-pill" t-out="loc.count + ' devices'"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_nhs_dashboard_section mb-4">
                    <div class="o_nhs_section_header border-warning-accent">
                        <div>
                            <h5 class="o_nhs_section_title">
                                <i class="fa fa-calendar me-2 text-warning"></i> Maintenance &amp; Calibration Planner
                            </h5>
                            <small class="text-muted">Schedule due vs overdue analysis and 6-month PPM / calibration timeline forecast</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-warning btn-sm rounded-pill" t-on-click="openDueSoonSchedules">
                                <i class="fa fa-clock-o me-1"></i> Due Soon (<t t-out="state.metrics.maintenance_planner.due_soon_count"/>)
                            </button>
                            <button class="btn btn-outline-primary btn-sm rounded-pill" t-on-click="() => this.openAction('nhs.device.schedule', 'list,pivot,graph,form', [], 'All Maintenance Schedules')">
                                <i class="fa fa-list me-1"></i> All Schedules
                            </button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-bar-chart text-warning me-2"></i> Maintenance Due vs Overdue
                                    </h6>
                                    <button class="btn btn-link btn-xs text-muted" t-on-click="() => this.openAction('nhs.device.schedule', 'list,pivot,graph,form', [], 'Maintenance Schedules')">Pivot / Graph</button>
                                </div>
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 240px;">
                                        <canvas t-ref="dueVsOverdueChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center">
                                    <div>
                                        <h6 class="card-title fw-bold mb-0 text-dark">
                                            <i class="fa fa-calendar-check-o text-primary me-2"></i>
                                            Maintenance &amp; Calibration Planner (Next 6 Months)
                                        </h6>
                                        <small class="text-muted">Forecasted PPM, calibration, and safety test schedules</small>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 240px;">
                                        <canvas t-ref="plannerChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_nhs_dashboard_section mb-4">
                    <div class="o_nhs_section_header border-danger-accent">
                        <div>
                            <h5 class="o_nhs_section_title">
                                <i class="fa fa-shield me-2 text-danger"></i> MHRA Safety Alerts Exposure &amp; Action Tracking
                            </h5>
                            <small class="text-muted">Open alerts breakdown by source and active notice exposure across devices</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill" t-on-click="() => this.openAction('nhs.device.alert', 'list,pivot,graph,form', [['state', 'in', ['open', 'in_progress']]], 'Safety Alerts Pivot / Graph')">
                                <i class="fa fa-table me-1"></i> Pivot / Graph View
                            </button>
                            <button class="btn btn-outline-warning btn-sm rounded-pill" t-on-click="openAffectedDevices">
                                Affected Devices (<t t-out="state.metrics.safety_alerts.affected_devices_count"/>)
                            </button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-5">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-shield text-warning me-2"></i> Safety Alerts Exposure by Source
                                    </h6>
                                    <button class="btn btn-link btn-xs text-muted" t-on-click="openSafetyAlerts">View Alerts</button>
                                </div>
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 230px;">
                                        <canvas t-ref="alertSourceChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-7">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="card-title fw-bold mb-0 text-dark">
                                        <i class="fa fa-bullhorn text-danger me-2"></i> Active MHRA / CAS Safety Alerts
                                    </h6>
                                </div>
                                <div class="card-body p-0 overflow-auto" style="max-height: 260px;">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light text-muted small text-uppercase">
                                                <tr>
                                                    <th class="ps-3">Reference</th>
                                                    <th>Alert Title</th>
                                                    <th>Source</th>
                                                    <th>Pending Devices</th>
                                                    <th>Deadline</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="!state.metrics.safety_alerts.top_alerts or state.metrics.safety_alerts.top_alerts.length == 0">
                                                    <tr>
                                                        <td colspan="5" class="text-center py-4 text-success fw-bold">
                                                            <i class="fa fa-check-circle me-1"></i> No open safety alerts.
                                                        </td>
                                                    </tr>
                                                </t>
                                                <t t-else="">
                                                    <t t-foreach="state.metrics.safety_alerts.top_alerts" t-as="alert" t-key="alert.id">
                                                        <tr class="cursor-pointer" t-on-click="() => this.openRecord('nhs.device.alert', alert.id)">
                                                            <td class="ps-3 fw-bold text-primary" t-out="alert.reference"/>
                                                            <td class="small fw-semibold text-dark text-truncate me-2" style="max-width: 220px;" t-out="alert.title"/>
                                                            <td>
                                                                <span class="badge bg-secondary" t-out="alert.source"/>
                                                            </td>
                                                            <td>
                                                                <span t-attf-class="badge #{alert.pending_count > 0 ? 'bg-danger' : 'bg-success'}" t-out="alert.pending_count + ' / ' + alert.affected_count"/>
                                                            </td>
                                                            <td t-attf-class="small #{alert.is_overdue ? 'text-danger fw-bold' : 'text-muted'}" t-out="alert.deadline"/>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_nhs_dashboard_section mb-4">
                    <div class="o_nhs_section_header border-success-accent">
                        <div>
                            <h5 class="o_nhs_section_title">
                                <i class="fa fa-gbp me-2 text-success"></i> Indicative Register Valuation
                            </h5>
                            <small class="text-muted">Straight-line depreciation valuation broken down by equipment category</small>
                        </div>
                        <span class="badge bg-primary-light text-primary fs-6">
                            Total: <t t-out="formatCurrency(state.metrics.register_value.total_indicative_value)"/>
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <div class="o_nhs_chart_container" style="height: 250px;">
                                        <canvas t-ref="valueCategoryChart"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
