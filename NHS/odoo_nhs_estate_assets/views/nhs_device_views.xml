<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KANBAN VIEW - Device Register  -->
    <record id="view_nhs_device_kanban" model="ir.ui.view">
        <field name="name">nhs.device.kanban</field>
        <field name="model">nhs.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="maintenance_status">
                <field name="display_name"/>
                <field name="asset_tag"/>
                <field name="category_id"/>
                <field name="status"/>
                <field name="maintenance_status"/>
                <field name="next_due_date"/>
                <field name="open_alert_count"/>
                <field name="image"/>
                <field name="is_end_of_life"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </strong>
                                <div>
                                    <field name="asset_tag"/>
                                </div>
                                <div>
                                    <field name="category_id"/>
                                </div>
                                <div>
                                    <span>Maintenance Status :
                                        <field name="maintenance_status" widget="badge"
                                               decoration-success="maintenance_status=='ok'"
                                               decoration-warning="maintenance_status=='due_soon'"
                                               decoration-danger="maintenance_status=='overdue'"/>
                                    </span>
                                </div>
                                <div>
                                    <t t-if="record.next_due_date.raw_value">
                                        Next Due:
                                        <field name="next_due_date"/>
                                    </t>
                                    <t t-if="record.open_alert_count.raw_value > 0">
                                        <span class="text-danger">Open Alerts:
                                            <field name="open_alert_count"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST VIEW - Device Register -->
    <record id="view_nhs_device_list" model="ir.ui.view">
        <field name="name">nhs.device.list</field>
        <field name="model">nhs.device</field>
        <field name="arch" type="xml">
            <list string="Device Register" multi_edit="1"
                  decoration-success="maintenance_status=='ok'"
                  decoration-warning="maintenance_status=='due_soon'"
                  decoration-danger="maintenance_status=='overdue'"
                  decoration-info="status=='out_of_service'"
                  decoration-muted="status in ['decommissioned','disposed']">
                <field name="asset_tag"/>
                <field name="barcode" optional="show"/>
                <field name="display_name"/>
                <field name="category_id"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="site_id"/>
                <field name="building_id"/>
                <field name="status"/>
                <field name="next_due_date"/>
                <field name="maintenance_status" invisible="1"/>
                <field name="open_alert_count" sum="Open Alerts"/>
                <field name="is_end_of_life"/>
                <field name="indicative_value"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW - Device Register -->
    <record id="view_nhs_device_search" model="ir.ui.view">
        <field name="name">nhs.device.search</field>
        <field name="model">nhs.device</field>
        <field name="arch" type="xml">
            <search string="Search Devices">
                <field name="display_name"/>
                <field name="asset_tag"/>
                <field name="barcode"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="category_id"/>
                <field name="site_id"/>
                <field name="building_id"/>
                <filter name="my_devices" string="My Devices" domain="[('responsible_user_id','=',uid)]"/>
                <filter name="medical" string="Medical Devices" domain="[('is_medical_device','=',True)]"/>
                <filter name="end_of_life" string="End of Life" domain="[('is_end_of_life','=',True)]"/>
                <filter name="overdue" string="Overdue" domain="[('maintenance_status','=','overdue')]"/>
                <filter name="due_soon" string="Due Soon" domain="[('maintenance_status','=','due_soon')]"/>
                <filter name="alerts" string="Has Alerts" domain="[('open_alert_count','>',0)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                <filter name="group_location" string="Location" context="{'group_by':'site_id'}"/>
                <filter name="group_status" string="Status" context="{'group_by':'status'}"/>
                <filter name="group_condition" string="Condition" context="{'group_by':'condition'}"/>
            </search>
        </field>
    </record>

    <!-- FORM VIEW - Device -->
    <record id="view_nhs_device_form" model="ir.ui.view">
        <field name="name">nhs.device.form</field>
        <field name="model">nhs.device</field>
        <field name="arch" type="xml">
            <form string="Device">
                <header>
                    <button name="action_log_service" string="Log Service" type="object" class="btn-primary"
                            invisible="status in ['disposed']"/>
                    <button name="action_decommission" string="Decommission" type="object" class="btn-secondary"
                            invisible="status in ['decommissioned','disposed']"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="OK"
                            bg_color="text-bg-success"
                            invisible="maintenance_status != 'ok'">
                        <i class="fa fa-star"/>
                    </widget>
                    <widget name="web_ribbon"
                            title="DUE SOON"
                            bg_color="text-bg-warning"
                            invisible="maintenance_status != 'due_soon'">
                        <i class="fa fa-exclamation-triangle"/>
                    </widget>
                    <widget name="web_ribbon"
                            title="OVERDUE"
                            bg_color="text-bg-danger"
                            invisible="maintenance_status != 'overdue'">
                        <i class="fa fa-exclamation-triangle"/>
                    </widget>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Device Name..."/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_schedules" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                help="Maintenance Schedules">
                            <div class="o_stat_info">
                                <field name="schedule_ids" widget="statinfo" string="Schedules"/>
                            </div>
                        </button>
                        <button name="action_view_services" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                help="Service History">
                            <div class="o_stat_info">
                                <field name="service_ids" widget="statinfo" string="Services"/>
                            </div>
                        </button>
                        <button name="action_view_alerts" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                help="Safety Alerts">
                            <div class="o_stat_info">
                                <field name="open_alert_count" widget="statinfo" string="Open Alerts"/>
                            </div>
                        </button>
                        <button name="action_view_warranties" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                help="Warranties &amp; Contracts">
                            <div class="o_stat_info">
                                <field name="warranty_ids" widget="statinfo" string="Warranties"/>
                            </div>
                        </button>
                        <button name="action_view_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <span class="o_stat_text">Maintenance</span>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group string="Identification">
                            <field name="barcode"/>
                            <field name="category_id"/>
                            <field name="is_medical_device"/>
                            <field name="create_maintenance_equipment"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="device_class"/>
                            <field name="marking"/>
                        </group>
                        <group string="Location &amp; Ownership">
                            <field name="site_id"/>
                            <field name="building_id" domain="[('site_id','=',site_id)]"/>
                            <field name="space_id" domain="[('building_id','=',building_id)]"/>
                            <field name="department"/>
                            <field name="cost_centre"/>
                            <field name="responsible_user_id"/>
                            <field name="condition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lifecycle &amp; Asset">
                            <group string="Acquisition">
                                <group>
                                    <field name="acquisition_date"/>
                                    <field name="in_service_date"/>
                                    <field name="acquisition_cost"/>
                                    <field name="funding_source"/>
                                </group>
                                <group>
                                    <field name="expected_life_years"/>
                                    <field name="expected_replacement_date"/>
                                    <field name="replacement_year"/>
                                    <field name="estimated_replacement_cost"/>
                                    <field name="is_end_of_life"/>
                                    <field name="indicative_value" decoration-warning="indicative_value > 0"/>
                                </group>
                            </group>
                            <group string="Disposal">
                                <group>
                                    <field name="decommission_date"/>
                                    <field name="disposal_method"/>
                                </group>
                                <group>
                                    <field name="disposal_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="Schedules" invisible="id == 0">
                            <field name="schedule_ids" readonly="status in ['disposed']">
                                <list string="Maintenance Schedules">
                                    <field name="schedule_type_id"/>
                                    <field name="interval_months"/>
                                    <field name="last_done_date"/>
                                    <field name="next_due_date" decoration-danger="status=='overdue'"
                                           decoration-warning="status=='due_soon'"/>
                                    <field name="status" widget="badge"
                                           decoration-danger="status=='overdue'"
                                           decoration-warning="status=='due_soon'"
                                           decoration-success="status=='ok'"/>
                                    <field name="delivery"/>
                                </list>
                            </field>
                        </page>
                        <page string="Service History" invisible="id == 0">
                            <field name="service_ids" readonly="status in ['disposed']">
                                <list string="Service History">
                                    <field name="name"/>
                                    <field name="service_date"/>
                                    <field name="service_type"/>
                                    <field name="outcome" widget="badge"
                                           decoration-success="outcome in ['pass','pass_with_note']"
                                           decoration-danger="outcome in ['fail','removed_from_use']"/>
                                    <field name="performed_by_id"/>
                                    <field name="contractor"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safety Alerts" invisible="id == 0">
                            <field name="alert_line_ids" readonly="status in ['disposed']">
                                <list string="Safety Alerts">
                                    <field name="alert_id"/>
                                    <field name="action_required"/>
                                    <field name="action_status" widget="badge"
                                           decoration-danger="action_status in ['pending']"
                                           decoration-warning="action_status in ['quarantined']"
                                           decoration-success="action_status in ['actioned','not_affected']"/>
                                    <field name="actioned_date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Warranties &amp; Contracts" invisible="id == 0">
                            <field name="warranty_ids" readonly="status in ['disposed']">
                                <list string="Warranties &amp; Contracts">
                                    <field name="cover_type"/>
                                    <field name="provider"/>
                                    <field name="reference"/>
                                    <field name="start_date"/>
                                    <field name="expiry_date" decoration-danger="is_expiring==1"/>
                                    <field name="is_expiring"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ACTION - Device Register -->
    <record id="action_nhs_device" model="ir.actions.act_window">
        <field name="name">Device Register</field>
        <field name="res_model">nhs.device</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_device_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your medical devices and equipment here.
                Each device can have maintenance schedules, service history,
                safety alerts, and warranty tracking.
            </p>
        </field>
    </record>

    <!-- ACTIONS - Due Soon -->
    <record id="action_nhs_device_due_soon" model="ir.actions.act_window">
        <field name="name">Due Soon</field>
        <field name="res_model">nhs.device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('maintenance_status','=','due_soon')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Devices with maintenance/calibration approaching their due date.
                These should be scheduled for service soon.
            </p>
        </field>
    </record>

    <!-- ACTIONS -  Overdue -->
    <record id="action_nhs_device_overdue" model="ir.actions.act_window">
        <field name="name">Overdue</field>
        <field name="res_model">nhs.device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('maintenance_status','=','overdue')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Devices with maintenance/calibration past their due date.
                These require immediate attention.
            </p>
        </field>
    </record>

    <!-- ACTIONS - End of Life -->
    <record id="action_nhs_device_end_of_life" model="ir.actions.act_window">
        <field name="name">End of Life</field>
        <field name="res_model">nhs.device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_end_of_life','=',True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Devices that have reached or passed their expected life.
                These should be considered for replacement.
            </p>
        </field>
    </record>

    <!-- Export Register Server Action (Selected Records from List Action) -->
    <record id="action_server_export_device_excel" model="ir.actions.server">
        <field name="name">Export Register (Excel)</field>
        <field name="model_id" ref="model_nhs_device"/>
        <field name="binding_model_id" ref="model_nhs_device"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_register_excel()</field>
    </record>

    <!-- Export All Devices Server Action (For Reporting Menu) -->
    <record id="action_server_export_all_device_excel" model="ir.actions.server">
        <field name="name">Export Full Device Register (Excel)</field>
        <field name="model_id" ref="model_nhs_device"/>
        <field name="state">code</field>
        <field name="code">action = env['nhs.device'].action_export_all_register_excel()</field>
    </record>
</odoo>