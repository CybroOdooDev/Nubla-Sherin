<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Maintenance Equipment Form -->
    <record id="view_maintenance_equipment_form_nhs" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.nhs.device</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="NHS Device">
                    <field name="nhs_device_id"/>
                    <field name="is_nhs_device" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_nhs_device"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-medkit"
                        invisible="not nhs_device_id">
                    <field name="nhs_device_id"
                           string="NHS Device"
                           widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>