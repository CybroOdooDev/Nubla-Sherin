<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- form VIEW - Device Decommission Wizard -->
    <record id="view_nhs_device_decommission_wizard_form" model="ir.ui.view">
        <field name="name">nhs.device.decommission.wizard.form</field>
        <field name="model">nhs.device.decommission.wizard</field>
        <field name="arch" type="xml">
            <form string="Decommission Device">
                <group>
                    <field name="device_id" readonly="1"/>
                    <field name="status"/>
                    <field name="decommission_date"/>
                    <field name="disposal_method" invisible="status != 'disposed'"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="disposal_value" invisible="status != 'disposed'"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_decommission" string="Decommission Device" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
