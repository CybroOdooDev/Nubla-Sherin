<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- form VIEW - Alert Match Wizard -->
    <record id="view_nhs_alert_match_wizard_form" model="ir.ui.view">
        <field name="name">nhs.alert.match.wizard.form</field>
        <field name="model">nhs.alert.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Match Affected Devices">
                <sheet>
                    <div class="oe_title">
                        <h1>Match Affected Devices</h1>
                        <p class="text-muted">
                            Match devices by make, model, or category.
                            Devices already linked to this alert are excluded.
                        </p>
                    </div>
                    <group>
                        <field name="alert_id" invisible="1"/>
                        <field name="affected_make" placeholder="e.g. Alaris"/>
                        <field name="affected_model" placeholder="e.g. GP"/>
                        <field name="affected_category_id"/>
                        <field name="match_mode"/>
                    </group>
                    <group string="Matched Devices">
                        <field name="matched_device_ids" nolabel="1">
                            <list string="Matched Devices" create="false" delete="false">
                                <field name="asset_tag"/>
                                <field name="display_name"/>
                                <field name="manufacturer"/>
                                <field name="model"/>
                                <field name="category_id"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </group>
                    <footer>
                        <button name="action_apply_and_open"
                                string="Apply &amp; Open"
                                type="object"
                                class="btn-primary"/>
                        <button name="action_apply_matches"
                                string="Apply"
                                type="object"
                                class="btn-secondary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>