<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View - Device Bulk Service Wizard -->
    <record id="view_nhs_device_service_wizard_form" model="ir.ui.view">
        <field name="name">nhs.device.service.wizard.form</field>
        <field name="model">nhs.device.service.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Service Creation">
                <sheet>
                    <div class="oe_title">
                        <h1>Create Service Records in Bulk</h1>
                        <p class="text-muted">
                            Log the same service event for multiple devices at once.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="device_ids" widget="many2many_tags"/>
                            <field name="service_type"/>
                            <field name="service_date"/>
                            <field name="outcome"/>
                        </group>
                        <group>
                            <field name="performed_by_id"/>
                            <field name="contractor"/>
                            <field name="cost"/>
                            <field name="downtime_hours"/>
                            <field name="certificate_ref"/>
                        </group>
                    </group>
                    <group>
                        <field name="parts_used"/>
                        <field name="notes"/>
                    </group>
                    <footer>
                        <button name="action_create_services"
                                string="Create Service Records"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Device Bulk Service Wizard - Action -->
    <record id="action_nhs_device_service_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Service</field>
        <field name="res_model">nhs.device.service.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nhs_device"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
