<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for device asset tags -->
        <record id="seq_nhs_device_asset_tag" model="ir.sequence">
            <field name="name">NHS Device Asset Tag</field>
            <field name="code">nhs.device</field>
            <field name="prefix">NHS-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for service references -->
        <record id="seq_nhs_device_service" model="ir.sequence">
            <field name="name">NHS Device Service</field>
            <field name="code">nhs.device.service</field>
            <field name="prefix">SVC-</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>