<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Schedule Types -->
        <record id="schedule_type_ppm" model="nhs.device.schedule.type">
            <field name="name">Planned Preventive Maintenance (PPM)</field>
            <field name="code">ppm</field>
            <field name="description">Regular scheduled preventive maintenance to maintain medical device performance,
                integrity, and safety standards.
            </field>
            <field name="sequence">10</field>
        </record>

        <record id="schedule_type_calibration" model="nhs.device.schedule.type">
            <field name="name">Calibration</field>
            <field name="code">calibration</field>
            <field name="description">Periodic calibration and measurement verification against recognized laboratory
                standards.
            </field>
            <field name="sequence">20</field>
        </record>

        <record id="schedule_type_electrical_safety" model="nhs.device.schedule.type">
            <field name="name">Electrical Safety Test</field>
            <field name="code">electrical_safety</field>
            <field name="description">Electrical safety inspection and testing in accordance with IEC 62353 / BS EN
                62353 standards.
            </field>
            <field name="sequence">30</field>
        </record>

        <record id="schedule_type_other" model="nhs.device.schedule.type">
            <field name="name">Other</field>
            <field name="code">other</field>
            <field name="description">Other specialized scheduled maintenance or regulatory checks (e.g., LOLER lifting
                inspection, PSSR pressure inspection, radiation safety check).
            </field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
