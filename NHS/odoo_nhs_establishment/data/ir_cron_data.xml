<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Daily cron: nudge followers on posts vacant beyond the long-vacancy threshold -->
    <record id="ir_cron_nhs_vacancy_age_refresh" model="ir.cron">
        <field name="name">NHS Establishment: Vacancy Age Refresh</field>
        <field name="model_id" ref="model_nhs_establishment_post"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_long_vacancies()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
