<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--nhs.trust.cqc.inspection — List / Form / Calendar / Search-->

    <!-- List view: CQC inspection history, colour-coded by overall_rating. -->
    <record id="nhs_trust_cqc_inspection_view_list" model="ir.ui.view">
        <field name="name">nhs.trust.cqc.inspection.list</field>
        <field name="model">nhs.trust.cqc.inspection</field>
        <field name="arch" type="xml">
            <list string="CQC Inspections"
                  decoration-success="overall_rating == 'outstanding'"
                  decoration-info="overall_rating == 'good'"
                  decoration-warning="overall_rating == 'requires_improvement'"
                  decoration-danger="overall_rating == 'inadequate'"
                  decoration-muted="overall_rating == 'not_rated'">
                <field name="trust_id"/>
                <field name="inspection_date"/>
                <field name="inspection_type"/>
                <field name="cqc_registration_status"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'under_review'"
                       decoration-success="state == 'active'"/>
                <field name="overall_rating" widget="badge"
                       decoration-success="overall_rating == 'outstanding'"
                       decoration-info="overall_rating == 'good'"
                       decoration-warning="overall_rating == 'requires_improvement'"
                       decoration-danger="overall_rating == 'inadequate'"/>
                <field name="safe_rating"/>
                <field name="effective_rating"/>
                <field name="caring_rating"/>
                <field name="responsive_rating"/>
                <field name="well_led_rating"/>
                <field name="next_inspection_due"/>
            </list>
        </field>
    </record>

    <!-- Form view: inspection details, submit/approve/reset workflow buttons,
         KLOE ratings, findings summary, and report attachments. -->
    <record id="nhs_trust_cqc_inspection_view_form" model="ir.ui.view">
        <field name="name">nhs.trust.cqc.inspection.form</field>
        <field name="model">nhs.trust.cqc.inspection</field>
        <field name="arch" type="xml">
            <form string="CQC Inspection">
                <header>
                    <button name="action_submit" string="Submit for Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'under_review'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="trust_id"/>
                        <h1>
                            <field name="trust_id" options="{'no_create': True}" domain="[('health_system', '=', 'nhs_england')]"/>
                        </h1>
                        <h4 class="text-muted">
                            CQC Inspection —
                            <field name="inspection_date" class="oe_inline"/>
                        </h4>
                    </div>

                    <group>
                        <group string="Inspection Details">
                            <field name="cqc_provider_id"/>
                            <field name="inspection_date"/>
                            <field name="inspection_type"/>
                            <field name="cqc_registration_status"/>
                            <field name="inspector_lead" placeholder="Lead inspector name..."/>
                            <field name="next_inspection_due"/>
                        </group>
                        <group string="CQC Report">
                            <field name="report_url" widget="url" placeholder="https://www.cqc.org.uk/..."/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group string="KLOE Ratings">
                        <group string="Overall">
                            <field name="overall_rating" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>

                    <group string="Key Lines of Enquiry (KLOE)">
                        <group>
                            <field name="safe_rating"/>
                            <field name="effective_rating"/>
                            <field name="caring_rating"/>
                        </group>
                        <group>
                            <field name="responsive_rating"/>
                            <field name="well_led_rating"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Findings Summary" name="findings">
                            <field name="findings_summary"
                                   placeholder="Copy key sections from the CQC report executive summary here..."/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="report_attachment_ids" widget="many2many_binary"
                                   string="Attached Reports / Action Plans"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Calendar view: plots inspections from inspection_date to next_inspection_due,
         colour-coded by overall_rating, for forward planning. -->
    <record id="nhs_trust_cqc_inspection_view_calendar" model="ir.ui.view">
        <field name="name">nhs.trust.cqc.inspection.calendar</field>
        <field name="model">nhs.trust.cqc.inspection</field>
        <field name="arch" type="xml">
            <calendar string="CQC Inspections"
                      date_start="inspection_date"
                      date_stop="next_inspection_due"
                      color="overall_rating"
                      mode="month">
                <field name="trust_id"/>
                <field name="overall_rating"/>
            </calendar>
        </field>
    </record>

    <!-- Search view: filters by rating and inspection type, "due soon" filter,
         and group-by trust/rating/type/year. -->
    <record id="nhs_trust_cqc_inspection_view_search" model="ir.ui.view">
        <field name="name">nhs.trust.cqc.inspection.search</field>
        <field name="model">nhs.trust.cqc.inspection</field>
        <field name="arch" type="xml">
            <search string="Search CQC Inspections">
                <field name="trust_id"/>
                <field name="inspector_lead"/>
                <separator/>
                <filter string="Outstanding" name="outstanding"
                        domain="[('overall_rating', '=', 'outstanding')]"/>
                <filter string="Good" name="good"
                        domain="[('overall_rating', '=', 'good')]"/>
                <filter string="Requires Improvement" name="requires_improvement"
                        domain="[('overall_rating', '=', 'requires_improvement')]"/>
                <filter string="Inadequate" name="inadequate"
                        domain="[('overall_rating', '=', 'inadequate')]"/>
                <separator/>
                <filter string="Comprehensive" name="comprehensive"
                        domain="[('inspection_type', '=', 'comprehensive')]"/>
                <separator/>
                <filter string="Due Soon (next 90 days)" name="due_soon"
                        domain="[('next_inspection_due', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d')),
                                  ('next_inspection_due', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Trust" name="group_by_trust" context="{'group_by': 'trust_id'}"/>
                    <filter string="Overall Rating" name="group_by_rating" context="{'group_by': 'overall_rating'}"/>
                    <filter string="Inspection Type" name="group_by_type" context="{'group_by': 'inspection_type'}"/>
                    <filter string="Year" name="group_by_year" context="{'group_by': 'inspection_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: entry point for the CQC Inspections menu (list/calendar/form). -->
    <record id="nhs_trust_cqc_inspection_action" model="ir.actions.act_window">
        <field name="name">CQC Inspections</field>
        <field name="res_model">nhs.trust.cqc.inspection</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="nhs_trust_cqc_inspection_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a CQC inspection.</p>
            <p>Track all five KLOE ratings (Safe, Effective, Caring, Responsive, Well-Led) and the overall rating.</p>
        </field>
    </record>
</odoo>
