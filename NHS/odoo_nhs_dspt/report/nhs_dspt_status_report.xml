<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_nhs_dspt_status" model="ir.actions.report">
        <field name="name">DSPT Status Report</field>
        <field name="model">nhs.dspt.assessment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_dspt.report_nhs_dspt_status_view</field>
        <field name="report_file">odoo_nhs_dspt.report_nhs_dspt_status_view</field>
        <field name="binding_model_id" ref="model_nhs_dspt_assessment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_nhs_dspt_status_view">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="assessment">
                    <div class="page">
                        <h2 style="color:#005EB8;">DSPT Status — <t t-out="assessment.name"/></h2>
                        <p class="text-muted">Generated <t t-out="generated_on"/></p>

                        <div class="row text-center mb-4 g-3">
                            <div class="col-3">
                                <h2 t-attf-style="color:#{assessment.readiness_pct >= 100 and '15803D' or assessment.readiness_pct >= 60 and 'ED8B00' or 'DC2626'};">
                                    <t t-out="round(assessment.readiness_pct, 1)"/>%
                                </h2>
                                <div class="text-muted">Readiness</div>
                            </div>
                            <div class="col-3">
                                <h2><t t-out="assessment.achieved_status"/></h2>
                                <div class="text-muted">Achieved Status</div>
                            </div>
                            <div class="col-3">
                                <h2 style="color:#DC2626;"><t t-out="assessment.gap_count"/></h2>
                                <div class="text-muted">Gaps Outstanding</div>
                            </div>
                            <div class="col-3">
                                <h2><t t-out="assessment.deadline or '-'"/></h2>
                                <div class="text-muted">Deadline</div>
                            </div>
                        </div>

                        <h4 style="color:#005EB8;">Readiness by Standard</h4>
                        <table class="table table-sm table-bordered mb-4">
                            <thead><tr><th>Standard</th><th>Mandatory Met</th><th>Rate</th></tr></thead>
                            <tbody>
                                <t t-foreach="[r for r in standard_rows if r['assessment'].id == assessment.id]" t-as="row">
                                    <tr>
                                        <td><t t-out="row['name']"/></td>
                                        <td><t t-out="row['met']"/> / <t t-out="row['total']"/></td>
                                        <td><t t-out="row['rate']"/>%</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 style="color:#DC2626;">Outstanding Mandatory Items</h4>
                        <t t-set="assessment_outstanding" t-value="[r for r in outstanding_rows if r['assessment'].id == assessment.id]"/>
                        <t t-if="assessment_outstanding">
                            <table class="table table-sm table-bordered">
                                <thead><tr><th>Ref</th><th>Standard</th><th>Item</th><th>Owner</th></tr></thead>
                                <tbody>
                                    <t t-foreach="assessment_outstanding" t-as="row">
                                        <tr>
                                            <td><t t-out="row['reference']"/></td>
                                            <td><t t-out="row['standard']"/></td>
                                            <td><t t-out="row['name']"/></td>
                                            <td><t t-out="row['owner']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-success">No outstanding mandatory items.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
