<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited form view for nhs.establishment.post adding training requirement profile -->
    <record id="view_nhs_establishment_post_form_inherit_training" model="ir.ui.view">
        <field name="name">nhs.establishment.post.form.inherit.training</field>
        <field name="model">nhs.establishment.post</field>
        <field name="inherit_id" ref="odoo_nhs_establishment.view_nhs_establishment_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cost_centre']" position="after">
                <field name="training_requirement_profile_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_workforce_members" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="member_count" widget="statinfo" string="Training Members"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Inherited list view for nhs.establishment.post adding training requirement profile column -->
    <record id="view_nhs_establishment_post_list_inherit_training" model="ir.ui.view">
        <field name="name">nhs.establishment.post.list.inherit.training</field>
        <field name="model">nhs.establishment.post</field>
        <field name="inherit_id" ref="odoo_nhs_establishment.view_nhs_establishment_post_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='staff_group_id']" position="after">
                <field name="training_requirement_profile_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
