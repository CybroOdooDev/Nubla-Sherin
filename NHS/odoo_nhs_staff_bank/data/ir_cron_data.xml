<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: auto-expire pending shift offers past their expiry deadline -->
        <record id="ir_cron_nhs_bank_offer_expiry" model="ir.cron">
            <field name="name">NHS Staff Bank: Offer Expiry</field>
            <field name="model_id" ref="model_nhs_shift_offer"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_offers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: recompute member compliance and alert coordinators on new lapses -->
        <record id="ir_cron_nhs_bank_compliance_recheck" model="ir.cron">
            <field name="name">NHS Staff Bank: Compliance Recheck</field>
            <field name="model_id" ref="model_nhs_bank_member"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_compliance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: expire shifts still open/partially-filled well past their end time -->
        <record id="ir_cron_nhs_bank_shift_expiry" model="ir.cron">
            <field name="name">NHS Staff Bank: Shift Expiry</field>
            <field name="model_id" ref="model_nhs_bank_shift"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_stale_shifts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: daily coordinator digest of open/urgent shifts -->
        <record id="ir_cron_nhs_bank_coordinator_digest" model="ir.cron">
            <field name="name">NHS Staff Bank: Coordinator Digest</field>
            <field name="model_id" ref="model_nhs_bank_shift"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_coordinator_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
