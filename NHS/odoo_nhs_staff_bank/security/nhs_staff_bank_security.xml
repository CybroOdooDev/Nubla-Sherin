<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category-->
        <record id="module_category_nhs_staff_bank" model="ir.module.category">
            <field name="name">NHS Staff Bank Management</field>
            <field name="description">NHS Staff Bank Management access levels.</field>
            <field name="sequence">55</field>
        </record>

        <!-- Privilege (Odoo 19 — replaces category_id on res.groups)-->
        <record id="privilege_staff_bank_access_level" model="res.groups.privilege">
            <field name="name">Staff Bank Access Level</field>
            <field name="category_id" ref="module_category_nhs_staff_bank"/>
            <field name="sequence">10</field>
        </record>

        <!-- Security group: Bank Member - portal self-service role. Deliberately
             does NOT imply base.group_portal: this group sits in the same
             "Role" selection widget as internal-user access levels, and an
             implied portal group would conflict with base.group_user the
             moment an internal user's access level is set to Bank Member
             (Portal/User/Public are mutually exclusive). Portal access is
             granted explicitly by action_create_portal_user() when a real
             portal account is created for the member. -->
        <record id="group_nhs_bank_member" model="res.groups">
            <field name="name">Bank Member</field>
            <field name="privilege_id" ref="privilege_staff_bank_access_level"/>
            <field name="implied_ids" eval="[(3, ref('base.group_portal'))]"/>
            <field name="comment">Portal role: a bank member sees available shifts,
                accepts/declines, sets availability, sees own bookings and pay
                summary. No access to other members, other members' data, or
                rate cards.</field>
        </record>

        <!-- Security group: Bank Officer - manage shifts/offers/bookings/members,
             not rate cards or configuration -->
        <record id="group_nhs_bank_officer" model="res.groups">
            <field name="name">Bank Officer</field>
            <field name="privilege_id" ref="privilege_staff_bank_access_level"/>
            <field name="comment">Temporary-staffing coordinator: manage shifts, offers,
                bookings and members; escalate to agency. Cannot edit rate cards or
                configuration.</field>
        </record>

        <!-- Security group: Bank Manager - full control incl. rate cards and config -->
        <record id="group_nhs_bank_manager" model="res.groups">
            <field name="name">Bank Manager</field>
            <field name="privilege_id" ref="privilege_staff_bank_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_bank_officer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full control: rate cards, compliance-gate policy,
                booking mode, working-time limits and all other configuration.</field>
        </record>

        <!-- Record Rules — company scope (officer/manager see everything in their
             company/companies) -->
        <record id="rule_nhs_bank_member_company" model="ir.rule">
            <field name="name">nhs.bank.member: company scope (officer/manager)</field>
            <field name="model_id" ref="model_nhs_bank_member"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: bank officers/managers only see shifts in their own company/companies -->
        <record id="rule_nhs_bank_shift_company" model="ir.rule">
            <field name="name">nhs.bank.shift: company scope (officer/manager)</field>
            <field name="model_id" ref="model_nhs_bank_shift"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: bank officers/managers only see shift offers in their own company/companies -->
        <record id="rule_nhs_shift_offer_company" model="ir.rule">
            <field name="name">nhs.shift.offer: company scope (officer/manager)</field>
            <field name="model_id" ref="model_nhs_shift_offer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: bank officers/managers only see bookings in their own company/companies -->
        <record id="rule_nhs_shift_booking_company" model="ir.rule">
            <field name="name">nhs.shift.booking: company scope (officer/manager)</field>
            <field name="model_id" ref="model_nhs_shift_booking"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: bank officers/managers only see member availability in their own company/companies -->
        <record id="rule_nhs_member_availability_company" model="ir.rule">
            <field name="name">nhs.member.availability: company scope (officer/manager)</field>
            <field name="model_id" ref="model_nhs_member_availability"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: bank managers only see rate cards in their own company/companies -->
        <record id="rule_nhs_bank_rate_company" model="ir.rule">
            <field name="name">nhs.bank.rate: company scope (manager)</field>
            <field name="model_id" ref="model_nhs_bank_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_manager'))]"/>
        </record>

        <!-- Record Rules — Bank Member portal scoping: a member sees only their own
             record/availability/offers/bookings. -->
        <record id="rule_nhs_bank_member_self" model="ir.rule">
            <field name="name">nhs.bank.member: own record only (bank member)</field>
            <field name="model_id" ref="model_nhs_bank_member"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_member'))]"/>
        </record>
        <!-- Record Rule: a bank member sees only their own availability entries -->
        <record id="rule_nhs_member_availability_self" model="ir.rule">
            <field name="name">nhs.member.availability: own record only (bank member)</field>
            <field name="model_id" ref="model_nhs_member_availability"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_member'))]"/>
        </record>
        <!-- Record Rule: a bank member sees only shift offers made to them -->
        <record id="rule_nhs_shift_offer_self" model="ir.rule">
            <field name="name">nhs.shift.offer: own offers only (bank member)</field>
            <field name="model_id" ref="model_nhs_shift_offer"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_member'))]"/>
        </record>
        <!-- Record Rule: a bank member sees only their own bookings -->
        <record id="rule_nhs_shift_booking_self" model="ir.rule">
            <field name="name">nhs.shift.booking: own bookings only (bank member)</field>
            <field name="model_id" ref="model_nhs_shift_booking"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_member'))]"/>
        </record>
        <!-- Record Rule: bank members can see company shifts (portal browsing of open/offered shifts) -->
        <record id="rule_nhs_bank_shift_member_visible" model="ir.rule">
            <field name="name">nhs.bank.shift: open shifts visible to bank members</field>
            <field name="model_id" ref="model_nhs_bank_shift"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_member'))]"/>
        </record>

        <!-- Record Rule — ward/area-manager scoping: any internal user who manages
             an org unit (Establishment nhs.org.unit.manager_id) may raise/view shifts
             for that unit, without needing full Bank Officer rights. Combines via OR
             with the officer/manager company-wide rule for users who hold both. -->
        <record id="rule_nhs_bank_shift_area_manager" model="ir.rule">
            <field name="name">nhs.bank.shift: own area only (ward/area manager)</field>
            <field name="model_id" ref="model_nhs_bank_shift"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('org_unit_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record Rules — reference/config models (company-scoped, nullable
             for shared/global reference data) -->
        <record id="rule_nhs_skill_company" model="ir.rule">
            <field name="name">nhs.skill: global reference data</field>
            <field name="model_id" ref="model_nhs_skill"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
        <!-- Record Rule: shift types visible if global (no company) or in the user's company/companies -->
        <record id="rule_nhs_shift_type_company" model="ir.rule">
            <field name="name">nhs.shift.type: company scope or global</field>
            <field name="model_id" ref="model_nhs_shift_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_bank_officer'))]"/>
        </record>
    </data>
</odoo>
