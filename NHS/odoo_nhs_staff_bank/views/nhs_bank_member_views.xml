<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: bank member register -->
    <record id="view_nhs_bank_member_list" model="ir.ui.view">
        <field name="name">nhs.bank.member.list</field>
        <field name="model">nhs.bank.member</field>
        <field name="arch" type="xml">
            <list string="Bank Members" decoration-danger="compliance_status == 'non_compliant'"
                  decoration-muted="state != 'active'">
                <field name="reference"/>
                <field name="name"/>
                <field name="member_type"/>
                <field name="band_id"/>
                <field name="role_ids" widget="many2many_tags"/>
                <field name="compliance_status" widget="badge"
                       decoration-success="compliance_status == 'compliant'"
                       decoration-danger="compliance_status == 'non_compliant'"/>
                <field name="state" widget="badge"/>
                <field name="join_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban view: bank member register — card grouped by status, coloured by
         compliance, with role/band badges and availability/offer/booking counts -->
    <record id="view_nhs_bank_member_kanban" model="ir.ui.view">
        <field name="name">nhs.bank.member.kanban</field>
        <field name="model">nhs.bank.member</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="0">
                <field name="name"/>
                <field name="reference"/>
                <field name="member_type"/>
                <field name="band_id"/>
                <field name="role_ids"/>
                <field name="compliance_status"/>
                <field name="state"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="availability_count"/>
                <field name="offer_count"/>
                <field name="booking_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-3 rounded shadow-sm border-start border-4 #{
                            record.compliance_status.raw_value == 'compliant' ? 'border-success' :
                            record.compliance_status.raw_value == 'non_compliant' ? 'border-danger' :
                            'border-secondary'
                        }">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge text-bg-light border fw-semibold" t-out="record.reference.value"/>
                                <span t-attf-class="badge #{
                                    record.compliance_status.raw_value == 'compliant' ? 'text-bg-success' :
                                    record.compliance_status.raw_value == 'non_compliant' ? 'text-bg-danger' :
                                    'text-bg-secondary'
                                } px-2 py-1 small fw-bold" t-out="record.compliance_status.value"/>
                            </div>
                            <h4 class="text-primary fw-bold mb-1 fs-5" t-out="record.name.value"/>
                            <div class="text-muted small mb-2">
                                <span t-if="record.member_type.raw_value" t-out="record.member_type.value"/>
                                <span t-if="record.member_type.raw_value and record.band_id.raw_value"> — </span>
                                <span t-if="record.band_id.raw_value" t-out="record.band_id.value"/>
                            </div>
                            <div class="mb-2" t-if="record.role_ids.raw_value.length">
                                <field name="role_ids" widget="many2many_tags"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-muted small mb-1">
                                <i class="fa fa-envelope-o me-1"/><t t-esc="record.email.value"/>
                            </div>
                            <div t-if="record.phone.raw_value" class="text-muted small mb-2">
                                <i class="fa fa-phone me-1"/><t t-esc="record.phone.value"/>
                            </div>
                            <hr class="my-2 opacity-25"/>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span t-attf-class="badge #{
                                    record.state.raw_value == 'active' ? 'text-bg-success' :
                                    record.state.raw_value == 'suspended' ? 'text-bg-danger' :
                                    record.state.raw_value == 'draft' ? 'text-bg-warning' :
                                    'text-bg-secondary'
                                } px-2 py-1 small fw-bold" t-out="record.state.value"/>
                                <div class="d-flex gap-2 text-muted small">
                                    <span title="Availability"><i class="fa fa-calendar me-1"/><t t-esc="record.availability_count.value"/></span>
                                    <span title="Offers"><i class="fa fa-paper-plane me-1"/><t t-esc="record.offer_count.value"/></span>
                                    <span title="Bookings"><i class="fa fa-check-square-o me-1"/><t t-esc="record.booking_count.value"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form view: bank member — type, roles/bands, skills, areas, checks-confirmed,
         compliance-status ribbon, availability and booking history -->
    <record id="view_nhs_bank_member_form" model="ir.ui.view">
        <field name="name">nhs.bank.member.form</field>
        <field name="model">nhs.bank.member</field>
        <field name="arch" type="xml">
            <form string="Bank Member">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_suspend" string="Suspend" type="object" invisible="state == 'suspended'"/>
                    <button name="action_deactivate" string="Set Inactive" type="object" invisible="state == 'inactive'"/>
                    <button name="action_create_portal_user" string="Create Portal User" type="object"
                            invisible="user_id or not email"
                            help="Create a Contact and Portal User from this member's name/email/phone, and email them an invitation to set their password."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended,inactive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_availability" type="object" class="oe_stat_button" icon="fa-calendar"
                                invisible="state == 'draft'">
                            <field name="availability_count" widget="statinfo" string="Availability"/>
                        </button>
                        <button name="action_view_offers" type="object" class="oe_stat_button" icon="fa-paper-plane"
                                invisible="state == 'draft'">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                        <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-check-square-o"
                                invisible="state == 'draft'">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Non-Compliant" bg_color="text-bg-danger"
                            invisible="compliance_status != 'non_compliant'"/>
                    <widget name="web_ribbon" title="Compliant" bg_color="text-bg-success"
                            invisible="compliance_status != 'compliant'"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Member Name"/></h1>
                        <h3><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Type &amp; Link">
                            <field name="member_type"/>
                            <field name="post_id" invisible="member_type != 'substantive_bank'"/>
                            <field name="workforce_member_id"
                                   domain="[('post_id', '=', post_id)] if member_type == 'substantive_bank' and post_id else []"/>
                            <field name="company_auto_create_portal_user" invisible="1"/>
                            <field name="user_id" invisible="not id and company_auto_create_portal_user"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Roles, Bands &amp; Areas">
                            <field name="role_ids" widget="many2many_tags"/>
                            <field name="band_id"/>
                            <field name="skill_ids" widget="many2many_tags"/>
                            <field name="area_ids" widget="many2many_tags"/>
                            <field name="preferred_shift_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group string="Compliance &amp; Checks">
                            <field name="checks_confirmed"/>
                            <field name="compliance_status" readonly="1"/>
                            <field name="compliance_reason" readonly="1"/>
                            <field name="manual_compliance_flag"/>
                            <field name="manual_compliance_note" invisible="manual_compliance_flag"/>
                        </group>
                        <group string="Working Time &amp; Preferences">
                            <field name="join_date"/>
                            <field name="weekly_hours_limit"/>
                            <field name="substantive_weekly_hours"
                                   invisible="member_type != 'substantive_bank'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view: bank members -->
    <record id="view_nhs_bank_member_search" model="ir.ui.view">
        <field name="name">nhs.bank.member.search</field>
        <field name="model">nhs.bank.member</field>
        <field name="arch" type="xml">
            <search string="Bank Members">
                <field name="name"/>
                <field name="reference"/>
                <field name="band_id"/>
                <field name="role_ids"/>
                <field name="skill_ids"/>
                <field name="area_ids"/>
                <filter string="Active" name="active_state" domain="[('state', '=', 'active')]"/>
                <filter string="Non-Compliant" name="non_compliant" domain="[('compliance_status', '=', 'non_compliant')]"/>
                <filter string="Substantive Doing Bank" name="substantive" domain="[('member_type', '=', 'substantive_bank')]"/>
                <filter string="Bank-Only" name="bank_only" domain="[('member_type', '=', 'bank_only')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Band" name="group_band" context="{'group_by': 'band_id'}"/>
                    <filter string="Member Type" name="group_type" context="{'group_by': 'member_type'}"/>
                    <filter string="Compliance Status" name="group_compliance" context="{'group_by': 'compliance_status'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: main Bank Members menu entry, showing members in all states -->
    <record id="action_nhs_bank_member" model="ir.actions.act_window">
        <field name="name">Bank Members</field>
        <field name="res_model">nhs.bank.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first bank member</p>
            <p>Bank members are the flexible/bank workers available for shifts.</p>
        </field>
    </record>

    <!-- Window action: watchlist of active members flagged non-compliant -->
    <record id="action_nhs_bank_member_compliance_watch" model="ir.actions.act_window">
        <field name="name">Compliance Watch</field>
        <field name="res_model">nhs.bank.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', '=', 'active'), ('compliance_status', '=', 'non_compliant')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No members currently non-compliant</p>
        </field>
    </record>
</odoo>
