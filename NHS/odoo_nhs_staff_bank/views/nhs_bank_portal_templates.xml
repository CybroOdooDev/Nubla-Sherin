<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal home card: links into the Staff Bank self-service pages. Same
         category row and card classes as portal.portal_docs_entry (used by
         the built-in Addresses/Connection &amp; Security cards), but with a
         Font Awesome icon instead of portal_docs_entry's image-only icon
         slot — no static image file to keep in sync/ship. -->
    <template id="portal_my_home_nhs_staff_bank" inherit_id="portal.portal_my_home" customize_show="True">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-if="bank_shift_count is not None">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/bank" title="Staff Bank"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-block align-self-start">
                            <i class="fa fa-2x fa-calendar-check-o text-primary"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1">
                                <span>Staff Bank</span>
                            </div>
                            <div class="opacity-75">Shifts offered to you, your availability and bookings</div>
                        </div>
                    </a>
                </div>
            </t>
        </div>
    </template>

    <!-- Breadcrumb trail for the Staff Bank portal pages: Home > Staff Bank > (sub-page),
         matching the pattern other apps (e.g. Sales) use for their own portal breadcrumbs. -->
    <template id="portal_my_home_menu_nhs_staff_bank" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'bank_home'" class="breadcrumb-item active">Staff Bank</li>
            <li t-elif="page_name in ('bank_shifts', 'bank_bookings', 'bank_availability')" class="breadcrumb-item">
                <a href="/my/bank" aria-label="Staff Bank" title="Staff Bank">Staff Bank</a>
            </li>
            <li t-if="page_name == 'bank_shifts'" class="breadcrumb-item active">Available Shifts</li>
            <li t-if="page_name == 'bank_bookings'" class="breadcrumb-item active">My Bookings</li>
            <li t-if="page_name == 'bank_availability'" class="breadcrumb-item active">Availability</li>
        </xpath>
    </template>

    <!-- Shown when the logged-in portal user is not linked to a bank member -->
    <template id="portal_bank_not_member" name="Not a Bank Member">
        <t t-call="portal.portal_layout">
            <div class="container o_portal_bank">
                <div class="alert alert-info mt-3">
                    You are not currently registered as a Staff Bank member. Contact the
                    Staff Bank team if you believe this is incorrect.
                </div>
            </div>
        </t>
    </template>

    <!-- Reusable empty-state block: icon + muted message, used whenever a
         Staff Bank list has nothing to show — consistent look across pages
         instead of a bare line of muted text. -->
    <template id="portal_bank_empty_state" name="Staff Bank Empty State">
        <div class="text-center text-muted py-4">
            <i t-attf-class="fa fa-2x mb-2 #{icon or 'fa-inbox'}"/>
            <p class="mb-0" t-out="message"/>
        </div>
    </template>

    <!-- Bank member portal home: summary + quick links -->
    <template id="portal_bank_home" name="Staff Bank Home">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container o_portal_bank mt-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                    <h2 class="mb-0">Staff Bank</h2>
                    <span t-attf-class="badge fs-6 #{member.compliance_status == 'compliant' and 'text-bg-success' or 'text-bg-danger'}"
                          t-esc="member.compliance_status"/>
                </div>
                <p class="text-muted">Welcome, <t t-esc="member.name"/>.</p>

                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm rounded-3">
                            <div class="card-body">
                                <i class="fa fa-calendar-check-o text-primary mb-2 fs-4"/>
                                <h5 class="card-title">Available Shifts</h5>
                                <p class="card-text text-muted">Shifts you're eligible and compliant to work.</p>
                                <a href="/my/bank/shifts" class="btn btn-primary btn-sm">View Shifts</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm rounded-3">
                            <div class="card-body">
                                <i class="fa fa-check-square-o text-primary mb-2 fs-4"/>
                                <h5 class="card-title">My Bookings</h5>
                                <p class="card-text text-muted">Your confirmed bookings and pay summary.</p>
                                <a href="/my/bank/bookings" class="btn btn-primary btn-sm">View Bookings</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm rounded-3">
                            <div class="card-body">
                                <i class="fa fa-clock-o text-primary mb-2 fs-4"/>
                                <h5 class="card-title">Availability</h5>
                                <p class="card-text text-muted">Tell us when you can work.</p>
                                <a href="/my/bank/availability" class="btn btn-primary btn-sm">Set Availability</a>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mt-4">Shifts Matching You</h4>
                <t t-if="eligible_shifts">
                    <div class="card shadow-sm rounded-3 mb-4">
                        <t t-call="portal.portal_table">
                            <thead>
                                <tr class="active">
                                    <th>Shift</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="eligible_shifts" t-as="shift">
                                    <td t-esc="shift.name"/>
                                    <td t-esc="shift.shift_start"/>
                                    <td t-esc="shift.shift_end"/>
                                    <td>
                                        <form t-attf-action="/my/bank/shifts/#{shift.id}/accept" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                    </div>
                </t>
                <t t-if="not eligible_shifts" t-call="odoo_nhs_staff_bank.portal_bank_empty_state">
                    <t t-set="icon" t-value="'fa-calendar-o'"/>
                    <t t-set="message">No matching shifts right now.</t>
                </t>

                <h4 class="mt-4">Upcoming Bookings</h4>
                <t t-if="upcoming_bookings">
                    <div class="card shadow-sm rounded-3 mb-4">
                        <t t-call="portal.portal_table">
                            <thead>
                                <tr class="active">
                                    <th>Shift</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="upcoming_bookings" t-as="booking">
                                    <td t-esc="booking.shift_id.name"/>
                                    <td t-esc="booking.shift_start"/>
                                    <td t-esc="booking.shift_end"/>
                                    <td t-esc="booking.state"/>
                                </tr>
                            </tbody>
                        </t>
                    </div>
                </t>
                <t t-if="not upcoming_bookings" t-call="odoo_nhs_staff_bank.portal_bank_empty_state">
                    <t t-set="icon" t-value="'fa-check-square-o'"/>
                    <t t-set="message">No upcoming bookings.</t>
                </t>
            </div>
        </t>
    </template>

    <!-- Bank member portal: available/eligible shifts, accept -->
    <template id="portal_bank_shifts" name="Staff Bank Shifts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container o_portal_bank mt-3">
                <h2>Available Shifts</h2>
                <t t-if="shifts">
                    <div class="card shadow-sm rounded-3 mb-4">
                        <t t-call="portal.portal_table">
                            <thead>
                                <tr class="active">
                                    <th>Shift</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Band</th>
                                    <th>Role</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="shifts" t-as="shift">
                                    <td t-esc="shift.name"/>
                                    <td t-esc="shift.shift_start"/>
                                    <td t-esc="shift.shift_end"/>
                                    <td t-esc="shift.band_id.name"/>
                                    <td t-esc="shift.role"/>
                                    <td>
                                        <form t-attf-action="/my/bank/shifts/#{shift.id}/accept" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                    </div>
                </t>
                <t t-if="not shifts" t-call="odoo_nhs_staff_bank.portal_bank_empty_state">
                    <t t-set="icon" t-value="'fa-calendar-o'"/>
                    <t t-set="message">No matching shifts right now.</t>
                </t>
            </div>
        </t>
    </template>

    <!-- Bank member portal: own bookings + pay summary -->
    <template id="portal_bank_bookings" name="Staff Bank Bookings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container o_portal_bank mt-3">
                <h2>My Bookings</h2>
                <p><strong>Total pay (worked shifts):</strong> <span t-esc="'%.2f' % total_pay"/></p>
                <t t-if="bookings">
                    <div class="card shadow-sm rounded-3 mb-4">
                        <t t-call="portal.portal_table">
                            <thead>
                                <tr class="active">
                                    <th>Reference</th>
                                    <th>Shift</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Status</th>
                                    <th>Payable</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bookings" t-as="booking">
                                    <td t-esc="booking.name"/>
                                    <td t-esc="booking.shift_id.name"/>
                                    <td t-esc="booking.shift_start"/>
                                    <td t-esc="booking.shift_end"/>
                                    <td t-esc="booking.state"/>
                                    <td t-esc="'%.2f' % booking.payable_amount"/>
                                </tr>
                            </tbody>
                        </t>
                    </div>
                </t>
                <t t-if="not bookings" t-call="odoo_nhs_staff_bank.portal_bank_empty_state">
                    <t t-set="icon" t-value="'fa-check-square-o'"/>
                    <t t-set="message">No bookings yet.</t>
                </t>
            </div>
        </t>
    </template>

    <!-- Bank member portal: set availability -->
    <template id="portal_bank_availability" name="Staff Bank Availability">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container o_portal_bank mt-3">
                <h2>My Availability</h2>
                <div class="alert alert-danger" role="alert" t-if="error" t-esc="error"/>
                <div class="card shadow-sm rounded-3 mb-4">
                    <div class="card-body">
                        <form action="/my/bank/availability/add" method="post" class="row g-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="col-md-3">
                                <label class="form-label">From</label>
                                <input type="datetime-local" name="date_from" class="form-control" required="required" t-att-min="min_datetime"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">To</label>
                                <input type="datetime-local" name="date_to" class="form-control" required="required" t-att-min="min_datetime"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Type</label>
                                <select name="availability_type" class="form-select">
                                    <option value="available">Available</option>
                                    <option value="unavailable">Unavailable (Blackout)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Note</label>
                                <input type="text" name="note" class="form-control"/>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </form>
                    </div>
                </div>
                <t t-if="availability">
                    <div class="card shadow-sm rounded-3 mb-4">
                        <t t-call="portal.portal_table">
                            <thead>
                                <tr class="active">
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Type</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="availability" t-as="a">
                                    <td t-esc="a.date_from"/>
                                    <td t-esc="a.date_to"/>
                                    <td t-esc="a.availability_type"/>
                                    <td t-esc="a.note"/>
                                </tr>
                            </tbody>
                        </t>
                    </div>
                </t>
                <t t-if="not availability" t-call="odoo_nhs_staff_bank.portal_bank_empty_state">
                    <t t-set="icon" t-value="'fa-clock-o'"/>
                    <t t-set="message">No availability recorded yet.</t>
                </t>
            </div>
        </t>
    </template>
</odoo>
