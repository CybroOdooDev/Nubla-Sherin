<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action: opens the OWL KPI fill-rate / bank-vs-agency dashboard -->
    <record id="action_nhs_bank_dashboard_client" model="ir.actions.client">
        <field name="name">Fill-Rate Dashboard</field>
        <field name="tag">nhs_bank_dashboard</field>
    </record>

    <!-- Graph/pivot: bank vs agency spend and fill-rate drill-down for power users -->
    <record id="view_nhs_bank_shift_graph" model="ir.ui.view">
        <field name="name">nhs.bank.shift.graph</field>
        <field name="model">nhs.bank.shift</field>
        <field name="arch" type="xml">
            <graph string="Shifts by State" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: shifts by org unit x state, estimated cost measure -->
    <record id="view_nhs_bank_shift_pivot" model="ir.ui.view">
        <field name="name">nhs.bank.shift.pivot</field>
        <field name="model">nhs.bank.shift</field>
        <field name="arch" type="xml">
            <pivot string="Shifts">
                <field name="org_unit_id" type="row"/>
                <field name="state" type="col"/>
                <field name="estimated_cost" type="measure"/>
                <field name="agency_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action: opens Bank vs Agency Analytics in pivot/graph/list. No default
         search group-by here — the pivot view already sets its own deliberate
         Org Unit (row) x Status (col) layout, and a search_default group-by
         on the same 'state' field would override that row axis, collapsing
         the pivot into a confusing Status-vs-Status cross-tab. -->
    <record id="action_nhs_bank_shift_analytics" model="ir.actions.act_window">
        <field name="name">Bank vs Agency Analytics</field>
        <field name="res_model">nhs.bank.shift</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <!-- Pivot: member utilisation — bookings by member x state, payable amount measure -->
    <record id="view_nhs_shift_booking_pivot" model="ir.ui.view">
        <field name="name">nhs.shift.booking.pivot</field>
        <field name="model">nhs.shift.booking</field>
        <field name="arch" type="xml">
            <pivot string="Member Utilisation">
                <field name="member_id" type="row"/>
                <field name="state" type="col"/>
                <field name="payable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action: opens Member Utilisation pivot/list -->
    <record id="action_nhs_member_utilisation" model="ir.actions.act_window">
        <field name="name">Member Utilisation</field>
        <field name="res_model">nhs.shift.booking</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
