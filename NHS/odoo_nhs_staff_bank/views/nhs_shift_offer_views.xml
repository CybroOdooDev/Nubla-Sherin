<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: shift offers — colour-coded by response, with inline accept/decline buttons for pending offers. -->
    <record id="view_nhs_shift_offer_list" model="ir.ui.view">
        <field name="name">nhs.shift.offer.list</field>
        <field name="model">nhs.shift.offer</field>
        <field name="arch" type="xml">
            <list string="Shift Offers" decoration-success="response == 'accepted'"
                  decoration-danger="response == 'declined'" decoration-muted="response in ('expired', 'withdrawn')">
                <field name="shift_id"/>
                <field name="member_id"/>
                <field name="offered_at"/>
                <field name="expiry_datetime"/>
                <field name="response" widget="badge"/>
                <field name="eligible"/>
                <field name="decline_reason" invisible="response != 'declined'"/>
                <button name="action_accept" type="object" string="Accept" icon="fa-check"
                        invisible="response != 'pending'"/>
                <button name="action_open_decline_wizard" type="object" string="Decline" icon="fa-times"
                        invisible="response != 'pending'"/>
                <button name="action_withdraw" type="object" string="Withdraw" icon="fa-ban"
                        invisible="response != 'pending'"
                        groups="odoo_nhs_staff_bank.group_nhs_bank_officer"/>
            </list>
        </field>
    </record>

    <!-- List view variant: same as above but with "New" disabled — used when opening Offers from an
         already-Filled shift, where a manually-added offer has nowhere valid to go (get_eligible_shifts/
         get_eligible_members already exclude a Filled shift, so the Shift field would just get silently
         cleared by the member_id onchange the moment a member is picked). Open/Partially Filled shifts keep
         using the base view above, where "New" stays available. -->
    <record id="view_nhs_shift_offer_list_filled" model="ir.ui.view">
        <field name="name">nhs.shift.offer.list.filled</field>
        <field name="model">nhs.shift.offer</field>
        <field name="inherit_id" ref="view_nhs_shift_offer_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Form view: shift offer — response statusbar with accept/decline actions and read-only eligibility info -->
    <record id="view_nhs_shift_offer_form" model="ir.ui.view">
        <field name="name">nhs.shift.offer.form</field>
        <field name="model">nhs.shift.offer</field>
        <field name="arch" type="xml">
            <form string="Shift Offer">
                <header>
                    <button name="action_accept" type="object" string="Accept" class="btn-primary"
                            invisible="response != 'pending'"/>
                    <button name="action_open_decline_wizard" type="object" string="Decline"
                            invisible="response != 'pending'"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="response != 'pending'"
                            groups="odoo_nhs_staff_bank.group_nhs_bank_officer"/>
                    <field name="response" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="eligible_member_ids" invisible="1"/>
                            <field name="member_id" domain="[('id', 'in', eligible_member_ids)]"/>
                            <field name="offered_at"/>
                            <field name="expiry_datetime"/>
                        </group>
                        <group>
                            <field name="eligible" readonly="1"/>
                            <field name="eligibility_reasons" readonly="1" invisible="eligible"/>
                            <field name="responded_at" readonly="1"/>
                            <field name="decline_reason" invisible="response != 'declined'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form view variant: same as above but with "New" disabled, for the same reason — paired with the list
         variant above so a Filled shift's Offers smart button can't reach a create form at all, including by
         direct URL. -->
    <record id="view_nhs_shift_offer_form_filled" model="ir.ui.view">
        <field name="name">nhs.shift.offer.form.filled</field>
        <field name="model">nhs.shift.offer</field>
        <field name="inherit_id" ref="view_nhs_shift_offer_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search view: shift offers — filter/group by response, shift and member -->
    <record id="view_nhs_shift_offer_search" model="ir.ui.view">
        <field name="name">nhs.shift.offer.search</field>
        <field name="model">nhs.shift.offer</field>
        <field name="arch" type="xml">
            <search string="Shift Offers">
                <field name="shift_id"/>
                <field name="member_id"/>
                <filter string="Pending" name="pending" domain="[('response', '=', 'pending')]"/>
                <filter string="Accepted" name="accepted" domain="[('response', '=', 'accepted')]"/>
                <filter string="Declined" name="declined" domain="[('response', '=', 'declined')]"/>
                <group>
                    <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
                    <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                    <filter string="Response" name="group_response" context="{'group_by': 'response'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: Offers menu entry -->
    <record id="action_nhs_shift_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">nhs.shift.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
