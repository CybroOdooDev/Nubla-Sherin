<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_shift_type_list" model="ir.ui.view">
        <field name="name">nhs.shift.type.list</field>
        <field name="model">nhs.shift.type</field>
        <field name="arch" type="xml">
            <list string="Shift Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_unsocial"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_shift_type" model="ir.actions.act_window">
        <field name="name">Shift Types</field>
        <field name="res_model">nhs.shift.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
