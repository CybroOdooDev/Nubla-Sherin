<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard view: escalate an unfilled shift to agency, capturing the cost -->
    <record id="view_nhs_escalate_agency_wizard_form" model="ir.ui.view">
        <field name="name">nhs.escalate.agency.wizard.form</field>
        <field name="model">nhs.escalate.agency.wizard</field>
        <field name="arch" type="xml">
            <form string="Escalate to Agency">
                <group>
                    <field name="shift_id" invisible="1"/>
                    <field name="agency_name"/>
                    <field name="agency_cost"/>
                    <field name="reason"/>
                </group>
                <div class="alert alert-info" role="alert">
                    This records the shift as filled by agency, at the cost above, for the
                    bank-vs-agency displacement metric. Any pending bank offers will be withdrawn.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Escalation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action: opens the agency escalation wizard as a popup dialog -->
    <record id="action_nhs_escalate_agency_wizard" model="ir.actions.act_window">
        <field name="name">Escalate to Agency</field>
        <field name="res_model">nhs.escalate.agency.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
