<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard view: date-range (and optional area) selector for the board PDF reports -->
    <record id="view_nhs_bank_report_wizard_form" model="ir.ui.view">
        <field name="name">nhs.bank.report.wizard.form</field>
        <field name="model">nhs.bank.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Staff Bank Reports">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="org_unit_id"/>
                </group>
                <footer>
                    <button name="action_print_fill_rate" type="object"
                            string="Fill-Rate &amp; Agency-Displacement (PDF)" class="btn-primary"/>
                    <button name="action_print_spend" type="object"
                            string="Bank-Spend (PDF)" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action: opens the report wizard as a popup dialog -->
    <record id="action_nhs_bank_report_wizard" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">nhs.bank.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
