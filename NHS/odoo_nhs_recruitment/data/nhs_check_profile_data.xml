    <!-- Clinical staff groups: all six standards, DBS enhanced with barred-list check -->
    <record id="check_profile_clinical" model="nhs.check.profile">
        <field name="name">Clinical (Enhanced DBS + Barred List)</field>
        <field name="staff_group_id" ref="odoo_nhs_establishment.staff_group_nursing_midwifery"/>
        <field name="line_ids">
            <record id="check_profile_clinical_identity" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_identity"/>
                <field name="sequence">10</field>
                <field name="is_required" eval="True"/>
            </record>
            <record id="check_profile_clinical_rtw" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_rtw"/>
                <field name="sequence">20</field>
                <field name="is_required" eval="True"/>
            </record>
            <record id="check_profile_clinical_registration" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_registration"/>
                <field name="sequence">30</field>
                <field name="is_required" eval="True"/>
            </record>
            <record id="check_profile_clinical_references" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_references"/>
                <field name="sequence">40</field>
                <field name="is_required" eval="True"/>
            </record>
            <record id="check_profile_clinical_dbs" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_dbs"/>
                <field name="sequence">50</field>
                <field name="level">enhanced_barred</field>
                <field name="is_required" eval="True"/>
            </record>
            <record id="check_profile_clinical_oh" model="nhs.check.profile.line">
                <field name="check_type_id" ref="check_type_oh"/>
                <field name="sequence">60</field>
                <field name="is_required" eval="True"/>
            </record>
        </field>
    </record>

