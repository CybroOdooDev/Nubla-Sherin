<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The six NHS Employment Check Standards -->
    <record id="check_type_identity" model="nhs.check.type">
        <field name="name">Identity</field>
        <field name="code">ID</field>
        <field name="sequence">10</field>
        <field name="is_sensitive">False</field>
        <field name="default_required">True</field>
    </record>

    <!-- Check type: Right to Work verification -->
    <record id="check_type_rtw" model="nhs.check.type">
        <field name="name">Right to Work</field>
        <field name="code">RTW</field>
        <field name="sequence">20</field>
        <field name="is_sensitive">False</field>
        <field name="default_required">True</field>
    </record>

    <!-- Check type: professional registration and qualifications verification -->
    <record id="check_type_registration" model="nhs.check.type">
        <field name="name">Professional Registration &amp; Qualifications</field>
        <field name="code">REG</field>
        <field name="sequence">30</field>
        <field name="is_sensitive">False</field>
        <field name="default_required">True</field>
    </record>

    <!-- Check type: employment history and references verification -->
    <record id="check_type_references" model="nhs.check.type">
        <field name="name">Employment History &amp; References</field>
        <field name="code">REF</field>
        <field name="sequence">40</field>
        <field name="is_sensitive">False</field>
        <field name="default_required">True</field>
    </record>

    <!-- Check type: criminal record (DBS) check, sensitive, supports DBS level -->
    <record id="check_type_dbs" model="nhs.check.type">
        <field name="name">Criminal Record (DBS)</field>
        <field name="code">DBS</field>
        <field name="sequence">50</field>
        <field name="is_sensitive">True</field>
        <field name="default_required">True</field>
    </record>

    <!-- Check type: occupational health clearance, sensitive data -->
    <record id="check_type_oh" model="nhs.check.type">
        <field name="name">Occupational Health</field>
        <field name="code">OH</field>
        <field name="sequence">60</field>
        <field name="is_sensitive">True</field>
        <field name="default_required">True</field>
    </record>
</odoo>
