<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: candidates with talent pool consent and retention expiry -->
    <record id="view_nhs_candidate_list" model="ir.ui.view">
        <field name="name">nhs.candidate.list</field>
        <field name="model">nhs.candidate</field>
        <field name="arch" type="xml">
            <list string="Candidates" decoration-muted="is_anonymised">
                <field name="reference"/>
                <field name="name"/>
                <field name="email"/>
                <field name="is_internal"/>
                <field name="application_count"/>
                <field name="talent_pool_consent"/>
                <field name="retention_expiry"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form view: candidate record with applications stat button and consent fields -->
    <record id="view_nhs_candidate_form" model="ir.ui.view">
        <field name="name">nhs.candidate.form</field>
        <field name="model">nhs.candidate</field>
        <field name="arch" type="xml">
            <form string="Candidate">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Anonymised" bg_color="text-bg-danger"
                            invisible="not is_anonymised"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="is_anonymised or active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_nhs_application)d" type="action"
                                class="oe_stat_button" icon="fa-file-text"
                                context="{'search_default_candidate_id': id}">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Jane Smith"/></h1>
                        <div class="text-muted"><field name="reference" readonly="1"/></div>
                    </div>
                    <div class="mt-2 mb-3">
                        <span invisible="not is_internal" class="badge text-bg-info me-1">
                            <i class="fa fa-building me-1"/>Internal Candidate
                        </span>
                        <span invisible="not talent_pool_consent" class="badge text-bg-success me-1">
                            <i class="fa fa-star me-1"/>Talent Pool
                        </span>
                    </div>
                    <group>
                        <group string="Contact Details">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="is_internal"/>
                        </group>
                        <group string="Retention &amp; Consent">
                            <field name="talent_pool_consent" widget="boolean_toggle"/>
                            <field name="retention_expiry" readonly="1" invisible="talent_pool_consent"/>
                            <field name="is_anonymised" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view: filter candidates by talent pool consent or internal status -->
    <record id="view_nhs_candidate_search" model="ir.ui.view">
        <field name="name">nhs.candidate.search</field>
        <field name="model">nhs.candidate</field>
        <field name="arch" type="xml">
            <search string="Candidates">
                <field name="name"/>
                <field name="reference"/>
                <field name="email"/>
                <filter string="Talent Pool" name="talent_pool" domain="[('talent_pool_consent', '=', True)]"/>
                <filter string="Internal" name="internal" domain="[('is_internal', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Kanban view: candidate cards with internal/talent pool badges and application count -->
    <record id="view_nhs_candidate_kanban" model="ir.ui.view">
        <field name="name">nhs.candidate.kanban</field>
        <field name="model">nhs.candidate</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="reference"/>
                <field name="email"/>
                <field name="application_count"/>
                <field name="is_internal"/>
                <field name="talent_pool_consent"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5"><field name="name"/></strong>
                                    <div class="text-muted"><field name="reference"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div t-if="record.email.raw_value"><i class="fa fa-envelope me-1" title="Email"/> <field name="email"/></div>
                                <div class="mt-2">
                                    <span t-if="record.is_internal.raw_value" class="badge text-bg-info me-1">Internal Candidate</span>
                                    <span t-if="record.talent_pool_consent.raw_value" class="badge text-bg-success me-1">Talent Pool</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <i class="fa fa-file-text-o me-1" title="Applications"/> <t t-esc="record.application_count.raw_value"/> Applications
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window action: Candidates menu entry (kanban/list/form) -->
    <record id="action_nhs_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">nhs.candidate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_candidate_search"/>
    </record>

    <!-- Window action: Talent Pool, candidates who consented to retention -->
    <record id="action_nhs_candidate_talent_pool" model="ir.actions.act_window">
        <field name="name">Talent Pool</field>
        <field name="res_model">nhs.candidate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('talent_pool_consent', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_nhs_candidate_search"/>
    </record>
</odoo>
