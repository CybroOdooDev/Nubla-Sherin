<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: interviews with invite status, outcome, score and rank -->
    <record id="view_nhs_interview_list" model="ir.ui.view">
        <field name="name">nhs.interview.list</field>
        <field name="model">nhs.interview</field>
        <field name="arch" type="xml">
            <list string="Interviews">
                <field name="name"/>
                <field name="application_id"/>
                <field name="vacancy_id"/>
                <field name="interview_datetime"/>
                <field name="invite_status" widget="badge"/>
                <field name="outcome" widget="badge"/>
                <field name="total_score"/>
                <field name="rank"/>
            </list>
        </field>
    </record>

    <!-- Form view: interview record with invite/outcome workflow buttons and panel scores -->
    <record id="view_nhs_interview_form" model="ir.ui.view">
        <field name="name">nhs.interview.form</field>
        <field name="model">nhs.interview</field>
        <field name="arch" type="xml">
            <form string="Interview">
                <!-- Viewer's role on interviews is to view and score (per spec) —
                     invite/outcome logistics are officer-managed, so every
                     header action below is officer+ only; a Viewer gets no
                     clickable buttons on this form. -->
                <header>
                    <button name="action_mark_accepted" type="object" string="Mark Accepted"
                            class="btn-primary" invisible="invite_status not in ('invited', 'rescheduled')"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_declined" type="object" string="Mark Declined"
                            invisible="invite_status not in ('invited', 'rescheduled', 'accepted')"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_rescheduled" type="object" string="Mark Rescheduled"
                            invisible="invite_status in ('rescheduled', 'attended')"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_attended" type="object" string="Mark Attended"
                            class="btn-primary" invisible="invite_status != 'accepted'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_no_show" type="object" string="Mark No Show"
                            invisible="invite_status != 'accepted'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_appointable" type="object" string="Mark Appointable"
                            class="btn-primary"
                            invisible="outcome == 'appointable' or invite_status != 'attended'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_mark_not_appointable" type="object" string="Mark Not Appointable"
                            invisible="outcome == 'not_appointable' or invite_status != 'attended'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <field name="invite_status" widget="statusbar" statusbar_visible="invited,accepted,attended"
                           options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="application_id"/>
                            <field name="vacancy_id" readonly="1"/>
                            <field name="interview_datetime"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="panel_ids" widget="many2many_tags"/>
                            <field name="outcome" widget="radio" options="{'horizontal': true}"
                                   invisible="invite_status != 'attended'"/>
                            <field name="rank"/>
                            <field name="total_score" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scores">
                            <field name="person_spec_id" invisible="1"/>
                            <div class="alert alert-warning" role="alert" invisible="person_spec_id">
                                This vacancy has no Person Specification set — set one on the
                                vacancy before scoring this interview against it.
                            </div>
                            <field name="score_line_ids">
                                <list editable="bottom">
                                    <field name="panellist_id" domain="[('id', 'in', parent.panel_ids)]"/>
                                    <field name="criterion_id" options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('spec_id', '=', parent.person_spec_id)]"/>
                                    <field name="score"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view: filter to my panels, group interviews by vacancy or outcome -->
    <record id="view_nhs_interview_search" model="ir.ui.view">
        <field name="name">nhs.interview.search</field>
        <field name="model">nhs.interview</field>
        <field name="arch" type="xml">
            <search string="Interviews">
                <field name="application_id"/>
                <field name="vacancy_id"/>
                <field name="panel_ids"/>
                <filter string="My Panels" name="my_panels" domain="[('panel_ids', 'in', uid)]"/>
                <group>
                    <filter string="Vacancy" name="group_vacancy" context="{'group_by': 'vacancy_id'}"/>
                    <filter string="Outcome" name="group_outcome" context="{'group_by': 'outcome'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: Interviews menu entry -->
    <record id="action_nhs_interview" model="ir.actions.act_window">
        <field name="name">Interviews</field>
        <field name="res_model">nhs.interview</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nhs_interview_search"/>
    </record>
</odoo>
