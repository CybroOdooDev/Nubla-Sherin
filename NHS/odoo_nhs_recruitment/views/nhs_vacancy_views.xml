<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view: vacancies pipeline, decorated by state (open/in-progress/filled/closed) -->
    <record id="view_nhs_vacancy_list" model="ir.ui.view">
        <field name="name">nhs.vacancy.list</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <list string="Vacancies" decoration-muted="state in ('closed', 'withdrawn')"
                  decoration-info="state == 'open'" decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'filled'">
                <field name="reference"/>
                <field name="name"/>
                <field name="org_unit_id"/>
                <field name="band_id"/>
                <field name="hiring_manager_id"/>
                <field name="fte"/>
                <field name="state" widget="badge"/>
                <field name="days_open"/>
                <field name="application_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Kanban view: vacancy cards grouped by state, with applications/days-open badges -->
    <record id="view_nhs_vacancy_kanban" model="ir.ui.view">
        <field name="name">nhs.vacancy.kanban</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="days_open"/>
                <field name="application_count"/>
                <field name="hiring_manager_id"/>
                <field name="org_unit_id"/>
                <field name="fte"/>
                <field name="indicative_cost"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-sitemap me-1" title="Department"/> <field name="org_unit_id"/></div>
                                <div class="mt-1"><i class="fa fa-user me-1" title="Hiring Manager"/> <field name="hiring_manager_id"/></div>
                                <div class="mt-1 text-muted">
                                    <i class="fa fa-clock-o me-1" title="FTE"/> <field name="fte"/> FTE
                                </div>
                                
                                <div class="mt-2">
                                    <span class="badge text-bg-info me-1" title="Total Applications">
                                        <i class="fa fa-file-text-o"/> <field name="application_count"/> Apps
                                    </span>
                                    <span t-if="record.days_open.raw_value > 0" class="badge text-bg-warning" title="Days Open">
                                        <i class="fa fa-calendar"/> <field name="days_open"/> days
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form view: vacancy with approval workflow buttons and applications/interviews/offers stats -->
    <record id="view_nhs_vacancy_form" model="ir.ui.view">
        <field name="name">nhs.vacancy.form</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <form string="Vacancy">
                <header>
                    <!-- Viewer has read-only ACL on nhs.vacancy (hiring managers view/score
                         only) — every state-changing action below is officer+ so the
                         button is hidden rather than surfacing an Access Error. -->
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_workforce_approve" type="object" string="Workforce Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_manager"/>
                    <button name="action_finance_approve" type="object" string="Finance Approve"
                            class="btn-primary" invisible="state != 'workforce_approved'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_manager"/>
                    <button name="action_open" type="object" string="Open for Advertising"
                            class="btn-primary" invisible="state != 'finance_approved'"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="%(odoo_nhs_recruitment.action_nhs_shortlist_wizard)d" type="action" string="Bulk Shortlist"
                            class="btn-primary"
                            invisible="state not in ('open', 'in_progress') or application_count == 0"
                            context="{'default_vacancy_id': id}"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-primary" invisible="state not in ('open', 'in_progress', 'filled')"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <button name="action_withdraw" type="object" string="Withdraw"
                            class="btn-primary" invisible="state in ('filled', 'closed', 'withdrawn')"
                            confirm="Withdraw this vacancy?"
                            groups="odoo_nhs_recruitment.group_nhs_recruit_officer"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,workforce_approved,finance_approved,open,in_progress,filled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_applications" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="application_count" widget="statinfo" string="Applications"/>
                        </button>
                        <button name="action_view_interviews" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="interview_count" widget="statinfo" string="Interviews"/>
                        </button>
                        <button name="action_view_offers" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Post Details">
                            <field name="post_id"/>
                            <field name="post_fte_display"/>
                            <field name="org_unit_id" readonly="1"/>
                            <field name="band_id" readonly="1"/>
                            <field name="staff_group_id" readonly="1"/>
                            <field name="fte"/>
                        </group>
                        <group string="Recruitment Details">
                            <field name="contract_type"/>
                            <field name="reason"/>
                            <field name="hiring_manager_id"/>
                            <field name="person_spec_id"/>
                            <field name="check_profile_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="indicative_cost" widget="monetary"/>
                            <field name="withdrawn_reason" invisible="state != 'withdrawn'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Advert">
                            <group>
                                <group>
                                    <field name="advertising_channel_ids" widget="many2many_tags"/>
                                    <field name="internal_only"/>
                                </group>
                                <group>
                                    <field name="open_date"/>
                                    <field name="close_date"/>
                                    <field name="anonymised_shortlisting"/>
                                </group>
                            </group>
                            <separator string="Advert Text"/>
                            <field name="advert_text" nolabel="1" placeholder="Full advert content shown to candidates..."/>
                        </page>
                        <page string="Pipeline Analytics">
                            <group>
                                <field name="days_open"/>
                                <field name="filled_date"/>
                                <field name="time_to_hire"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view: filter vacancies by manager, approval status or open state -->
    <record id="view_nhs_vacancy_search" model="ir.ui.view">
        <field name="name">nhs.vacancy.search</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <search string="Vacancies">
                <field name="reference"/>
                <field name="name"/>
                <field name="org_unit_id"/>
                <field name="hiring_manager_id"/>
                <filter string="My Vacancies" name="my_vacancies"
                        domain="[('hiring_manager_id', '=', uid)]"/>
                <filter string="Awaiting Approval" name="awaiting_approval"
                        domain="[('state', 'in', ('submitted', 'workforce_approved'))]"/>
                <filter string="Open" name="open" domain="[('state', 'in', ('open', 'in_progress'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Team" name="group_org_unit" context="{'group_by': 'org_unit_id'}"/>
                    <filter string="Hiring Manager" name="group_manager" context="{'group_by': 'hiring_manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: Vacancies menu entry, defaulting to open vacancies -->
    <record id="action_nhs_vacancy" model="ir.actions.act_window">
        <field name="name">Vacancies</field>
        <field name="res_model">nhs.vacancy</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_vacancy_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- Window action: My Vacancies, filtered to the current hiring manager -->
    <record id="action_nhs_vacancy_my" model="ir.actions.act_window">
        <field name="name">My Vacancies</field>
        <field name="res_model">nhs.vacancy</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_nhs_vacancy_search"/>
        <field name="context">{'search_default_my_vacancies': 1}</field>
    </record>

    <!-- Window action: vacancies awaiting workforce or finance approval -->
    <record id="action_nhs_vacancy_approvals" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">nhs.vacancy</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('submitted', 'workforce_approved'))]</field>
        <field name="search_view_id" ref="view_nhs_vacancy_search"/>
    </record>
</odoo>
