<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vacancy analytics: ageing, time-to-hire, volumes by stage -->
    <record id="view_nhs_vacancy_graph" model="ir.ui.view">
        <field name="name">nhs.vacancy.graph</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <graph string="Vacancies" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- Pivot view: vacancies by org unit and state, measuring time-to-hire -->
    <record id="view_nhs_vacancy_pivot" model="ir.ui.view">
        <field name="name">nhs.vacancy.pivot</field>
        <field name="model">nhs.vacancy</field>
        <field name="arch" type="xml">
            <pivot string="Vacancies">
                <field name="org_unit_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- The visual KPI-card dashboard (client action) is the primary "Recruitment
         Dashboard" menu entry; this graph/pivot/list action is kept as the
         underlying "Vacancy Analytics" drill-down for power users. -->
    <record id="action_nhs_vacancy_analytics" model="ir.actions.act_window">
        <field name="name">Vacancy Analytics</field>
        <field name="res_model">nhs.vacancy</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <!-- Client action: opens the OWL KPI recruitment dashboard -->
    <record id="action_nhs_recruitment_dashboard_client" model="ir.actions.client">
        <field name="name">Recruitment Dashboard</field>
        <field name="tag">nhs_recruitment_dashboard</field>
    </record>

    <!-- Stage conversion / funnel -->
    <record id="view_nhs_application_pivot" model="ir.ui.view">
        <field name="name">nhs.application.pivot</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <pivot string="Stage Conversion">
                <field name="vacancy_id" type="row"/>
                <field name="stage" type="col"/>
                <field name="shortlist_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Bar graph: application counts by stage -->
    <record id="view_nhs_application_graph" model="ir.ui.view">
        <field name="name">nhs.application.graph</field>
        <field name="model">nhs.application</field>
        <field name="arch" type="xml">
            <graph string="Stage Conversion" type="bar">
                <field name="stage"/>
            </graph>
        </field>
    </record>

    <!-- Window action: time-to-hire / funnel analytics for applications -->
    <record id="action_nhs_time_to_hire" model="ir.actions.act_window">
        <field name="name">Time-to-Hire / Funnel</field>
        <field name="res_model">nhs.application</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- Pivot view: equality monitoring counts by ethnicity and sex, never per-record -->
    <record id="view_nhs_equality_monitoring_pivot" model="ir.ui.view">
        <field name="name">nhs.equality.monitoring.pivot</field>
        <field name="model">nhs.equality.monitoring</field>
        <field name="arch" type="xml">
            <pivot string="Equality Monitoring (Aggregate)">
                <field name="ethnicity" type="row"/>
                <field name="sex" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Bar graph: equality monitoring counts by ethnicity -->
    <record id="view_nhs_equality_monitoring_graph" model="ir.ui.view">
        <field name="name">nhs.equality.monitoring.graph</field>
        <field name="model">nhs.equality.monitoring</field>
        <field name="arch" type="xml">
            <graph string="Equality Monitoring (Aggregate)" type="bar">
                <field name="ethnicity"/>
            </graph>
        </field>
    </record>

    <!-- Equality monitoring (aggregate only): pivot/graph only, no list view,
         so no screen ever shows one row per identifiable applicant -->
    <record id="action_nhs_equality_monitoring" model="ir.actions.act_window">
        <field name="name">Equality Monitoring (Aggregate)</field>
        <field name="res_model">nhs.equality.monitoring</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>
