<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly Board Pack PDF (res.company): aggregates incident counts, open/overdue
         Duty of Candour compliance, active High/Extreme risks and overdue actions
         into a single quality & safety oversight report for the board. -->
    <record id="action_report_board_pack" model="ir.actions.report">
        <field name="name">Monthly Board Pack</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_incident_risk.report_board_pack</field>
        <field name="print_report_name">'Quality Safety Board Pack - ' + object.name</field>
        <field name="binding_model_id" ref="base.model_res_company"/>
    </record>

    <template id="report_board_pack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="company">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #000000; font-size: 13px;">
                        
                        <!-- Report Title -->
                        <div class="text-center mb-4">
                            <h2 style="font-weight: bold; margin-bottom: 5px;">Quality &amp; Safety Monthly Board Pack</h2>
                            <h4 style="color: #555555; font-weight: normal; margin-bottom: 0;" t-out="company.name"/>
                            <hr style="border-top: 1px solid #000000; margin-top: 15px;"/>
                        </div>

                        <!-- 1. Incident Summary -->
                        <h4 style="font-weight: bold; margin-top: 25px; margin-bottom: 10px; border-bottom: 1px solid #cccccc; padding-bottom: 3px;">
                            1. Incident Summary
                        </h4>
                        
                        <t t-set="total_incidents" t-value="company.env['nhs.incident'].search_count([('company_id','=',company.id),('state','!=','rejected')])"/>
                        <t t-set="open_incidents" t-value="company.env['nhs.incident'].search_count([('company_id','=',company.id),('state','not in',['closed','rejected','duplicate'])])"/>
                        <t t-set="severe_incidents" t-value="company.env['nhs.incident'].search_count([('company_id','=',company.id),('harm_grade','in',['severe','death'])])"/>
                        
                        <table class="table table-sm table-bordered" style="margin-bottom: 20px;">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th style="width: 80%;">Metric</th>
                                    <th style="width: 20%; text-align: center;">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 6px 8px;">Total Incidents (all time)</td>
                                    <td style="text-align: center; font-weight: bold; padding: 6px 8px;" t-out="total_incidents"/>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 8px;">Active / Open Incidents</td>
                                    <td style="text-align: center; font-weight: bold; padding: 6px 8px;" t-out="open_incidents"/>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 8px;">Severe / Fatal Harm Incidents</td>
                                    <td style="text-align: center; font-weight: bold; padding: 6px 8px;" t-out="severe_incidents"/>
                                </tr>
                            </tbody>
                        </table>


                        <!-- 2. Duty of Candour -->
                        <h4 style="font-weight: bold; margin-top: 25px; margin-bottom: 10px; border-bottom: 1px solid #cccccc; padding-bottom: 3px;">
                            2. Duty of Candour (CQC Reg 20)
                        </h4>
                        
                        <t t-set="open_doc" t-value="company.env['nhs.duty.of.candour'].search([('incident_id.company_id','=',company.id),('state','in',['open','overdue'])])"/>
                        
                        <t t-if="not open_doc">
                            <p style="font-style: italic; color: #555555;">There are currently no open or overdue Duty of Candour compliance records.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th>Incident</th>
                                        <th style="text-align: center;">Obligation Triggered</th>
                                        <th style="text-align: center;">Written Deadline</th>
                                        <th style="text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="open_doc" t-as="doc">
                                        <tr>
                                            <td t-out="doc.incident_id.name"/>
                                            <td style="text-align: center;" t-out="doc.triggered_at" t-options='{"widget": "date"}'/>
                                            <td style="text-align: center;" t-out="doc.written_deadline" t-options='{"widget": "date"}'/>
                                            <td style="text-align: center;">
                                                <t t-if="doc.state == 'overdue'">
                                                    <span style="color: #b91c1c; font-weight: bold; text-transform: uppercase;">Overdue</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="text-transform: uppercase;">Open</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- 3. Extreme & High Risks -->
                        <h4 style="font-weight: bold; margin-top: 25px; margin-bottom: 10px; border-bottom: 1px solid #cccccc; padding-bottom: 3px;">
                            3. Extreme &amp; High Active Risks
                        </h4>
                        
                        <t t-set="extreme_risks" t-value="company.env['nhs.risk'].search([('company_id','=',company.id),('state','=','active'),('current_band','in',['extreme','high'])])"/>
                        
                        <t t-if="not extreme_risks">
                            <p style="font-style: italic; color: #555555;">No active High or Extreme risks are currently registered on the Risk Register.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th style="width: 15%;">Reference</th>
                                        <th style="width: 50%;">Risk Description</th>
                                        <th style="width: 10%; text-align: center;">Rating</th>
                                        <th style="width: 10%; text-align: center;">Band</th>
                                        <th style="width: 15%;">Owner</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="extreme_risks" t-as="risk">
                                        <tr>
                                            <td style="font-weight: bold;" t-out="risk.name"/>
                                            <td t-out="risk.title"/>
                                            <td style="text-align: center;" t-out="risk.current_rating"/>
                                            <td style="text-align: center; text-transform: uppercase;">
                                                <t t-out="risk.current_band"/>
                                            </td>
                                            <td t-out="risk.risk_owner_id.name"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- 4. Overdue Actions -->
                        <h4 style="font-weight: bold; margin-top: 25px; margin-bottom: 10px; border-bottom: 1px solid #cccccc; padding-bottom: 3px;">
                            4. Overdue Corrective &amp; Preventative Actions
                        </h4>
                        
                        <t t-set="overdue_actions" t-value="company.env['nhs.action'].search([('company_id','=',company.id),('state','not in',['done','cancelled']),('due_date','&lt;',today_date)])"/>
                        
                        <t t-if="not overdue_actions">
                            <p style="font-style: italic; color: #555555;">All actions are currently on track. No overdue actions recorded.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th style="width: 55%;">Action Description</th>
                                        <th style="width: 20%;">Owner</th>
                                        <th style="width: 15%; text-align: center;">Due Date</th>
                                        <th style="width: 10%; text-align: center;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="overdue_actions" t-as="act">
                                        <tr>
                                            <td t-out="act.name"/>
                                            <td t-out="act.owner_id.name"/>
                                            <td style="text-align: center; color: #b91c1c; font-weight: bold;" t-out="act.due_date" t-options='{"widget": "date"}'/>
                                            <td style="text-align: center; color: #b91c1c; font-weight: bold; text-transform: uppercase;">Overdue</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>



</odoo>
