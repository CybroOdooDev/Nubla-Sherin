<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analysis/dashboard entry points (pivot, graph and list views) surfaced under
         the Reporting menu for incidents, risks, and open Duty of Candour clocks. -->

    <!-- ── Incident Analysis pivot -->
    <record id="action_nhs_incident_analysis" model="ir.actions.act_window">
        <field name="name">Incident Analysis</field>
        <field name="res_model">nhs.incident</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_open': False}</field>
    </record>

    <!-- ── Risk Analysis pivot -->
    <record id="action_nhs_risk_analysis" model="ir.actions.act_window">
        <field name="name">Risk Analysis</field>
        <field name="res_model">nhs.risk</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <!-- DoC open clocks -->
    <record id="action_nhs_doc_open" model="ir.actions.act_window">
        <field name="name">Open Duty of Candour Records</field>
        <field name="res_model">nhs.duty.of.candour</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['open', 'overdue'])]</field>
    </record>
</odoo>
