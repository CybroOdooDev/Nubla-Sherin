<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nhs_eric" model="ir.module.category">
        <field name="name">NHS ERIC Returns</field>
        <field name="description">Access levels for NHS ERIC Returns.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_nhs_eric_level" model="res.groups.privilege">
        <field name="name">NHS ERIC Returns Access Level</field>
        <field name="category_id" ref="module_category_nhs_eric"/>
        <field name="sequence">10</field>
    </record>

    <!-- Security Groups -->
    <record id="group_nhs_eric_user" model="res.groups">
        <field name="name">ERIC User</field>
        <field name="privilege_id" ref="privilege_nhs_eric_level"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_nhs_eric_officer" model="res.groups">
        <field name="name">ERIC Officer</field>
        <field name="privilege_id" ref="privilege_nhs_eric_level"/>
        <field name="implied_ids" eval="[(4, ref('group_nhs_eric_user'))]"/>
    </record>

    <record id="group_nhs_eric_manager" model="res.groups">
        <field name="name">ERIC Manager</field>
        <field name="privilege_id" ref="privilege_nhs_eric_level"/>
        <field name="implied_ids" eval="[(4, ref('group_nhs_eric_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_nhs_eric_return_company" model="ir.rule">
        <field name="name">ERIC Return: Company</field>
        <field name="model_id" ref="model_nhs_eric_return"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups"
               eval="[(4, ref('group_nhs_eric_user')), (4, ref('group_nhs_eric_officer')), (4, ref('group_nhs_eric_manager'))]"/>
    </record>

    <record id="rule_nhs_eric_value_company" model="ir.rule">
        <field name="name">ERIC Value: Company</field>
        <field name="model_id" ref="model_nhs_eric_value"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('return_id.company_id', 'in', company_ids)]</field>
        <field name="groups"
               eval="[(4, ref('group_nhs_eric_user')), (4, ref('group_nhs_eric_officer')), (4, ref('group_nhs_eric_manager'))]"/>
    </record>

    <record id="rule_nhs_eric_dataset_manager" model="ir.rule">
        <field name="name">ERIC Dataset: Manager Only</field>
        <field name="model_id" ref="model_nhs_eric_dataset"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_nhs_eric_manager'))]"/>
    </record>
</odoo>