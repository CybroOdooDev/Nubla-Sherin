        <record id="item_cost_rent" model="nhs.eric.item.def">
            <field name="name">Property Rent Costs</field>
            <field name="code">COST_RENT</field>
            <field name="section_id" ref="sec_financial_costs"/>
            <field name="sequence">10</field>
            <field name="data_type">currency</field>
            <field name="reporting_level">site</field>
            <field name="unit">£</field>
            <field name="source_type">manual</field>
            <field name="min_value">0.0</field>
            <field name="help_text">Annual rent expenditure paid for leased property.</field>
