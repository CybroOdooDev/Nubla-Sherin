<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View for Returns -->
    <record id="view_nhs_eric_return_list" model="ir.ui.view">
        <field name="name">nhs.eric.return.list</field>
        <field name="model">nhs.eric.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="dataset_id"/>
                <field name="state" widget="badge" decoration-success="state == 'finalised'"
                       decoration-info="state == 'validated'" decoration-warning="state == 'in_progress'"
                       decoration-primary="state == 'submitted'"/>
                <field name="completeness_pct"/>
                <field name="gap_count"/>
                <field name="validation_error_count"/>
                <field name="last_populated"/>
                <field name="finalised_at"/>
            </list>
        </field>
    </record>

    <!-- Form View for Returns -->
    <record id="view_nhs_eric_return_form" model="ir.ui.view">
        <field name="name">nhs.eric.return.form</field>
        <field name="model">nhs.eric.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_populate" string="Populate" type="object"
                            invisible="state in ['finalised','submitted']"/>
                    <button name="action_validate" string="Validate" type="object"
                            invisible="state in ['draft','finalised','submitted']"/>
                    <button name="action_finalise" string="Finalise" type="object" class="oe_highlight"
                            invisible="state in ['draft','in_progress','finalised','submitted']"/>
                    <button name="action_submit" string="Mark Submitted" type="object" class="oe_highlight"
                            invisible="state in ['draft','in_progress','validated','submitted']"/>
                    <button name="action_export_finalized_excel" string="Export Excel" type="object" class="oe_highlight"
                            invisible="state in ['draft','in_progress','validated','submitted']"/>
                    <button name="action_carry_forward" string="Carry Forward" type="object"
                            invisible="not prior_return_id or state in ['validated','finalised','submitted']"/>
                    <button name="action_view_gap_invalid_values" string="Manual Entry" type="object" class="oe_highlight"
                            invisible="state in ['finalised','submitted']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,validated,finalised,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_all_values" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="values_count" string="All Values" widget="statinfo"/>
                        </button>
                        <button name="action_view_gap_invalid_values" type="object" class="oe_stat_button"
                                icon="fa-list">
                            <field name="gap_invalid_count" string="Gap Report" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="dataset_id" readonly="state in ['finalised', 'submitted']"/>
                            <field name="year"/>
                            <field name="company_id" readonly="state in ['finalised', 'submitted']"/>
                            <field name="ods_code" readonly="state in ['finalised', 'submitted']"/>
                            <field name="prior_return_id" readonly="state in ['finalised', 'submitted']"/>
                        </group>
                        <group>
                            <field name="completeness_pct"/>
                            <field name="gap_count"/>
                            <field name="validation_error_count"/>
                            <field name="last_populated"/>
                            <field name="finalised_by_id"/>
                            <field name="finalised_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="state in ['finalised', 'submitted']"/>
                    </group>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids" readonly="state in ['finalised', 'submitted']">
                                <list editable="bottom" >
                                    <field name="section_id"  />
                                    <field name="site_id"  />
                                    <field name="item_def_id" />
                                    <field name="source_type"  />
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'populated'"
                                           decoration-warning="status == 'gap'"
                                           decoration-danger="status == 'invalid'"/>
                                    <field name="signed_off"/>
                                </list>
                            </field>
                        </page>
                        <page string="YoY Comparison" name="yoy_comparison" invisible="not prior_return_id">
                            <field name="comparison_line_ids" >
                                <list decoration-danger="highlight_color == 'red'"
                                      decoration-success="highlight_color == 'green'"
                                      decoration-warning="highlight_color == 'orange'" create="false" edit="false"
                                      delete="false">
                                    <field name="item_code"/>
                                    <field name="item_def_id"/>
                                    <field name="site_id" optional="show"/>
                                    <field name="prior_value_display" string="Last Year"/>
                                    <field name="current_value_display" string="This Year"/>
                                    <field name="percentage_change" string="Change %"/>
                                    <field name="change_flag" string="Trend"/>
                                    <field name="highlight_color" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Section Sign-off" name="section_sign_off">
                            <field name="section_line_ids" readonly="state in ['finalised', 'submitted']">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="section_id"  />
                                    <field name="owner_id"/>
                                    <field name="reviewer_id"/>
                                    <field name="state" readonly="1"/>
                                    <field name="signed_off_by_id" />
                                    <field name="signed_off_at" />
                                    <button name="action_submit_for_review" string="Submit for Review" type="object"
                                            class="oe_highlight"
                                            invisible="state != 'draft' and state != 'in_progress'"/>
                                    <button name="action_sign_off" string="Sign Off" type="object" class="oe_highlight"
                                            invisible="state != 'ready_for_review'"/>
                                    <button name="action_reopen" string="Reopen" type="object"
                                            invisible="state != 'signed_off' and state != 'ready_for_review'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nhs_eric_return_search" model="ir.ui.view">
        <field name="name">nhs.eric.return.search</field>
        <field name="model">nhs.eric.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="dataset_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="finalised" string="Finalised" domain="[('state', '=', 'finalised')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Organisation" domain="[]" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nhs_eric_return" model="ir.actions.act_window">
        <field name="name">ERIC Returns</field>
        <field name="res_model">nhs.eric.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_nhs_eric_current_return" model="ir.actions.act_window">
        <field name="name">Current Return</field>
        <field name="res_model">nhs.eric.return</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'not in', ['submitted'])]</field>
    </record>

    <!-- Trend Metric Views -->
    <record id="view_nhs_eric_trend_metric_list" model="ir.ui.view">
        <field name="name">nhs.eric.trend.metric.list</field>
        <field name="model">nhs.eric.trend.metric</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="gia"/>
                <field name="backlog"/>
                <field name="backlog_high" optional="hide"/>
                <field name="backlog_significant" optional="hide"/>
                <field name="backlog_moderate" optional="hide"/>
                <field name="backlog_low" optional="hide"/>
                <field name="compliance_pct"/>
                <field name="cost_per_m2"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_eric_trend_metric_graph" model="ir.ui.view">
        <field name="name">nhs.eric.trend.metric.graph</field>
        <field name="model">nhs.eric.trend.metric</field>
        <field name="arch" type="xml">
            <graph string="ERIC YoY Trends" type="line" sample="1">
                <field name="year" type="row"/>
                <field name="cost_per_m2" type="measure"/>
                <field name="compliance_pct" type="measure"/>
                <field name="backlog" type="measure"/>
                <field name="gia" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_nhs_eric_trend_metric_pivot" model="ir.ui.view">
        <field name="name">nhs.eric.trend.metric.pivot</field>
        <field name="model">nhs.eric.trend.metric</field>
        <field name="arch" type="xml">
            <pivot string="ERIC YoY Trends" sample="1">
                <field name="year" type="row"/>
                <field name="gia" type="measure"/>
                <field name="backlog" type="measure"/>
                <field name="backlog_high" type="measure"/>
                <field name="backlog_significant" type="measure"/>
                <field name="backlog_moderate" type="measure"/>
                <field name="backlog_low" type="measure"/>
                <field name="compliance_pct" type="measure"/>
                <field name="cost_per_m2" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_nhs_eric_year_on_year" model="ir.actions.act_window">
        <field name="name">Year-on-Year Trends</field>
        <field name="res_model">nhs.eric.trend.metric</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No trend data available
            </p>
            <p>
                Trend data will be automatically generated once ERIC returns are finalised.
            </p>
        </field>
    </record>

