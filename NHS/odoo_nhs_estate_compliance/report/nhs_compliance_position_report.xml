<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance Position Report - Action -->
    <record id="report_nhs_compliance_position" model="ir.actions.report">
        <field name="name">Compliance Position</field>
        <field name="model">nhs.compliance.item</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_estate_compliance.report_nhs_compliance_position_view</field>
        <field name="report_file">odoo_nhs_estate_compliance.report_nhs_compliance_position_view</field>
        <field name="binding_model_id" ref="model_nhs_compliance_item"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Compliance Position Report - Template -->
    <template id="report_nhs_compliance_position_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #333; line-height: 1.5;">
                        <!-- Title -->
                        <div class="row mb-4" style="border-bottom: 3px solid #005EB8; padding-bottom: 12px;">
                            <div class="col-8">
                                <h2 style="color: #005EB8; font-weight: bold; margin: 0;">Compliance Position Report</h2>
                                <div style="font-size: 1.1rem; margin-top: 4px;">
                                    <span style="font-weight: bold;" t-field="doc.reference"/>
                                    <t t-if="env.context.get('till_date')">
                                        (As of: <span style="font-weight: bold;" t-out="env.context.get('till_date')"/>)
                                    </t>
                                </div>
                            </div>
                            <div class="col-4 text-end">
                                <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 50px;" alt="Company Logo"/>
                            </div>
                        </div>

                        <!-- Item Details -->
                        <div class="row mb-4" style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 15px; margin: 0;">
                            <div class="col-6">
                                <div style="padding: 4px 0;"><strong>Reference:</strong> <span t-field="doc.reference"/></div>
                                <div style="padding: 4px 0;"><strong>Discipline:</strong> <span t-field="doc.discipline_id.name"/></div>
                                <div style="padding: 4px 0;"><strong>Type:</strong> <span t-field="doc.compliance_type_id.name"/></div>
                                <div style="padding: 4px 0;"><strong>Responsible Person:</strong> <span t-field="doc.responsible_person_id.name"/></div>
                                <div style="padding: 4px 0;"><strong>Criticality:</strong> <span style="text-transform: capitalize;" t-field="doc.criticality"/></div>
                            </div>
                            <div class="col-6">
                                <div style="padding: 4px 0;"><strong>Location:</strong> <span t-out="doc.building_id.name or doc.site_id.name or 'N/A'"/></div>
                                <div style="padding: 4px 0;"><strong>Last Completed:</strong> <span t-out="doc.last_completed_date or 'Never'"/></div>
                                <div style="padding: 4px 0;"><strong>Next Due:</strong> <span t-field="doc.next_due_date"/></div>
                                <div style="padding: 4px 0;">
                                    <strong>Status:</strong>
                                    <t t-if="doc.status == 'compliant'">
                                        <span style="background-color: #198754; color: white; padding: 2px 10px; border-radius: 4px;">Compliant</span>
                                    </t>
                                    <t t-elif="doc.status == 'failed'">
                                        <span style="background-color: #dc3545; color: white; padding: 2px 10px; border-radius: 4px;">Failed</span>
                                    </t>
                                    <t t-elif="doc.status == 'overdue'">
                                        <span style="background-color: #dc3545; color: white; padding: 2px 10px; border-radius: 4px;">Overdue</span>
                                    </t>
                                    <t t-elif="doc.status == 'due_soon'">
                                        <span style="background-color: #ffc107; color: black; padding: 2px 10px; border-radius: 4px;">Due Soon</span>
                                    </t>
                                    <t t-else="">
                                        <span style="background-color: #6c757d; color: white; padding: 2px 10px; border-radius: 4px;" t-out="doc.status.replace('_', ' ').title()"/>
                                    </t>
                                </div>
                                <div style="padding: 4px 0;"><strong>Open Remedials:</strong> <span t-field="doc.open_remedial_count"/></div>
                            </div>
                        </div>

                        <!-- Historical Tests -->
                        <div class="row">
                            <div class="col-12">
                                <h5 style="color: #005EB8; font-weight: bold; border-bottom: 2px solid #dee2e6; padding-bottom: 6px;">Historical Inspections / Tests</h5>
                                <t t-if="doc.test_ids.filtered(lambda t: t.active)">
                                    <table class="table table-sm" style="border: 1px solid #dee2e6; width: 100%; border-collapse: collapse;">
                                        <thead style="background-color: #005EB8; color: white;">
                                            <tr>
                                                <th style="padding: 8px; text-align: left;">Reference</th>
                                                <th style="padding: 8px; text-align: left;">Date</th>
                                                <th style="padding: 8px; text-align: left;">Performed By</th>
                                                <th style="padding: 8px; text-align: left;">Contractor</th>
                                                <th style="padding: 8px; text-align: center;">Outcome</th>
                                                <th style="padding: 8px; text-align: left;">Certificate</th>
                                                <th style="padding: 8px; text-align: left;">Expiry</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.test_ids.filtered(lambda t: t.active)" t-as="test">
                                                <tr style="border-bottom: 1px solid #dee2e6;">
                                                    <td style="padding: 8px;"><span t-field="test.name"/></td>
                                                    <td style="padding: 8px;"><span t-field="test.test_date"/></td>
                                                    <td style="padding: 8px;"><span t-field="test.performed_by_id.name"/></td>
                                                    <td style="padding: 8px;"><span t-field="test.contractor_id.name"/></td>
                                                    <td style="padding: 8px; text-align: center;">
                                                        <t t-if="test.outcome == 'pass'">
                                                            <span style="color: #198754;">Pass</span>
                                                        </t>
                                                        <t t-elif="test.outcome == 'pass_with_observations'">
                                                            <span style="color: #ffc107;">Pass (Obs)</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span style="color: #dc3545;" t-out="test.outcome.replace('_', ' ').title()"/>
                                                        </t>
                                                    </td>
                                                    <td style="padding: 8px;"><span t-field="test.certificate_ref"/></td>
                                                    <td style="padding: 8px;"><span t-field="test.certificate_expiry"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p style="color: #6c757d; font-style: italic;">No tests recorded for this compliance item.</p>
                                </t>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div style="margin-top: 20px; padding-top: 12px; border-top: 1px solid #dee2e6; font-size: 0.7rem; color: #6c757d; text-align: center;">
                            <p>Report generated on <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>