<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Compliance Item Sequence -->
        <record id="seq_nhs_compliance_item" model="ir.sequence">
            <field name="name">NHS Compliance Item</field>
            <field name="code">nhs.compliance.item</field>
            <field name="prefix">COMPL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Compliance Test Sequence -->
        <record id="seq_nhs_compliance_test" model="ir.sequence">
            <field name="name">NHS Compliance Test</field>
            <field name="code">nhs.compliance.test</field>
            <field name="prefix">TEST/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Contractor Visit Sequence -->
        <record id="seq_nhs_contractor_visit" model="ir.sequence">
            <field name="name">NHS Contractor Visit</field>
            <field name="code">nhs.contractor.visit</field>
            <field name="prefix">VISIT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>