<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Due Soon Item Reminder - Mail Template  -->
        <record id="mail_template_compliance_due_soon" model="mail.template">
            <field name="name">Compliance: Due Soon Reminder</field>
            <field name="model_id" ref="model_nhs_compliance_item"/>
            <field name="email_from">{{ (object.responsible_person_id.email_formatted or user.email_formatted or '')
                }}
            </field>
            <field name="email_to">{{ object.responsible_person_id.email or '' }}</field>
            <field name="subject">Compliance Item Due Soon: {{ object.reference }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>Dear <t t-out="object.responsible_person_id.name or ''">Responsible Person</t>,
                    </p>
                    <p>The following compliance item is due soon:</p>
                    <ul>
                        <li>
                            <strong>Reference:</strong>
                            <t t-out="object.reference or ''">REF</t>
                        </li>
                        <li>
                            <strong>Type:</strong>
                            <t t-out="object.compliance_type_id.name or ''">Type</t>
                        </li>
                        <li>
                            <strong>Discipline:</strong>
                            <t t-out="object.discipline_id.name or ''">Discipline</t>
                        </li>
                        <li>
                            <strong>Location:</strong>
                            <t t-out="object.building_id.name or object.site_id.name or ''">Location</t>
                        </li>
                        <li>
                            <strong>Next Due Date:</strong>
                            <t t-out="object.next_due_date or ''">Date</t>
                        </li>
                    </ul>
                    <p>Please ensure this test is completed before the due date.</p>
                    <p>Kind regards,<br/>Estates Compliance Team
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

