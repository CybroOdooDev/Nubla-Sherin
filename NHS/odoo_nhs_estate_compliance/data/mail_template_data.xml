        <!-- Item Escalation Alert - Mail Template  -->
        <record id="mail_template_compliance_escalation" model="mail.template">
            <field name="name">Compliance: Escalation Alert</field>
            <field name="model_id" ref="model_nhs_compliance_item"/>
            <field name="email_from">{{ (object.responsible_person_id.email_formatted or user.email_formatted or '')
                }}
            </field>
            <field name="email_to">{{ object.responsible_person_id.email or '' }}</field>
            <field name="subject">CRITICAL COMPLIANCE ESCALATION: {{ object.reference }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="color: red; font-size: 16px;">
                        <strong>CRITICAL: Compliance Escalation Notice</strong>
                    </p>
                    <p>The following compliance item remains unresolved and has exceeded the escalation threshold:</p>
                    <ul>
                        <li>
                            <strong>Reference:</strong>
                            <t t-out="object.reference or ''">REF</t>
                        </li>
                        <li>
                            <strong>Type:</strong>
                            <t t-out="object.compliance_type_id.name or ''">Type</t>
                        </li>
                        <li>
                            <strong>Discipline:</strong>
                            <t t-out="object.discipline_id.name or ''">Discipline</t>
                        </li>
                        <li>
                            <strong>Location:</strong>
                            <t t-out="object.building_id.name or object.site_id.name or ''">Location</t>
                        </li>
                        <li>
                            <strong>Next Due Date:</strong>
                            <t t-out="object.next_due_date or ''">Date</t>
                        </li>
                    </ul>
                    <p>Please take immediate corrective action.</p>
                    <p>Kind regards,<br/>Estates Compliance Team
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Duty Role Authorisation Expiring Remainder - Mail Template  -->
        <record id="mail_template_authorisation_expiry" model="mail.template">
            <field name="name">Compliance: Duty Role Authorisation Expiring</field>
            <field name="model_id" ref="model_nhs_duty_assignment"/>
            <field name="email_from">{{ (object.person_id.email_formatted or user.email_formatted or '') }}</field>
            <field name="email_to">{{ object.person_id.email or '' }}</field>
            <field name="subject">Duty Role Authorisation Expiring: {{ object.duty_role_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>Dear <t t-out="object.person_id.name or ''">User</t>,
                    </p>
                    <p>This is a reminder that your duty role authorisation for
                        <strong>
                            <t t-out="object.duty_role_id.name or ''">Duty Role</t>
                        </strong>
                        is expiring soon:
                    </p>
                    <ul>
                        <li>
                            <strong>Discipline:</strong>
                            <t t-out="object.discipline_id.name or 'Organisation-wide'">Discipline</t>
                        </li>
                        <li>
                            <strong>Expiry Date:</strong>
                            <t t-out="object.authorised_to or ''">Date</t>
                        </li>
                        <li>
                            <strong>Reference:</strong>
                            <t t-out="object.authorisation_ref or 'N/A'">Ref</t>
                        </li>
                    </ul>
                    <p>Please renew your competency/authorisation credentials to maintain compliance.</p>
                    <p>Kind regards,<br/>Estates Compliance Team
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

