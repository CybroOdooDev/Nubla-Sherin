<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category -->
    <record id="module_category_nhs_estate_compliance" model="ir.module.category">
        <field name="name">NHS Estates Compliance</field>
        <field name="description">Access levels for NHS Estates Compliance.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Privilege -->
    <record id="privilege_nhs_estate_compliance_level" model="res.groups.privilege">
        <field name="name">NHS Estate Compliance Access Level</field>
        <field name="category_id" ref="module_category_nhs_estate_compliance"/>
        <field name="sequence">10</field>
    </record>

    <!-- Groups -->
    <record id="group_nhs_compliance_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_nhs_estate_compliance_level"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_nhs_compliance_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_nhs_estate_compliance_level"/>
        <field name="implied_ids" eval="[(4, ref('group_nhs_compliance_user'))]"/>
    </record>

    <record id="group_nhs_compliance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_nhs_estate_compliance_level"/>
        <field name="implied_ids" eval="[(4, ref('group_nhs_compliance_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_nhs_compliance_company" model="ir.rule">
        <field name="name">Company Multi-Company</field>
        <field name="model_id" ref="model_nhs_compliance_item"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_nhs_compliance_company_type" model="ir.rule">
        <field name="name">Company Multi-Company - Types</field>
        <field name="model_id" ref="model_nhs_compliance_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_nhs_compliance_company_discipline" model="ir.rule">
        <field name="name">Company Multi-Company - Disciplines</field>
        <field name="model_id" ref="model_nhs_compliance_discipline"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_nhs_compliance_test_company" model="ir.rule">
        <field name="name">Company Multi-Company - Tests</field>
        <field name="model_id" ref="model_nhs_compliance_test"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('item_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>