<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance Register Excel Wizard Form View -->
    <record id="view_nhs_compliance_register_excel_wizard" model="ir.ui.view">
        <field name="name">nhs.compliance.register.excel.wizard.form</field>
        <field name="model">nhs.compliance.register.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Compliance Register to Excel">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="statutory_filter" widget="radio"/>
                    </group>
                    <footer>
                        <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Compliance Register Excel Wizard - Action -->
    <record id="action_nhs_compliance_register_excel_wizard" model="ir.actions.act_window">
        <field name="name">Export Compliance Register</field>
        <field name="res_model">nhs.compliance.register.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
