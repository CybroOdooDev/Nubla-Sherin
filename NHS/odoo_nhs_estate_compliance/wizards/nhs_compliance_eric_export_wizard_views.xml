<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance ERIC Export Wizard Form View -->
    <record id="view_nhs_compliance_eric_export_wizard" model="ir.ui.view">
        <field name="name">nhs.compliance.eric.export.wizard.form</field>
        <field name="model">nhs.compliance.eric.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="site_id" placeholder="All Sites"/>
                            <field name="discipline_id" placeholder="All Disciplines"/>
                            <field name="compliance_type_id" placeholder="All Compliance Types"
                                   invisible="not discipline_id"/>
                            <field name="statutory_filter" widget="radio"/>
                            <field name="data_gap_count" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="data_gap_count == 0">
                        <strong>Data Gap Warning:</strong> There are <field name="data_gap_count"/> building and discipline combination(s) with NO compliance items configured. Please review below.
                    </div>
                    <div class="mb-3">
                        <button name="action_preview" string="Preview Aggregation &amp; Data Gaps" type="object" class="btn-info"/>
                    </div>
                    <notebook invisible="not line_ids">
                        <page string="ERIC Aggregation &amp; Data Gaps Preview">
                            <field name="line_ids" readonly="1">
                                <list decoration-danger="is_data_gap == True" decoration-success="is_data_gap == False">
                                    <field name="site_id"/>
                                    <field name="building_id"/>
                                    <field name="discipline_id"/>
                                    <field name="total_items"/>
                                    <field name="compliant_items"/>
                                    <field name="overdue_items"/>
                                    <field name="compliance_rate"/>
                                    <field name="is_data_gap"/>
                                    <field name="data_gap_warning"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Compliance ERIC Export Wizard - Action -->
    <record id="action_nhs_compliance_eric_export_wizard" model="ir.actions.act_window">
        <field name="name">ERIC Compliance Export</field>
        <field name="res_model">nhs.compliance.eric.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>