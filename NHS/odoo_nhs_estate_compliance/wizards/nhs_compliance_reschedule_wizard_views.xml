<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compliance Reschedule Wizard Form View -->
    <record id="view_nhs_compliance_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">nhs.compliance.reschedule.wizard.form</field>
        <field name="model">nhs.compliance.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Reschedule Compliance Items">
                <group>
                    <field name="new_due_date"/>
                    <field name="reason" placeholder="Enter reason for rescheduling..."/>
                </group>
                <footer>
                    <button name="action_apply" string="Reschedule" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Compliance Reschedule Wizard - Action -->
    <record id="action_nhs_compliance_reschedule_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Reschedule</field>
        <field name="res_model">nhs.compliance.reschedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nhs_compliance_item"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
