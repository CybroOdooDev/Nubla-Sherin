<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Discipline  List View -->
    <record id="view_nhs_compliance_discipline_tree" model="ir.ui.view">
        <field name="name">nhs.compliance.discipline.tree</field>
        <field name="model">nhs.compliance.discipline</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="htm_reference"/>
                <field name="legislation_reference"/>
                <field name="active"/>
                <field name="item_count" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Discipline  Form View -->
    <record id="view_nhs_compliance_discipline_form" model="ir.ui.view">
        <field name="name">nhs.compliance.discipline.form</field>
        <field name="model">nhs.compliance.discipline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_compliance_item" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                        <button name="action_view_contractors" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="contractor_count" widget="statinfo" string="Contractors"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="htm_reference"/>
                            <field name="legislation_reference"/>
                            <field name="lead_days"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page name="types" string="Compliance Types">
                            <field name="type_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Discipline  Search View -->
    <record id="view_nhs_compliance_discipline_search" model="ir.ui.view">
        <field name="name">nhs.compliance.discipline.search</field>
        <field name="model">nhs.compliance.discipline</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="htm_reference"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Discipline  Action -->
    <record id="action_nhs_compliance_discipline" model="ir.actions.act_window">
        <field name="name">Disciplines</field>
        <field name="res_model">nhs.compliance.discipline</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create compliance disciplines to organise your statutory testing.
            </p>
        </field>
    </record>
</odoo>