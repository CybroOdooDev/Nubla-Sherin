<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Duty Roles List View -->
    <record id="view_nhs_duty_role_tree" model="ir.ui.view">
        <field name="name">nhs.duty.role.tree</field>
        <field name="model">nhs.duty.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="requires_authorisation"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Duty Roles Form View -->
    <record id="view_nhs_duty_role_form" model="ir.ui.view">
        <field name="name">nhs.duty.role.form</field>
        <field name="model">nhs.duty.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="requires_authorisation"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Duty Assignment List View -->
    <record id="view_nhs_duty_assignment_tree" model="ir.ui.view">
        <field name="name">nhs.duty.assignment.tree</field>
        <field name="model">nhs.duty.assignment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_expired==True">
                <field name="person_id"/>
                <field name="duty_role_id"/>
                <field name="discipline_id"/>
                <field name="site_id"/>
                <field name="building_id"/>
                <field name="authorised_from"/>
                <field name="authorised_to"/>
                <field name="is_expired" widget="boolean"/>
                <field name="safety_group"/>
                <field name="authorisation_ref"/>
            </list>
        </field>
    </record>

    <!-- Duty Assignment Form View -->
    <record id="view_nhs_duty_assignment_form" model="ir.ui.view">
        <field name="name">nhs.duty.assignment.form</field>
        <field name="model">nhs.duty.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file">
                            <span class="o_stat_text">Documents</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="person_id"/>
                            <field name="duty_role_id"/>
                            <field name="discipline_id"/>
                            <field name="safety_group"/>
                            <field name="is_expired"/>
                        </group>
                        <group>
                            <field name="site_id"/>
                            <field name="building_id"/>
                            <field name="authorised_from"/>
                            <field name="authorised_to"/>
                            <field name="authorisation_ref"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Competency Evidence">
                            <group>
                                <field name="competency_evidence_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Duty Assignment Search View -->
    <record id="view_nhs_duty_assignment_search" model="ir.ui.view">
        <field name="name">nhs.duty.assignment.search</field>
        <field name="model">nhs.duty.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="person_id"/>
                <field name="duty_role_id"/>
                <field name="discipline_id"/>
                <filter name="expired" string="Expired" domain="[('is_expired', '=', True)]"/>
                <filter name="valid" string="Valid" domain="[('is_expired', '=', False)]"/>
                <separator/>
                <filter name="expiring_soon" string="Authorisation Expiring Soon"
                        domain="[('authorised_to', '!=', False), ('authorised_to', '&gt;=', context_today()), ('authorised_to', '&lt;=', context_today() + relativedelta(days=30))]"/>
            </search>
        </field>
    </record>

    <!-- Duty Roles Action -->
    <record id="action_nhs_duty_role" model="ir.actions.act_window">
        <field name="name">Duty Roles</field>
        <field name="res_model">nhs.duty.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Duty Assignments Action -->
    <record id="action_nhs_duty_assignment" model="ir.actions.act_window">
        <field name="name">Duty Assignments</field>
        <field name="res_model">nhs.duty.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>