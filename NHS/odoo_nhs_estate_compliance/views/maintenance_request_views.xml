<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Request Form View - Inherited -->
    <record id="hr_equipment_request_view_form_inherit_compliance" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.compliance</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="compliance_item_id" invisible="not compliance_item_id" />
            </xpath>
        </field>
    </record>

    <!-- Maintenance Request List View - Inherited -->
    <record id="hr_equipment_request_view_tree_inherit_compliance" model="ir.ui.view">
        <field name="name">maintenance.request.list.inherit.compliance</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="compliance_item_id" readonly="1" invisible="not compliance_item_id" />
            </xpath>
        </field>
    </record>
</odoo>
