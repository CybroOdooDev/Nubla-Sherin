<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Equipment Form View - Inherited -->
    <record id="hr_equipment_view_form_inherit_compliance" model="ir.ui.view">
        <field name="name">maintenance.form.inherit.compliance</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_compliance_item"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-circle">
                    <field name="compliance_item_count" widget="statinfo" string="Compliance Items"/>
                </button>
            </div>
        </field>
    </record>
</odoo>