<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_job_plan_session_category_list for ir.ui.view -->
    <record id="view_nhs_job_plan_session_category_list" model="ir.ui.view">
        <field name="name">nhs.job.plan.session.category.list</field>
        <field name="model">nhs.job.plan.session.category</field>
        <field name="arch" type="xml">
            <list string="Session Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_classification"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Record: action_nhs_job_plan_session_category for ir.actions.act_window -->
    <record id="action_nhs_job_plan_session_category" model="ir.actions.act_window">
        <field name="name">Session Categories</field>
        <field name="res_model">nhs.job.plan.session.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
