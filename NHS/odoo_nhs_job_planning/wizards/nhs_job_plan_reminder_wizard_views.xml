<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record: view_nhs_job_plan_reminder_wizard_form for ir.ui.view -->
    <record id="view_nhs_job_plan_reminder_wizard_form" model="ir.ui.view">
        <field name="name">nhs.job.plan.reminder.wizard.form</field>
        <field name="model">nhs.job.plan.reminder.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Job Plan Reminders">
                <group>
                    <field name="target"/>
                    <field name="plan_year_id"/>
                </group>
                <field name="preview_plan_ids" readonly="1">
                    <list>
                        <field name="reference"/>
                        <field name="doctor_name"/>
                        <field name="post_id"/>
                        <field name="plan_year_id"/>
                        <field name="state" widget="badge"/>
                        <field name="review_due_date"/>
                    </list>
                </field>
                <footer>
                    <button name="action_send_reminders" type="object" string="Send Reminders" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Record: action_nhs_job_plan_reminder_wizard for ir.actions.act_window -->
    <record id="action_nhs_job_plan_reminder_wizard" model="ir.actions.act_window">
        <field name="name">Send Reminders</field>
        <field name="res_model">nhs.job.plan.reminder.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
