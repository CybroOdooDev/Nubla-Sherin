<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record: ir_cron_jobplan_remind_due for ir.cron -->
        <record id="ir_cron_jobplan_remind_due" model="ir.cron">
            <field name="name">NHS Job Planning: Remind Plans Due / Stalled</field>
            <field name="model_id" ref="model_nhs_job_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_plans_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Record: ir_cron_jobplan_auto_create_next_year for ir.cron -->
        <record id="ir_cron_jobplan_auto_create_next_year" model="ir.cron">
            <field name="name">NHS Job Planning: Auto-Create Next Plan Year</field>
            <field name="model_id" ref="model_nhs_plan_year"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_create_next_year()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
