<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Building Passport Report Action -->
    <record id="action_report_building_passport" model="ir.actions.report">
        <field name="name">Building Passport</field>
        <field name="model">nhs.estate.building</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_estate.report_building_passport</field>
        <field name="report_file">odoo_nhs_estate.report_building_passport</field>
        <field name="binding_model_id" ref="model_nhs_estate_building"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Building Passport Report Template -->
    <template id="report_building_passport">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page"
                         style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #212529; font-size: 12px; line-height: 1.5;">
                        <div style="border-bottom: 3px solid #005EB8; padding-bottom: 10px; margin-bottom: 20px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td>
                                        <h2 style="color: #005EB8; margin: 0; font-weight: bold; font-size: 32px;">NHS
                                            Building Passport
                                        </h2>
                                        <h4 style="color: #4c6272; margin: 6px 0 0 0; font-weight: normal; font-size: 30px;">
                                            <span t-field="doc.name"/>
                                            <t t-if="doc.code">(<span t-field="doc.code"/>)
                                            </t>
                                        </h4>
                                    </td>
                                    <td style="text-align: right; vertical-align: bottom; color: #6c757d; font-size: 15px;">
                                        <strong>Date:</strong>
                                        <span t-esc="time.strftime('%d/%m/%Y %H:%M')"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- 1. Building Overview -->
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                1. Building Overview
                            </h5>
                            <table class="table table-sm table-bordered"
                                   style="width: 100%; margin-bottom: 0; border-collapse: collapse;">
                                <tbody>
                                    <tr>
                                        <th style="width: 15%; padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Building Name
                                        </th>
                                        <td style="width: 35%; padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.name"/>
                                        </td>
                                        <th style="width: 15%; padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Site
                                        </th>
                                        <td style="width: 35%; padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.site_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Building Code
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.code"/>
                                        </td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Status
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.operational_status"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Build Year
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.build_year"/>
                                            <t t-if="doc.age_years">(
                                                <span t-field="doc.age_years"/>
                                                years)
                                            </t>
                                        </td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Storeys
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.storeys"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Function
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.function_id.name"/>
                                        </td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Tenure Type
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.tenure_type"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Construction
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.construction_type"/>
                                        </td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Listed Building
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <t t-if="doc.is_listed">Yes</t>
                                            <t t-else="">No</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Last Refurbished
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.last_refurb_date"/>
                                        </td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">
                                            Condition Grade
                                        </th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.latest_condition_grade"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- 2. Key Performance Indicators -->
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                2. Key Performance Indicators
                            </h5>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 0;">
                                <tr>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">
                                            Floors
                                        </div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;">
                                            <span t-field="doc.floor_count"/>
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">
                                            Spaces / Rooms
                                        </div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;">
                                            <span t-field="doc.space_count"/>
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">
                                            Total GIA
                                        </div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;">
                                            <span t-field="doc.gia"/>
                                            m²
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">
                                            Total Backlog
                                        </div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;">
                                            <span t-field="doc.backlog_total"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Clinical Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;">
                                            <span t-field="doc.clinical_area"/>
                                            m²
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Non-Clinical Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;">
                                            <span t-field="doc.non_clinical_area"/>
                                            m²
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Occupied Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;">
                                            <span t-field="doc.occupied_area"/>
                                            m²
                                        </div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Vacant Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;">
                                            <span t-field="doc.vacant_area"/>
                                            m²
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-bottom: 22px;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                3. Floor Register
                            </h5>
                            <t t-if="doc.floor_ids">
                                <table class="table table-sm table-bordered"
                                       style="width: 100%; margin-bottom: 0; font-size: 15px; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background-color: #005EB8;">
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8; color: white;">
                                                Floor Name
                                            </th>
                                            <th style="padding: 10px 8px; text-align: center; font-size: 15px; border: 1px solid #005EB8; color: white;">
                                                Order
                                            </th>
                                            <th style="padding: 10px 8px; text-align: center; font-size: 15px; border: 1px solid #005EB8; color: white;">
                                                Spaces
                                            </th>
                                            <th style="padding: 10px 8px; text-align: right; font-size: 15px; border: 1px solid #005EB8; color: white;">
                                                GIA (m²)
                                            </th>
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8; color: white;">
                                                Predominant Function
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.floor_ids" t-as="f" style="page-break-inside: avoid;">
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <strong>
                                                    <span t-field="f.name"/>
                                                </strong>
                                            </td>
                                            <td style="padding: 8px 8px; text-align: center; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <span t-field="f.sequence"/>
                                            </td>
                                            <td style="padding: 8px 8px; text-align: center; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <span t-field="f.space_count"/>
                                            </td>
                                            <td style="padding: 8px 8px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <span t-field="f.gia"/>
                                            </td>
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <span t-field="f.function_id.name"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p style="color: #6c757d; font-style: italic; font-size: 12px;">No floors registered for
                                    this building.
                                </p>
                            </t>
                        </div>
                        <t t-set="b_backlogs" t-value="doc.backlog_ids"/>
                        <t t-set="bl_high"
                           t-value="sum(b_backlogs.filtered(lambda bl: bl.risk_category == 'high').mapped('cost_estimate'))"/>
                        <t t-set="bl_sig"
                           t-value="sum(b_backlogs.filtered(lambda bl: bl.risk_category == 'significant').mapped('cost_estimate'))"/>
                        <t t-set="bl_mod"
                           t-value="sum(b_backlogs.filtered(lambda bl: bl.risk_category == 'moderate').mapped('cost_estimate'))"/>
                        <t t-set="bl_low"
                           t-value="sum(b_backlogs.filtered(lambda bl: bl.risk_category == 'low').mapped('cost_estimate'))"/>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                4. Backlog Summary
                            </h5>
                            <table class="table table-sm table-bordered"
                                   style="width: 60%; margin-bottom: 0; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #f0f4f8;">
                                        <th style="padding: 10px 12px; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">
                                            Backlog Risk Level
                                        </th>
                                        <th style="padding: 10px 12px; text-align: right; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">
                                            Estimated Cost
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <strong>High Risk</strong>
                                        </td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <span t-esc="bl_high"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <strong>Significant Risk</strong>
                                        </td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <span t-esc="bl_sig"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <strong>Moderate Risk</strong>
                                        </td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <span t-esc="bl_mod"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <strong>Low Risk</strong>
                                        </td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;">
                                            <span t-esc="bl_low"
                                                  t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #f0f4f8; font-weight: bold;">
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px; color: #005EB8;">
                                            Total Backlog
                                        </td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px; color: #005EB8;">
                                            <span t-field="doc.backlog_total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <t t-if="doc.image">
                            <div style="margin-bottom: 22px; page-break-inside: avoid;">
                                <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                    5. Building Photos
                                </h5>
                                <div class="row">
                                    <t t-foreach="doc.image[:4]" t-as="img">
                                        <t t-if="img.datas">
                                            <div class="col-3 text-center mb-2">
                                                <img t-att-src="image_data_uri(img.datas)"
                                                     style="max-height: 120px; max-width: 100%; border: 1px solid #d0dbe5; border-radius: 4px; padding: 2px;"
                                                     alt="Building Photo"/>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Footer -->
                        <div style="margin-top: 30px; padding-top: 10px; border-top: 1px solid #d0dbe5; text-align: center; color: #6c757d; font-size: 14px;">
                            NHS Estate Register — Generated:
                            <span t-esc="time.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>