<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estate Register Report Action -->
    <record id="action_report_estate_register" model="ir.actions.report">
        <field name="name">Estate Register</field>
        <field name="model">nhs.estate.site</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_estate.report_estate_register</field>
        <field name="report_file">odoo_nhs_estate.report_estate_register</field>
        <field name="binding_model_id" ref="model_nhs_estate_site"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Estate Register Report Template -->
    <template id="report_estate_register">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #212529; font-size: 12px; line-height: 1.5;">
                        <div style="border-bottom: 3px solid #005EB8; padding-bottom: 10px; margin-bottom: 20px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td>
                                        <h2 style="color: #005EB8; margin: 0; font-weight: bold; font-size: 32px;">NHS Estate Register</h2>
                                        <h4 style="color: #4c6272; margin: 6px 0 0 0; font-weight: normal; font-size: 30px;">
                                            <span t-field="doc.name"/> <t t-if="doc.code">(<span t-field="doc.code"/>)</t>
                                        </h4>
                                    </td>
                                    <td style="text-align: right; vertical-align: bottom; color: #6c757d; font-size: 15px;">
                                        <strong>Date:</strong> <span t-esc="time.strftime('%d/%m/%Y %H:%M')"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                1. Site Overview
                            </h5>
                            <table class="table table-sm table-bordered" style="width: 100%; margin-bottom: 0; border-collapse: collapse;">
                                <tbody>
                                    <tr>
                                        <th style="width: 15%; padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Site Name</th>
                                        <td style="width: 35%; padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.name"/></td>
                                        <th style="width: 15%; padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Street</th>
                                        <td style="width: 35%; padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <span t-field="doc.street"/>
                                            <t t-if="doc.street2">, <span t-field="doc.street2"/></t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Site Code</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.code"/></td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">City / ZIP</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <t t-if="doc.city"><span t-field="doc.city"/></t>
                                            <t t-if="doc.zip"> <span t-field="doc.zip"/></t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Site Type</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.site_type"/></td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Country</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.country_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Status</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.operational_status"/></td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Acquired Date</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.acquired_date"/></td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Parent Site</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.parent_id.name"/></td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Land Area</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <t t-if="doc.land_area_ha"><span t-field="doc.land_area_ha"/> ha</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Owner Org</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.owner_org"/></td>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Car Parking</th>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;">
                                            <t t-if="doc.car_parking_spaces"><span t-field="doc.car_parking_spaces"/> spaces</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="padding: 10px 12px; background-color: #f0f4f8; font-weight: bold; font-size: 15px; border: 1px solid #d0dbe5;">Site Contact</th>
                                        <td colspan="3" style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 15px;"><span t-field="doc.manager_id.name"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                2. Key Performance Indicators
                            </h5>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 0;">
                                <tr>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">Buildings</div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;"><span t-field="doc.building_count"/></div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">Spaces / Rooms</div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;"><span t-field="doc.space_count"/></div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">Total GIA</div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;"><span t-field="doc.total_gia"/> m²</div>
                                    </td>
                                    <td style="width: 25%; background: #f0f4f8; border: 1px solid #d0dbe5; padding: 12px 10px; text-align: center;">
                                        <div style="font-size: 13px; text-transform: uppercase; color: #4c6272; font-weight: bold;">Total Backlog</div>
                                        <div style="font-size: 18px; font-weight: bold; color: #005EB8; margin-top: 4px;"><span t-field="doc.total_backlog"/></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Clinical Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;"><span t-field="doc.site_clinical_area"/> m²</div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Non-Clinical Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;"><span t-field="doc.site_non_clinical_area"/> m²</div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Occupied Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;"><span t-field="doc.site_occupied_area"/> m²</div>
                                    </td>
                                    <td style="width: 25%; background: #f8fafc; border: 1px solid #d0dbe5; padding: 10px 10px; text-align: center;">
                                        <div style="font-size: 13px; color: #6c757d;">Vacant Area</div>
                                        <div style="font-size: 18px; font-weight: bold; margin-top: 2px;"><span t-field="doc.site_vacant_area"/> m²</div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-bottom: 22px;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                3. Building Register
                            </h5>
                            <t t-if="doc.building_ids">
                                <table class="table table-sm table-bordered" style="width: 100%; margin-bottom: 0; font-size: 15px; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background-color: #005EB8;">
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8;color: white;">Building Name</th>
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8;color: white;">Code</th>
                                            <th style="padding: 10px 8px; text-align: center; font-size: 15px; border: 1px solid #005EB8;color: white;">Year</th>
                                            <th style="padding: 10px 8px; text-align: center; font-size: 15px; border: 1px solid #005EB8;color: white;">Floor / Space</th>
                                            <th style="padding: 10px 8px; text-align: right; font-size: 15px; border: 1px solid #005EB8;color: white;">GIA (m²)</th>
                                            <th style="padding: 10px 8px; text-align: right; font-size: 15px; border: 1px solid #005EB8;color: white;">NIA (m²)</th>
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8;color: white;">Function</th>
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8;color: white;">Tenure</th>
                                            <th style="padding: 10px 8px; text-align: center; font-size: 15px; border: 1px solid #005EB8;color: white;">Grade</th>
                                            <th style="padding: 10px 8px; text-align: right; font-size: 15px; border: 1px solid #005EB8;color: white;">Backlog</th>
                                            <th style="padding: 10px 8px; font-size: 15px; border: 1px solid #005EB8;color: white;">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.building_ids" t-as="b" style="page-break-inside: avoid;">
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;"><strong><span t-field="b.name"/></strong></td>
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.code"/></td>
                                            <td style="padding: 8px 8px; text-align: center; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.build_year"/></td>
                                            <td style="padding: 8px 8px; text-align: center; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.floor_count"/> / <span t-field="b.space_count"/></td>
                                            <td style="padding: 8px 8px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.gia"/></td>
                                            <td style="padding: 8px 8px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.nia"/></td>
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.function_id.name"/></td>
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.tenure_type"/></td>
                                            <td style="padding: 8px 8px; text-align: center; border: 1px solid #d0dbe5; font-size: 14px;">
                                                <span t-field="b.latest_condition_grade"/>
                                            </td>
                                            <td style="padding: 8px 8px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.backlog_total"/></td>
                                            <td style="padding: 8px 8px; border: 1px solid #d0dbe5; font-size: 14px;"><span t-field="b.operational_status"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p style="color: #6c757d; font-style: italic; font-size: 12px;">No buildings registered for this site.</p>
                            </t>
                        </div>
                        <t t-set="grade_a_count" t-value="len(doc.building_ids.filtered(lambda b: b.latest_condition_grade == 'A'))"/>
                        <t t-set="grade_b_count" t-value="len(doc.building_ids.filtered(lambda b: b.latest_condition_grade == 'B'))"/>
                        <t t-set="grade_c_count" t-value="len(doc.building_ids.filtered(lambda b: b.latest_condition_grade == 'C'))"/>
                        <t t-set="grade_d_count" t-value="len(doc.building_ids.filtered(lambda b: b.latest_condition_grade == 'D'))"/>
                        <t t-set="grade_none_count" t-value="len(doc.building_ids.filtered(lambda b: not b.latest_condition_grade))"/>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                4. Condition Summary
                            </h5>
                            <table class="table table-sm table-bordered" style="width: 60%; margin-bottom: 0; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #f0f4f8;">
                                        <th style="padding: 10px 12px; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Condition Grade</th>
                                        <th style="padding: 10px 12px; text-align: right; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Building Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Grade A</strong> — Excellent</td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="grade_a_count"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Grade B</strong> — Good</td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="grade_b_count"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Grade C</strong> — Fair</td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="grade_c_count"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Grade D</strong> — Poor</td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="grade_d_count"/></td>
                                    </tr>
                                    <t t-if="grade_none_count &gt; 0">
                                        <tr>
                                            <td style="padding: 10px 12px; border: 1px solid #d0dbe5; color: #6c757d; font-size: 14px;"><em>Unassessed</em></td>
                                            <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; color: #6c757d; font-size: 14px;"><span t-esc="grade_none_count"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <t t-set="site_backlogs" t-value="doc.building_ids.mapped('backlog_ids')"/>
                        <t t-set="bl_high" t-value="sum(site_backlogs.filtered(lambda bl: bl.risk_category == 'high').mapped('cost_estimate'))"/>
                        <t t-set="bl_sig" t-value="sum(site_backlogs.filtered(lambda bl: bl.risk_category == 'significant').mapped('cost_estimate'))"/>
                        <t t-set="bl_mod" t-value="sum(site_backlogs.filtered(lambda bl: bl.risk_category == 'moderate').mapped('cost_estimate'))"/>
                        <t t-set="bl_low" t-value="sum(site_backlogs.filtered(lambda bl: bl.risk_category == 'low').mapped('cost_estimate'))"/>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                5. Backlog Summary
                            </h5>
                            <table class="table table-sm table-bordered" style="width: 60%; margin-bottom: 0; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #f0f4f8;">
                                        <th style="padding: 10px 12px; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Backlog Risk Level</th>
                                        <th style="padding: 10px 12px; text-align: right; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Estimated Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>High Risk</strong></td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="bl_high" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Significant Risk</strong></td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="bl_sig" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Moderate Risk</strong></td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="bl_mod" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;"><strong>Low Risk</strong></td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="bl_low" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                    <tr style="background-color: #f0f4f8; font-weight: bold;">
                                        <td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px; color: #005EB8;">Total Backlog</td>
                                        <td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px; color: #005EB8;"><span t-field="doc.total_backlog"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <t t-set="t_freehold" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'freehold'))"/>
                        <t t-set="t_leasehold" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'leasehold'))"/>
                        <t t-set="t_pfi" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'pfi'))"/>
                        <t t-set="t_lift" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'lift'))"/>
                        <t t-set="t_nhsps" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'nhsps'))"/>
                        <t t-set="t_chp" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'chp'))"/>
                        <t t-set="t_licence" t-value="len(doc.building_ids.filtered(lambda b: b.tenure_type == 'licence'))"/>
                        <t t-set="t_unspecified" t-value="len(doc.building_ids.filtered(lambda b: not b.tenure_type))"/>
                        <div style="margin-bottom: 22px; page-break-inside: avoid;">
                            <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                6. Tenure Summary
                            </h5>
                            <table class="table table-sm table-bordered" style="width: 60%; margin-bottom: 0; border-collapse: collapse;">
                                <thead>
                                    <tr style="background-color: #f0f4f8;">
                                        <th style="padding: 10px 12px; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Tenure Type</th>
                                        <th style="padding: 10px 12px; text-align: right; font-size: 15px; font-weight: bold; border: 1px solid #d0dbe5; color: #005EB8;">Buildings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="t_freehold &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">Freehold</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_freehold"/></td></tr>
                                    </t>
                                    <t t-if="t_leasehold &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">Leasehold</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_leasehold"/></td></tr>
                                    </t>
                                    <t t-if="t_pfi &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">PFI</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_pfi"/></td></tr>
                                    </t>
                                    <t t-if="t_lift &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">LIFT</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_lift"/></td></tr>
                                    </t>
                                    <t t-if="t_nhsps &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">NHSPS</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_nhsps"/></td></tr>
                                    </t>
                                    <t t-if="t_chp &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">CHP</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_chp"/></td></tr>
                                    </t>
                                    <t t-if="t_licence &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; font-size: 14px;">Licence</td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; font-size: 14px;"><span t-esc="t_licence"/></td></tr>
                                    </t>
                                    <t t-if="t_unspecified &gt; 0">
                                        <tr><td style="padding: 10px 12px; border: 1px solid #d0dbe5; color: #6c757d; font-size: 14px;"><em>Unspecified</em></td><td style="padding: 10px 12px; text-align: right; border: 1px solid #d0dbe5; color: #6c757d; font-size: 14px;"><span t-esc="t_unspecified"/></td></tr>
                                    </t>
                                    <t t-if="t_freehold + t_leasehold + t_pfi + t_lift + t_nhsps + t_chp + t_licence + t_unspecified == 0">
                                        <tr><td colspan="2" style="padding: 10px 12px; border: 1px solid #d0dbe5; color: #6c757d; font-style: italic; font-size: 12px;">No tenure data available</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <t t-if="doc.image">
                            <div style="margin-bottom: 22px; page-break-inside: avoid;">
                                <h5 style="color: #005EB8; border-bottom: 2px solid #005EB8; padding-bottom: 4px; margin-bottom: 12px; font-weight: bold; font-size: 18px;">
                                    7. Site Photos
                                </h5>
                                <div class="row">
                                    <t t-foreach="doc.image[:4]" t-as="img">
                                        <t t-if="img.datas">
                                            <div class="col-3 text-center mb-2">
                                                <img t-att-src="image_data_uri(img.datas)" style="max-height: 120px; max-width: 100%; border: 1px solid #d0dbe5; border-radius: 4px; padding: 2px;" alt="Site Photo"/>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <div style="margin-top: 30px; padding-top: 10px; border-top: 1px solid #d0dbe5; text-align: center; color: #6c757d; font-size: 14px;">
                            NHS Estate Register — Generated: <span t-esc="time.strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>