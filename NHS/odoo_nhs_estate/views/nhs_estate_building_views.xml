<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Building List View -->
    <record id="view_nhs_estate_building_list" model="ir.ui.view">
        <field name="name">nhs.estate.building.list</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <list string="Buildings" multi_edit="1" decoration-danger="latest_condition_grade=='D'"
                  decoration-warning="latest_condition_grade=='C'"
                  decoration-success="latest_condition_grade=='A'">
                <field name="name"/>
                <field name="code"/>
                <field name="site_id"/>
                <field name="gia" sum="Total Gross Internal Area"/>
                <field name="tenure_type" widget="badge"/>
                <field name="latest_condition_grade" widget="badge"/>
                <field name="backlog_total" sum="Total Backlog"/>
                <field name="floor_count"/>
                <field name="operational_status" widget="badge"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Building Form View -->
    <record id="view_nhs_estate_building_form" model="ir.ui.view">
        <field name="name">nhs.estate.building.form</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <header>
                    <button name="action_operational" type="object" string="Operational" class="oe_highlight"
                            invisible="operational_status in ['operational','closed','disposed']"/>
                    <button name="action_partial_operational" type="object" string="Partially Operational"
                            class="oe_highlight"
                            invisible="operational_status in ['partial','closed','disposed']"/>
                    <button name="action_closed" type="object" string="Closed" class="oe_highlight"
                            invisible="operational_status in ['closed','disposed']"/>
                    <button name="action_disposed" type="object" string="Disposed" class="oe_highlight"
                            invisible="operational_status in ['disposed']"/>
                    <field name="operational_status" widget="statusbar"
                           statusbar_visible="operational,partial,closed,disposed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="LISTED BUILDING"
                            bg_color="text-bg-success"
                            invisible="not is_listed">
                        <i class="fa fa-star"/>
                    </widget>
                    <widget name="web_ribbon"
                            title="CLOSED"
                            bg_color="text-bg-danger"
                            invisible="operational_status != 'closed'">
                        <i class="fa fa-exclamation-triangle"/>
                    </widget>
                    <widget name="web_ribbon"
                            title="DISPOSED"
                            bg_color="text-bg-danger"
                            invisible="operational_status != 'disposed'">
                        <i class="fa fa-exclamation-triangle"/>
                    </widget>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_floors" type="object"
                                class="oe_stat_button" icon="fa-building">
                            <field name="floor_count" widget="statinfo" string="Floors"/>
                        </button>
                        <button name="action_view_spaces_from_building" type="object"
                                class="oe_stat_button" icon="fa-building">
                            <field name="space_count" widget="statinfo" string="Spaces"/>
                        </button>
                        <button name="action_view_conditions" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="condition_count" widget="statinfo" string="Condition Survey"/>
                        </button>
                        <button name="action_view_backlog" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="backlog_count" widget="statinfo" string="Backlogs"/>
                        </button>
                        <button name="action_view_tenure" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <span class="o_stat_text">Tenure</span>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file">
                            <span class="o_stat_text">Documents</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Building Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="code" placeholder="Building Reference..."/>
                        <field name="site_id" placeholder="Site..."/>
                    </group>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="storeys"/>
                            <field name="construction_type"/>
                        </group>
                        <group>
                            <field name="last_refurb_date"/>
                            <field name="latest_condition_grade" widget="badge"
                                   decoration-danger="latest_condition_grade=='D'"
                                   decoration-warning="latest_condition_grade=='C'"
                                   decoration-success="latest_condition_grade=='A'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General">
                            <group>
                                <field name="build_year"/>
                                <field name="age_years" />
                                <field name="function_id"/>
                                <field name="is_listed"/>
                            </group>
                            <group string="Space Details">
                                <group>
                                    <field name="clinical_area"/>
                                    <field name="non_clinical_area"/>
                                    <field name="occupied_area"/>
                                    <field name="vacant_area"/>
                                </group>
                                <group>
                                    <field name="gia"/>
                                    <field name="nia"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tenure" invisible="id == 0">
                            <group>
                                <field name="tenure_id" context="{'default_building_id': id}" readonly="operational_status in ['closed', 'disposed']"/>
                                <field name="tenure_type" readonly="1"/>
                            </group>
                        </page>
                        <page string="Floors" invisible="id == 0">
                            <field name="floor_ids" readonly="operational_status in ['closed', 'disposed']"/>
                        </page>
                        <page string="Condition Surveys" invisible="id == 0">
                            <field name="condition_ids" readonly="operational_status in ['closed', 'disposed']"/>
                        </page>
                        <page string="Backlog" invisible="id == 0">
                            <field name="backlog_ids" readonly="operational_status in ['closed', 'disposed']"/>
                        </page>
                        <page string="Photos &amp; Plans">
                            <field name="image" widget="many2many_binary" help="Building Photo and Floor Plan"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Building Kanban View -->
    <record id="view_nhs_estate_building_kanban" model="ir.ui.view">
        <field name="name">nhs.estate.building.kanban</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <kanban default_group_by="operational_status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="site_id"/>
                <field name="operational_status"/>
                <field name="gia"/>
                <field name="latest_condition_grade"/>
                <field name="backlog_total"/>
                <field name="floor_count"/>
                <field name="tenure_type"/>
                <field name="is_listed"/>
                <field name="build_year"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="oe_kanban_details d-flex flex-column justify-content-between h-100">
                                <div>
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <div class="text-muted">
                                                <field name="code"/>
                                                -
                                                <field name="site_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body mt-2">
                                        <div class="d-flex justify-content-between mb-2 flex-wrap gap-1">
                                            <span t-if="record.is_listed.value" class="badge text-bg-primary">
                                                <i class="fa fa-university mr-1"/>
                                                Listed
                                            </span>
                                            <span class="badge"
                                                  t-attf-class="badge #{record.operational_status.raw_value == 'operational' ? 'text-bg-success' : record.operational_status.raw_value == 'partial' ? 'text-bg-warning' : record.operational_status.raw_value == 'closed' ? 'text-bg-danger' : 'text-bg-secondary'}">
                                                <field name="operational_status"/>
                                            </span>
                                            <span t-if="record.latest_condition_grade.raw_value == 'A'"
                                                  class="badge text-bg-success">
                                                <i class="fa fa-check mr-1"/>
                                                <field name="latest_condition_grade"/>
                                            </span>
                                            <span t-elif="record.latest_condition_grade.raw_value == 'B'"
                                                  class="badge text-bg-info">
                                                <i class="fa fa-thumbs-up mr-1"/>
                                                <field name="latest_condition_grade"/>
                                            </span>
                                            <span t-elif="record.latest_condition_grade.raw_value == 'C'"
                                                  class="badge text-bg-warning">
                                                <i class="fa fa-exclamation mr-1"/>
                                                <field name="latest_condition_grade"/>
                                            </span>
                                            <span t-elif="record.latest_condition_grade.raw_value == 'D'"
                                                  class="badge text-bg-danger">
                                                <i class="fa fa-times mr-1"/>
                                                <field name="latest_condition_grade"/>
                                            </span>
                                            <span t-else="" class="badge text-bg-secondary">
                                                <field name="latest_condition_grade"/>
                                            </span>
                                        </div>
                                        <div class="mt-2 text-muted">
                                            <i class="fa fa-arrows-alt mr-1"/>
                                            <field name="gia"/>
                                            m²
                                        </div>
                                        <div class="mt-1 text-muted">
                                            <i class="fa fa-layer-group mr-1"/>
                                            <field name="floor_count"/>
                                            Floors
                                        </div>
                                        <div class="mt-1 text-muted">
                                            <i class="fa fa-calendar mr-1"/>
                                            <span t-if="record.build_year.raw_value">
                                                <field name="build_year"/>
                                            </span>
                                            <span t-else="">Year N/A</span>
                                        </div>
                                        <div class="mt-1 text-muted">
                                            <i class="fa fa-file-text-o mr-1"/>
                                            <field name="tenure_type"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-3 d-flex justify-content-between align-items-center"
                                     style="border-top: 1px solid #f3f4f6; padding-top: 8px;">
                                    <span class="badge" style="background-color: #f3f4f6; color: #6b7280;">
                                        <i class="fa fa-money mr-1"/>
                                        <field name="backlog_total"/>
                                    </span>
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Building Search View -->
    <record id="view_nhs_estate_building_search" model="ir.ui.view">
        <field name="name">nhs.estate.building.search</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="site_id"/>
                <field name="operational_status"/>
                <field name="latest_condition_grade"/>
                <filter name="group_by_latest_condition_grade"
                        string="Condition Grade"
                        context="{'group_by': 'latest_condition_grade'}"/>
                <filter name="group_by_site"
                        string="Site"
                        context="{'group_by': 'site_id'}"/>
                <filter name="group_by_status"
                        string="Status"
                        context="{'group_by': 'operational_status'}"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Building Pivot View -->
    <record id="view_nhs_estate_building_pivot" model="ir.ui.view">
        <field name="name">nhs.estate.building.pivot</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <pivot string="Building Analysis">
                <field name="site_id" type="row"/>
                <field name="function_id" type="col"/>
                <field name="gia" type="measure" operator="sum"/>
                <field name="backlog_total" type="measure" operator="sum"/>
                <field name="floor_count" type="measure" operator="sum"/>
            </pivot>
        </field>
    </record>

    <!-- Building Graph View -->
    <record id="view_nhs_estate_building_graph" model="ir.ui.view">
        <field name="name">nhs.estate.building.graph</field>
        <field name="model">nhs.estate.building</field>
        <field name="arch" type="xml">
            <graph string="Building Analysis" type="bar">
                <field name="site_id" type="row"/>
                <field name="gia" type="measure" operator="sum"/>
                <field name="backlog_total" type="measure" operator="sum"/>
            </graph>
        </field>
    </record>

    <!-- Building Action -->
    <record id="action_nhs_estate_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">nhs.estate.building</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first building
            </p>
            <p>
                Buildings are the second level of the estate hierarchy.
                Each building belongs to a site and contains floors.
            </p>
        </field>
    </record>
</odoo>