<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Site Sequence Generation -->
        <record id="seq_nhs_estate_site" model="ir.sequence">
            <field name="name">NHS Estate Site</field>
            <field name="code">nhs.estate.site</field>
            <field name="prefix">SITE/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Building Sequence Generation -->
        <record id="seq_nhs_estate_building" model="ir.sequence">
            <field name="name">NHS Estate Building</field>
            <field name="code">nhs.estate.building</field>
            <field name="prefix">BLD/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Space Sequence Generation -->
        <record id="seq_nhs_estate_space" model="ir.sequence">
            <field name="name">NHS Estate Space</field>
            <field name="code">nhs.estate.space</field>
            <field name="prefix">SPC/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Condition Survey Sequence Generation -->
        <record id="seq_nhs_estate_condition" model="ir.sequence">
            <field name="name">NHS Estate Condition Survey</field>
            <field name="code">nhs.estate.condition</field>
            <field name="prefix">COND/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>