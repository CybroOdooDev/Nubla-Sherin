<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Survey Reminders - Creates activities 15-30 days before due -->
        <record id="cron_survey_reminders" model="ir.cron">
            <field name="name">Survey Due Reminders</field>
            <field name="model_id" ref="model_nhs_estate_condition"/>
            <field name="code">model.cron_create_survey_reminders()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Overdue Survey Check - Creates urgent activities for overdue surveys -->
        <record id="cron_overdue_surveys" model="ir.cron">
            <field name="name">Overdue Survey Check</field>
            <field name="model_id" ref="model_nhs_estate_condition"/>
            <field name="code">model.cron_check_overdue_surveys()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>