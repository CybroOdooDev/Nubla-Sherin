<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Break Clause Reminders - Runs Daily -->
        <record id="cron_break_clause_reminders" model="ir.cron">
            <field name="name">Break Clause Reminders</field>
            <field name="model_id" ref="model_nhs_estate_tenure"/>
            <field name="code">model.cron_create_break_clause_reminders()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Rent Review Reminders - Runs Daily -->
        <record id="cron_rent_review_reminders" model="ir.cron">
            <field name="name">Rent Review Reminders</field>
            <field name="model_id" ref="model_nhs_estate_tenure"/>
            <field name="code">model.cron_create_rent_review_reminders()</field>
            <field name="state">code</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>