<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hourly check that flags/notifies overdue or due-today acknowledgement deadlines -->
    <record id="cron_complaint_ack_deadline" model="ir.cron">
        <field name="name">NHS Complaints: Acknowledgement Deadline Check</field>
        <field name="model_id" ref="model_nhs_complaint"/>
        <field name="state">code</field>
        <field name="code">model._cron_ack_deadline()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Daily check that reminds handlers of upcoming or overdue response deadlines -->
    <record id="cron_complaint_response_deadline" model="ir.cron">
        <field name="name">NHS Complaints: Response Deadline Reminders</field>
        <field name="model_id" ref="model_nhs_complaint"/>
        <field name="state">code</field>
        <field name="code">model._cron_response_deadline()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Weekly check that schedules follow-up activities on open PHSO escalations -->
    <record id="cron_complaint_phso_followup" model="ir.cron">
        <field name="name">NHS Complaints: PHSO Follow-up Check</field>
        <field name="model_id" ref="model_nhs_complaint_phso"/>
        <field name="state">code</field>
        <field name="code">model._cron_phso_followup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>

    <!-- Monthly job (disabled by default) that anonymises complainant data on old closed complaints -->
    <record id="cron_complaint_anonymise" model="ir.cron">
        <field name="name">NHS Complaints: Complainant Data Anonymisation (disabled)</field>
        <field name="model_id" ref="model_nhs_complaint"/>
        <field name="state">code</field>
        <field name="code">model._cron_anonymise_closed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">False</field>
    </record>
</odoo>
