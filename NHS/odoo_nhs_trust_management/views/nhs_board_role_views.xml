<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nhs_board_role_list" model="ir.ui.view">
        <field name="name">nhs.board.role.list</field>
        <field name="model">nhs.board.role</field>
        <field name="arch" type="xml">
            <list string="Board Roles">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_ned"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_board_role_form" model="ir.ui.view">
        <field name="name">nhs.board.role.form</field>
        <field name="model">nhs.board.role</field>
        <field name="arch" type="xml">
            <form string="Board Role">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Chair"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_ned"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Guidance shown to administrators when choosing this role..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_nhs_board_role" model="ir.actions.act_window">
        <field name="name">Board Roles</field>
        <field name="res_model">nhs.board.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Rename a Board Role label or toggle whether it counts as a Non-Executive Director.
            </p>
        </field>
    </record>

    <menuitem id="menu_settings_nhs_board_role"
              name="Board Roles"
              parent="base.menu_users"
              action="action_nhs_board_role"
              sequence="25"
              groups="odoo_nhs_trust_management.group_nhs_trust_admin"/>
</odoo>
