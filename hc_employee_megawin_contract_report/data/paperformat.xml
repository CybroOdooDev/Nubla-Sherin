<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="paperformat_megawin_contract_report" model="report.paperformat">
            <field name="name">Megawin Contract Paperformat</field>
            <field name="format">A4</field>

            <field name="page_height">0</field>
            <field name="page_width">0</field>
