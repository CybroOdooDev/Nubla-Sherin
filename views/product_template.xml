<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view_rental" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.rental.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Rental Checkbox in Options -->
            <xpath expr="//div[@name='options']" position="inside">
                <field name="is_rental"/>
                <label for="is_rental"/>
            </xpath>

            <!-- Rental Page -->
            <xpath expr="//notebook" position="inside">
                <page string="Rental">
                    <group>
                        <field name="is_security_required"/>
                    </group>

                    <group>
                        <field name="rental_tenure_ids"
                               context="{'default_product_tmpl_id': id}">
                            <list>
                                <field name="name"/>
                                <field name="uom_id"/>
                                <field name="range_start"/>
                                <field name="range_end"/>
                                <field name="amount"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>