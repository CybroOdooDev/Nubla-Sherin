<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view of member report model.-->
    <record id="member_report_view_form" model="ir.ui.view">
        <field name="name">member.report.view.form</field>
        <field name="model">member.report</field>
        <field name="arch" type="xml">
            <form string="Member Report">
                <group string="Report Filters">
                    <group>
                        <field name="membership_type_id"/>
                    </group>
                    <group>
                        <field name="is_block_status"/>
                    </group>
                </group>
                <footer>
                    <button name="get_report" string="Print PDF Report"
                            type="object" class="oe_highlight"/>
                    <button name="get_xlsx_report" string="Print XLSX Report"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!--    Window action  of member report model.-->
    <record id="member_report_action" model="ir.actions.act_window">
        <field name="name">Member Report</field>
        <field name="res_model">member.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="member_report_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
