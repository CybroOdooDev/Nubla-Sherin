<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Graph View with error handling -->
    <record id="view_library_fine_graph" model="ir.ui.view">
        <field name="name">library.fine.graph</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <graph string="Library Fines Analysis" type="bar">
                <field name="fine_date" type="row" interval="month"/>
                <field name="adjusted_amount" type="measure"/>
                <field name="original_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Alternative Line Chart -->
    <record id="view_library_fine_graph_line" model="ir.ui.view">
        <field name="name">library.fine.graph.line</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <graph string="Fine Trends" type="line">
                <field name="fine_date" type="row" interval="week"/>
                <field name="adjusted_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_library_fine_pivot" model="ir.ui.view">
        <field name="name">library.fine.pivot</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <pivot string="Fines Analysis Report">
                <field name="member_id" type="row"/>
                <field name="fine_date" type="col" interval="month"/>
                <field name="state" type="col"/>
                <field name="adjusted_amount" type="measure"/>
                <field name="original_amount" type="measure"/>
                <field name="waived_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- List View -->
    <record id="view_library_fine_list" model="ir.ui.view">
        <field name="name">library.fine.list</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <list string="Library Fines" decoration-info="state=='draft'"
                  decoration-warning="state=='confirmed'" decoration-success="state=='paid'">
                <field name="member_id"/>
                <field name="book_register_id"/>
                <field name="fine_date"/>
                <field name="original_amount"/>
                <field name="waived_amount"/>
                <field name="adjusted_amount"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_fine_form" model="ir.ui.view">
        <field name="name">library.fine.form</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <form string="Library Fine">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="book_register_id"/>
                            <field name="rule_id"/>
                            <field name="fine_date"/>
                        </group>
                        <group>
                            <field name="original_amount" widget="monetary"/>
                            <field name="waived_amount" widget="monetary"/>
                            <field name="adjusted_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Additional remarks..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_fine_report" model="ir.actions.act_window">
        <field name="name">Library Fines Report</field>
        <field name="res_model">library.fine</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{
            'search_default_this_month': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fines recorded yet!
            </p>
            <p>
                Library fines will appear here when members have overdue books or other violations.
            </p>
        </field>
    </record>

    <!-- Regular Action -->
    <record id="action_library_fine" model="ir.actions.act_window">
        <field name="name">Library Fines</field>
        <field name="res_model">library.fine</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first library fine!
            </p>
            <p>
                Track and manage library fines for overdue books and other violations.
            </p>
        </field>
    </record>
</odoo>