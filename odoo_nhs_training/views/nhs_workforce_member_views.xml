<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_workforce_member_list" model="ir.ui.view">
        <field name="name">nhs.workforce.member.list</field>
        <field name="model">nhs.workforce.member</field>
        <field name="arch" type="xml">
            <list decoration-success="compliance_status=='compliant'"
                  decoration-warning="compliance_status=='at_risk'"
                  decoration-danger="compliance_status=='non_compliant'">
                <field name="reference"/>
                <field name="name"/>
                <field name="email" widget="email"/>
                <field name="org_unit_id"/>
                <field name="post_id"/>
                <field name="staff_group_id"/>
                <field name="compliance_pct" string="Compliance %"/>
                <field name="expired_subject_count" string="Expired"/>
                <field name="compliance_status" widget="badge"/>
                <field name="is_leaver"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_workforce_member_kanban" model="ir.ui.view">
        <field name="name">nhs.workforce.member.kanban</field>
        <field name="model">nhs.workforce.member</field>
        <field name="arch" type="xml">
            <kanban default_group_by="compliance_status" records_draggable="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="reference"/>
                <field name="compliance_pct"/>
                <field name="compliance_status"/>
                <field name="org_unit_id"/>
                <field name="post_id"/>
                <field name="expired_subject_count"/>
                <field name="email"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click p-3 rounded shadow-sm border-start border-4 #{
                            record.compliance_status.raw_value == 'compliant' ? 'border-success' :
                            record.compliance_status.raw_value == 'at_risk' ? 'border-warning' :
                            'border-danger'
                        }">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge text-bg-light border fw-semibold">
                                    <field name="reference"/>
                                </span>
                                <span t-attf-class="badge #{
                                    record.compliance_status.raw_value == 'compliant' ? 'text-bg-success text-success-light' :
                                    record.compliance_status.raw_value == 'at_risk' ? 'text-bg-warning text-warning-light' :
                                    'text-bg-danger text-danger-light'
                                } px-2 py-1 small fw-bold">
                                    <field name="compliance_status"/>
                                </span>
                            </div>
                            
                            <h4 class="text-primary fw-bold mb-1 fs-5">
                                <field name="name"/>
                            </h4>
                            
                            <div class="text-muted small mb-2">
                                <span t-if="record.post_id.raw_value">
                                    <field name="post_id"/>
                                </span>
                                <span t-if="record.post_id.raw_value">
                                    <span t-if="record.org_unit_id.raw_value"> — </span>
                                </span>
                                <span t-if="record.org_unit_id.raw_value">
                                    <field name="org_unit_id"/>
                                </span>
                            </div>
                            
                            <div t-if="record.email.raw_value" class="text-muted small mb-2">
                                <i class="fa fa-envelope-o me-1"/> <field name="email"/>
                            </div>
                            
                            <hr class="my-2 opacity-25"/>
                            
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="o_row">
                                    <span class="text-muted small">Compliance: </span>
                                    <span t-attf-class="fw-bold #{
                                        record.compliance_status.raw_value == 'compliant' ? 'text-success' :
                                        record.compliance_status.raw_value == 'at_risk' ? 'text-warning' :
                                        'text-danger'
                                    }"><field name="compliance_pct"/>%</span>
                                </div>
                                <span t-if="record.expired_subject_count.raw_value"
                                      class="badge text-bg-danger px-2 py-1 small fw-bold">
                                    <field name="expired_subject_count"/> expired
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_nhs_workforce_member_form" model="ir.ui.view">
        <field name="name">nhs.workforce.member.form</field>
        <field name="model">nhs.workforce.member</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_record_training" type="object" string="Record Training"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="record_count" widget="statinfo" string="Records"/>
                        </button>
                        <button name="action_view_registrations" type="object"
                                class="oe_stat_button" icon="fa-id-card">
                            <field name="registration_count" widget="statinfo" string="Registrations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Leaver" bg_color="text-bg-warning" invisible="not is_leaver"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <span class="o_form_label">Reference</span>
                        <h2>
                            <field name="reference" readonly="1"/>
                        </h2>
                        <h1>
                            <field name="name" placeholder="Member name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="post_id" options="{'no_create': True}"/>
                            <field name="org_unit_id" options="{'no_create': True}"/>
                            <field name="staff_group_id" options="{'no_create': True}"/>
                            <field name="requirement_profile_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="compliance_pct" widget="progressbar"/>
                            <field name="compliance_status" widget="badge"/>
                            <field name="required_subject_count"/>
                            <field name="expired_subject_count"/>
                            <field name="failed_subject_count"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="is_leaver"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="user_id" invisible="1"/>
                            <field name="employee_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="required_status" string="Required &amp; Status">
                            <field name="compliance_line_ids" readonly="1">
                                <list decoration-success="status=='compliant'"
                                      decoration-warning="status=='due_soon'"
                                      decoration-info="status=='exempt'"
                                      decoration-muted="status=='not_done'"
                                      decoration-danger="status in ('expired', 'failed')"
                                      create="0" delete="0" edit="0">
                                    <field name="subject_id"/>
                                    <field name="status" widget="badge"/>
                                    <field name="expiry_date"/>
                                </list>
                            </field>
                        </page>
                        <page name="records" string="Training Records">
                            <field name="record_ids">
                                <list decoration-success="status=='compliant'"
                                      decoration-warning="status=='due_soon'"
                                      decoration-danger="status=='expired'">
                                    <field name="subject_id"/>
                                    <field name="completion_date"/>
                                    <field name="method"/>
                                    <field name="expiry_date"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="registrations" string="Registrations">
                            <field name="registration_ids">
                                <list decoration-success="status=='current'"
                                      decoration-warning="status=='expiring_soon'"
                                      decoration-danger="status=='lapsed'">
                                    <field name="regulator_id"/>
                                    <field name="registration_number"/>
                                    <field name="expiry_date"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="overrides" string="Individual Overrides">
                            <field name="requirement_line_ids">
                                <list editable="bottom">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="override_type"/>
                                    <field name="exemption_reason"/>
                                    <field name="exemption_review_date"/>
                                    <field name="effective_from"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="active" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nhs_workforce_member_search" model="ir.ui.view">
        <field name="name">nhs.workforce.member.search</field>
        <field name="model">nhs.workforce.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="org_unit_id"/>
                <field name="post_id"/>
                <field name="staff_group_id"/>
                <filter name="compliant" string="Compliant" domain="[('compliance_status', '=', 'compliant')]"/>
                <filter name="at_risk" string="At Risk" domain="[('compliance_status', '=', 'at_risk')]"/>
                <filter name="non_compliant" string="Non-Compliant" domain="[('compliance_status', '=', 'non_compliant')]"/>
                <separator/>
                <filter name="leavers" string="Leavers" domain="[('is_leaver', '=', True)]"/>
                <filter name="exclude_leavers" string="Exclude Leavers" domain="[('is_leaver', '=', False)]"/>
                <group>
                    <filter name="group_org_unit" string="Team" context="{'group_by': 'org_unit_id'}"/>
                    <filter name="group_staff_group" string="Staff Group" context="{'group_by': 'staff_group_id'}"/>
                    <filter name="group_status" string="Compliance Status" context="{'group_by': 'compliance_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nhs_workforce_member" model="ir.actions.act_window">
        <field name="name">Workforce Members</field>
        <field name="res_model">nhs.workforce.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_exclude_leavers': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a workforce member to start tracking their training compliance.
            </p>
        </field>
    </record>

    <record id="view_nhs_workforce_member_pivot" model="ir.ui.view">
        <field name="name">nhs.workforce.member.pivot</field>
        <field name="model">nhs.workforce.member</field>
        <field name="arch" type="xml">
            <pivot string="Compliance by Staff Group">
                <field name="staff_group_id" type="row"/>
                <field name="compliance_status" type="col"/>
                <field name="compliance_pct" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_nhs_training_by_staff_group" model="ir.actions.act_window">
        <field name="name">By Staff Group</field>
        <field name="res_model">nhs.workforce.member</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('is_leaver', '=', False)]</field>
        <field name="context">{'search_default_group_staff_group': 1}</field>
    </record>
</odoo>
