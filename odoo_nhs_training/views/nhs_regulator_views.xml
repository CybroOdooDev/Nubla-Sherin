<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_regulator_list" model="ir.ui.view">
        <field name="name">nhs.regulator.list</field>
        <field name="model">nhs.regulator</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_cycle_months"/>
                <field name="registration_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_regulator" model="ir.actions.act_window">
        <field name="name">Regulators</field>
        <field name="res_model">nhs.regulator</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
