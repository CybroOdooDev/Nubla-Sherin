<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_registration_list" model="ir.ui.view">
        <field name="name">nhs.registration.list</field>
        <field name="model">nhs.registration</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='current'"
                  decoration-warning="status=='expiring_soon'"
                  decoration-danger="status=='lapsed'">
                <field name="member_id"/>
                <field name="regulator_id"/>
                <field name="registration_number" groups="odoo_nhs_training.group_nhs_training_officer"/>
                <field name="expiry_date"/>
                <field name="revalidation_date"/>
                <field name="status" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_registration_form" model="ir.ui.view">
        <field name="name">nhs.registration.form</field>
        <field name="model">nhs.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="current,expiring_soon,lapsed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id" options="{'no_create': True}"/>
                            <field name="regulator_id" options="{'no_create': True}"/>
                            <field name="registration_number"/>
                        </group>
                        <group>
                            <field name="registered_from"/>
                            <field name="expiry_date"/>
                            <field name="revalidation_date"/>
                        </group>
                    </group>
                    <group string="Evidence">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nhs_registration_search" model="ir.ui.view">
        <field name="name">nhs.registration.search</field>
        <field name="model">nhs.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="regulator_id"/>
                <field name="registration_number"/>
                <filter name="current" string="Current" domain="[('status', '=', 'current')]"/>
                <filter name="expiring_soon" string="Expiring Soon" domain="[('status', '=', 'expiring_soon')]"/>
                <filter name="lapsed" string="Lapsed" domain="[('status', '=', 'lapsed')]"/>
                <separator/>
                <filter name="expiry_this_month" string="Expiring This Month"
                        domain="[('expiry_date', '&gt;=', context_today()),
                                 ('expiry_date', '&lt;=', context_today() + relativedelta(months=1))]"/>
                <group>
                    <filter name="group_regulator" string="Regulator" context="{'group_by': 'regulator_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nhs_registration" model="ir.actions.act_window">
        <field name="name">Professional Registrations</field>
        <field name="res_model">nhs.registration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a professional registration (NMC / GMC / HCPC / GPhC / GDC…).
            </p>
        </field>
    </record>
</odoo>
