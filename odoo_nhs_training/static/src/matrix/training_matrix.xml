<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_nhs_training.NhsTrainingMatrix" owl="1">
        <div class="o_nhs_training_matrix o_content p-3" style="height: 100%; overflow: auto;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">
                    <i class="fa fa-table me-2"/> Training Matrix
                </h2>
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0 text-muted">Team:</label>
                    <select class="form-select form-select-sm" style="width: auto;" t-on-change="onTeamChange">
                        <option value="">All Teams</option>
                        <t t-foreach="state.orgUnits" t-as="unit" t-key="unit.id">
                            <option t-att-value="unit.id" t-esc="unit.complete_name"/>
                        </t>
                    </select>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 40vh;">
                    <div class="spinner-border text-primary" role="status"/>
                </div>
            </t>
            <t t-else="">
                <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted me-2 small fw-bold">Legend:</span>
                    <span class="badge rounded-pill text-white px-3 py-1" style="background-color: #28a745; font-weight: 600; font-size: 0.75rem;">Compliant</span>
                    <span class="badge rounded-pill text-dark px-3 py-1" style="background-color: #ffc107; font-weight: 600; font-size: 0.75rem;">Due Soon</span>
                    <span class="badge rounded-pill text-white px-3 py-1" style="background-color: #dc3545; font-weight: 600; font-size: 0.75rem;">Expired</span>
                    <span class="badge rounded-pill text-white px-3 py-1" style="background-color: #adb5bd; font-weight: 600; font-size: 0.75rem;">Not Done</span>
                    <span class="badge rounded-pill text-white px-3 py-1" style="background-color: #17a2b8; font-weight: 600; font-size: 0.75rem;">Exempt</span>
                </div>
                <div class="table-responsive shadow-sm rounded border">
                    <table class="table table-hover align-middle o_nhs_matrix_table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="o_nhs_matrix_member_col text-start ps-3">Member</th>
                                <th class="text-start">Team</th>
                                <t t-foreach="state.data.subjects" t-as="subject" t-key="subject.id">
                                    <th class="o_nhs_matrix_subject_col text-center" t-esc="subject.name"/>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.members" t-as="member" t-key="member.id">
                                <tr>
                                    <td class="ps-3 fw-bold">
                                        <a href="#" class="text-decoration-none" t-on-click.prevent="() => this.openMember(member.id)" t-esc="member.name"/>
                                    </td>
                                    <td class="text-muted small" t-esc="member.org_unit"/>
                                    <t t-foreach="state.data.subjects" t-as="subject" t-key="subject.id">
                                        <t t-set="cell" t-value="member.cells[subject.id]"/>
                                        <td t-if="cell"
                                            class="text-center"
                                            style="cursor: pointer;"
                                            t-att-title="cell.expiry_date"
                                            t-on-click="() => this.onCellClick(member.id, subject.id, cell)">
                                            <span t-attf-class="badge rounded-pill px-3 py-2 d-inline-block {{ cell.status === 'due_soon' ? 'text-dark' : 'text-white' }}"
                                                  t-attf-style="background-color: {{ this.color(cell.status) }}; font-weight: 600; min-width: 90px;"
                                                  t-esc="cell.label"/>
                                        </td>
                                        <td t-else="" class="text-center text-muted small bg-light-subtle">-</td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>
</templates>
