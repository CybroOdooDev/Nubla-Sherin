<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ══════════════════════════════════════════════════════════════
             Module Category
        ══════════════════════════════════════════════════════════════════ -->
        <record id="module_category_nhs_training" model="ir.module.category">
            <field name="name">NHS Mandatory Training Register</field>
            <field name="description">NHS Mandatory Training Register access levels.</field>
            <field name="sequence">53</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Privilege (Odoo 19 — replaces category_id on res.groups)
        ══════════════════════════════════════════════════════════════════ -->
        <record id="privilege_training_access_level" model="res.groups.privilege">
            <field name="name">Training Access Level</field>
            <field name="category_id" ref="module_category_nhs_training"/>
            <field name="sequence">10</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Groups
        ══════════════════════════════════════════════════════════════════ -->
        <record id="group_nhs_training_user" model="res.groups">
            <field name="name">Training User</field>
            <field name="privilege_id" ref="privilege_training_access_level"/>
            <field name="comment">Read-only training compliance for their own scope. A user who
                manages one or more org units (Establishment "Manager / Lead") sees that
                unit's subtree; a user who manages none sees nothing under this group alone —
                assign org-wide read-only reviewers (e.g. CQC-prep) to Training Officer instead.</field>
        </record>

        <record id="group_nhs_training_officer" model="res.groups">
            <field name="name">Training Officer / L&amp;D</field>
            <field name="privilege_id" ref="privilege_training_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_training_user'))]"/>
            <field name="comment">L&amp;D / training-admin role: record completions, manage
                members, requirements and registrations across the company. Cannot edit
                configuration (subjects, frequencies, regulators, targets).</field>
        </record>

        <record id="group_nhs_training_manager" model="res.groups">
            <field name="name">Training Manager</field>
            <field name="privilege_id" ref="privilege_training_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_training_officer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full control: configure subjects, frequencies, requirement
                profiles, regulators and the compliance target; manage all members and records.</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Record Rules — Company scoping (multi-organisation isolation)
        ══════════════════════════════════════════════════════════════════ -->
        <record id="rule_nhs_workforce_member_company" model="ir.rule">
            <field name="name">nhs.workforce.member: company scope</field>
            <field name="model_id" ref="model_nhs_workforce_member"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <record id="rule_nhs_training_record_company" model="ir.rule">
            <field name="name">nhs.training.record: company scope</field>
            <field name="model_id" ref="model_nhs_training_record"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <record id="rule_nhs_registration_company" model="ir.rule">
            <field name="name">nhs.registration: company scope</field>
            <field name="model_id" ref="model_nhs_registration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Record Rules — Line-manager scoping (Training User only;
             Officer/Manager see the whole company per the rule above).
        ══════════════════════════════════════════════════════════════════ -->
        <record id="rule_nhs_workforce_member_manager_scope" model="ir.rule">
            <field name="name">nhs.workforce.member: line-manager team scope</field>
            <field name="model_id" ref="model_nhs_workforce_member"/>
            <field name="domain_force">[('org_unit_id', 'child_of', user.nhs_managed_unit_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <record id="rule_nhs_training_record_manager_scope" model="ir.rule">
            <field name="name">nhs.training.record: line-manager team scope</field>
            <field name="model_id" ref="model_nhs_training_record"/>
            <field name="domain_force">[('org_unit_id', 'child_of', user.nhs_managed_unit_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <record id="rule_nhs_registration_manager_scope" model="ir.rule">
            <field name="name">nhs.registration: line-manager team scope</field>
            <field name="model_id" ref="model_nhs_registration"/>
            <field name="domain_force">[('member_id.org_unit_id', 'child_of', user.nhs_managed_unit_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_training_user'))]"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════════
             Record Rules — Portal self-view (base.group_portal)
        ══════════════════════════════════════════════════════════════════ -->
        <record id="rule_nhs_workforce_member_portal_self" model="ir.rule">
            <field name="name">nhs.workforce.member: portal self-view</field>
            <field name="model_id" ref="model_nhs_workforce_member"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_nhs_training_record_portal_self" model="ir.rule">
            <field name="name">nhs.training.record: portal self-view</field>
            <field name="model_id" ref="model_nhs_training_record"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_nhs_registration_portal_self" model="ir.rule">
            <field name="name">nhs.registration: portal self-view</field>
            <field name="model_id" ref="model_nhs_registration"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- No-delete is enforced by overriding unlink() on nhs.training.record and
             nhs.registration (archive-not-delete, to preserve the evidence trail), and
             via perm_unlink=0 in ir.model.access.csv for the user/officer groups. -->
    </data>
</odoo>
