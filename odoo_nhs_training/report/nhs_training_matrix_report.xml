<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_nhs_training_matrix" model="ir.actions.report">
        <field name="name">Team Training Matrix</field>
        <field name="model">nhs.workforce.member</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_training.report_nhs_training_matrix_view</field>
        <field name="report_file">odoo_nhs_training.report_nhs_training_matrix_view</field>
        <field name="binding_model_id" ref="model_nhs_workforce_member"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_nhs_training_matrix_view">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="color:#005EB8;">Team Training Matrix</h2>
                    <p class="text-muted">Generated <t t-out="generated_on"/></p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>Team</th>
                                <t t-foreach="subjects" t-as="subject">
                                    <th style="font-size: 0.7rem;"><t t-out="subject.complete_name"/></th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rows" t-as="row">
                                <tr>
                                    <td><t t-out="row['member'].name"/></td>
                                    <td><t t-out="row['member'].org_unit_id.name"/></td>
                                    <t t-foreach="row['cells']" t-as="cell">
                                        <td t-attf-style="text-align:center; #{cell['status'] == 'compliant' and 'background-color:#d4edda;' or cell['status'] == 'due_soon' and 'background-color:#fff3cd;' or cell['status'] == 'expired' and 'background-color:#f8d7da;' or cell['status'] == 'failed' and 'background-color:#f1aeb5;' or cell['status'] == 'exempt' and 'background-color:#d1ecf1;' or ''}">
                                            <t t-out="cell['label']"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
