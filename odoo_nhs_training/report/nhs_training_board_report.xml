<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_nhs_training_board" model="ir.actions.report">
        <field name="name">Board Assurance</field>
        <field name="model">nhs.org.unit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_training.report_nhs_training_board_view</field>
        <field name="report_file">odoo_nhs_training.report_nhs_training_board_view</field>
        <field name="binding_model_id" ref="odoo_nhs_establishment.model_nhs_org_unit"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_nhs_training_board_view">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="color:#005EB8;">NHS Training Compliance — Board Assurance Report</h2>
                    <p class="text-muted">Generated <t t-out="generated_on"/></p>

                    <div class="row text-center mb-4 g-3">
                        <div class="col-4">
                            <h2 style="color:#15803D;"><t t-out="overall_rate"/>%</h2>
                            <div class="text-muted">Overall Compliance (Target <t t-out="target"/>%)</div>
                        </div>
                        <div class="col-4">
                            <h2><t t-out="total_members"/></h2>
                            <div class="text-muted">Workforce Members</div>
                        </div>
                        <div class="col-4">
                            <h2 style="color:#DC2626;"><t t-out="non_compliant_count"/></h2>
                            <div class="text-muted">Non-Compliant Members</div>
                        </div>
                    </div>

                    <h4 style="color:#005EB8;">Compliance by Staff Group</h4>
                    <table class="table table-sm table-bordered mb-4">
                        <thead><tr><th>Staff Group</th><th>Members</th><th>Compliance %</th></tr></thead>
                        <tbody>
                            <t t-foreach="staff_group_stats" t-as="s">
                                <tr>
                                    <td><t t-out="s['name']"/></td>
                                    <td><t t-out="s['member_count']"/></td>
                                    <td><t t-out="s['rate']"/>%</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <h4 style="color:#005EB8;">Compliance by Team</h4>
                    <table class="table table-sm table-bordered mb-4">
                        <thead><tr><th>Team</th><th>Members</th><th>Compliance %</th></tr></thead>
                        <tbody>
                            <t t-foreach="team_stats" t-as="s">
                                <tr>
                                    <td><t t-out="s['name']"/></td>
                                    <td><t t-out="s['member_count']"/></td>
                                    <td><t t-out="s['rate']"/>%</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <h4 style="color:#DC2626;">Lapsed Professional Registrations</h4>
                    <t t-if="lapsed_registrations">
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Member</th><th>Regulator</th><th>Expiry</th></tr></thead>
                            <tbody>
                                <t t-foreach="lapsed_registrations" t-as="r">
                                    <tr>
                                        <td><t t-out="r.member_id.name"/></td>
                                        <td><t t-out="r.regulator_id.name"/></td>
                                        <td><t t-out="r.expiry_date"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-success">No lapsed professional registrations.</p>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
