<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_bulk_completion_wizard_form" model="ir.ui.view">
        <field name="name">nhs.bulk.completion.wizard.form</field>
        <field name="model">nhs.bulk.completion.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk-Record a Training Session">
                <group>
                    <group>
                        <field name="subject_id" options="{'no_create': True}"/>
                        <field name="completion_date"/>
                        <field name="method"/>
                        <field name="provider"/>
                    </group>
                    <group>
                        <field name="certificate_ref"/>
                        <field name="org_unit_id" options="{'no_create': True}"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Attach Certificate" class="text-nowrap"/>
                    </group>
                </group>
                <separator string="Members Attending"/>
                <field name="member_ids" nolabel="1">
                    <list>
                        <field name="name"/>
                        <field name="org_unit_id"/>
                        <field name="post_id"/>
                        <field name="compliance_pct" string="Compliance %"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Record Completions"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nhs_bulk_completion_wizard" model="ir.actions.act_window">
        <field name="name">Bulk-Record Training Session</field>
        <field name="res_model">nhs.bulk.completion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
