<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view of issued books report model.-->
    <record id="issued_books_report_view_form" model="ir.ui.view">
        <field name="name">issued.book.report.view.form</field>
        <field name="model">issued.book.report</field>
        <field name="arch" type="xml">
            <form string="Issued Books Report">
                <group string="Report Filters">
                    <group>
                        <field name="date_start"/>
                        <field name="book_name_id"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                        <field name="member_id"/>
                        <field name="user_id"/>
                    </group>
                </group>
                <footer>
                    <button name="get_report" string="Print PDF Report"
                            type="object" class="oe_highlight"/>
                    <button name="get_xlsx_report" string="Print XLSX Report"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!--   The action is associated with a window view that displays the report in 'form' mode.-->
    <!--It is linked to the 'issued.book.report' model and utilizes the view defined in -->
    <!--'issued_books_report_view_form'.-->
    <record id="issued_books_report_action" model="ir.actions.act_window">
        <field name="name">Issued Book Report</field>
        <field name="res_model">issued.book.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="issued_books_report_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
