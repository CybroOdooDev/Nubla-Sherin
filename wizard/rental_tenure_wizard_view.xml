<odoo>

    <record id="view_rental_product_tenure_wizard_form" model="ir.ui.view">
        <field name="name">rental.product.tenure.wizard.form</field>
        <field name="model">rental.product.tenure</field>
        <field name="arch" type="xml">
            <form string="Create Rental Product Tenure">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="uom_id"/>
                    </group>
                    <group>
                        <field name="range_start"/>
                        <field name="range_end"/>
                    </group>
                    <group>
                        <field name="amount"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save Close" type="object" name="action_save_close" class="btn-primary"/>
                    <button string="Save New" type="object" name="action_save_new" class="btn-secondary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
