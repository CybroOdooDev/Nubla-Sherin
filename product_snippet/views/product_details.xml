<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_details_tree" model="ir.ui.view">
        <field name="name">product.details.tree</field>
        <field name="model">product.details</field>
        <field name="arch" type="xml">
            <list string="Product Details">
                <field name="product_name"/>
                <field name="image" widget="image" options="{'size': (64, 64)}"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="view_product_details_form" model="ir.ui.view">
        <field name="name">product.details.form</field>
        <field name="model">product.details</field>
        <field name="arch" type="xml">
            <form string="Product Details">
                <sheet>
                    <group>
                        <field name="product_name"/>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="image" widget="image" options="{'preview_image': 'image'}"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_details" model="ir.actions.act_window">
        <field name="name">Product Details</field>
        <field name="res_model">product.details</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create product details records</p>
        </field>
    </record>

    <menuitem id="menu_product_root" name="Products" sequence="30"/>
    <menuitem id="menu_product_details" name="Product Details" parent="menu_product_root" action="action_product_details" sequence="10"/>
</odoo>
