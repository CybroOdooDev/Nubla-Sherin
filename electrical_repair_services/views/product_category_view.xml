<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Repair" name="repair_services">
<!--                <page string="Repair" name="repair_services" invisible = " categ_id != ">-->
                <group name="product_to_repair_ids" string="Repair Product">
                    <field name="product_to_repair_ids" string="Repair Product"  />
                </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

