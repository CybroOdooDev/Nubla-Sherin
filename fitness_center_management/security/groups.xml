<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fitness_management" model="res.groups.privilege">
        <field name="name">Fitness Center Management</field>
        <field name="description">Category for Fitness Center Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_fitness_user" model="res.groups">
        <field name="name">Fitness User</field>
        <field name="privilege_id" ref="module_category_fitness_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fitness_manager" model="res.groups">
        <field name="name">Fitness Manager</field>
        <field name="privilege_id" ref="module_category_fitness_management"/>
        <field name="implied_ids" eval="[(4, ref('group_fitness_user'))]"/>
    </record>
</odoo>
