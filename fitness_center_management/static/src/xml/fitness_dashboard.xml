<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fitness_center_management.FitnessDashboard">
        <div class="fitness-dashboard">
            <!-- Dashboard Header -->
            <div class="fitness-dashboard-header">
                <div class="fitness-header-content">
                    <div class="fitness-header-left">
                        <h1 class="fitness-title">
                            <i class="fa fa-heartbeat fitness-pulse-icon"/> Fitness Center Dashboard
                        </h1>
                        <p class="fitness-subtitle">Real-time overview of your gym operations</p>
                    </div>
                    <div class="fitness-header-right">
                        <button class="fitness-dark-toggle" t-on-click="toggleDarkMode">
                            <i t-attf-class="fa #{state.darkMode ? 'fa-sun-o' : 'fa-moon-o'}"/>
                        </button>
                        <button class="fitness-refresh-btn" t-on-click="loadDashboardData">
                            <i class="fa fa-refresh"/> Refresh
                        </button>
                    </div>
                </div>
            </div>

            <div class="fitness-dashboard-body">
                <!-- KPI Cards Row 1 -->
                <div class="fitness-kpi-grid">
                    <div class="fitness-kpi-card fitness-kpi-members" t-on-click="viewMembers">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-users"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.total_members"/>
                            <span class="fitness-kpi-label">Total Members</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-subscriptions" t-on-click="viewSubscriptions">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-id-card"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.active_subscriptions"/>
                            <span class="fitness-kpi-label">Active Subscriptions</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-revenue" t-on-click="viewPayments">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-dollar"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value">
                                $ <t t-esc="state.total_revenue"/>
                            </span>
                            <span class="fitness-kpi-label">Total Revenue</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-trainers" t-on-click="viewTrainers">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-user-circle"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.total_trainers"/>
                            <span class="fitness-kpi-label">Trainers</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>
                </div>

                <!-- KPI Cards Row 2 -->
                <div class="fitness-kpi-grid">
                    <div class="fitness-kpi-card fitness-kpi-classes" t-on-click="viewClasses">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-calendar-check-o"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.total_classes"/>
                            <span class="fitness-kpi-label">Fitness Classes</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-bookings" t-on-click="viewBookings">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-bookmark"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.pending_bookings"/>
                            <span class="fitness-kpi-label">Pending Bookings</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-equipment" t-on-click="viewEquipment">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-cogs"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.active_equipment"/>
                            <span class="fitness-kpi-label">Active Equipment</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>

                    <div class="fitness-kpi-card fitness-kpi-maintenance" t-on-click="viewMaintenance">
                        <div class="fitness-kpi-icon-wrap">
                            <i class="fa fa-wrench"/>
                        </div>
                        <div class="fitness-kpi-info">
                            <span class="fitness-kpi-value" t-esc="state.maintenance_due"/>
                            <span class="fitness-kpi-label">Maintenance Due</span>
                        </div>
                        <div class="fitness-kpi-arrow"><i class="fa fa-arrow-right"/></div>
                    </div>
                </div>

                <!-- Content Row: Recent Members + Subscription Stats -->
                <div class="fitness-content-grid">
                    <!-- Recent Members -->
                    <div class="fitness-card">
                        <div class="fitness-card-header">
                            <h3><i class="fa fa-user-plus"/> Recent Members</h3>
                            <button class="fitness-view-all-btn" t-on-click="viewMembers">View All</button>
                        </div>
                        <div class="fitness-card-body">
                            <t t-if="state.recent_members.length">
                                <table class="fitness-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.recent_members" t-as="member" t-key="member.id">
                                            <tr>
                                                <td class="fitness-member-name">
                                                    <div class="fitness-avatar">
                                                        <t t-esc="member.name.charAt(0).toUpperCase()"/>
                                                    </div>
                                                    <span t-esc="member.name"/>
                                                </td>
                                                <td t-esc="member.email"/>
                                                <td t-esc="member.phone"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <div class="fitness-empty-state">
                                    <i class="fa fa-users fa-3x"/>
                                    <p>No members yet</p>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Subscription Stats -->
                    <div class="fitness-card">
                        <div class="fitness-card-header">
                            <h3><i class="fa fa-pie-chart"/> Subscription Stats</h3>
                            <button class="fitness-view-all-btn" t-on-click="viewSubscriptions">View All</button>
                        </div>
                        <div class="fitness-card-body">
                            <t t-if="state.subscription_stats.length">
                                <t t-foreach="state.subscription_stats" t-as="stat" t-key="stat.state">
                                    <div class="fitness-stat-row">
                                        <div class="fitness-stat-info">
                                            <span t-attf-class="fitness-stat-dot fitness-dot-#{stat.state}"/>
                                            <span class="fitness-stat-label" t-esc="stat.label"/>
                                        </div>
                                        <div class="fitness-stat-bar-wrap">
                                            <div class="fitness-stat-bar" t-attf-style="width: #{stat.percentage}%;">
                                                <div t-attf-class="fitness-stat-bar-fill fitness-bar-#{stat.state}"/>
                                            </div>
                                        </div>
                                        <span class="fitness-stat-count" t-esc="stat.count"/>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="fitness-empty-state">
                                    <i class="fa fa-pie-chart fa-3x"/>
                                    <p>No subscription data</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Content Row: Plan Distribution + Recent Payments -->
                <div class="fitness-content-grid">
                    <!-- Plan Distribution -->
                    <div class="fitness-card">
                        <div class="fitness-card-header">
                            <h3><i class="fa fa-tags"/> Plan Distribution</h3>
                        </div>
                        <div class="fitness-card-body">
                            <t t-if="state.plan_distribution.length">
                                <t t-foreach="state.plan_distribution" t-as="plan" t-key="plan.name">
                                    <div class="fitness-plan-item">
                                        <div class="fitness-plan-info">
                                            <span class="fitness-plan-name" t-esc="plan.name"/>
                                            <span class="fitness-plan-count">
                                                <t t-esc="plan.count"/> subscribers
                                            </span>
                                        </div>
                                        <div class="fitness-plan-bar-bg">
                                            <div class="fitness-plan-bar-fill" t-attf-style="width: #{plan.percentage}%;"/>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="fitness-empty-state">
                                    <i class="fa fa-tags fa-3x"/>
                                    <p>No plan data</p>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Recent Payments -->
                    <div class="fitness-card">
                        <div class="fitness-card-header">
                            <h3><i class="fa fa-credit-card"/> Recent Payments</h3>
                            <button class="fitness-view-all-btn" t-on-click="viewPayments">View All</button>
                        </div>
                        <div class="fitness-card-body">
                            <t t-if="state.recent_payments.length">
                                <table class="fitness-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Member</th>
                                            <th>Amount</th>
                                            <th>Method</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.recent_payments" t-as="payment" t-key="payment.id">
                                            <tr>
                                                <td t-esc="payment.date"/>
                                                <td t-esc="payment.member"/>
                                                <td class="fitness-amount">$ <t t-esc="payment.amount"/></td>
                                                <td>
                                                    <span class="fitness-badge" t-esc="payment.method"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <div class="fitness-empty-state">
                                    <i class="fa fa-credit-card fa-3x"/>
                                    <p>No payments recorded</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
