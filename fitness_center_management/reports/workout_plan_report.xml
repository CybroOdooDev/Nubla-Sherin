<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_workout_plan" model="ir.actions.report">
        <field name="name">Workout Plan</field>
        <field name="model">fitness.workout.plan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fitness_center_management.report_workout_plan_template</field>
        <field name="report_file">fitness_center_management.report_workout_plan_template</field>
        <field name="print_report_name">'Workout Plan - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_fitness_workout_plan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_workout_plan_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row mt32 mb32">
                            <div class="col-12 text-center">
                                <h2>Workout Schedule</h2>
                                <h4 t-field="o.name"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6">
                                <strong>Member: </strong><span t-field="o.member_id.name"/><br/>
                                <strong>Trainer: </strong><span t-field="o.trainer_id.name"/><br/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>Start Date: </strong><span t-field="o.start_date"/><br/>
                                <strong>End Date: </strong><span t-field="o.end_date"/><br/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mt32">
                            <thead>
                                <tr>
                                    <th class="text-left">Exercise</th>
                                    <th class="text-left">Description</th>
                                    <th class="text-right">Sets</th>
                                    <th class="text-right">Reps</th>
                                    <th class="text-right">Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.exercise_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td><span t-field="line.description"/></td>
                                        <td class="text-right"><span t-field="line.sets"/></td>
                                        <td class="text-right"><span t-field="line.reps"/></td>
                                        <td class="text-right"><span t-field="line.duration_minutes"/> mins</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
