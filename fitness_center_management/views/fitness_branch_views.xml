<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_branch_tree" model="ir.ui.view">
        <field name="name">fitness.branch.tree</field>
        <field name="model">fitness.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_branch_form" model="ir.ui.view">
        <field name="name">fitness.branch.form</field>
        <field name="model">fitness.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Branch Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <field name="address"/>
                        </page>
                        <page string="Members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="membership_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fitness_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">fitness.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_branch"
              name="Branches"
              parent="menu_fitness_configuration_root"
              action="action_fitness_branch"
              sequence="10"/>
</odoo>
