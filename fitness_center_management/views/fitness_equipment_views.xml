<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_equipment_tree" model="ir.ui.view">
        <field name="name">fitness.equipment.tree</field>
        <field name="model">fitness.equipment</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="name"/>
                <field name="category"/>
                <field name="serial_number"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'operational'"
                       decoration-warning="status == 'maintenance'"
                       decoration-danger="status == 'broken'"/>
                <field name="location"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_equipment_form" model="ir.ui.view">
        <field name="name">fitness.equipment.form</field>
        <field name="model">fitness.equipment</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Equipment Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info" string="Basic Info">
                            <field name="category"/>
                            <field name="serial_number"/>
                            <field name="status"/>
                        </group>
                        <group name="financial_loc" string="Financial &amp; Location">
                            <field name="purchase_date"/>
                            <field name="warranty_expiry"/>
                            <field name="cost"/>
                            <field name="location"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">fitness.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_equipment"
              name="Equipment"
              parent="menu_fitness_equipment_root"
              action="action_fitness_equipment"
              sequence="10"/>
</odoo>
