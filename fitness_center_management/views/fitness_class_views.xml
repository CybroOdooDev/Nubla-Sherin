<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_class_tree" model="ir.ui.view">
        <field name="name">fitness.class.tree</field>
        <field name="model">fitness.class</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="name"/>
                <field name="class_type"/>
                <field name="max_capacity"/>
                <field name="default_duration"/>
                <field name="difficulty"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_class_form" model="ir.ui.view">
        <field name="name">fitness.class.form</field>
        <field name="model">fitness.class</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Class Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="class_details" string="Class Details">
                            <field name="class_type"/>
                            <field name="max_capacity"/>
                            <field name="branch_id"/>
                        </group>
                        <group name="timing_diff" string="Timing &amp; Difficulty">
                            <field name="default_duration"/>
                            <field name="difficulty"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Enter class description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">fitness.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_class"
              name="Classes"
              parent="menu_fitness_classes_root"
              action="action_fitness_class"
              sequence="10"/>
</odoo>
