<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FOOD ITEM DB -->
    <record id="view_fitness_food_item_tree" model="ir.ui.view">
        <field name="name">fitness.food.item.list</field>
        <field name="model">fitness.food.item</field>
        <field name="arch" type="xml">
            <list string="Food Database">
                <field name="name"/>
                <field name="serving_size"/>
                <field name="calories" sum="Total"/>
                <field name="protein" sum="Total"/>
                <field name="carbs" sum="Total"/>
                <field name="fats" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_food_item_form" model="ir.ui.view">
        <field name="name">fitness.food.item.form</field>
        <field name="model">fitness.food.item</field>
        <field name="arch" type="xml">
            <form string="Food Item">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="E.g. Banana, Chicken Breast..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="serving_size"/>
                            <field name="barcode"/>
                            <field name="is_verified"/>
                        </group>
                        <group string="Macros / Nutrition">
                            <field name="calories"/>
                            <field name="protein"/>
                            <field name="carbs"/>
                            <field name="fats"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fitness_food_item" model="ir.actions.act_window">
        <field name="name">Food Database</field>
        <field name="res_model">fitness.food.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add food items to the database!
            </p>
        </field>
    </record>

    <!-- MEAL LOG -->
    <record id="view_fitness_meal_log_tree" model="ir.ui.view">
        <field name="name">fitness.meal.log.list</field>
        <field name="model">fitness.meal.log</field>
        <field name="arch" type="xml">
            <list string="Meal Logs">
                <field name="name"/>
                <field name="member_id"/>
                <field name="date"/>
                <field name="meal_type"/>
                <field name="food_id"/>
                <field name="total_calories" sum="Calories"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_meal_log_form" model="ir.ui.view">
        <field name="name">fitness.meal.log.form</field>
        <field name="model">fitness.meal.log</field>
        <field name="arch" type="xml">
            <form string="Meal Log">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="date"/>
                            <field name="meal_type"/>
                        </group>
                        <group>
                            <field name="food_id"/>
                            <field name="servings"/>
                        </group>
                    </group>
                    <group string="Nutrition Breakdown">
                        <group>
                            <field name="total_calories"/>
                            <field name="total_protein"/>
                        </group>
                        <group>
                            <field name="total_carbs"/>
                            <field name="total_fats"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fitness_meal_log" model="ir.actions.act_window">
        <field name="name">Meal Logs</field>
        <field name="res_model">fitness.meal.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Log a daily meal!
            </p>
        </field>
    </record>

</odoo>
