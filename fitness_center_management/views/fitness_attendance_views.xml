<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_attendance_tree" model="ir.ui.view">
        <field name="name">fitness.attendance.tree</field>
        <field name="model">fitness.attendance</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Attendance">
                <field name="member_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration" sum="Total Duration"/>
                <field name="method"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_attendance_form" model="ir.ui.view">
        <field name="name">fitness.attendance.form</field>
        <field name="model">fitness.attendance</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group name="member_info" string="Member Information">
                            <field name="member_id"/>
                            <field name="method"/>
                        </group>
                        <group name="timing" string="Timing &amp; Duration">
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="duration"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">fitness.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_attendance"
              name="Attendance Logs"
              parent="menu_fitness_attendance_root"
              action="action_fitness_attendance"
              sequence="10"/>
</odoo>
