<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_membership_plan_tree" model="ir.ui.view">
        <field name="name">fitness.membership.plan.tree</field>
        <field name="model">fitness.membership.plan</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Membership Plans">
                <field name="name"/>
                <field name="plan_type"/>
                <field name="duration_months"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_membership_plan_form" model="ir.ui.view">
        <field name="name">fitness.membership.plan.form</field>
        <field name="model">fitness.membership.plan</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Plan Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="plan_details" string="Plan Details">
                            <field name="plan_type"/>
                            <field name="duration_months"/>
                        </group>
                        <group name="pricing" string="Pricing &amp; Status">
                            <field name="price"/>
                            <field name="max_freeze_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Features" name="features">
                            <field name="features" placeholder="Describe the plan features..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_membership_plan" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">fitness.membership.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_membership_plan"
              name="Membership Plans"
              parent="menu_fitness_configuration_root"
              action="action_fitness_membership_plan"
              sequence="10"/>
</odoo>
