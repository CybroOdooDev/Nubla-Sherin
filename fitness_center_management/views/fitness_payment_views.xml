<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_payment_tree" model="ir.ui.view">
        <field name="name">fitness.payment.tree</field>
        <field name="model">fitness.payment</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="payment_date"/>
                <field name="subscription_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="payment_method"/>
            </list>
        </field>
    </record>

    <record id="action_fitness_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">fitness.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_payment"
              name="Payments"
              parent="menu_fitness_subscriptions_root"
              action="action_fitness_payment"
              sequence="20"/>
</odoo>
