<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitness_class_schedule_tree" model="ir.ui.view">
        <field name="name">fitness.class.schedule.tree</field>
        <field name="model">fitness.class.schedule</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Class Schedule">
                <field name="date_start"/>
                <field name="class_id"/>
                <field name="trainer_id"/>
                <field name="room"/>
                <field name="current_bookings"/>
                <field name="available_spots"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_class_schedule_form" model="ir.ui.view">
        <field name="name">fitness.class.schedule.form</field>
        <field name="model">fitness.class.schedule</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Class Schedule">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group name="class_trainer" string="Class &amp; Trainer">
                            <field name="class_id"/>
                            <field name="trainer_id"/>
                            <field name="room"/>
                        </group>
                        <group name="schedule_info" string="Schedule Info">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="current_bookings"/>
                            <field name="available_spots"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_class_schedule" model="ir.actions.act_window">
        <field name="name">Class Schedules</field>
        <field name="res_model">fitness.class.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fitness_class_schedule"
              name="Class Schedules"
              parent="menu_fitness_classes_root"
              action="action_fitness_class_schedule"
              sequence="20"/>
</odoo>
