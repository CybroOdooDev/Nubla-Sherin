<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SOCIAL POSTS -->
    <record id="view_fitness_social_post_tree" model="ir.ui.view">
        <field name="name">fitness.social.post.list</field>
        <field name="model">fitness.social.post</field>
        <field name="arch" type="xml">
            <list string="Social Posts">
                <field name="member_id"/>
                <field name="name"/>
                <field name="create_date"/>
                <field name="kudos_count"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_social_post_form" model="ir.ui.view">
        <field name="name">fitness.social.post.form</field>
        <field name="model">fitness.social.post</field>
        <field name="arch" type="xml">
            <form string="Social Post">
                <header>
                    <button name="action_give_kudos" string="Give Kudos" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="E.g. Just crushed my 5k run!"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="workout_log_id"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="kudos_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content"/>
                        </page>
                        <page string="Image" name="image">
                            <field name="image" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fitness_social_post" model="ir.actions.act_window">
        <field name="name">Community Feed</field>
        <field name="res_model">fitness.social.post</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CHALLENGES -->
    <record id="view_fitness_challenge_tree" model="ir.ui.view">
        <field name="name">fitness.challenge.list</field>
        <field name="model">fitness.challenge</field>
        <field name="arch" type="xml">
            <list string="Challenges">
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="target_metric"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_challenge_form" model="ir.ui.view">
        <field name="name">fitness.challenge.form</field>
        <field name="model">fitness.challenge</field>
        <field name="arch" type="xml">
            <form string="Challenge">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <field name="cover_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="E.g. Spring 100k Running Challenge"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="target_metric"/>
                            <field name="target_value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fitness_challenge" model="ir.actions.act_window">
        <field name="name">Challenges</field>
        <field name="res_model">fitness.challenge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
