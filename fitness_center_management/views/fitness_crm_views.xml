<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════ CRM LEAD INHERITED VIEW ══════════ -->
    <record id="view_crm_lead_form_inherit_fitness" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.fitness</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']" position="after">
                <group string="Diet Information" name="diet_info">
                    <field name="diet_category_id"/>
                    <field name="diet_type_id"/>
                    <field name="birthdate"/>
                    <field name="gender"/>
                    <field name="diet_description"/>
                </group>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_diet_member" type="object" string="Create Member" class="oe_stat_button" icon="fa-user-plus"/>
                <button name="action_create_diet_plan" type="object" string="Create Diet Plan" class="oe_stat_button" icon="fa-cutlery"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════ CRM LEAD LIST VIEW ══════════ -->
    <record id="view_crm_lead_list_inherit_fitness" model="ir.ui.view">
        <field name="name">crm.lead.list.inherit.fitness</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="diet_category_id" optional="hide"/>
                <field name="diet_type_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════ CRM LEADS ACTION (Diet Filtered) ══════════ -->
    <record id="action_fitness_diet_leads" model="ir.actions.act_window">
        <field name="name">Diet Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('diet_category_id', '!=', False)]</field>
        <field name="context">{'default_type': 'lead'}</field>
    </record>

    <record id="action_fitness_diet_opportunities" model="ir.actions.act_window">
        <field name="name">Diet Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('diet_category_id', '!=', False), ('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
    </record>

    <!-- ══════════ MENUS - Under Health & Wellness ══════════ -->
    <menuitem id="menu_fitness_crm_root" name="Leads" parent="fitness_center_management.menu_fitness_health_wellness" sequence="1"/>
    <menuitem id="menu_fitness_diet_leads" name="Diet Leads" parent="menu_fitness_crm_root" action="action_fitness_diet_leads" sequence="10"/>
    <menuitem id="menu_fitness_diet_opportunities" name="Opportunities" parent="menu_fitness_crm_root" action="action_fitness_diet_opportunities" sequence="20"/>

</odoo>
