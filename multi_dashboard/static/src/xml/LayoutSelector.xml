<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--  LayoutSelector template  -->
    <t t-name="multi_dashboard.LayoutSelector" owl="1">
        <div class="d-flex gap-3">
            <t t-foreach="layouts" t-as="layout" t-key="layout.id">
                <div class="layout-option"
                     t-att-class="selectedLayout === layout.id ? 'selected-layout' : ''"
                     t-on-click="() => this.selectLayout(layout.id)"
                     style="cursor: pointer; border: 2px solid transparent; border-radius: 8px; padding: 4px;">

                    <div t-if="layout.id == 'layout_1'"
                         style="width: 80px; height: 50px; background: #eee; border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <div style="width: 20px; height: 10px; background: #333; margin-bottom: 2px;"/>
                        <div style="width: 40px; height: 4px; background: #999;"/>
                    </div>

                    <div t-if="layout.id == 'layout_2'"
                         style="width: 80px; height: 50px; background: #eee; border-radius: 4px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px;">
                        <div style="width: 20px; height: 20px; background: #333;"/>
                        <div style="width: 30px; height: 4px; background: #999;"/>
                    </div>

                    <div t-if="layout.id == 'layout_3'"
                         style="width: 80px; height: 50px; background: #eee; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; padding: 5px;">
                        <div style="width: 30px; height: 4px; background: #999;"/>
                        <div style="width: 25px; height: 15px; background: #333; align-self: flex-end;"/>
                    </div>

                    <div class="text-center text-muted small mt-1"><t t-esc="layout.name"/></div>
                </div>
            </t>
        </div>

        <style>
            .selected-layout { border-color: #714B67 !important; background-color: #f3f0f2; }
        </style>
    </t>
</templates>
