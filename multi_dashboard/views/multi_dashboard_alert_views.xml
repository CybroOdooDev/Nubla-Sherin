<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Simple Alert List View -->
    <record id="view_multi_dashboard_alert_tree" model="ir.ui.view">
        <field name="name">multi.dashboard.alert.tree</field>
        <field name="model">multi.dashboard.alert</field>
        <field name="arch" type="xml">
            <list string="Dashboard Alerts">
                <field name="name"/>
                <field name="chart_id"/>
                <field name="condition"/>
                <field name="value" string="Threshold"/>
            </list>
        </field>
    </record>

    <!-- Simple Alert Form View -->
    <record id="view_multi_dashboard_alert_form" model="ir.ui.view">
        <field name="name">multi.dashboard.alert.form</field>
        <field name="model">multi.dashboard.alert</field>
        <field name="arch" type="xml">
            <form string="Dashboard Alert">
                <header>
                    <button name="action_dismiss_alert" string="Dismiss" type="object" class="oe_highlight" invisible="is_acknowledged"/>
                    <field name="is_acknowledged" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="chart_id"/>
                        <field name="condition"/>
                        <field name="value"/>
                        <field name="last_triggered_value" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Alert Action -->
    <record id="multi_dashboard_alert_action" model="ir.actions.act_window">
        <field name="name">Dashboard Alerts</field>
        <field name="res_model">multi.dashboard.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
