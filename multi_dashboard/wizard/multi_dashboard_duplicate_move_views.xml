<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_dashboard_duplicate_move_form" model="ir.ui.view">
        <field name="name">multi.dashboard.duplicate.move.form</field>
        <field name="model">multi.dashboard.duplicate.move</field>
        <field name="arch" type="xml">
            <form string="Duplicate or Move Dashboard Item">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        Select the target dashboard and the action you wish to perform.
                    </div>
                    <group>
                        <field name="chart_id" invisible="1"/>
                        <field name="dashboard_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="action_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
