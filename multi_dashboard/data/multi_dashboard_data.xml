<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <menuitem id="multi_dashboard_root"
                  name="Multi Dashboards"
                  web_icon="multi_dashboard,static/description/icon.png"
                  sequence="2"/>

        <!-- My Dashboard Record -->
        <record id="default_multi_dashboard" model="multi.dashboards">
            <field name="name">My Dashboard</field>
            <field name="parent_menu" ref="multi_dashboard_root"/>
            <field name="sequence">10</field>
        </record>

        <!-- Client Action for Dashboard -->
        <record id="action_default_dashboard_client" model="ir.actions.client">
            <field name="name">My Dashboard</field>
            <field name="tag">MultiDashboardClientAction</field>
            <field name="params" eval="{'dashboard_id': ref('default_multi_dashboard'), 'theme': 'light'}"/>
            <field name="context" eval="{'active_id': ref('default_multi_dashboard')}"/>
        </record>

        <!-- Dashboard Submenu -->
        <menuitem id="menu_default_dashboard"
                  name="My Dashboard"
                  parent="multi_dashboard_root"
                  action="action_default_dashboard_client"
                  sequence="10"/>

        <!-- Update Dashboard Record with menu_id -->
        <record id="default_multi_dashboard" model="multi.dashboards">
            <field name="menu_id" ref="menu_default_dashboard"/>
        </record>
    </data>
</odoo>
