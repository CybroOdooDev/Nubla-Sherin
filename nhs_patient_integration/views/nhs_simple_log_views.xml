<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nhs_simple_log_list" model="ir.ui.view">
        <field name="name">nhs.simple.log.list</field>
        <field name="model">nhs.simple.log</field>
        <field name="arch" type="xml">
            <list decoration-success="success == True"
                  decoration-danger="success == False"
                  default_order="create_date desc">
                <field name="create_date" string="When"/>
                <field name="patient_id"/>
                <field name="nhs_number"/>
                <field name="status_code"/>
                <field name="duration_ms"/>
                <field name="environment"/>
                <field name="user_id"/>
                <field name="success" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_nhs_simple_log_form" model="ir.ui.view">
        <field name="name">nhs.simple.log.form</field>
        <field name="model">nhs.simple.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="patient_id"/>
                            <field name="nhs_number"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="environment"/>
                            <field name="status_code"/>
                            <field name="duration_ms"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <field name="url"/>
                    <field name="request_id"/>
                    <notebook>
                        <page string="Response">
                            <field name="response_body" widget="text"/>
                        </page>
                        <page string="Error" invisible="not error">
                            <field name="error" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nhs_simple_log" model="ir.actions.act_window">
        <field name="name">NHS API Log</field>
        <field name="res_model">nhs.simple.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
