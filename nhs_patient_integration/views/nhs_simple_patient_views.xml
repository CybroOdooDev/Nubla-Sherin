<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST view (Odoo 19 uses <list> instead of <tree>) -->
    <record id="view_nhs_simple_patient_list" model="ir.ui.view">
        <field name="name">nhs.simple.patient.list</field>
        <field name="model">nhs.simple.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="nhs_number"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="nhs_synced" widget="boolean_toggle"
                       string="Verified"/>
                <field name="nhs_last_sync"/>
            </list>
        </field>
    </record>

    <!-- FORM view -->
    <record id="view_nhs_simple_patient_form" model="ir.ui.view">
        <field name="name">nhs.simple.patient.form</field>
        <field name="model">nhs.simple.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_fetch_from_nhs"
                            string="Fetch from NHS"
                            type="object"
                            class="btn-primary"
                            icon="fa-cloud-download"
                            invisible="not nhs_number or not id"
                            help="Pull demographics from NHS PDS"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_fetch_from_nhs"
                                icon="fa-refresh"
                                invisible="not nhs_synced">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Re-sync</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Verified with NHS"
                            bg_color="bg-success"
                            invisible="not nhs_synced"/>
                    <div class="oe_title">
                        <label for="name" string="Patient Name"/>
                        <h1><field name="name" placeholder="Patient name..."/></h1>
                    </div>
                    <group>
                        <group string="NHS Identification">
                            <field name="nhs_number"
                                   placeholder="9000000009"/>
                            <field name="nhs_synced" readonly="1"/>
                            <field name="nhs_last_sync" readonly="1"/>
                        </group>
                        <group string="Demographics">
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                        </group>
                    </group>
                    <group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Last NHS Response"
                              invisible="not nhs_raw_response">
                            <field name="nhs_raw_response" widget="text"
                                   readonly="1"
                                   options="{'rows': 20}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH view -->
    <record id="view_nhs_simple_patient_search" model="ir.ui.view">
        <field name="name">nhs.simple.patient.search</field>
        <field name="model">nhs.simple.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="nhs_number"/>
                <field name="phone"/>
                <field name="city"/>
                <filter string="Verified with NHS" name="verified"
                        domain="[('nhs_synced','=',True)]"/>
                <filter string="Not Verified" name="not_verified"
                        domain="[('nhs_synced','=',False)]"/>
                <group>
                    <filter string="Gender" name="group_gender"
                            context="{'group_by':'gender'}"/>
                    <filter string="Verified" name="group_verified"
                            context="{'group_by':'nhs_synced'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nhs_simple_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">nhs.simple.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first patient</p>
            <p>
                Enter a name and NHS Number, save, then click
                <b>Fetch from NHS</b> to pull demographics from the NHS
                sandbox.
                <br/>
                Sandbox test NHS Numbers: 9000000009, 9000000017, 9000000025, 9000000033
            </p>
        </field>
    </record>

</odoo>
