<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ══════════════════════════════════════════════════════════
             MODULE CATEGORY
        ══════════════════════════════════════════════════════════ -->
        <record id="module_category_nhs_incident_risk" model="ir.module.category">
            <field name="name">Quality and Safety</field>
            <field name="description">NHS Incident and Risk Management access levels.</field>
            <field name="sequence">50</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             PRIVILEGE  (Odoo 19 — replaces category_id on res.groups)
        ══════════════════════════════════════════════════════════ -->
        <record id="privilege_hc_access_level" model="res.groups.privilege">
            <field name="name">Quality and Safety Access Level</field>
            <field name="category_id" ref="module_category_nhs_incident_risk"/>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_hc_safeguarding" model="res.groups.privilege">
            <field name="name">Safeguarding Access</field>
            <field name="category_id" ref="module_category_nhs_incident_risk"/>
            <field name="sequence">20</field>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             GROUPS
        ══════════════════════════════════════════════════════════ -->
        <record id="group_hc_reporter" model="res.groups">
            <field name="name">Reporter</field>
            <field name="privilege_id" ref="privilege_hc_access_level"/>
        </record>

        <record id="group_hc_handler" model="res.groups">
            <field name="name">Handler</field>
            <field name="privilege_id" ref="privilege_hc_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_hc_reporter'))]"/>
        </record>

        <record id="group_hc_investigator" model="res.groups">
            <field name="name">Investigator</field>
            <field name="privilege_id" ref="privilege_hc_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_hc_handler'))]"/>
        </record>

        <record id="group_hc_risk_manager" model="res.groups">
            <field name="name">Risk Manager</field>
            <field name="privilege_id" ref="privilege_hc_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_hc_handler'))]"/>
        </record>

        <record id="group_hc_quality_lead" model="res.groups">
            <field name="name">Quality Lead</field>
            <field name="privilege_id" ref="privilege_hc_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_hc_investigator')), (4, ref('group_hc_risk_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hc_safeguarding" model="res.groups">
            <field name="name">Safeguarding Officer</field>
            <field name="privilege_id" ref="privilege_hc_safeguarding"/>
        </record>

        <!-- ══════════════════════════════════════════════════════════
             RECORD RULES
        ══════════════════════════════════════════════════════════ -->

        <!-- Company isolation on incidents (handlers see only their company) -->
        <record id="rule_incident_company" model="ir.rule">
            <field name="name">Incident: company isolation</field>
            <field name="model_id" ref="model_nhs_incident"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_hc_handler'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Reporters see only their own incidents -->
        <record id="rule_incident_reporter_own" model="ir.rule">
            <field name="name">Incident: reporter sees own reports only</field>
            <field name="model_id" ref="model_nhs_incident"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hc_reporter'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Company isolation on risks -->
        <record id="rule_risk_company" model="ir.rule">
            <field name="name">Risk: company isolation</field>
            <field name="model_id" ref="model_nhs_risk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_hc_handler'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- BAF/corporate registers: write only for quality leads -->
        <record id="rule_risk_baf_write" model="ir.rule">
            <field name="name">Risk: BAF/corporate writable by quality lead only</field>
            <field name="model_id" ref="model_nhs_risk"/>
            <field name="domain_force">['|',
                ('register_id.tier', 'not in', ['corporate', 'baf']),
                ('register_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_hc_risk_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
