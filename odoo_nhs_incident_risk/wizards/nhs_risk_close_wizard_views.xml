<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_risk_close_wizard_form" model="ir.ui.view">
        <field name="name">nhs.risk.close.wizard.form</field>
        <field name="model">nhs.risk.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Risk">
                <group>
                    <field name="risk_id" readonly="1"/>
                    <field name="closure_reason"
                           placeholder="Enter the reason for closing this risk…"
                           rows="5"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Close Risk"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
