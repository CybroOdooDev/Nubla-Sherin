<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_risk_review_wizard_form" model="ir.ui.view">
        <field name="name">nhs.risk.review.wizard.form</field>
        <field name="model">nhs.risk.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Risk Review">
                <group>
                    <field name="risk_id" readonly="1"/>
                    <field name="decision" widget="radio"/>
                </group>
                <group string="Re-score" invisible="decision != 'rescore'">
                    <field name="new_current_consequence"/>
                    <field name="new_current_likelihood"/>
                </group>
                <group string="Commentary">
                    <field name="commentary" nolabel="1"
                           placeholder="Notes, rationale, actions arising…"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Save Review"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
