<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_action_form" model="ir.ui.view">
        <field name="name">nhs.action.form</field>
        <field name="model">nhs.action</field>
        <field name="arch" type="xml">
            <form string="Action">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_submit_evidence" string="Submit Evidence"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_verify" string="Verify &amp; Close"
                            type="object" class="btn-success"
                            groups="odoo_nhs_incident_risk.group_hc_quality_lead"
                            invisible="state != 'evidence_review'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,evidence_review,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="name"/>
                            <field name="action_type"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="due_date"/>
                            <field name="verified_by_id" readonly="1"
                                   invisible="state != 'done'"/>
                            <field name="verified_at" readonly="1"
                                   invisible="state != 'done'"/>
                        </group>
                    </group>
                    <group string="Source">
                        <field name="incident_id"/>
                        <field name="investigation_id"/>
                        <field name="risk_id"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Completion Evidence"
                           invisible="state not in ('in_progress','evidence_review','done')">
                        <field name="completion_evidence" nolabel="1"/>
                    </group>
                    <group string="Effectiveness Check">
                        <field name="effectiveness_check"/>
                        <field name="effectiveness_days"
                               invisible="not effectiveness_check"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nhs_action_list" model="ir.ui.view">
        <field name="name">nhs.action.list</field>
        <field name="model">nhs.action</field>
        <field name="arch" type="xml">
            <list string="Actions"
                  decoration-danger="due_date and due_date &lt; context_today() and state not in ('done','cancelled')"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="incident_id" optional="show"/>
                <field name="risk_id" optional="show"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'open' and due_date and due_date &lt; context_today()"
                       decoration-warning="state == 'evidence_review'"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_action_my" model="ir.actions.act_window">
        <field name="name">My Actions</field>
        <field name="res_model">nhs.action</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_id','=',uid),('state','not in',['done','cancelled'])]</field>
    </record>

    <record id="action_nhs_action_all" model="ir.actions.act_window">
        <field name="name">All Actions</field>
        <field name="res_model">nhs.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
