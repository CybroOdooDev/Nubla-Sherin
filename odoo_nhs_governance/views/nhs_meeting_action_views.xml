<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for a single governance action -->
    <record id="view_nhs_meeting_action_form" model="ir.ui.view">
        <field name="name">nhs.meeting.action.form</field>
        <field name="model">nhs.meeting.action</field>
        <field name="arch" type="xml">
            <form string="Governance Action">
                <header>
                    <button name="action_start" string="Start" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_complete" string="Mark Complete" type="object"
                            invisible="state in ('open', 'completed')" class="btn-primary"/>
                    <button name="action_report_to_next_meeting" string="Report To Next Meeting"
                            type="object" invisible="state not in ('completed', 'in_progress') or not meeting_id or reported_meeting_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,completed,overdue"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="committee_id" readonly="1"/>
                            <field name="meeting_id"/>
                            <field name="agenda_item_id" domain="[('meeting_id', '=', meeting_id)]"
                                   context="{'default_meeting_id': meeting_id}"/>
                            <field name="baf_risk_id" domain="[('owning_committee_id', '=', committee_id)]"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="due_date"/>
                            <field name="reported_meeting_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Completion">
                        <field name="completion_note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view for the governance action log -->
    <record id="view_nhs_meeting_action_list" model="ir.ui.view">
        <field name="name">nhs.meeting.action.list</field>
        <field name="model">nhs.meeting.action</field>
        <field name="arch" type="xml">
            <list string="Action Log" decoration-danger="state == 'overdue'"
                  decoration-success="state == 'completed'">
                <field name="reference"/>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'overdue'"
                       decoration-warning="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <!-- Search view with filters and group-bys for actions -->
    <record id="view_nhs_meeting_action_search" model="ir.ui.view">
        <field name="name">nhs.meeting.action.search</field>
        <field name="model">nhs.meeting.action</field>
        <field name="arch" type="xml">
            <search string="Search Actions">
                <field name="name"/>
                <field name="reference"/>
                <field name="committee_id"/>
                <field name="owner_id"/>
                <filter name="my_actions" string="My Actions" domain="[('owner_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('state', '!=', 'completed')]"/>
                <filter name="overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <group name="group_by">
                    <filter name="group_committee" string="Committee" context="{'group_by': 'committee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action opening the Action Log (matters-arising) list -->
    <record id="action_nhs_meeting_action" model="ir.actions.act_window">
        <field name="name">Action Log</field>
        <field name="res_model">nhs.meeting.action</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_committee': 1, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No governance actions yet</p>
            <p>Actions arising from meetings and BAF gaps appear here — the matters-arising view.</p>
        </field>
    </record>
</odoo>
