<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Single Consolidated Governance Dashboard Client Action -->
    <record id="action_nhs_governance_dashboard_client" model="ir.actions.client">
        <field name="name">Governance Dashboard</field>
        <field name="tag">nhs_governance_dashboard</field>
    </record>

    <!-- Governance dashboard window actions -->
    <record id="action_nhs_gov_dashboard_upcoming_meetings" model="ir.actions.act_window">
        <field name="name">Upcoming Meetings</field>
        <field name="res_model">nhs.meeting</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('meeting_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'cancelled')]</field>
    </record>

    <record id="action_nhs_gov_dashboard_inquorate" model="ir.actions.act_window">
        <field name="name">Inquorate Meetings</field>
        <field name="res_model">nhs.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_quorate', '=', False), ('state', 'not in', ('scheduled', 'cancelled'))]</field>
    </record>

    <record id="action_nhs_gov_dashboard_overdue_actions" model="ir.actions.act_window">
        <field name="name">Overdue Actions</field>
        <field name="res_model">nhs.meeting.action</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'overdue')]</field>
    </record>

    <record id="action_nhs_gov_dashboard_doi_refresh_due" model="ir.actions.act_window">
        <field name="name">DoI Refreshes Due</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('nhs_gov_committee_membership_ids', '!=', False)]</field>
        <field name="help" type="html">
            <p>Directors and officers due an annual declaration-of-interest refresh receive an
               activity reminder automatically — open a contact record to see their declaration history.</p>
        </field>
    </record>

    <record id="action_nhs_gov_dashboard_tor_due" model="ir.actions.act_window">
        <field name="name">ToR Reviews Due</field>
        <field name="res_model">nhs.committee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tor_review_date', '!=', False), ('tor_review_date', '&lt;=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'active')]</field>
    </record>

    <record id="action_nhs_gov_dashboard_baf_unreviewed" model="ir.actions.act_window">
        <field name="name">BAF Risks Un-Reviewed</field>
        <field name="res_model">nhs.baf.risk</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('last_reviewed', '=', False)]</field>
    </record>

    <record id="action_nhs_gov_dashboard_baf_status" model="ir.actions.act_window">
        <field name="name">BAF Status</field>
        <field name="res_model">nhs.baf.risk</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_group_band': 1}</field>
    </record>

    <!-- ── Attendance report — a board-effectiveness metric ──────────── -->
    <record id="view_nhs_meeting_attendee_pivot" model="ir.ui.view">
        <field name="name">nhs.meeting.attendee.pivot</field>
        <field name="model">nhs.meeting.attendee</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Report">
                <field name="member_id" type="row"/>
                <field name="committee_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_nhs_meeting_attendee_list_report" model="ir.ui.view">
        <field name="name">nhs.meeting.attendee.list.report</field>
        <field name="model">nhs.meeting.attendee</field>
        <field name="arch" type="xml">
            <list string="Attendance Report" default_order="meeting_id desc">
                <field name="meeting_id"/>
                <field name="name"/>
                <field name="role"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'apologies'"
                       decoration-danger="status == 'absent'"/>
            </list>
        </field>
    </record>

    <record id="action_nhs_gov_attendance_report" model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">nhs.meeting.attendee</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_nhs_meeting_attendee_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_nhs_meeting_attendee_list_report')})]"/>
    </record>
</odoo>
