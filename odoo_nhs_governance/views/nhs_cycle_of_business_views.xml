<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_cycle_of_business_list" model="ir.ui.view">
        <field name="name">nhs.cycle.of.business.list</field>
        <field name="model">nhs.cycle.of.business</field>
        <field name="arch" type="xml">
            <list><field name="committee_id"/><field name="sequence"/><field name="title"/><field name="frequency"/><field name="scheduled_months"/><field name="purpose"/><field name="is_statutory"/></list>
        </field>
    </record>
    <record id="view_nhs_cycle_of_business_form" model="ir.ui.view">
        <field name="name">nhs.cycle.of.business.form</field>
        <field name="model">nhs.cycle.of.business</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="committee_id"/><field name="sequence"/><field name="title"/><field name="frequency"/><field name="scheduled_months"/><field name="purpose"/><field name="owner_director_id"/><field name="is_statutory"/></group></sheet></form>
        </field>
    </record>
    <record id="action_nhs_cycle_of_business" model="ir.actions.act_window">
        <field name="name">Cycle of Business</field>
        <field name="res_model">nhs.cycle.of.business</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
