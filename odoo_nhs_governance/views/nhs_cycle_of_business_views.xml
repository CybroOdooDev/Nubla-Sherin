<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Editable list view of standing cycle-of-business items, highlighting statutory ones -->
    <record id="view_nhs_cycle_of_business_list" model="ir.ui.view">
        <field name="name">nhs.cycle.of.business.list</field>
        <field name="model">nhs.cycle.of.business</field>
        <field name="arch" type="xml">
            <list string="Cycle Of Business" editable="bottom" decoration-warning="is_statutory">
                <field name="owner_partner_ids" column_invisible="1"/>
                <field name="committee_id"/>
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="frequency"/>
                <field name="scheduled_months" widget="many2many_tags"
                       invisible="frequency == 'every_meeting'"/>
                <field name="purpose"/>
                <field name="owner_id"/>
                <field name="is_statutory"/>
            </list>
        </field>
    </record>

    <!-- Form view for a single standing item: frequency, scheduled months and owner -->
    <record id="view_nhs_cycle_of_business_form" model="ir.ui.view">
        <field name="name">nhs.cycle.of.business.form</field>
        <field name="model">nhs.cycle.of.business</field>
        <field name="arch" type="xml">
            <form string="Cycle Of Business">
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Annual Accounts"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="frequency"/>
                            <field name="scheduled_months" widget="many2many_tags"
                                   invisible="frequency == 'every_meeting'"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="purpose"/>
                            <field name="owner_partner_ids" invisible="1"/>
                            <field name="owner_id"/>
                            <field name="is_statutory"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view with statutory filter and committee/frequency group-bys -->
    <record id="view_nhs_cycle_of_business_search" model="ir.ui.view">
        <field name="name">nhs.cycle.of.business.search</field>
        <field name="model">nhs.cycle.of.business</field>
        <field name="arch" type="xml">
            <search string="Search Cycle Of Business">
                <field name="title"/>
                <field name="committee_id"/>
                <filter name="statutory" string="Statutory" domain="[('is_statutory', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_committee" string="Committee" context="{'group_by': 'committee_id'}"/>
                    <filter name="group_frequency" string="Frequency" context="{'group_by': 'frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action opening the Cycle Of Business list/form, grouped by committee -->
    <record id="action_nhs_cycle_of_business" model="ir.actions.act_window">
        <field name="name">Cycle Of Business</field>
        <field name="res_model">nhs.cycle.of.business</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_committee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the annual cycle of business</p>
            <p>Standing items scheduled to specific meetings across the year — nothing statutory gets missed.</p>
        </field>
    </record>
</odoo>
