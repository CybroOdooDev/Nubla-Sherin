<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_director_list" model="ir.ui.view">
        <field name="name">nhs.director.list</field>
        <field name="model">nhs.director</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role_title"/>
                <field name="is_executive"/>
                <field name="appointment_date"/>
                <field name="term_end"/>
                <field name="fppr_status"/>
            </list>
        </field>
    </record>
    <record id="view_nhs_director_form" model="ir.ui.view">
        <field name="name">nhs.director.form</field>
        <field name="model">nhs.director</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="role_title"/>
                            <field name="is_executive"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="appointment_date"/>
                            <field name="term_end"/>
                            <field name="fppr_status"/>
                            <field name="fppr_check_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact"><group><field name="partner_id"/><field name="user_id"/></group></page>
                        <page string="Committees"><field name="committee_membership_ids"/></page>
                        <page string="Declarations"><field name="declaration_ids"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nhs_director" model="ir.actions.act_window">
        <field name="name">Directors</field>
        <field name="res_model">nhs.director</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
