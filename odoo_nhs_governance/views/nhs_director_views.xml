<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Governance-owned Directors register: res.partner scoped to is_nhs_board_member,
         surfacing the FPPR / executive / term fields this module adds, rather than just
         reusing Trust Management's generic Board Members list. -->

    <!-- List view of directors, focused on FPPR and term status -->
    <record id="view_nhs_gov_director_list" model="ir.ui.view">
        <field name="name">res.partner.nhs.gov.director.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Directors">
                <field name="name"/>
                <field name="nhs_board_role" string="Role"/>
                <field name="nhs_is_executive" string="Executive"/>
                <field name="term_start_date" string="Term Start"/>
                <field name="term_end_date" string="Term End"/>
                <field name="is_term_active" string="Term Active" widget="boolean"/>
                <field name="nhs_gov_fppr_status" string="FPPR Status"/>
                <field name="nhs_gov_fppr_check_date" string="FPPR Check Date"/>
                <field name="nhs_gov_committee_count" string="Committees"/>
            </list>
        </field>
    </record>

    <!-- Kanban view of directors, cards led by FPPR status rather than trust/voting info -->
    <record id="view_nhs_gov_director_kanban" model="ir.ui.view">
        <field name="name">res.partner.nhs.gov.director.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" record_draggable="false" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="nhs_board_role"/>
                <field name="nhs_is_executive"/>
                <field name="term_start_date"/>
                <field name="term_end_date"/>
                <field name="is_term_active"/>
                <field name="nhs_gov_fppr_status"/>
                <field name="nhs_gov_fppr_check_date"/>
                <field name="nhs_gov_committee_count"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="avatar_128" alt="Director" class="w-100 h-100 m-0" widget="image" options="{'img_class': 'object-fit-cover w-100 h-100'}"/>
                        </aside>

                        <main class="ps-2 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <field name="name" class="mb-0 fw-bold fs-5"/>
                                <span t-attf-class="badge #{record.nhs_is_executive.raw_value ? 'text-bg-primary' : 'text-bg-secondary'}"
                                      style="font-size: 0.72em; padding: 2px 6px;">
                                    <t t-if="record.nhs_is_executive.raw_value">Executive</t>
                                    <t t-else="">Non-Executive</t>
                                </span>
                            </div>

                            <div style="font-size: 0.88em; color: #4b5563;">
                                <!-- Role -->
                                <div t-if="record.nhs_board_role.raw_value" class="d-flex align-items-center mb-1 text-truncate">
                                    <i class="fa fa-briefcase me-2 text-secondary" style="width: 14px;" title="Role"/>
                                    <span><field name="nhs_board_role"/></span>
                                </div>
                                <!-- Term Dates -->
                                <div class="d-flex align-items-center text-muted mb-1" style="font-size: 0.85em;">
                                    <i class="fa fa-calendar me-2" style="width: 14px;" title="Term Dates"/>
                                    <span>
                                        <t t-if="record.term_start_date.raw_value"><field name="term_start_date"/></t>
                                        <t t-else="">...</t>
                                        to
                                        <t t-if="record.term_end_date.raw_value"><field name="term_end_date"/></t>
                                        <t t-else="">Present</t>
                                    </span>
                                </div>
                                <!-- FPPR check date -->
                                <div t-if="record.nhs_gov_fppr_check_date.raw_value" class="d-flex align-items-center mb-1 text-truncate">
                                    <i class="fa fa-shield me-2 text-secondary" style="width: 14px;" title="FPPR Check Date"/>
                                    <span>FPPR checked <field name="nhs_gov_fppr_check_date"/></span>
                                </div>
                            </div>

                            <!-- Footer -->
                            <footer class="mt-2">
                                <span t-attf-class="badge #{
                                        record.nhs_gov_fppr_status.raw_value === 'passed' ? 'text-bg-success' :
                                        record.nhs_gov_fppr_status.raw_value === 'concern' ? 'text-bg-danger' :
                                        record.nhs_gov_fppr_status.raw_value === 'in_progress' ? 'text-bg-warning' : 'text-bg-light'}"
                                      style="font-size: 0.78em; padding: 4px 8px;">
                                    <field name="nhs_gov_fppr_status"/>
                                </span>
                                <span t-if="record.nhs_gov_committee_count.raw_value" class="badge text-bg-info ms-1"
                                      style="font-size: 0.78em; padding: 4px 8px;">
                                    <t t-esc="record.nhs_gov_committee_count.raw_value"/> committee(s)
                                </span>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view: filter/group directors by FPPR status and executive/non-executive -->
    <record id="view_nhs_gov_director_search" model="ir.ui.view">
        <field name="name">res.partner.nhs.gov.director.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Search Directors">
                <field name="name"/>
                <field name="nhs_board_role"/>
                <filter string="Executive" name="filter_executive" domain="[('nhs_is_executive', '=', True)]"/>
                <filter string="Non-Executive" name="filter_non_executive" domain="[('nhs_is_executive', '=', False)]"/>
                <separator/>
                <filter string="FPPR Not Checked" name="filter_fppr_not_checked" domain="[('nhs_gov_fppr_status', '=', 'not_checked')]"/>
                <filter string="FPPR In Progress" name="filter_fppr_in_progress" domain="[('nhs_gov_fppr_status', '=', 'in_progress')]"/>
                <filter string="FPPR Passed" name="filter_fppr_passed" domain="[('nhs_gov_fppr_status', '=', 'passed')]"/>
                <filter string="FPPR Concern Raised" name="filter_fppr_concern" domain="[('nhs_gov_fppr_status', '=', 'concern')]"/>
                <group name="group_by">
                    <filter string="Role" name="groupby_role" context="{'group_by': 'nhs_board_role'}"/>
                    <filter string="FPPR Status" name="groupby_fppr_status" context="{'group_by': 'nhs_gov_fppr_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action: the Directors register, filtered to NHS board members -->
    <record id="action_nhs_gov_director" model="ir.actions.act_window">
        <field name="name">Directors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_nhs_gov_director_search"/>
        <field name="domain">[('is_nhs_board_member', '=', True)]</field>
        <field name="context">{'default_is_nhs_board_member': True, 'default_is_company': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_nhs_gov_director_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_nhs_gov_director_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No directors found.</p>
            <p>Directors/officers are board members with appointment, executive and Fit and
               Proper Person (FPPR) details tracked for governance purposes.</p>
        </field>
    </record>
</odoo>
