<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extends the "NHS Governance" tab that odoo_nhs_trust_management already adds to the
         Contact form (page name="nhs_governance"), rather than adding a second, competing tab.
         Adds FPPR tracking plus committee-membership / declaration-of-interest smart buttons. -->
    <record id="view_partner_form_gov" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.nhs_governance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="odoo_nhs_trust_management.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_nhs_gov_committees"
                        class="oe_stat_button" icon="fa-users"
                        invisible="not is_nhs_board_member or not nhs_gov_committee_count">
                    <field name="nhs_gov_committee_count" widget="statinfo" string="Committees"/>
                </button>
                <button type="object" name="action_view_nhs_gov_declarations"
                        class="oe_stat_button" icon="fa-balance-scale"
                        invisible="not is_nhs_board_member">
                    <field name="nhs_gov_declaration_count" widget="statinfo" string="Declarations"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='nhs_governance']" position="inside">
                <group string="Fit and Proper Person (FPPR)">
                    <field name="nhs_is_executive"/>
                    <field name="nhs_gov_fppr_status" widget="badge"
                           decoration-success="nhs_gov_fppr_status == 'passed'"
                           decoration-warning="nhs_gov_fppr_status in ('not_checked', 'in_progress')"
                           decoration-danger="nhs_gov_fppr_status == 'concern'"/>
                    <field name="nhs_gov_fppr_check_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
