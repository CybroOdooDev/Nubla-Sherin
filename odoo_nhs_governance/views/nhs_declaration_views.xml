<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_declaration_list" model="ir.ui.view">
        <field name="name">nhs.declaration.list</field>
        <field name="model">nhs.declaration</field>
        <field name="arch" type="xml">
            <list><field name="director_id"/><field name="declaration_type"/><field name="event"/><field name="related_org"/><field name="date_from"/><field name="date_to"/><field name="conflict_management"/><field name="is_published"/></list>
        </field>
    </record>
    <record id="view_nhs_declaration_form" model="ir.ui.view">
        <field name="name">nhs.declaration.form</field>
        <field name="model">nhs.declaration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="director_id"/><field name="category_id"/><field name="declaration_type"/><field name="event"/><field name="is_published"/></group>
                        <group><field name="related_org"/><field name="value_band"/><field name="date_from"/><field name="date_to"/></group>
                    </group>
                    <group string="Meeting Conflict"><field name="meeting_id"/><field name="agenda_item_id"/><field name="conflict_management"/></group>
                    <field name="nature"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nhs_declaration" model="ir.actions.act_window">
        <field name="name">Interests Register</field>
        <field name="res_model">nhs.declaration</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_nhs_declaration_annual" model="ir.actions.act_window">
        <field name="name">Annual Declarations</field>
        <field name="res_model">nhs.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('event', '=', 'annual')]</field>
    </record>
</odoo>
