<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_committee_list" model="ir.ui.view">
        <field name="name">nhs.committee.list</field>
        <field name="model">nhs.committee</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="committee_type_id"/>
                <field name="frequency"/>
                <field name="tor_review_date"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <record id="view_nhs_committee_form" model="ir.ui.view">
        <field name="name">nhs.committee.form</field>
        <field name="model">nhs.committee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,dormant,disbanded"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="committee_type_id"/>
                            <field name="parent_id"/>
                            <field name="trust_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="tor_review_date"/>
                            <field name="quorum_min"/>
                            <field name="quorum_min_ned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms of Reference"><field name="terms_of_reference"/></page>
                        <page string="Membership">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="director_id"/>
                                    <field name="partner_id"/>
                                    <field name="user_id"/>
                                    <field name="role"/>
                                    <field name="is_ned"/>
                                    <field name="voting"/>
                                    <field name="term_start"/>
                                    <field name="term_end"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cycle of Business"><field name="cycle_item_ids"/></page>
                        <page string="Meetings"><field name="meeting_ids"/></page>
                        <page string="BAF Risks"><field name="baf_risk_ids"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_nhs_committee" model="ir.actions.act_window">
        <field name="name">Committees &amp; Boards</field>
        <field name="res_model">nhs.committee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
