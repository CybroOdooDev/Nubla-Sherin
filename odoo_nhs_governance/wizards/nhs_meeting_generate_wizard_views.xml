<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for the recurring meeting series generation wizard -->
    <record id="view_nhs_meeting_generate_wizard_form" model="ir.ui.view">
        <field name="name">nhs.meeting.generate.wizard.form</field>
        <field name="model">nhs.meeting.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Recurring Meeting Series">
                <group>
                    <field name="committee_id" readonly="1"/>
                    <field name="frequency"/>
                    <field name="start_date"/>
                    <field name="number_of_meetings"/>
                    <field name="location"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard action to launch the recurring meeting series generator -->
    <record id="action_nhs_meeting_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Meeting Series</field>
        <field name="res_model">nhs.meeting.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
