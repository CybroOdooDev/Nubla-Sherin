<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nhs_agenda_from_cycle_wizard_form" model="ir.ui.view">
        <field name="name">nhs.agenda.from.cycle.wizard.form</field>
        <field name="model">nhs.agenda.from.cycle.wizard</field>
        <field name="arch" type="xml">
            <form string="Populate Agenda From Cycle Of Business">
                <p>This pulls in the standing items due from the committee's cycle of business for
                   this meeting's month. Ad-hoc items can be added separately afterwards.</p>
                <group>
                    <field name="meeting_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_populate" string="Populate Agenda" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
