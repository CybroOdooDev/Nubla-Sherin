<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_doi_register" model="ir.actions.report">
        <field name="name">Declarations Of Interest Register</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_governance.report_doi_register</field>
        <field name="print_report_name">'Declarations of Interest Register - ' + object.name</field>
    </record>

    <template id="report_doi_register">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="company">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #000000; font-size: 13px;">
                        <div class="text-center mb-4">
                            <h2 style="font-weight: bold;">Declarations Of Interest Register</h2>
                            <h4 style="color: #555555; font-weight: normal;" t-out="company.name"/>
                            <hr style="border-top: 1px solid #000000;"/>
                        </div>
                        <t t-set="declarations" t-value="company.env['nhs.declaration'].search([
                            ('company_id', '=', company.id), ('is_published', '=', True)], order='partner_id, date_from desc')"/>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Director / Officer</th>
                                    <th>Category</th>
                                    <th>Nature</th>
                                    <th>Related Organisation</th>
                                    <th>From</th>
                                    <th>To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="declarations" t-as="decl">
                                    <td t-out="decl.partner_id.name"/>
                                    <td t-out="decl.category_id.name"/>
                                    <td t-out="decl.nature or ('Nil return' if decl.category_code == 'nil' else '')"/>
                                    <td t-out="decl.related_org"/>
                                    <td t-out="decl.date_from"/>
                                    <td t-out="decl.date_to"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
