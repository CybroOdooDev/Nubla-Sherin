<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_baf" model="ir.actions.report">
        <field name="name">BAF Report</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_governance.report_baf</field>
        <field name="print_report_name">'Board Assurance Framework - ' + object.name</field>
    </record>

    <template id="report_baf">
        <t t-call="web.html_container">
            <t t-set="companies" t-value="docs or env.company"/>
            <t t-foreach="companies" t-as="company">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #000000; font-size: 13px;">
                        <div class="text-center mb-4">
                            <h2 style="font-weight: bold;">Board Assurance Framework</h2>
                            <h4 style="color: #555555; font-weight: normal;" t-out="company.name"/>
                            <hr style="border-top: 1px solid #000000;"/>
                        </div>
                        <t t-set="objectives" t-value="company.env['nhs.baf.objective'].search([('company_id', '=', company.id)])"/>
                        <t t-foreach="objectives" t-as="objective">
                            <h4 style="font-weight: bold; margin-top: 20px;" t-out="(objective.code or '') + ' ' + objective.name"/>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr style="background-color: #f5f5f5;">
                                        <th>Ref</th>
                                        <th>Principal Risk</th>
                                        <th>Committee</th>
                                        <th>C</th><th>L</th><th>Score</th><th>Band</th>
                                        <th>Target</th>
                                        <th>Assurance Rating</th>
                                        <th>Last Reviewed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="objective.risk_ids" t-as="risk">
                                        <td t-out="risk.reference"/>
                                        <td t-out="risk.name"/>
                                        <td t-out="risk.owning_committee_id.name"/>
                                        <td t-out="risk.consequence"/>
                                        <td t-out="risk.likelihood"/>
                                        <td t-out="risk.current_score"/>
                                        <td t-out="risk.current_band"/>
                                        <td t-out="risk.target_score"/>
                                        <td t-out="risk.assurance_rating"/>
                                        <td t-out="risk.last_reviewed"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
