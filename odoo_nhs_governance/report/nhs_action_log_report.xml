<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_action_log" model="ir.actions.report">
        <field name="name">Action Log</field>
        <field name="model">nhs.committee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_nhs_governance.report_action_log</field>
        <field name="print_report_name">'Action Log - ' + object.name</field>
        <field name="binding_model_id" ref="model_nhs_committee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_action_log">
        <t t-call="web.html_container">
            <t t-set="committees" t-value="docs or env['nhs.committee'].search([('state', '=', 'active')]) or env['nhs.committee'].search([])"/>
            <t t-foreach="committees" t-as="committee">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #000000; font-size: 13px;">
                        <div class="text-center mb-4">
                            <h2 style="font-weight: bold;">Action Log</h2>
                            <h4 style="color: #555555; font-weight: normal;" t-out="committee.complete_name"/>
                            <hr style="border-top: 1px solid #000000;"/>
                        </div>
                        <t t-set="actions" t-value="committee.env['nhs.meeting.action'].search([
                            ('committee_id', '=', committee.id)], order='due_date')"/>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr style="background-color: #f5f5f5;">
                                    <th>Reference</th>
                                    <th>Description</th>
                                    <th>Owner</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Reported To</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="actions" t-as="action">
                                    <td t-out="action.reference"/>
                                    <td t-out="action.name"/>
                                    <td t-out="action.owner_id.name"/>
                                    <td t-out="action.due_date"/>
                                    <td t-out="action.state"/>
                                    <td t-out="action.reported_meeting_id.name"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
