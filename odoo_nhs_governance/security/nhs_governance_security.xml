<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_nhs_governance" model="ir.module.category">
            <field name="name">NHS Governance Management</field>
            <field name="description">Board and committee governance access levels.</field>
            <field name="sequence">56</field>
        </record>

        <record id="privilege_governance_access_level" model="res.groups.privilege">
            <field name="name">Governance Access Level</field>
            <field name="category_id" ref="module_category_nhs_governance"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_nhs_gov_viewer" model="res.groups">
            <field name="name">Governance Viewer</field>
            <field name="privilege_id" ref="privilege_governance_access_level"/>
            <field name="comment">Read governance records within company scope. Committee-scoped and portal restrictions can be layered in customer deployments.</field>
        </record>

        <record id="group_nhs_gov_officer" model="res.groups">
            <field name="name">Committee Secretary / Governance Officer</field>
            <field name="privilege_id" ref="privilege_governance_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
            <field name="comment">Manage committees, meetings, agendas, papers, minutes, actions, declarations and BAF records.</field>
        </record>

        <record id="group_nhs_gov_manager" model="res.groups">
            <field name="name">Governance Manager / Company Secretary</field>
            <field name="privilege_id" ref="privilege_governance_access_level"/>
            <field name="implied_ids" eval="[(4, ref('group_nhs_gov_officer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full governance control including configuration.</field>
        </record>

        <record id="rule_nhs_committee_company" model="ir.rule">
            <field name="name">nhs.committee: company scope</field>
            <field name="model_id" ref="model_nhs_committee"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
        <record id="rule_nhs_director_company" model="ir.rule">
            <field name="name">nhs.director: company scope</field>
            <field name="model_id" ref="model_nhs_director"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
        <record id="rule_nhs_meeting_company" model="ir.rule">
            <field name="name">nhs.meeting: company scope</field>
            <field name="model_id" ref="model_nhs_meeting"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
        <record id="rule_nhs_declaration_company" model="ir.rule">
            <field name="name">nhs.declaration: company scope</field>
            <field name="model_id" ref="model_nhs_declaration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
        <record id="rule_nhs_baf_objective_company" model="ir.rule">
            <field name="name">nhs.baf.objective: company scope</field>
            <field name="model_id" ref="model_nhs_baf_objective"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
        <record id="rule_nhs_baf_risk_company" model="ir.rule">
            <field name="name">nhs.baf.risk: company scope</field>
            <field name="model_id" ref="model_nhs_baf_risk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_nhs_gov_viewer'))]"/>
        </record>
    </data>
</odoo>
