<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_nhs_governance.NhsGovernanceDashboard" owl="1">
        <div class="o_nhs_governance_dashboard o_content p-4" style="height: 100%; overflow-y: auto;">
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
                    <div class="spinner-border text-nhs-blue" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>

            <t t-else="">
                <!-- Dashboard Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom bg-white p-3 rounded-3 shadow-sm">
                    <div>
                        <h3 class="fw-bold mb-0 text-nhs-blue">
                            <i class="fa fa-tachometer me-2"/>Governance Dashboard
                        </h3>
                        <div class="text-muted small">
                            NHS Board &amp; Committee Governance Overview
                        </div>
                    </div>
                    <button class="btn btn-outline-nhs-blue btn-sm fw-semibold" t-on-click="loadData">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                </div>

                <!-- KPI Metric Cards Grid (NHS Blue Theme) -->
                <div class="row g-3 mb-4">
                    <!-- Upcoming Meetings -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openUpcomingMeetings">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Upcoming</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-calendar"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.upcoming_count"/>
                                <small class="text-muted">Meetings scheduled</small>
                            </div>
                        </div>
                    </div>

                    <!-- Inquorate Meetings -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openInquorateMeetings">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Inquorate</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-exclamation-triangle"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.inquorate_count"/>
                                <small class="text-muted">Non-quorate flags</small>
                            </div>
                        </div>
                    </div>

                    <!-- Overdue Actions -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openOverdueActions">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">Overdue</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-clock-o"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.overdue_actions_count"/>
                                <small class="text-muted">Action items pending</small>
                            </div>
                        </div>
                    </div>

                    <!-- DoI Refreshes -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openDoiRefreshes">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">DoI Refresh</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-id-card-o"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.doi_count"/>
                                <small class="text-muted">Members to review</small>
                            </div>
                        </div>
                    </div>

                    <!-- ToR Reviews Due -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openTorReviews">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">ToR Reviews</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-file-text-o"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.tor_count"/>
                                <small class="text-muted">Committees due</small>
                            </div>
                        </div>
                    </div>

                    <!-- BAF Unreviewed -->
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card h-100 shadow-sm rounded-3 gov-stat-card cursor-pointer"
                             t-on-click="openBafUnreviewed">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase small fw-bold text-muted">BAF Risks</span>
                                    <div class="stat-icon-wrapper">
                                        <i class="fa fa-shield"/>
                                    </div>
                                </div>
                                <h3 class="fw-bold mb-0 text-nhs-blue" t-esc="state.data.baf_unreviewed_count"/>
                                <small class="text-muted">Un-reviewed risks</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Panels Layout -->
                <div class="row g-4">
                    <!-- Left Column: Meetings & Actions -->
                    <div class="col-lg-7">
                        <!-- Upcoming Meetings Panel -->
                        <div class="card shadow-sm mb-4 rounded-3">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-calendar-check-o text-nhs-blue me-2"/>Upcoming Meetings
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="openUpcomingMeetings">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="small">
                                                <th>Meeting / Committee</th>
                                                <th>Date / Time</th>
                                                <th>Venue</th>
                                                <th>Quorate</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="!state.data.upcoming_list.length">
                                                <tr>
                                                    <td colspan="5" class="text-center py-4 text-muted">
                                                        No upcoming meetings scheduled
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="state.data.upcoming_list" t-as="m" t-key="m.id">
                                                <tr class="cursor-pointer" t-on-click="() => this.openRecord('nhs.meeting', m.id)">
                                                    <td class="fw-semibold text-nhs-blue" t-esc="m.name"/>
                                                    <td class="small text-muted" t-esc="m.date"/>
                                                    <td class="small" t-esc="m.venue"/>
                                                    <td>
                                                        <span t-if="m.is_quorate" class="badge bg-nhs-blue"><i class="fa fa-check me-1"/>Quorate</span>
                                                        <span t-else="" class="badge text-bg-warning"><i class="fa fa-exclamation me-1"/>Inquorate</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge text-bg-secondary" t-esc="m.state_label"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Overdue Actions Panel -->
                        <div class="card shadow-sm rounded-3">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-tasks text-nhs-blue me-2"/>Overdue Actions
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="openOverdueActions">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="small">
                                                <th>Action Item</th>
                                                <th>Meeting</th>
                                                <th>Assigned To</th>
                                                <th>Due Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-if="!state.data.overdue_actions_list.length">
                                                <tr>
                                                    <td colspan="4" class="text-center py-4 text-muted">
                                                        <i class="fa fa-check-circle text-success me-1"/> No overdue action items
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-foreach="state.data.overdue_actions_list" t-as="act" t-key="act.id">
                                                <tr class="cursor-pointer" t-on-click="() => this.openRecord('nhs.meeting.action', act.id)">
                                                    <td class="fw-semibold text-dark" t-esc="act.name"/>
                                                    <td class="small text-muted" t-esc="act.meeting_name"/>
                                                    <td class="small" t-esc="act.assigned_to"/>
                                                    <td>
                                                        <span class="badge text-bg-secondary" t-esc="act.due_date"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: BAF & Reminders -->
                    <div class="col-lg-5">
                        <!-- BAF Risk Status Panel (NHS Blue Theme) -->
                        <div class="card shadow-sm mb-4 rounded-3">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-shield text-nhs-blue me-2"/>BAF Risk Register Overview
                                </h6>
                                <button class="btn btn-sm btn-link text-nhs-blue p-0 text-decoration-none fw-semibold" t-on-click="() => this.openBafStatus()">
                                    View All <i class="fa fa-arrow-right ms-1"/>
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small text-muted">Total BAF Risks Registered</span>
                                    <span class="badge bg-nhs-blue fs-6" t-esc="state.data.baf_total"/>
                                </div>
                                <!-- Risk Bands Grid (NHS Blue Theme) -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="p-2 baf-band-card baf-band-extreme rounded-2 cursor-pointer"
                                             t-on-click="() => this.openBafStatus('extreme')">
                                            <div class="small fw-bold text-dark">Extreme (15-25)</div>
                                            <div class="fs-5 fw-bold text-nhs-blue" t-esc="state.data.baf_bands.extreme"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 baf-band-card baf-band-high rounded-2 cursor-pointer"
                                             t-on-click="() => this.openBafStatus('high')">
                                            <div class="small fw-bold text-dark">High (8-12)</div>
                                            <div class="fs-5 fw-bold text-nhs-blue" t-esc="state.data.baf_bands.high"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 baf-band-card baf-band-moderate rounded-2 cursor-pointer"
                                             t-on-click="() => this.openBafStatus('moderate')">
                                            <div class="small fw-bold text-dark">Moderate (4-6)</div>
                                            <div class="fs-5 fw-bold text-nhs-blue" t-esc="state.data.baf_bands.moderate"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 baf-band-card baf-band-low rounded-2 cursor-pointer"
                                             t-on-click="() => this.openBafStatus('low')">
                                            <div class="small fw-bold text-dark">Low (1-3)</div>
                                            <div class="fs-5 fw-bold text-nhs-blue" t-esc="state.data.baf_bands.low"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="fw-bold small mb-2 text-muted">Un-Reviewed BAF Risks</div>
                                <t t-if="!state.data.baf_unreviewed_list.length">
                                    <div class="small text-muted text-center py-2">
                                        <i class="fa fa-check-circle text-success me-1"/> All BAF risks up to date
                                    </div>
                                </t>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="state.data.baf_unreviewed_list" t-as="r" t-key="r.id">
                                        <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center cursor-pointer"
                                            t-on-click="() => this.openRecord('nhs.baf.risk', r.id)">
                                            <div>
                                                <div class="small fw-semibold text-dark" t-esc="r.name"/>
                                                <div class="small text-muted opacity-75" t-esc="r.objective_name"/>
                                            </div>
                                            <span class="badge bg-nhs-blue" t-esc="'Score: ' + r.score"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>

                        <!-- Governance Reminders Panel -->
                        <div class="card shadow-sm rounded-3">
                            <div class="card-header bg-white py-3">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-bell-o text-nhs-blue me-2"/>Governance Reminders
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold small text-dark"><i class="fa fa-file-text me-1 text-nhs-blue"/>ToR Reviews Due</span>
                                    <button class="btn btn-sm btn-link text-nhs-blue p-0 small text-decoration-none fw-semibold" t-on-click="openTorReviews">
                                        View All
                                    </button>
                                </div>
                                <ul class="list-group list-group-flush mb-3">
                                    <t t-if="!state.data.tor_list.length">
                                        <li class="list-group-item px-0 py-2 small text-muted text-center">
                                            No committee terms of reference review due
                                        </li>
                                    </t>
                                    <t t-foreach="state.data.tor_list" t-as="c" t-key="c.id">
                                        <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center cursor-pointer"
                                            t-on-click="() => this.openRecord('nhs.committee', c.id)">
                                            <div>
                                                <div class="small fw-semibold text-dark" t-esc="c.name"/>
                                                <div class="small text-muted opacity-75" t-esc="'Chair: ' + c.chair_name"/>
                                            </div>
                                            <span class="badge text-bg-secondary" t-esc="c.tor_review_date"/>
                                        </li>
                                    </t>
                                </ul>

                                <div class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                                    <span class="fw-bold small text-dark"><i class="fa fa-id-card me-1 text-nhs-blue"/>DoI Annual Refresh Due</span>
                                    <button class="btn btn-sm btn-link text-nhs-blue p-0 small text-decoration-none fw-semibold" t-on-click="openDoiRefreshes">
                                        View All
                                    </button>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <t t-if="!state.data.doi_list.length">
                                        <li class="list-group-item px-0 py-2 small text-muted text-center">
                                            All declaration refreshes completed
                                        </li>
                                    </t>
                                    <t t-foreach="state.data.doi_list" t-as="p" t-key="p.id">
                                        <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center cursor-pointer"
                                            t-on-click="() => this.openRecord('res.partner', p.id)">
                                            <div>
                                                <div class="small fw-semibold text-dark" t-esc="p.name"/>
                                                <div class="small text-muted opacity-75" t-esc="p.email"/>
                                            </div>
                                            <span class="badge bg-nhs-blue" t-esc="p.memberships_count + ' committees'"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
