<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Three lines of defence -->
    <record id="assurance_line_first" model="nhs.gov.assurance.line">
        <field name="name">First Line — Operational Management</field>
        <field name="code">first</field>
        <field name="sequence">10</field>
        <field name="description">Assurance from operational management itself — day-to-day controls, local audits and performance monitoring.</field>
    </record>
    <record id="assurance_line_second" model="nhs.gov.assurance.line">
        <field name="name">Second Line — Oversight Functions</field>
        <field name="code">second</field>
        <field name="sequence">20</field>
        <field name="description">Assurance from oversight functions — risk management, compliance, quality governance functions independent of the front line.</field>
    </record>
    <record id="assurance_line_third" model="nhs.gov.assurance.line">
        <field name="name">Third Line — Independent Assurance</field>
        <field name="code">third</field>
        <field name="sequence">30</field>
        <field name="description">Independent assurance — internal audit, external audit, regulatory inspection (e.g. CQC).</field>
    </record>
</odoo>
