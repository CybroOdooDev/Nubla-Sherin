<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_nhs_meeting_action" model="ir.sequence">
        <field name="name">NHS Governance Action Reference</field>
        <field name="code">nhs.meeting.action</field>
        <field name="prefix">GOV-ACT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_nhs_baf_risk" model="ir.sequence">
        <field name="name">NHS BAF Principal Risk Reference</field>
        <field name="code">nhs.baf.risk</field>
        <field name="prefix">BAF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
