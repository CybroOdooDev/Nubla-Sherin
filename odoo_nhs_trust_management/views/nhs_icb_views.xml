<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Smart Button Action -->
    <record id="action_nhs_trust_from_icb" model="ir.actions.act_window">
        <field name="name">Associated Trusts</field>
        <field name="res_model">nhs.trust</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('icb_id', '=', active_id)]</field>
        <field name="context">{'default_icb_id': active_id}</field>
    </record>

    <!-- Tree View -->
    <record id="view_nhs_icb_tree" model="ir.ui.view">
        <field name="name">nhs.icb.tree</field>
        <field name="model">nhs.icb</field>
        <field name="arch" type="xml">
            <list string="NHS Integrated Care Boards (ICBs)">
                <field name="code"/>
                <field name="name"/>
                <field name="short_name"/>
                <field name="region_id"/>
                <field name="trust_count" string="Trusts Count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_icb_form" model="ir.ui.view">
        <field name="name">nhs.icb.form</field>
        <field name="model">nhs.icb</field>
        <field name="arch" type="xml">
            <form string="NHS Integrated Care Board (ICB)">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_nhs_trust_from_icb)d" type="action" class="oe_stat_button" icon="fa-hospital-o">
                            <field name="trust_count" string="Trusts" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. NHS Humber and North Yorkshire ICB"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Core Identifiers">
                            <field name="code" placeholder="e.g. QOP"/>
                            <field name="short_name" placeholder="e.g. Humber &amp; NY"/>
                            <field name="region_id"/>
                        </group>
                        <group string="Key Metrics &amp; Contact">
                            <field name="population_served"/>
                            <field name="website" widget="url" placeholder="e.g. https://humberandnorthyorkshire.icb.nhs.uk"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Headquarters &amp; Info" name="hq_info">
                            <group>
                                <field name="headquarters_address" placeholder="Specify full postal address..."/>
                            </group>
                        </page>
                        <page string="ICS Subdivisions" name="ics_subdivisions">
                            <field name="ics_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nhs_icb_search" model="ir.ui.view">
        <field name="name">nhs.icb.search</field>
        <field name="model">nhs.icb</field>
        <field name="arch" type="xml">
            <search string="Search ICBs">
                <field name="name"/>
                <field name="code"/>
                <field name="region_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="NHS Region" name="group_by_region" context="{'group_by': 'region_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_nhs_icb" model="ir.actions.act_window">
        <field name="name">NHS Integrated Care Boards (ICBs)</field>
        <field name="res_model">nhs.icb</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nhs_icb_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a new Integrated Care Board (ICB) for England.
            </p>
        </field>
    </record>
</odoo>
