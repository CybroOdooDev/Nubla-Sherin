<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_nhs_trust_root"
              name="NHS Trusts"
              web_icon="odoo_nhs_trust_management,static/description/icon.png"
              sequence="45"/>

    <!-- Submenus -->
    <menuitem id="menu_nhs_trust"
              name="Trusts"
              parent="menu_nhs_trust_root"
              action="action_nhs_trust"
              sequence="10"/>

    <!-- Configuration Menu -->
