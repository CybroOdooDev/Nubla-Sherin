<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="external_layout_boxed_custom" inherit_id="web.external_layout_boxed">

      <xpath expr="//div[@class='o_footer_content row border-top pt-2']/div[@class='col-8']" position="replace">
          <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <!-- Footer content centered -->
            <div class="text-center flex-grow-1">
                <span t-field="company.report_footer"/>
            </div>
            <!-- Page number on the right -->
             <span t-if="report_type == 'pdf'" class="text-muted">Page <span class="page"/> / <span class="topage"/></span>

        </div>
    </div>

    </xpath>



  </template>



</odoo>






