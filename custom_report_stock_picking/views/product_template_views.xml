<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_keep_description" model="ir.ui.view">
        <field name="name">product.template.description.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group[@name='operations']" position="inside">
                <field name="keep_description"/>
            </xpath>
        </field>
    </record>
</odoo>