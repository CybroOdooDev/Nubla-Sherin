<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_document_split_description"
              inherit_id="account.report_invoice_document">
        <xpath expr="//thead/tr/th[@name='th_description']" position="replace">
            <th name="th_reference" class="text-start">Reference</th>
            <th name="th_description" class="text-start">Description</th>
        </xpath>
        <xpath expr="//tbody[@class='invoice_tbody']//td[@name='account_invoice_line_name']"
               position="replace">
            <td class="text-start">
                <span t-field="line.product_id.default_code"/>
            </td>
            <td class="text-start">
                <span t-esc="line.name.split(']', 1)[-1].strip() if ']' in line.name else line.name"/>
            </td>
        </xpath>
             <xpath expr="//table[@name='invoice_line_table']"
               position="before">
            <style>
                table[name="invoice_line_table"] thead th {
                    font-weight: 700 !important;
                }
                table[name="invoice_line_table"] tbody td {
                font-size: 14px !important;
                }
            </style>
        </xpath>

    </template>
</odoo>
