<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_epic_condition_list" model="ir.ui.view">
        <field name="name">epic.condition.list</field>
        <field name="model">epic.condition</field>
        <field name="arch" type="xml">
            <list string="Conditions">
                <header>
                    <button name="action_sync_conditions" type="object"
                            string="Sync Conditions from Epic" class="btn-primary" display="always"/>
                </header>
                <field name="condition_name"/>
                <field name="patient_id"/>
                <field name="category"/>
                <field name="clinical_status"
                       decoration-success="clinical_status in ('resolved','remission')"
                       decoration-warning="clinical_status in ('inactive','relapse')"
                       decoration-danger="clinical_status == 'active'"
                       widget="badge"/>
                <field name="verification_status"
                       decoration-success="verification_status == 'confirmed'"
                       decoration-warning="verification_status == 'unconfirmed'"
                       widget="badge"/>
                <field name="severity"/>
                <field name="onset_date"/>
                <field name="recorded_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_epic_condition_form" model="ir.ui.view">
        <field name="name">epic.condition.form</field>
        <field name="model">epic.condition</field>
        <field name="arch" type="xml">
            <form string="Condition">
                <header>
                    <button name="action_push_to_epic" type="object"
                            string="Push to Epic" class="btn-primary"
                            invisible="epic_id != False"/>
                    <button name="action_sync_conditions" type="object"
                            string="Sync Conditions from Epic" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="condition_name" placeholder="Condition / Diagnosis Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="clinical_status"/>
                            <field name="verification_status"/>
                        </group>
                        <group string="Patient &amp; Record">
                            <field name="patient_id"/>
                            <field name="patient_epic_id"/>
                            <field name="onset_date"/>
                            <field name="abatement_date"/>
                            <field name="recorded_date"/>
                            <field name="epic_id"/>
                        </group>
                    </group>
                    <group string="Condition Code">
                        <field name="condition_code"/>
                        <field name="condition_system"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_epic_condition" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">epic.condition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Conditions Found</p>
            <p>Click "Sync Conditions from Epic" to fetch condition data, or create a new record to push to Epic.</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_epic_conditions" name="Conditions"
              parent="menu_epic_integration_root"
              action="action_epic_condition" sequence="40"/>
</odoo>
