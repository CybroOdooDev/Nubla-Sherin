<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_nhs_ward_list" model="ir.ui.view">
        <field name="name">nhs.ward.list</field>
        <field name="model">nhs.ward</field>
        <field name="arch" type="xml">
            <list string="Wards">
                <field name="name"/>
                <field name="code"/>
                <field name="ward_type"/>
                <field name="specialty"/>
                <field name="capacity"/>
                <field name="patient_count" string="Current Patients"/>
                <field name="location"/>
                <field name="phone"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nhs_ward_form" model="ir.ui.view">
        <field name="name">nhs.ward.form</field>
        <field name="model">nhs.ward</field>
        <field name="arch" type="xml">
            <form string="Ward">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_patients" icon="fa-users">
                            <field name="patient_count" widget="statinfo" string="Patients"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ward Name"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="code" placeholder="Ward Code (e.g. W12)"/>
                        </h4>
                    </div>
                    <group>
                        <group string="Ward Details">
                            <field name="ward_type"/>
                            <field name="specialty"/>
                            <field name="capacity"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Location &amp; Contact">
                            <field name="location"/>
                            <field name="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes" invisible="not note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_nhs_ward_kanban" model="ir.ui.view">
        <field name="name">nhs.ward.kanban</field>
        <field name="model">nhs.ward</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="ward_type">
                <field name="name"/>
                <field name="code"/>
                <field name="ward_type"/>
                <field name="specialty"/>
                <field name="capacity"/>
                <field name="patient_count"/>
                <field name="phone"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_card oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="text-muted ms-1" t-if="record.code.value">
                                        (<field name="code"/>)
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div t-if="record.specialty.value">
                                    <i class="fa fa-stethoscope me-1 text-muted"/>
                                    <field name="specialty"/>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-bed me-1 text-muted"/>
                                    <span><field name="patient_count"/> / <field name="capacity"/> beds</span>
                                </div>
                                <div t-if="record.phone.value" class="mt-1">
                                    <i class="fa fa-phone me-1 text-muted"/>
                                    <field name="phone"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nhs_ward" model="ir.actions.act_window">
        <field name="name">Wards</field>
        <field name="res_model">nhs.ward</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Wards Configured</p>
            <p>Create your NHS ward and department structure to organise patient assignments.</p>
        </field>
    </record>

    <!-- Menu under Configuration -->
    <menuitem id="menu_nhs_wards_config"
              name="Wards"
              parent="menu_epic_configuration"
              action="action_nhs_ward"
              sequence="20"
              groups="epic_integration.group_nhs_trust_admin"/>
</odoo>
