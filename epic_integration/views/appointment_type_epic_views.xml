<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Inherit appointment.type form — add Epic Integration tab ──────── -->
    <record id="view_appointment_type_form_epic" model="ir.ui.view">
        <field name="name">appointment.type.form.epic</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Epic Integration" name="epic_integration">
                    <group>
                        <group string="Epic FHIR Mapping">
                            <field name="epic_service_type_code"
                                   placeholder="e.g. 501, CARDIO…"/>
                            <field name="epic_appointment_type_code"
                                   placeholder="e.g. FOLLOW-UP, ROUTINE…"/>
                            <field name="epic_department_code"
                                   placeholder="e.g. CARDIO-001, GP-WEST…"/>
                        </group>
                        <group string="Sync Settings">
                            <field name="epic_push_enabled"/>
                            <field name="epic_auto_sync"/>
                            <field name="is_nhs_appointment"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="epic_notes" nolabel="1"
                               placeholder="Describe how this appointment type maps to Epic…"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Custom NHS list view with domain filter + custom js_class ──────── -->
    <record id="view_appointment_type_list_nhs" model="ir.ui.view">
        <field name="name">appointment.type.list.nhs</field>
        <field name="model">appointment.type</field>
        <field name="arch" type="xml">
            <list string="NHS Appointments"
                  js_class="nhs_appointment_type_list">
                <field name="name" string="Appointment Title"/>
                <field name="appointment_duration" string="Duration (hrs)"/>
                <field name="epic_service_type_code" string="Epic Service Code"
                       optional="show"/>
                <field name="epic_appointment_type_code" string="Epic Type Code"
                       optional="show"/>
                <field name="epic_push_enabled" string="Push to Epic"
                       optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Action: NHS-filtered appointment types ────────────────────────── -->
    <record id="action_epic_appointment_types" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">appointment.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_nhs_appointment', '=', True)]</field>
        <field name="views" eval="[
            (ref('view_appointment_type_list_nhs'), 'list'),
            (False, 'kanban'),
            (False, 'form'),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No NHS Appointment Types Yet</p>
            <p>Click <strong>New</strong> to create an NHS appointment type using
               one of the pre-built templates (GP Consultation, Specialist,
               Follow-up, etc.) and map it to your Epic EHR codes.</p>
        </field>
    </record>

    <!-- ── Update the Appointments menu item ─────────────────────────────── -->
    <record id="menu_epic_appointments" model="ir.ui.menu">
        <field name="action" ref="action_epic_appointment_types"/>
        <field name="name">Appointments</field>
    </record>

    <!-- ── Synced appointments (from Epic FHIR sync) under Clinical Records ─ -->
    <menuitem id="menu_epic_synced_appointments"
              name="Synced Appointments (Epic)"
              parent="menu_epic_clinical"
              action="action_epic_appointment"
              sequence="35"
              groups="epic_integration.group_nhs_clinician"/>

</odoo>
