<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_epic_appointment_list" model="ir.ui.view">
        <field name="name">epic.appointment.list</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" default_order="start desc">
                <header>
                    <button name="action_sync_appointments" type="object" string="Sync Appointments from Epic" class="btn-primary" display="always"/>
                </header>
                <field name="start"/>
                <field name="end"/>
                <field name="patient_name"/>
                <field name="practitioner_name"/>
                <field name="service_type"/>
                <field name="appointment_type"/>
                <field name="status" widget="badge"
                    decoration-success="status in ('booked','arrived','checked-in')"
                    decoration-warning="status in ('proposed','pending','waitlist')"
                    decoration-danger="status in ('cancelled','noshow','entered-in-error')"
                    decoration-muted="status == 'fulfilled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_epic_appointment_form" model="ir.ui.view">
        <field name="name">epic.appointment.form</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <field name="status" widget="statusbar"
                        statusbar_visible="booked,arrived,fulfilled,cancelled"/>
                    <button name="action_sync_appointments" type="object" string="Sync Appointments from Epic" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="description" placeholder="Description"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="start"/>
                            <field name="end"/>
                            <field name="appointment_type"/>
                            <field name="service_type"/>
                        </group>
                        <group string="Participants">
                            <field name="patient_name"/>
                            <field name="practitioner_name"/>
                            <field name="epic_id"/>
                        </group>
                    </group>
                    <group string="Notes" invisible="not comment">
                        <field name="comment" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_epic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">epic.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sync Appointments from Epic</p>
            <p>Click "Sync Appointments from Epic" to fetch appointment data from the Epic FHIR API.</p>
        </field>
    </record>
</odoo>
