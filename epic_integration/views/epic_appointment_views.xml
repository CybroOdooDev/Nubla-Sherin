<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search View ─────────────────────────────────────────────────── -->
    <record id="view_epic_appointment_search" model="ir.ui.view">
        <field name="name">epic.appointment.search</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="description" string="Title"/>
                <field name="patient_id" string="Patient"/>
                <field name="practitioner_id" string="Practitioner"/>
                <field name="patient_name" string="Patient Name"/>
                <field name="service_type" string="Service Type"/>
                <separator/>
                <filter name="filter_booked" string="Booked"
                        domain="[('status','=','booked')]"/>
                <filter name="filter_arrived" string="Arrived"
                        domain="[('status','=','arrived')]"/>
                <filter name="filter_fulfilled" string="Fulfilled"
                        domain="[('status','=','fulfilled')]"/>
                <filter name="filter_cancelled" string="Cancelled"
                        domain="[('status','=','cancelled')]"/>
                <separator/>
                <filter name="filter_urgent" string="Urgent"
                        domain="[('priority','=','1')]"/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_patient" string="Patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter name="group_practitioner" string="Practitioner"
                            context="{'group_by': 'practitioner_id'}"/>
                    <filter name="group_service" string="Service Type"
                            context="{'group_by': 'service_type'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List View ───────────────────────────────────────────────────── -->
    <record id="view_epic_appointment_list" model="ir.ui.view">
        <field name="name">epic.appointment.list</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" default_order="start desc"
                  decoration-warning="status in ('proposed','pending','waitlist')"
                  decoration-danger="status in ('cancelled','noshow','entered-in-error')"
                  decoration-muted="status == 'fulfilled'">
                <header>
                    <button name="action_sync_appointments" type="object"
                            string="Sync Appointments from Epic"
                            class="btn-primary" display="always"/>
                </header>
                <field name="start" string="Date &amp; Time" optional="show"/>
                <field name="end" string="End" optional="hide"/>
                <field name="duration" string="Duration (hrs)" optional="show"/>
                <field name="description" string="Title"/>
                <field name="patient_id" string="Patient" optional="show"/>
                <field name="patient_name" string="Patient (Epic)"
                       optional="hide"/>
                <field name="practitioner_id" string="Practitioner"
                       optional="show"/>
                <field name="service_type" string="Service"/>
                <field name="appointment_type" string="Type" optional="hide"/>
                <field name="location" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('booked','arrived','checked-in')"
                       decoration-warning="status in ('proposed','pending','waitlist')"
                       decoration-danger="status in ('cancelled','noshow','entered-in-error')"
                       decoration-muted="status == 'fulfilled'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ─────────────────────────────────────────────────── -->
    <record id="view_epic_appointment_kanban" model="ir.ui.view">
        <field name="name">epic.appointment.kanban</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column"
                    quick_create="false">
                <field name="start"/>
                <field name="end"/>
                <field name="patient_id"/>
                <field name="patient_name"/>
                <field name="practitioner_id"/>
                <field name="practitioner_name"/>
                <field name="service_type"/>
                <field name="appointment_type"/>
                <field name="status"/>
                <field name="description"/>
                <field name="priority"/>
                <field name="location"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_card oe_kanban_global_click p-3">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-6">
                                        <t t-if="record.patient_id.value">
                                            <t t-esc="record.patient_id.value"/>
                                        </t>
                                        <t t-elif="record.patient_name.value">
                                            <t t-esc="record.patient_name.value"/>
                                        </t>
                                        <t t-else="">No Patient</t>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="text-muted small mb-1">
                                <t t-esc="record.description.value"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.start.value" class="d-flex align-items-center gap-1 mb-1">
                                    <i class="fa fa-clock-o text-muted"/>
                                    <span class="small"><field name="start"/></span>
                                </div>
                                <div t-if="record.service_type.value" class="d-flex align-items-center gap-1 mb-1">
                                    <i class="fa fa-stethoscope text-muted"/>
                                    <span class="small"><t t-esc="record.service_type.value"/></span>
                                </div>
                                <div t-if="record.practitioner_id.value or record.practitioner_name.value"
                                     class="d-flex align-items-center gap-1 mb-1">
                                    <i class="fa fa-user-md text-muted"/>
                                    <span class="small">
                                        <t t-if="record.practitioner_id.value">
                                            <t t-esc="record.practitioner_id.value"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="record.practitioner_name.value"/>
                                        </t>
                                    </span>
                                </div>
                                <div t-if="record.location.value" class="d-flex align-items-center gap-1">
                                    <i class="fa fa-map-marker text-muted"/>
                                    <span class="small"><t t-esc="record.location.value"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Form View ───────────────────────────────────────────────────── -->
    <record id="view_epic_appointment_form" model="ir.ui.view">
        <field name="name">epic.appointment.form</field>
        <field name="model">epic.appointment</field>
        <field name="arch" type="xml">
            <form string="NHS Appointment">
                <header>
                    <button name="action_sync_appointments" type="object"
                            string="Sync from Epic" class="btn-secondary"
                            groups="epic_integration.group_nhs_trust_admin"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="booked,arrived,fulfilled,cancelled"/>
                </header>
                <sheet>

                    <!-- ── Booking banner ───────────────────────────── -->
                    <div class="o_field_widget mb-3" style="
                            background: linear-gradient(135deg,#003087 0%,#005EB8 100%);
                            border-radius:8px; padding:20px 24px; color:#fff;">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fa fa-calendar-plus-o fa-2x" style="opacity:.8;"/>
                            <div class="flex-grow-1">
                                <div class="small fw-bold text-uppercase"
                                     style="letter-spacing:.08em;opacity:.75;">
                                    NHS Appointment
                                </div>
                                <h2 class="mb-0 mt-1" style="color:#fff;font-weight:600;">
                                    <field name="description"
                                           style="color:#fff;background:transparent;border:none;border-bottom:2px solid rgba(255,255,255,.4);border-radius:0;padding:0;font-size:inherit;font-weight:inherit;"
                                           placeholder="e.g. GP Consultation — John Smith"/>
                                </h2>
                            </div>
                            <div class="text-end">
                                <field name="priority" widget="priority"/>
                            </div>
                        </div>
                    </div>

                    <!-- ── Two-column booking details ───────────────── -->
                    <group>
                        <group string="Appointment Details">
                            <field name="nhs_appointment_type" string="Appointment Type"/>
                            <field name="start" string="Date &amp; Start Time"/>
                            <field name="end" string="End Time"/>
                            <field name="duration" string="Duration (hrs)"
                                   widget="float_time"/>
                            <field name="service_type"
                                   placeholder="e.g. General Medicine, Cardiology…"/>
                            <field name="location"
                                   placeholder="e.g. Ward 5, Room 12B…"/>
                            <field name="ward_id"
                                   placeholder="Select ward…"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Participants">
                            <field name="patient_id"
                                   string="Patient"
                                   placeholder="Search NHS patients…"
                                   options="{'no_create': True}"/>
                            <field name="patient_name"
                                   string="Patient (Epic, unlinked)"
                                   invisible="patient_id != False"
                                   placeholder="Name from Epic sync"/>
                            <field name="practitioner_id"
                                   string="Doctor / Practitioner"
                                   placeholder="Search clinical staff…"
                                   options="{'no_create': True}"/>
                            <field name="practitioner_name"
                                   string="Practitioner (Epic, unlinked)"
                                   invisible="practitioner_id != False"
                                   placeholder="Name from Epic sync"/>
                        </group>
                    </group>

                    <!-- ── Tabs ─────────────────────────────────────── -->
                    <notebook>
                        <page string="Notes &amp; Instructions" name="notes">
                            <field name="comment" nolabel="1"
                                   placeholder="Patient instructions, preparation details, appointment notes…"/>
                        </page>
                        <page string="Epic Integration" name="epic_data">
                            <group>
                                <group string="FHIR Reference">
                                    <field name="epic_id" string="Epic FHIR ID"
                                           readonly="1"
                                           placeholder="Auto-filled on sync from Epic"/>
                                    <field name="appointment_type"
                                           string="Epic Appointment Type (raw)"
                                           readonly="1"/>
                                </group>
                                <group string="Epic Participant Names">
                                    <field name="patient_name"
                                           string="Patient Name (Epic)"/>
                                    <field name="practitioner_name"
                                           string="Practitioner Name (Epic)"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ──────────────────────────────────────────────────────── -->
    <record id="action_epic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">epic.appointment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_epic_appointment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Appointments Yet</p>
            <p>Create a new appointment manually, or click
               <strong>Sync Appointments from Epic</strong> to pull from your
               Epic EHR system.</p>
        </field>
    </record>

</odoo>
