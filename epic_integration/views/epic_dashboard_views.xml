<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action that mounts the OWL dashboard component -->
    <record id="action_epic_dashboard" model="ir.actions.client">
        <field name="name">Clinical Dashboard</field>
        <field name="tag">epic_integration.dashboard</field>
