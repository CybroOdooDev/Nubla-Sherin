<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="epic_integration.NhsAppointmentPickerDialog">
        <Dialog size="'lg'" title.translate="Choose NHS Appointment Type">
            <t t-if="state.loading">
                <div class="text-center py-4">
                    <i class="fa fa-spinner fa-spin fa-2x" style="color:#005EB8"/>
                    <p class="mt-2 text-muted">Loading NHS templates…</p>
                </div>
            </t>
            <t t-else="">
                <div class="o_appointment_template_picker justify-content-center row">
                    <t t-foreach="Object.keys(state.templates)" t-as="key" t-key="key">
                        <t t-set="tpl" t-value="state.templates[key]"/>
                        <div class="col-12 col-md-6 py-2">
                            <div t-on-click="() => this.onTemplateClick(tpl)"
                                 class="o_appointment_template_card cursor-pointer card rounded row flex-row h-100 p-3 pt-4 g-0">
                                <div class="col-9 col-md-8 card-body d-flex flex-column pe-0 py-0">
                                    <h3 class="card-title text-break" t-out="tpl.title"/>
                                    <p class="card-text text-muted" t-out="tpl.description"/>
                                    <small t-if="tpl.duration_label" class="mt-auto text-primary fw-semibold">
                                        <i class="fa fa-clock-o me-1"/>
                                        <t t-esc="tpl.duration_label"/>
                                    </small>
                                </div>
                                <div class="col-3 col-md-4 d-flex align-items-center justify-content-center">
                                    <img class="h-75 w-auto" t-attf-src="{{tpl.icon}}" t-attf-alt="{{tpl.title}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
            <t t-set-slot="footer">
                <button t-on-click="props.close" class="btn btn-secondary" data-hotkey="x">
                    Close
                </button>
            </t>
        </Dialog>
    </t>
</templates>
