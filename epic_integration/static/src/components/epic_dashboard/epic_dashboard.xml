<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="epic_integration.Dashboard">
        <div class="o_epic_dashboard">

            <!-- Header -->
            <div class="o_epic_dashboard_header d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="mb-0">NHS Trust | Epic — Clinical Dashboard</h3>
                    <small class="text-muted">Real-time overview of all clinical records</small>
                </div>
            </div>

            <!-- Loading -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x" style="color:#005EB8"/>
                    <p class="mt-3 text-muted">Loading clinical data…</p>
                </div>
            </t>

            <!-- Error -->
            <t t-elif="state.error">
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-circle me-2"/>
                    <t t-esc="state.error"/>
                </div>
            </t>

            <!-- Dashboard content -->
            <t t-elif="state.data">

                <!-- ── KPI Cards ── -->
                <div class="o_epic_kpi_row">

                    <div class="o_epic_kpi_card o_epic_kpi_patients"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_patient')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-users"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.patients.total"/></span>
                            <span class="o_epic_kpi_label">Patients</span>
                            <span class="o_epic_kpi_sub"><t t-esc="state.data.patients.active"/> active</span>
                        </div>
                    </div>

                    <div class="o_epic_kpi_card o_epic_kpi_appointments"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_appointment')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-calendar-check-o"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.appointments.total"/></span>
                            <span class="o_epic_kpi_label">Appointments</span>
                            <span class="o_epic_kpi_sub"><t t-esc="state.data.appointments.today"/> today</span>
                        </div>
                    </div>

                    <div class="o_epic_kpi_card o_epic_kpi_allergies"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_allergy')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-exclamation-triangle"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.allergies.total"/></span>
                            <span class="o_epic_kpi_label">Allergies</span>
                            <span class="o_epic_kpi_sub">
                                <span class="badge text-bg-danger"><t t-esc="state.data.allergies.high_criticality"/> high risk</span>
                            </span>
                        </div>
                    </div>

                    <div class="o_epic_kpi_card o_epic_kpi_conditions"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_condition')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-heartbeat"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.conditions.total"/></span>
                            <span class="o_epic_kpi_label">Conditions</span>
                            <span class="o_epic_kpi_sub"><t t-esc="state.data.conditions.active"/> active</span>
                        </div>
                    </div>

                    <div class="o_epic_kpi_card o_epic_kpi_notes"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_clinical_note')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-file-text-o"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.clinical_notes.total"/></span>
                            <span class="o_epic_kpi_label">Clinical Notes</span>
                        </div>
                    </div>

                    <div class="o_epic_kpi_card o_epic_kpi_staff"
                         t-on-click="() => this.navigateTo('epic_integration.action_epic_practitioner')">
                        <div class="o_epic_kpi_icon"><i class="fa fa-user-md"/></div>
                        <div class="o_epic_kpi_body">
                            <span class="o_epic_kpi_value"><t t-esc="state.data.practitioners.total"/></span>
                            <span class="o_epic_kpi_label">Clinical Staff</span>
                            <span class="o_epic_kpi_sub"><t t-esc="state.data.wards.total"/> wards</span>
                        </div>
                    </div>

                </div>
                <!-- ── End KPI Cards ── -->

                <!-- ── Charts Row 1 ── -->
                <div class="o_epic_charts_row">
                    <div class="o_epic_chart_card">
                        <div class="o_epic_chart_title">Patients by Gender</div>
                        <div class="o_epic_chart_container">
                            <canvas t-ref="patientChart"/>
                        </div>
                    </div>
                    <div class="o_epic_chart_card">
                        <div class="o_epic_chart_title">Appointments by Status</div>
                        <div class="o_epic_chart_container">
                            <canvas t-ref="appointmentChart"/>
                        </div>
                    </div>
                    <div class="o_epic_chart_card">
                        <div class="o_epic_chart_title">Conditions by Status</div>
                        <div class="o_epic_chart_container">
                            <canvas t-ref="conditionChart"/>
                        </div>
                    </div>
                </div>

                <!-- ── Charts Row 2 ── -->
                <div class="o_epic_charts_row">
                    <div class="o_epic_chart_card">
                        <div class="o_epic_chart_title">Allergy Clinical Status</div>
                        <div class="o_epic_chart_container">
                            <canvas t-ref="allergyStatusChart"/>
                        </div>
                    </div>
                    <div class="o_epic_chart_card">
                        <div class="o_epic_chart_title">Allergies by Category</div>
                        <div class="o_epic_chart_container">
                            <canvas t-ref="allergyCategoryChart"/>
                        </div>
                    </div>
                    <!-- Allergy criticality summary card (no chart) -->
                    <div class="o_epic_chart_card o_epic_summary_card">
                        <div class="o_epic_chart_title">Allergy Criticality</div>
                        <div class="o_epic_criticality_summary">
                            <div class="o_epic_crit_row o_epic_crit_high">
                                <i class="fa fa-circle me-2"/>
                                <span>High</span>
                                <strong><t t-esc="state.data.allergies.high_criticality"/></strong>
                            </div>
                            <div class="o_epic_crit_row o_epic_crit_low">
                                <i class="fa fa-circle me-2"/>
                                <span>Low</span>
                                <strong><t t-esc="state.data.allergies.low_criticality"/></strong>
                            </div>
                            <div class="o_epic_crit_row o_epic_crit_total">
                                <i class="fa fa-circle me-2"/>
                                <span>Total Allergies</span>
                                <strong><t t-esc="state.data.allergies.total"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </div>
    </t>
</templates>
