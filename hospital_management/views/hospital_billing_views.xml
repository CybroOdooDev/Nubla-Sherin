<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Tree View Inherit -->
<record id="view_hospital_invoice_tree" model="ir.ui.view">
    <field name="name">account.move.tree.hospital</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_date']" position="after">
            <field name="patient_id" optional="show"/>
        </xpath>
    </field>
</record>

    <!-- Invoice Form View Inherit -->
    <record id="view_hospital_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form.hospital</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id"
                       invisible="move_type not in ['out_invoice', 'out_refund']"
                       domain="[('id', '=', partner_id)]"/>
                <field name="admission_id"
                       invisible="not patient_id"
                       domain="[('patient_id', '=', patient_id)]"/>
                <field name="consultation_id"
                       invisible="not patient_id"
                       domain="[('patient_id', '=', patient_id)]"/>
            </xpath>
        </field>
    </record>

    <!-- Invoice Search View Inherit -->
    <record id="view_hospital_invoice_search" model="ir.ui.view">
        <field name="name">account.move.search.hospital</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id"/>
            </xpath>
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter string="Hospital Invoices" name="hospital"
                        domain="[('is_hospital_invoice', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>