<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patient Portal Menu -->
    <template id="portal_my_home_menu_hospital" name="Portal layout : hospital menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'appointments'" class="breadcrumb-item active">
                <a href="/my/appointments">Appointments</a>
            </li>
            <li t-if="page_name == 'prescriptions'" class="breadcrumb-item active">
                <a href="/my/prescriptions">Prescriptions</a>
            </li>
            <li t-if="page_name == 'lab_results'" class="breadcrumb-item active">
                <a href="/my/lab-results">Lab Results</a>
            </li>
            <li t-if="page_name == 'invoices'" class="breadcrumb-item active">
                <a href="/my/invoices">Invoices</a>
            </li>
        </xpath>
    </template>

    <!-- Portal My Home -->
    <template id="portal_my_home_hospital" name="Portal My Home : hospital entries"
              inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Appointments</t>
                <t t-set="url" t-value="'/my/appointments'"/>
                <t t-set="placeholder_count" t-value="'appointment_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Prescriptions</t>
                <t t-set="url" t-value="'/my/prescriptions'"/>
                <t t-set="placeholder_count" t-value="'prescription_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Lab Results</t>
                <t t-set="url" t-value="'/my/lab-results'"/>
                <t t-set="placeholder_count" t-value="'lab_result_count'"/>
            </t>
        </xpath>
    </template>

    <!-- My Appointments -->
    <template id="portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Appointments</t>
            </t>
            <t t-if="not appointments">
                <div class="alert alert-info" role="alert">
                    You have no appointments yet.
                </div>
            </t>
            <t t-else="">
                <div class="row">
                    <t t-foreach="appointments" t-as="appointment">
                        <div class="col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <t t-esc="appointment.name"/>
                                    </h5>
                                    <p class="card-text">
                                        <strong>Doctor:</strong>
                                        Dr.
                                        <t t-esc="appointment.doctor_id.name"/>
                                        <br/>
                                        <strong>Date:</strong>
                                        <t t-esc="appointment.appointment_date"/>
                                        <br/>
                                        <strong>Time:</strong>
                                        <t t-esc="appointment.appointment_time"/>
                                        <br/>
                                        <strong>Status:</strong>
                                        <span t-attf-class="badge badge-#{appointment.state == 'confirmed' and 'success' or 'info'}">
                                            <t t-esc="appointment.state"/>
                                        </span>
                                    </p>
                                    <a t-attf-href="/my/appointment/#{appointment.id}" class="btn btn-primary btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- Appointment Detail -->
    <template id="portal_appointment_detail" name="Appointment Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header">
                                <h3>Appointment Details</h3>
                            </div>
                            <div class="card-body">
                                <table class="table">
                                    <tr>
                                        <td>
                                            <strong>Appointment ID:</strong>
                                        </td>
                                        <td>
                                            <t t-esc="appointment.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Doctor:</strong>
                                        </td>
                                        <td>Dr.
                                            <t t-esc="appointment.doctor_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Department:</strong>
                                        </td>
                                        <td>
                                            <t t-esc="appointment.department_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Date:</strong>
                                        </td>
                                        <td>
                                            <t t-esc="appointment.appointment_date"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Time:</strong>
                                        </td>
                                        <td>
                                            <t t-esc="appointment.appointment_time"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Status:</strong>
                                        </td>
                                        <td>
                                            <span t-attf-class="badge badge-#{appointment.state == 'confirmed' and 'success' or 'info'}">
                                                <t t-esc="appointment.state"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- My Prescriptions Template -->
    <template id="portal_my_prescriptions" name="My Prescriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Prescriptions</t>
            </t>
            <t t-if="not prescriptions">
                <div class="alert alert-info" role="alert">
                    You have no prescriptions yet.
                </div>
            </t>
            <t t-else="">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Date</th>
                            <th>Doctor</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="prescriptions" t-as="prescription">
                            <tr>
                                <td>
                                    <t t-esc="prescription.name"/>
                                </td>
                                <td>
                                    <t t-esc="prescription.prescription_date"/>
                                </td>
                                <td>Dr.
                                    <t t-esc="prescription.doctor_id.name"/>
                                </td>
                                <td>
                                    <span t-attf-class="badge badge-#{prescription.state == 'dispensed' and 'success' or 'info'}">
                                        <t t-esc="prescription.state"/>
                                    </span>
                                </td>
                                <td>
                                    <a t-attf-href="/my/prescription/#{prescription.id}" class="btn btn-sm btn-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <!-- My Lab Results Template -->
    <template id="portal_my_lab_results" name="My Lab Results">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Lab Results</t>
            </t>
            <t t-if="not lab_results">
                <div class="alert alert-info" role="alert">
                    You have no lab results yet.
                </div>
            </t>
            <t t-else="">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Test</th>
                            <th>Request Date</th>
                            <th>Completed Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lab_results" t-as="lab">
                            <tr>
                                <td>
                                    <t t-esc="lab.name"/>
                                </td>
                                <td>
                                    <t t-esc="lab.test_id.name"/>
                                </td>
                                <td>
                                    <t t-esc="lab.request_date"/>
                                </td>
                                <td>
                                    <t t-esc="lab.completed_date"/>
                                </td>
                                <td>
                                    <a t-attf-href="/my/lab-result/#{lab.id}" class="btn btn-sm btn-primary">
                                        View Result
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

</odoo>