<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department Tree View -->
    <record id="view_hospital_department_tree" model="ir.ui.view">
        <field name="name">hospital.department.tree</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="code"/>
                <field name="name"/>
                <field name="head_doctor_id"/>
                <field name="doctor_count"/>
                <field name="bed_count"/>
            </list>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_hospital_department_form" model="ir.ui.view">
        <field name="name">hospital.department.form</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="head_doctor_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Department description..."/>
                    </group>
                    <group>
                        <group>
                            <field name="doctor_count"/>
                        </group>
                        <group>
                            <field name="bed_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Wards">
                            <field name="ward_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="ward_type"/>
                                    <field name="total_beds"/>
                                    <field name="available_beds"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>




</odoo>