<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Insurance Tree View -->
    <record id="view_hospital_insurance_tree" model="ir.ui.view">
        <field name="name">hospital.insurance.tree</field>
        <field name="model">hospital.insurance</field>
        <field name="arch" type="xml">
            <list string="Insurance Companies">
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="coverage_percentage"/>
            </list>
        </field>
    </record>

    <!-- Insurance Form View -->
    <record id="view_hospital_insurance_form" model="ir.ui.view">
        <field name="name">hospital.insurance.form</field>
        <field name="model">hospital.insurance</field>
        <field name="arch" type="xml">
            <form string="Insurance Company">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="coverage_percentage"/>
                            <field name="max_coverage_amount"/>
                        </group>
                    </group>
                    <group string="Contact Information">
                        <group>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Insurance Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="coverage_percentage"/>
                                    <field name="max_coverage_amount"/>
                                    <field name="deductible"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Insurance Claim Tree View -->
    <record id="view_hospital_insurance_claim_tree" model="ir.ui.view">
        <field name="name">hospital.insurance.claim.tree</field>
        <field name="model">hospital.insurance.claim</field>
        <field name="arch" type="xml">
            <list string="Insurance Claims">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurance_id"/>
                <field name="claim_date"/>
                <field name="claimed_amount"/>
                <field name="approved_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Insurance Claim Form View -->
    <record id="view_hospital_insurance_claim_form" model="ir.ui.view">
        <field name="name">hospital.insurance.claim.form</field>
        <field name="model">hospital.insurance.claim</field>
        <field name="arch" type="xml">
            <form string="Insurance Claim">
                <header>
                    <button name="action_submit" string="Submit Claim" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="state != 'under_review'"/>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-danger" invisible="state != 'under_review'"/>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="insurance_id"/>
                            <field name="plan_id"/>
                        </group>
                        <group>
                            <field name="claim_date"/>
                            <field name="service_date"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="claimed_amount"/>
                            <field name="deductible"/>
                            <field name="copay"/>
                        </group>
                        <group>
                            <field name="approved_amount"/>
                            <field name="paid_amount"/>
                        </group>
                    </group>
                    <group string="Rejection Reason" invisible="state != 'rejected'">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Insurance Action -->
    <record id="action_hospital_insurance" model="ir.actions.act_window">
        <field name="name">Insurance Companies</field>
        <field name="res_model">hospital.insurance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an insurance company
            </p>
        </field>
    </record>

    <!-- Insurance Claim Action -->
    <record id="action_hospital_insurance_claim" model="ir.actions.act_window">
        <field name="name">Insurance Claims</field>
        <field name="res_model">hospital.insurance.claim</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an insurance claim
            </p>
        </field>
    </record>


</odoo>