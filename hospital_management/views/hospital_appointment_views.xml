<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment Tree View -->
    <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-info="state=='draft'"
                  decoration-success="state=='confirmed'"
                  decoration-warning="state=='waiting'"
                  decoration-danger="state=='no_show'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time" widget="float_time"/>
                <field name="appointment_type"/>
                <field name="queue_number"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-success="state=='completed'"
                       decoration-warning="state=='waiting'"/>
            </list>
        </field>
    </record>

<!--     Appointment Form View-->
<record id="view_hospital_appointment_form" model="ir.ui.view">
    <field name="name">hospital.appointment.form</field>
    <field name="model">hospital.appointment</field>
    <field name="arch" type="xml">
        <form string="Appointment">
            <header>
                <button name="action_confirm" string="Confirm" type="object"
                        class="oe_highlight" invisible="state != 'draft'"/>
                <button name="action_waiting" string="Check-in" type="object"
                        class="oe_highlight" invisible="state != 'confirmed'"/>
                <button name="action_in_progress" string="Start Consultation" type="object"
                        class="oe_highlight" invisible="state != 'waiting'"/>
                <button name="action_complete" string="Complete" type="object"
                        class="oe_highlight" invisible="state != 'in_progress'"/>
                <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ['completed', 'cancelled', 'no_show']"/>
                <button name="action_no_show" string="Mark as No Show" type="object"
                        invisible="state != 'confirmed'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,confirmed,waiting,in_progress,completed"/>
            </header>

            <sheet>
                <!-- Smart Button Section -->
                <div class="oe_button_box" name="button_box">
                    <button name="%(hospital_management.action_hospital_consultation)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-stethoscope"
                            invisible="not consultation_id"
                            context="{'default_appointment_id': id}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Consultation</span>
                        </div>
                    </button>
                </div>

                <!-- Title -->
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>

                <!-- Patient & Appointment Info -->
                <group>
                    <group string="Patient Information">
                        <field name="patient_id" options="{'no_create': True}"/>
                        <field name="patient_phone"/>
                        <field name="patient_email"/>
                    </group>
                    <group string="Appointment Details">
                        <field name="doctor_id" options="{'no_create': True}"/>
                        <field name="department_id"/>
                        <field name="appointment_type"/>
                        <field name="priority" widget="priority"/>
                    </group>
                </group>

                <!-- Schedule & Billing -->
                <group>
                    <group string="Schedule">
                        <field name="appointment_date"/>
                        <field name="appointment_time" widget="float_time"/>
                        <field name="duration"/>
                    </group>
                    <group string="Queue  Billing">
                        <field name="queue_number"/>
                        <field name="doctor_fee"/>
                        <field name="check_in_time" readonly="1"/>
                    </group>
                </group>

                <!-- Reason & Notes -->
                <group>
                    <field name="reason" placeholder="Reason for visit..."/>
                    <field name="notes" placeholder="Additional notes..."/>
                </group>

                <!-- Recurring Appointment -->
                <group string="Recurring Appointment" invisible="state != 'draft'">
                    <field name="is_recurring"/>
                    <field name="recurrence_pattern" invisible="not is_recurring"/>
                    <field name="recurrence_count" invisible="not is_recurring"/>
                </group>

                <!-- Notifications -->
                <group string="Notifications">
                    <group>
                        <field name="email_sent"/>
                        <field name="sms_sent"/>
                    </group>
                    <group>
                        <field name="reminder_sent"/>
                    </group>
                </group>
            </sheet>

            <!-- Chatter -->
            <chatter/>
        </form>
    </field>
</record>



    <!-- Appointment Kanban View -->
    <record id="view_hospital_appointment_kanban" model="ir.ui.view">
        <field name="name">hospital.appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="patient_id"/>
                                    </strong>
                                </div>
                                <span class="badge badge-pill">
                                    <field name="appointment_time" widget="float_time"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="doctor_id"/>
                                <br/>
                                <field name="appointment_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Appointment Search View -->
    <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <filter string="Today" name="today"
                        domain="[('appointment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('appointment_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                ('appointment_date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Waiting" name="waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <separator/>
                <filter string="Consultation" name="consultation" domain="[('appointment_type', '=', 'consultation')]"/>
                <filter string="Emergency" name="emergency" domain="[('appointment_type', '=', 'emergency')]"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'appointment_date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>



</odoo>