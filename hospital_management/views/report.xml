<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patient Card Report -->
    <record id="action_report_patient_card" model="ir.actions.report">
        <field name="name">Patient Card</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_patient_card</field>
        <field name="report_file">hospital_management.report_patient_card</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Prescription Report -->
    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hospital.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_prescription</field>
        <field name="report_file">hospital_management.report_prescription</field>
        <field name="binding_model_id" ref="model_hospital_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Lab Result Report -->
    <record id="action_report_lab_result" model="ir.actions.report">
        <field name="name">Lab Result</field>
        <field name="model">hospital.lab.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_lab_result</field>
        <field name="report_file">hospital_management.report_lab_result</field>
        <field name="binding_model_id" ref="model_hospital_lab_request"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Discharge Summary Report -->
    <record id="action_report_discharge_summary" model="ir.actions.report">
        <field name="name">Discharge Summary</field>
        <field name="model">hospital.admission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_discharge_summary</field>
        <field name="report_file">hospital_management.report_discharge_summary</field>
        <field name="binding_model_id" ref="model_hospital_admission"/>
        <field name="binding_type">report</field>
    </record>

</odoo>