<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_appointment_wizard_form" model="ir.ui.view">
        <field name="name">hospital.appointment.wizard.form</field>
        <field name="model">hospital.appointment.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Appointment">
                <group>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                    </group>
                    <group>
                        <field name="appointment_date"/>
                        <field name="appointment_time" widget="float_time"/>
                        <field name="appointment_type"/>
                    </group>
                </group>
                <group>
                    <field name="reason" placeholder="Reason for visit..."/>
                </group>
                <footer>
                    <button string="Create Appointment" type="object"
                            name="action_create_appointment" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hospital_appointment_wizard" model="ir.actions.act_window">
        <field name="name">Quick Appointment</field>
        <field name="res_model">hospital.appointment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>