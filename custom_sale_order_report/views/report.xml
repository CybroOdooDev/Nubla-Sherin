<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="global_report_styles"
              name="Global Report Styles"
              inherit_id="web.minimal_layout">

        <xpath expr="//head" position="inside">
            <style>

            /* Keep full grid */
            table.o_main_table {
                border-collapse: collapse !important;
            }

            table.o_main_table th,
            table.o_main_table td {
                border: 1px solid #9da3a6 !important;
            }

            /* STOP vertical border after last column */
            table.o_main_table th:last-child,
            table.o_main_table td:last-child {
                border-right: 0 !important;
            }

            /* STOP bottom border bleed on page 1 table */
            table.o_main_table_page1 tbody tr:last-child td {
                border-bottom: 0 !important;
            }

            table.o_main_table_page1 {
                border-bottom: 0 !important;
            }

            /* Page 2 table starts fresh */
            table.o_main_table_page2 {
                margin-top: 0 !important;
            }

            /* Clean page break */
            .page-break-table {
                page-break-after: always !important;
                height: 0;
                margin: 0;
                padding: 0;
                border: none;
                clear: both;
            }

            .so_totals_wrapper {
                width: 45%;
                margin-left: auto;
                margin-top: 8px;
                page-break-inside: avoid;
            }

            .so_totals_wrapper .o_total_table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            .so_totals_wrapper .o_total_table td {
                border: 1px solid #9da3a6 !important;
                padding: 6px 8px;
                background: #ffffff;
                color: #000;
            }

            .so_totals_wrapper .o_total_table td:last-child {
                text-align: right;
            }

            /* SUCCESS total row */
            .so_totals_wrapper .o_total_table tr.o_total td,
            .so_totals_wrapper .o_total_table tr:last-child td {
                background-color: #7fb52c !important; /* success */
                color: #ffffff !important;
                font-weight: 600;
                border-color: #28a745 !important;
            }

            .so_totals_wrapper .o_total_table tr.o_total td *,
            .so_totals_wrapper .o_total_table tr:last-child td * {
                color: #ffffff !important;
            }

            .so_totals_wrapper {
                width: 48% !important;
                min-width: 320px !important;
                margin-left: auto !important;
            }

            /* Make rows visually taller */
            .so_totals_wrapper .o_total_table {
                width: 100% !important;
                table-layout: fixed !important;
            }

            /* Increase cell size */
            .so_totals_wrapper .o_total_table td {
                padding: 9px 12px !important;
                font-size: 15px !important;
                line-height: 1.45 !important;
            }

            /* Make TOTAL row slightly stronger */
            .so_totals_wrapper .o_total_table tr:last-child td {
                padding-top: 10px !important;
                padding-bottom: 10px !important;
            }

            </style>
        </xpath>
    </template>


    <template id="sale_report_totals_detached"
              inherit_id="sale.report_saleorder_document">

        <!-- Replace the main table with split tables -->
        <xpath expr="//table[contains(@class,'o_main_table')]" position="replace">

            <!-- Calculate split point -->
            <t t-set="total_lines" t-value="len(lines_to_report)"/>
            <t t-set="split_at" t-value="int(total_lines * 0.9) if total_lines > 10 else total_lines"/>

            <!-- PAGE 1 TABLE -->
            <table class="o_has_total_table table o_main_table o_main_table_page1 table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-start">Description</th>
                        <th name="th_quantity" class="text-end text-nowrap">Quantity</th>
                        <th name="th_priceunit" class="text-end text-nowrap">Unit Price</th>
                        <th name="th_discount" t-if="display_discount" class="text-end">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_taxes" class="text-end">Taxes</th>
                        <th name="th_subtotal" class="text-end">
                            <span>Amount</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="lines_to_report[:split_at]" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                        <tr t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                <td name="td_name"><span t-field="line.name">Bacon Burger</span></td>
                                <td name="td_quantity" class="o_td_quantity text-end">
                                    <span t-field="line.product_uom_qty" class="text-nowrap">3</span>
                                    <span t-field="line.product_uom">units</span>
                                    <span t-if="line.product_packaging_id">
                                        (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                    </span>
                                </td>
                                <td name="td_priceunit" class="text-end text-nowrap">
                                    <span t-field="line.price_unit">3</span>
                                </td>
                                <td t-if="display_discount" class="text-end">
                                    <span t-field="line.discount">-</span>
                                </td>
                                <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                    <span t-out="taxes">Tax 15%</span>
                                </td>
                                <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_subtotal">27.00</span>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name">A section title</span>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name">A note</span>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- PAGE BREAK (only if we have more lines) -->
            <t t-if="split_at &lt; total_lines">
                <div class="page-break-table"></div>

                <!-- PAGE 2 TABLE -->
                <table class="o_has_total_table table o_main_table o_main_table_page2 table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description" class="text-start">Description</th>
                            <th name="th_quantity" class="text-end text-nowrap">Quantity</th>
                            <th name="th_priceunit" class="text-end text-nowrap">Unit Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-end">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_taxes" class="text-end">Taxes</th>
                            <th name="th_subtotal" class="text-end">
                                <span>Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-foreach="lines_to_report[split_at:]" t-as="line">
                            <tr t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type and line.product_type != 'combo'">
                                    <td name="td_name"><span t-field="line.name">Bacon Burger</span></td>
                                    <td name="td_quantity" class="o_td_quantity text-end">
                                        <span t-field="line.product_uom_qty" class="text-nowrap">3</span>
                                        <span t-field="line.product_uom">units</span>
                                        <span t-if="line.product_packaging_id">
                                            (<span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="line.product_packaging_id"/>)
                                        </span>
                                    </td>
                                    <td name="td_priceunit" class="text-end text-nowrap">
                                        <span t-field="line.price_unit">3</span>
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span t-field="line.discount">-</span>
                                    </td>
                                    <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                    <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes">Tax 15%</span>
                                    </td>
                                    <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                        <span t-field="line.price_subtotal">27.00</span>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name">A section title</span>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name">A note</span>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

        </xpath>

        <!-- Replace totals section with right-aligned wrapper -->
        <xpath expr="//div[@class='clearfix'][@name='so_total_summary']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="sale.document_tax_totals">
                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                        <t t-set="currency" t-value="doc.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>

    </template>


    <template id="invoice_report_totals_detached"
              inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='total']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="account.document_tax_totals">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-set="currency" t-value="o.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>
    </template>


    <template id="purchase_report_totals_detached"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//div[@id='total']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="purchase.document_tax_totals">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-set="currency" t-value="o.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>
    </template>

</odoo>