           /* ===============================
   SALE ORDER TABLE ONLY
=============================== */

.sale-order-report table.o_main_table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 14px;
}

.sale-order-report table.o_main_table th,
.sale-order-report table.o_main_table td {
    border: 1px solid #9da3a6;
    padding: 8px 10px;
    line-height: 1.6;
    vertical-align: top;
}

.sale-order-report table.o_main_table tr {
<!--    page-break-inside: avoid;-->
                page-break-inside: auto;
}

/* COLUMN WIDTHS */
.sale-order-report table.o_main_table th:nth-child(1),
.sale-order-report table.o_main_table td:nth-child(1) { width: 12%; }

.sale-order-report table.o_main_table th:nth-child(2),
.sale-order-report table.o_main_table td:nth-child(2) { width: 38%; }

.sale-order-report table.o_main_table th:nth-child(3),
.sale-order-report table.o_main_table td:nth-child(3) {
    width: 10%;
    white-space: nowrap;
}

.sale-order-report table.o_main_table th:nth-child(4),
.sale-order-report table.o_main_table td:nth-child(4) {
    width: 10%;
    white-space: nowrap;
}

.sale-order-report table.o_main_table th:nth-child(5),
.sale-order-report table.o_main_table td:nth-child(5) {
    width: 8%;
    white-space: nowrap;
}

.sale-order-report table.o_main_table th:nth-child(6),
.sale-order-report table.o_main_table td:nth-child(6) {
    width: 8%;
    white-space: nowrap;
}

.sale-order-report table.o_main_table th:nth-child(7),
.sale-order-report table.o_main_table td:nth-child(7) {
    width: 14%;
    white-space: nowrap;
    text-align: right;
}

/* Prevent ugly word breaking */
.sale-order-report table.o_main_table td:nth-child(2) {
    word-break: normal;
    overflow-wrap: normal;
    white-space: normal;
}
                .sale-order-report table.o_main_table thead th {
    font-weight: 800 !important;
                font-size: 14px;
}


            /* ===============================
               TOTALS TABLE
            =============================== */

             .so_totals_wrapper {
                width: 45%;
                margin-left: auto;
                margin-top: 8px;
                page-break-inside: avoid;
            }

            .so_totals_wrapper .o_total_table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            .so_totals_wrapper .o_total_table td {
                border: 1px solid #9da3a6 !important;
                padding: 6px 8px;
                background: #ffffff;
                color: #000;
            }

            .so_totals_wrapper .o_total_table td:last-child {
                text-align: right;
            }

            /* SUCCESS total row */
            .so_totals_wrapper .o_total_table tr.o_total td,
            .so_totals_wrapper .o_total_table tr:last-child td {
                background-color: #7fb52c !important; /* success */
                color: #ffffff !important;
                font-weight: 700;
                border-color: #28a745 !important;
            }

            .so_totals_wrapper .o_total_table tr.o_total td *,
            .so_totals_wrapper .o_total_table tr:last-child td * {
                color: #ffffff !important;
            }


            .so_totals_wrapper {
                width: 48% !important;
                min-width: 320px !important;
                margin-left: auto !important;
            }

            /* Make rows visually taller */
            .so_totals_wrapper .o_total_table {
                width: 100% !important;
                table-layout: fixed !important;
            }

            /* Increase cell size */
            .so_totals_wrapper .o_total_table td {
                padding: 9px 12px !important;
                font-size: 15px !important;
                line-height: 1.45 !important;
            }

            /* Make TOTAL row slightly stronger */
            .so_totals_wrapper .o_total_table tr:last-child td {
                padding-top: 10px !important;
                padding-bottom: 10px !important;
            }

            </style>
        </xpath>
    </template>

    <!-- =====================================================
         SALE ORDER REPORT
    ====================================================== -->
    <template id="sale_report_totals_detached"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']" position="attributes">
        <attribute name="class">page sale-order-report</attribute>
    </xpath>

        <!-- Totals -->
        <xpath expr="//div[@class='clearfix'][@name='so_total_summary']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="sale.document_tax_totals">
                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                        <t t-set="currency" t-value="doc.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>

        <!-- MAIN TABLE -->
        <xpath expr="//table[contains(@class, 'o_main_table')]" position="replace">

            <t t-set="lines" t-value="lines_to_report"/>
            <t t-set="first_page_rows" t-value="8"/>
            <t t-set="other_page_rows" t-value="18"/>

            <!-- ================= PAGE 1 ================= -->
            <table class="o_main_table">
                <thead>
                    <tr>
                        <th>Referentie</th>
                        <th>Omschrijving</th>
                        <th class="text-end">Aantal</th>
                        <th class="text-end">Prijs</th>
                        <th class="text-end">Kort.%</th>
                        <th class="text-end">BTW</th>
                        <th class="text-end">Bedrag</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines[:first_page_rows]" t-as="line">
                        <tr>
                            <td><span t-field="line.product_id.default_code"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td class="text-end"><span t-field="line.discount"/></td>
                            <td class="text-end">
                                <span t-esc="', '.join([tax.name for tax in line.tax_id])"/>
                            </td>
                            <td class="text-end"><span t-field="line.price_subtotal"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <t t-if="len(lines) &gt; first_page_rows">
                <div style="page-break-after: always;"></div>
            </t>

            <!-- ================= PAGE 2+ ================= -->
            <t t-foreach="range(first_page_rows, len(lines), other_page_rows)" t-as="page_start">

                <table class="o_main_table">
                    <thead>
                        <tr>
                            <th>Referentie</th>
                            <th>Omschrijving</th>
                            <th class="text-end">Aantal</th>
                            <th class="text-end">Prijs</th>
                            <th class="text-end">Kort.%</th>
                            <th class="text-end">BTW</th>
                            <th class="text-end">Bedrag</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines[page_start:page_start + other_page_rows]" t-as="line">
                            <tr>
                                <td><span t-field="line.product_id.default_code"/></td>
                                <td><span t-field="line.name"/></td>
                                <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                <td class="text-end"><span t-field="line.price_unit"/></td>
                                <td class="text-end"><span t-field="line.discount"/></td>
                                <td class="text-end">
                                    <span t-esc="', '.join([tax.name for tax in line.tax_id])"/>
                                </td>
                                <td class="text-end"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <t t-if="page_start + other_page_rows &lt; len(lines)">
                    <div style="page-break-after: always;"></div>
                </t>

            </t>

        </xpath>
    </template>
      <template id="invoice_report_totals_detached"
              inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='total']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="account.document_tax_totals">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-set="currency" t-value="o.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>
    </template>


    <template id="purchase_report_totals_detached"
              inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//div[@id='total']" position="replace">
            <div class="so_totals_wrapper">
                <table class="o_total_table">
                    <t t-call="purchase.document_tax_totals">
                        <t t-set="tax_totals" t-value="o.tax_totals"/>
                        <t t-set="currency" t-value="o.currency_id"/>
                    </t>
                </table>
            </div>
        </xpath>
    </template>
</odoo>


