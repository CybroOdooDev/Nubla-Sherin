<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- My Receipts List Page -->
    <template id="portal_my_receipts" name="My Receipts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Receipts</t>
            </t>

            <div class="container mt-3">
                <t t-if="not receipts">
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0">You don't have any receipts yet.</p>
                    </div>
                </t>

                <t t-if="receipts">
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Receipt #</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="receipts" t-as="receipt">
                                        <td>
                                            <a t-attf-href="/my/receipt/#{receipt.receipt_token}">
                                                <strong t-field="receipt.name"/>
                                            </a>
                                        </td>
                                        <td>
                                            <span t-field="receipt.date_order" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td>
                                            <span t-esc="len(receipt.lines)"/> items
                                        </td>
                                        <td class="text-end">
                                            <strong t-field="receipt.amount_total"
                                                    t-options='{"widget": "monetary", "display_currency": receipt.currency_id}'/>
                                        </td>
                                        <td class="text-center">
                                            <a t-attf-href="/my/receipt/#{receipt.receipt_token}"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa fa-eye"/> View
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pager -->
                    <div t-if="pager" class="mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Receipt Detail Page -->
    <template id="portal_receipt_detail" name="Receipt Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 mb-5">
                <div class="row">
                    <div class="col-12 mb-3">
                        <a href="/my/receipts" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"/> Back to My Receipts
                        </a>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm">
                            <div class="card-body p-4">
                                <!-- Company Header -->
                                <div class="text-center mb-4 pb-3 border-bottom">
                                    <img t-if="company.logo"
                                         t-att-src="image_data_uri(company.logo)"
                                         style="max-height: 80px;"
                                         class="mb-3"
                                         alt="Company Logo"/>
                                    <h3 t-field="company.name" class="mb-2"/>
                                    <div class="text-muted">
                                        <div t-field="company.street"/>
                                        <div>
                                            <span t-field="company.city"/>,
                                            <span t-field="company.state_id.name"/>
                                            <span t-field="company.zip"/>
                                        </div>
                                        <div t-field="company.phone"/>
                                    </div>
                                </div>

                                <!-- Receipt Info -->
                                <div class="row mb-4">
                                    <div class="col-6">
                                        <h5 class="text-primary">Receipt Details</h5>
                                        <table class="table table-sm table-borderless">
                                            <tr>
                                                <td><strong>Receipt #:</strong></td>
                                                <td><span t-field="order.name"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Date:</strong></td>
                                                <td><span t-field="order.date_order" t-options='{"widget": "datetime"}'/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Cashier:</strong></td>
                                                <td><span t-field="order.user_id.name"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-6">
                                        <h5 class="text-primary">Customer</h5>
                                        <p class="mb-1"><strong t-field="order.partner_id.name"/></p>
                                        <p class="text-muted mb-0" t-if="order.partner_id.email">
                                            <i class="fa fa-envelope"/> <span t-field="order.partner_id.email"/>
                                        </p>
                                        <p class="text-muted mb-0" t-if="order.partner_id.phone">
                                            <i class="fa fa-phone"/> <span t-field="order.partner_id.phone"/>
                                        </p>
                                    </div>
                                </div>

                                <!-- Order Lines -->
                                <h5 class="text-primary mb-3">Items</h5>
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Product</th>
                                                <th class="text-center">Qty</th>
                                                <th class="text-end">Unit Price</th>
                                                <th class="text-end">Discount</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="order.lines" t-as="line">
                                                <td>
                                                    <strong t-field="line.product_id.name"/>
                                                    <div class="small text-muted" t-if="line.product_id.default_code">
                                                        [<span t-field="line.product_id.default_code"/>]
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <span t-field="line.qty"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-field="line.price_unit"
                                                          t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-if="line.discount > 0">
                                                        <span t-field="line.discount"/>%
                                                    </span>
                                                    <span t-else="">-</span>
                                                </td>
                                                <td class="text-end">
                                                    <strong t-field="line.price_subtotal_incl"
                                                            t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Totals -->
                                <div class="row justify-content-end mt-4">
                                    <div class="col-md-6">
                                        <table class="table table-sm">
                                            <tr>
                                                <td class="text-end"><strong>Subtotal:</strong></td>
                                                <td class="text-end" style="width: 150px;">
                                                    <span t-field="order.amount_total"
                                                          t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="text-end"><strong>Tax:</strong></td>
                                                <td class="text-end">
                                                    <span t-field="order.amount_tax"
                                                          t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                            </tr>
                                            <tr class="table-active">
                                                <td class="text-end"><h5 class="mb-0"><strong>Total:</strong></h5></td>
                                                <td class="text-end">
                                                    <h5 class="mb-0">
                                                        <strong t-field="order.amount_total"
                                                                t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                    </h5>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <!-- Payment Info -->
                                <div class="mt-4 pt-3 border-top" t-if="order.payment_ids">
                                    <h5 class="text-primary mb-3">Payment Information</h5>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Payment Method</th>
                                                <th class="text-end">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="order.payment_ids" t-as="payment">
                                                <td><span t-field="payment.payment_method_id.name"/></td>
                                                <td class="text-end">
                                                    <span t-field="payment.amount"
                                                          t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Actions -->
                                <div class="text-center mt-4 pt-3 border-top">
                                    <p class="text-muted mb-3">Thank you for your purchase!</p>
                                    <a t-attf-href="/my/receipt/#{order.receipt_token}/pdf"
                                       class="btn btn-primary me-2">
                                        <i class="fa fa-download"/> Download PDF
                                    </a>
                                    <button class="btn btn-secondary" onclick="window.print()">
                                        <i class="fa fa-print"/> Print Receipt
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Public Receipt Template (for QR code access) -->
    <template id="public_receipt_template" name="Public Receipt">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle"/>
                            This is a public receipt view.
                            <a href="/web/login">Login</a> to see all your receipts.
                        </div>

                        <t t-call="pos_digital_receipt.portal_receipt_detail"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Receipt Not Found -->
    <template id="receipt_not_found" name="Receipt Not Found">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="alert alert-danger text-center">
                    <h3><i class="fa fa-exclamation-triangle"/> Receipt Not Found</h3>
                    <p>The receipt you are looking for does not exist or has been removed.</p>
                    <a href="/my/receipts" class="btn btn-primary mt-3">View My Receipts</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Add Receipt Counter to Portal Home -->
    <template id="portal_my_home_receipt" name="Portal My Home : receipt entries" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Receipts</t>
                <t t-set="url" t-value="'/my/receipts'"/>
                <t t-set="placeholder_count" t-value="'receipt_count'"/>
            </t>
        </xpath>
    </template>
</odoo>