<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="public_receipt_template">
        <t t-call="website.layout">

            <div class="container mt-3" style="max-width:380px;">

                <div class="text-center">
                    <img t-if="company.logo"
                         t-att-src="'data:image/png;base64,' + company.logo.decode()"
                         style="max-height:80px;"/>
                </div>

                <div class="text-center" style="font-size:13px;">
                    <div><t t-esc="company.name"/></div>
                    <div><t t-esc="company.phone"/></div>
                    <div><t t-esc="company.email"/></div>
                </div>

                <hr/>

                <table style="width:100%; font-size:14px;">
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Amount</th>
                    </tr>
                    <tr t-foreach="order.lines" t-as="line">
                        <td><t t-esc="line.product_id.display_name"/></td>
                        <td><t t-esc="line.qty"/></td>
                        <td><t t-esc="line.price_subtotal"/></td>
                    </tr>
                </table>

                <hr/>

                <div style="font-weight:700;">
                    Subtotal: <t t-esc="order.amount_untaxed"/>
                </div>

                <div style="font-weight:700;">
                    TOTAL: <t t-esc="order.amount_total"/>
                </div>

                <hr/>

                <div class="text-center" style="font-size:13px;">
                    Thank You... Please Visit Again ...
                </div>

            </div>

        </t>
    </template>

</odoo>
