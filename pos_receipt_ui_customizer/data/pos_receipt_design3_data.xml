<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_receipt_design3" model="pos.receipt">
        <field name="name">Design 3 - Row Layout</field>
        <field name="design_receipt"><![CDATA[
            <div class="pos-receipt custom-pos-receipt design3-row-layout"
                 t-att-style="'padding:15px; line-height:1.3; max-width:320px; margin:0 auto; font-size:12px; font-family:' + (env.services.pos.config.design_receipt_font_style or 'Arial')">

                <!-- HEADER -->
                <div class="receipt-header-section" style="text-align:center; padding-bottom:12px; border-bottom:2px solid #000;">
                    <t t-if="env.services.pos.config.logo">
                        <img t-att-src="'data:image/png;base64,' + env.services.pos.config.logo"
                             style="max-width:100px; margin-bottom:6px; opacity:0.95;"/>
                    </t>

                    <div class="placeholder-span" style="font-size:16px; font-weight:700; letter-spacing:0.5px; margin-top:4px;">
                        [[ company.name ]]
                    </div>

                    <div class="placeholder-span" style="font-size:10px; line-height:1.4; opacity:0.85;">
                        [[ company.phone ]]
                    </div>
                    <div class="placeholder-span" style="font-size:10px; line-height:1.4; opacity:0.85;">
                        [[ company.email ]]
                    </div>
                    <div class="placeholder-span" style="font-size:10px; line-height:1.4; opacity:0.85;">
                        [[ company.website ]]
                    </div>
                </div>

                <!-- ORDERLINES SECTION - COMPACT ROW LAYOUT -->
                <div class="receipt-orderlines" style="margin-top:12px;">
                    <div style="font-weight:600; font-size:11px; letter-spacing:0.3px; margin-bottom:8px; text-transform:uppercase; opacity:0.75;">
                        Order Details
                    </div>

                    <!-- Compact orderlines -->
                    <div class="orderlines-container" style="margin-top:8px;">
                        <t t-if="props.orderlines and props.orderlines.length">
                            <div t-foreach="props.orderlines"
                                 t-as="orderline"
                                 t-key="orderline_index"
                                 class="orderline-row"
                                 style="padding:6px 8px;
                                        margin-bottom:4px;">

                                <!-- Product Name & Quantity in one line -->
                                <div style="display:flex;
                                            justify-content:space-between;
                                            align-items:baseline;
                                            font-size:12px;
                                            font-weight:600;
                                            margin-bottom:4px;
                                            color:#333;">
                                    <span style="flex:1; word-wrap:break-word; padding-right:8px;">
                                        <t t-esc="orderline.productName"/>
                                    </span>
                                    <span style="white-space:nowrap; font-size:11px; opacity:0.7;">
                                        Qty: <t t-esc="orderline.qty"/>
                                    </span>
                                </div>

                                <!-- Price -->
                                <div style="text-align:right;
                                            font-size:13px;
                                            font-weight:700;
                                            color:#000;">
                                    <t t-esc="orderline.price"/>
                                </div>

                                <!-- Dynamic Fields - Compact -->
                                <t t-if="orderline._dynamicValues">
                                    <div t-foreach="Object.entries(orderline._dynamicValues)"
                                         t-as="entry"
                                         t-key="entry[0]"
                                         style="display:flex;
                                                justify-content:space-between;
                                                font-size:10px;
                                                margin-top:3px;
                                                padding-top:3px;
                                                border-top:1px dashed #ddd;">
                                        <span style="opacity:0.6;">
                                            <t t-esc="entry[0]"/>
                                        </span>
                                        <span style="font-weight:600;">
                                            <t t-esc="entry[1] || ''"/>
                                        </span>
                                    </div>
                                </t>

                                <!-- DROP ZONE for dynamic fields -->
                                <div class="design3-order-dropzone receipt-header-dropzone"
                                     data-zone="order"
                                     t-on-dragover.prevent
                                     t-on-drop="onColumnDropUniversal"
                                     style="margin:3px 0;
                                            padding:3px;
                                            border:1px dashed #bbb;
                                            border-radius:3px;
                                            min-height:20px;
                                            text-align:center;
                                            font-size:9px;
                                            color:#888;">
                                    <span class="customizer-only-text"></span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- TOTALS SECTION - COMPACT -->
                <div class="receipt-totals" style="margin-top:15px; padding:10px; border:2px solid #000;">
                    <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:6px; opacity:0.85;">
                        <span style="font-weight:500;">Subtotal</span>
                        <span class="placeholder-span">[[ receipt.total_without_tax ]]</span>
                    </div>

                    <div style="border-top:1px solid #000; margin:8px 0;"></div>

                    <div style="display:flex; justify-content:space-between; font-size:14px; font-weight:700; letter-spacing:0.3px;">
                        <span>TOTAL</span>
                        <span class="placeholder-span">[[ receipt.amount_total ]]</span>
                    </div>
                </div>

                <!-- QR CODE SECTION -->
                <div class="receipt-qr-wrapper">
                    <div class="receipt-qr-template" style="display:none;">
                        <t t-if="props.data.custom_qr_image">
                            <img t-att-src="'data:image/png;base64,' + props.data.custom_qr_image"
                                 style="width:100px; height:100px; margin:8px auto; display:block;"/>
                        </t>
                    </div>
                </div>

                <div class="qrArea" style="display:flex; justify-content:center; margin:15px 0;">
                    <!-- JS QR goes here -->
                </div>

                <!-- FOOTER - COMPACT -->
                <div class="receipt-footer" style="text-align:center; font-size:11px; border-top:2px solid #000; padding-top:10px; letter-spacing:0.3px; line-height:1.5;">
                    <div style="font-weight:600; margin-bottom:3px;">Thank You</div>
                    <div style="opacity:0.7;">We appreciate your business</div>
                </div>

            </div>
        ]]></field>
    </record>
</odoo>